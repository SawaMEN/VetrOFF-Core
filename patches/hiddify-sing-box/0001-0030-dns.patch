+					"default":  &routerTestFakeDNSTransport{tag: "default", transportType: C.DNSTypeUDP},
+				},
+			}
+			client := &fakeDNSClient{
+				exchange: func(transport adapter.DNSTransport, message *mDNS.Msg) (*mDNS.Msg, error) {
+					switch transport.Tag() {
+					case "upstream":
