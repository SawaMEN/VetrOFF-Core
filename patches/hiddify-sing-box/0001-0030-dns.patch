+					DefaultOptions: option.DefaultDNSRule{
+						RawDefaultDNSRule: option.RawDefaultDNSRule{
+							MatchResponse: &option.DNSRuleMatchResponse{Enabled: true},
+							Invert:        testCase.invert,
