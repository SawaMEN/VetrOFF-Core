diff --git a/common/tls/h_utls_xray_names.go b/common/tls/h_utls_xray_names.go
new file mode 100644
index 0000000000000000000000000000000000000000..0755cefbb731e38299cf48b86b0489597c7b2823
--- /dev/null
+++ b/common/tls/h_utls_xray_names.go
@@ -0,0 +1,72 @@
+//go:build with_utls
+
+package tls
+
+import (
+	"strings"
+
+	utls "github.com/metacubex/utls"
+)
+
+// xrayFingerprints are Xray's fingerprint names for a fixed uTLS ClientHello (its
