+// An MTU that has no room for a fragment is one that nothing larger than it is written to.
+func TestFragmentsWithoutRoom(t *testing.T) {
+	for _, test := range []struct {
+		src, dst string
+		mtu      int
+	}{
+		{"10.0.0.2:53", "10.0.0.1:1234", ipv4HeaderSize + 7},
