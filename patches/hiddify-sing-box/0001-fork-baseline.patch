diff --git a/third_party/xray-core/infra/conf/policy.go b/third_party/xray-core/infra/conf/policy.go
new file mode 100644
index 0000000000000000000000000000000000000000..1182766cc854226acffc449ebeeda5843ae84dbf
--- /dev/null
