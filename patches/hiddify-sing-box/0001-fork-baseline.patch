+}
+
+type HasLatency interface {
+	ConnectionLatency() Latency
+	HandshakeLatency() Latency
+}
+
+type AverageLatency struct {
+	access sync.Mutex
+	value  uint64
+}
+
+func (al *AverageLatency) Update(newValue uint64) {
+	al.access.Lock()
