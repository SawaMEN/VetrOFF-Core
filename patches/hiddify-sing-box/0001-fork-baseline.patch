+// What comes through a tunnel has come a long way and is not taken with a wrong checksum.
+// And nothing that is from or for this machine itself is taken from any tun.
+func TestChecksumsAndLoopback(t *testing.T) {
+	for _, test := range []struct {
+		src, dst, loopback string
+		read               []string
+	}{
+		{"10.0.0.1:1234", "10.0.0.2:80", "127.0.0.1:80", []string{"zero", "abc", "pad"}},
+		{"[fd00::1]:1234", "[fd00::2]:80", "[::1]:80", []string{"abc", "pad"}},
+	} {
+		conns := make(chan accepted, 2)
+		p, l := newPeer(t, test.src, test.dst)
+		s := newTestStack(t, l, accept(conns))
+		s.verify = true
+		damaged := func(b []byte) []byte {
+			b = bytes.Clone(b)
+			b[len(b)-1] ^= 1
+			return b
+		}
+
+		syn := p.bytes(p.seq, tcpSyn, nil, []byte{0})
+		l.in <- damaged(syn)
+		if syn[0]>>4 == 4 {
+			header := bytes.Clone(syn)
+			header[8]--
+			l.in <- header
+		}
+		p.silent(50 * time.Millisecond)
+		l.in <- syn
+		if s := p.receive(); s.flags != tcpSyn|tcpAck || s.ack != p.seq+1 {
+			t.Fatal("not an answer to the SYN: flags ", s.flags, ", ack ", s.ack)
+		}
+		p.send(p.seq+1, tcpRst, nil, nil)
+		forgotten(t, s)
+		if syn[0]>>4 == 4 {
+			// the options of a header are a part of it
+			options := append(append(bytes.Clone(syn[:ipv4HeaderSize]), 1, 1, 1, 1), syn[ipv4HeaderSize:]...)
+			options[0]++
+			binary.BigEndian.PutUint16(options[2:], uint16(len(options)))
+			options[10], options[11] = 0, 0
+			binary.BigEndian.PutUint16(options[10:], checksum(sum(options[:ipv4HeaderSize+4], 0)))
+			wrong := bytes.Clone(options)
+			wrong[ipv4HeaderSize] = 0
+			l.in <- wrong
+			p.silent(50 * time.Millisecond)
+			l.in <- options
+			if s := p.receive(); s.flags != tcpSyn|tcpAck || s.ack != p.seq+1 {
+				t.Fatal("not an answer to the SYN: flags ", s.flags, ", ack ", s.ack)
+			}
+			p.send(p.seq+1, tcpRst, nil, nil)
+			forgotten(t, s)
+		}
+
+		// a UDP packet may go without a checksum, but not an IPv6 one
+		l.in <- udpPacket(p.src, p.dst, []byte("zero"))
+		l.in <- damaged(summed(udpPacket(p.src, p.dst, []byte("abc"))))
+		l.in <- summed(udpPacket(p.src, p.dst, []byte("abc")))
+		// a packet may be longer than what it carries, and the checksum is of that
+		padded := append(summed(udpPacket(p.src, p.dst, []byte("pad"))), 0, 0, 0, 0)
+		setIPLength(padded[:len(padded)-4-3-udpHeaderSize], len(padded))
+		l.in <- padded
+		a := take(t, conns)
+		for _, expected := range test.read {
+			read(t, a.conn, expected)
+		}
+
+		proto, request := byte(protoICMPv4), byte(8)
+		if p.src.Addr().Is6() {
+			proto, request = protoICMPv6, 128
+		}
+		var ip [ipv6HeaderSize]byte
+		n := putIPHeader(ip[:], proto, p.src.Addr(), p.dst.Addr())
+		setIPLength(ip[:n], n+12)
+		echo := summed(append(ip[:n:n], request, 0, 0, 0, 1, 2, 3, 4, 'a', 'b', 'c', 'd'))
+		l.in <- damaged(echo)
+		p.silent(50 * time.Millisecond)
+		l.in <- echo
+		if packet, ok := parsePacket(p.packet(), 0); !ok || packet.proto != proto || string(packet.payload[4:]) != "\x01\x02\x03\x04abcd" {
+			t.Fatal("wrong echo reply: ", packet)
+		}
+
+		// to this machine itself, from it, to no address, and from many at once
+		loopback := netip.MustParseAddrPort(test.loopback)
+		none := netip.AddrPortFrom(netip.IPv4Unspecified(), 80)
+		if p.src.Addr().Is6() {
+			none = netip.AddrPortFrom(netip.IPv6Unspecified(), 80)
+		}
+		l.in <- summed(udpPacket(netip.AddrPortFrom(p.src.Addr(), 1236), none, []byte("abc")))
+		many := netip.AddrPortFrom(netip.MustParseAddr("224.0.0.1"), 1234)
+		if p.src.Addr().Is6() {
+			many = netip.AddrPortFrom(netip.MustParseAddr("ff02::1"), 1234)
+		}
+		for _, from := range []netip.AddrPort{loopback, many} {
+			l.in <- summed(udpPacket(from, netip.AddrPortFrom(p.dst.Addr(), 53), []byte("abc")))
+		}
+		l.in <- summed(udpPacket(netip.AddrPortFrom(p.src.Addr(), 1235), loopback, []byte("abc")))
+		if p.src.Addr().Is6() {
+			// nor to or from an IPv6 address that stands for an IPv4 one: ::ffff:0.0.0.0 would be dialed as 0.0.0.0
+			for _, to := range []string{"[::ffff:0.0.0.0]:53", "[::ffff:127.0.0.1]:53", "[::ffff:10.0.0.2]:53"} {
+				l.in <- summed(udpPacket(netip.AddrPortFrom(p.src.Addr(), 1237), netip.MustParseAddrPort(to), []byte("abc")))
+			}
+			l.in <- summed(udpPacket(netip.MustParseAddrPort("[::ffff:10.0.0.1]:1238"), netip.AddrPortFrom(p.dst.Addr(), 53), []byte("abc")))
+			dst := p.dst
+			p.dst = netip.MustParseAddrPort("[::ffff:0.0.0.0]:80")
+			p.send(p.seq, tcpSyn, nil, nil)
+			p.dst = dst
+		}
+		p.dst = loopback
+		p.send(p.seq, tcpSyn, nil, nil)
+		p.silent(50 * time.Millisecond)
+		select {
+		case a := <-conns:
+			t.Fatal("a connection from ", a.conn.RemoteAddr(), " to ", a.dest)
+		default:
+		}
+	}
+}
+
+// handler is a ConnectionHandler that is a function
+type handler func(net.Conn, net.Destination)
+
+func (h handler) HandleConnection(conn net.Conn, dest net.Destination) { h(conn, dest) }
+
+// What a stack is like depends on what it is made with.
+func TestNewStack(t *testing.T) {
+	l := newLink()
+	made, _ := NewStack(context.Background(), StackOptions{Tun: l, MTU: testMTU}, nil)
+	if s := made.(*stack); s.mtu != testMTU || s.window != tcpWindow || s.verify || s.stamps || s.segmenter != nil || s.handle != nil || s.udp != nil {
+		t.Fatal("wrong stack for a tun of this machine that only opens connections: ", s)
+	}
+	l.segments = true
+	made, _ = NewStack(context.Background(), StackOptions{Tun: l, MTU: testMTU}, handler(echo))
+	if s := made.(*stack); s.window != tcpLargeWindow || s.verify || s.stamps || s.segmenter == nil || s.handle == nil || s.udp == nil {
+		t.Fatal("wrong stack for a tun that takes large segments: ", s)
+	}
+	l.segments = false
+	addresses := []netip.Addr{netip.MustParseAddr("10.0.0.2")}
+	made, _ = NewStack(context.Background(), StackOptions{Tun: l, MTU: testMTU, Addresses: addresses, Remote: true}, nil)
+	if s := made.(*stack); s.window != tcpLargeWindow || !s.verify || !s.stamps || s.segmenter != nil || len(s.addresses) != 1 {
+		t.Fatal("wrong stack for a tunnel to another system: ", s)
+	}
+}
+
+// What is opened from here gets a port that nothing else of it is on, as long as there is one.
+func TestPorts(t *testing.T) {
+	p, l := newPeer(t, "10.0.0.1:80", "10.0.0.2:0")
+	s := newDialStack(t, l, "10.0.0.2", "fd00::2")
+	// all but one are taken, UDP ports on one address or the other
+	const free = 1<<15 + 1234
+	udp, tcp := &udpSocket{queue: newPacketQueue(1)}, new(tcpConn)
+	s.mu.Lock()
+	for port := 1 << 15; port < 1<<16; port++ {
+		if port != free {
+			s.sockets[netip.AddrPortFrom(s.addresses[port&1], uint16(port))] = udp
+			s.conns[flow{src: p.src, dst: netip.AddrPortFrom(s.addresses[0], uint16(port))}] = tcp
+		}
+	}
+	s.mu.Unlock()
+	defer func() {
+		s.mu.Lock()
+		for f, c := range s.conns {
+			if c == tcp {
+				delete(s.conns, f)
+			}
+		}
+		s.mu.Unlock()
+	}()
+
+	conn, err := s.DialUDP()
+	if err != nil || netip.MustParseAddrPort(conn.LocalAddr().String()).Port() != free {
+		t.Fatal("a port that is taken: ", conn, ", error: ", err)
+	}
+	if _, err := s.DialUDP(); err == nil {
+		t.Fatal("a port although none is left")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	result := dial(ctx, s, p.src)
+	if p.dialed(); p.dst.Port() != free {
+		t.Fatal("a connection from a port that is taken: ", p.dst)
+	}
+	if _, err := s.DialTCP(context.Background(), p.src); err == nil {
+		t.Fatal("a connection although no port is left")
+	}
+	// only for the same other side
+	other := dial(ctx, s, netip.MustParseAddrPort("10.0.0.1:81"))
+	p.packet()
+	cancel()
+	<-result
+	<-other
+}
+
+// Fragments that do not fit each other are of no packet, and those of a packet are not put together
+// with those of another.
+func TestFragmentsThatDoNotFit(t *testing.T) {
+	src, dst := netip.MustParseAddr("10.0.0.1"), netip.MustParseAddr("10.0.0.2")
+	fragment := func(from netip.Addr, proto byte, id uint32, offset, size int, more bool, fill byte) packet {
+		return packet{proto: proto, src: from, dst: dst, payload: bytes.Repeat([]byte{fill}, size), fragment: true, more: more, offset: offset, id: id}
+	}
+	udp := func(offset, size int, more bool, fill byte) packet {
+		return fragment(src, protoUDP, 1, offset, size, more, fill)
+	}
+	waited := func(r *reassembly) int {
+		r.mu.Lock()
+		defer r.mu.Unlock()
+		return len(r.packets)
+	}
+	// add takes fragments, the last of which makes a packet or not
+	add := func(r *reassembly, fragments ...packet) (packet, bool) {
+		for _, f := range fragments[:len(fragments)-1] {
+			if p, ok := r.add(f); ok {
+				t.Fatal("a packet before its last fragment: ", p)
+			}
+		}
+		return r.add(fragments[len(fragments)-1])
+	}
+
+	r := new(reassembly)
+	for i, f := range []packet{
+		// without anything, not a number of 8 bytes with more to come, past what an IP packet carries
+		udp(0, 0, true, 1),
+		udp(0, 12, true, 1),
+		udp(math.MaxUint16-ipv4HeaderSize-7, 8, false, 1),
+		fragment(netip.MustParseAddr("fd00::1"), protoUDP, 1, math.MaxUint16-7, 8, false, 1),
+	} {
+		if _, ok := r.add(f); ok || waited(r) != 0 {
+			t.Fatal("a fragment that is none is waited for more of: ", i)
+		}
+	}
+	for i, fragments := range [][]packet{
+		// overlapping, a second end past the first and before it, past the end, an end before what came
+		{udp(0, 16, true, 1), udp(8, 16, true, 2)},
+		{udp(8, 8, false, 1), udp(16, 8, false, 2)},
+		{udp(8, 8, false, 1), udp(0, 8, false, 2)},
+		{udp(8, 8, false, 1), udp(16, 16, true, 2)},
+		{udp(16, 8, true, 1), udp(8, 8, false, 2)},
+	} {
+		r := new(reassembly)
+		if _, ok := add(r, fragments...); ok || waited(r) != 0 {
+			t.Fatal("fragments that do not fit each other are still waited for: ", i)
+		}
+	}
+
+	// one that comes twice is taken once, as it came first
+	if p, ok := add(r, udp(0, 16, true, 1), udp(0, 16, true, 2), udp(16, 8, false, 3)); !ok || string(p.payload) != strings.Repeat("\x01", 16)+strings.Repeat("\x03", 8) || waited(r) != 0 {
+		t.Fatal("wrong packet of a fragment that came twice: ", p, ok)
+	}
+	// the same number from someone else, or of another protocol, is another packet
+	if p, ok := add(r, udp(0, 8, true, 1), fragment(netip.MustParseAddr("10.0.0.3"), protoUDP, 1, 8, 8, false, 2),
+		fragment(src, protoICMPv4, 1, 8, 8, false, 3), udp(8, 8, false, 4)); !ok || string(p.payload) != strings.Repeat("\x01", 8)+strings.Repeat("\x04", 8) || waited(r) != 2 {
+		t.Fatal("wrong packet among others with its number: ", p, ok)
+	}
+	// what is left of a packet whose other fragments were lost is not put together with a later one of its number
+	r = new(reassembly)
+	r.add(udp(0, 8, true, 1))
+	r.packets[fragments{src, dst, protoUDP, 1}].since = time.Now().Add(-2 * fragmentsTime)
+	if p, ok := add(r, udp(8, 8, false, 2), udp(0, 8, true, 3)); !ok || string(p.payload) != strings.Repeat("\x03", 8)+strings.Repeat("\x02", 8) {
+		t.Fatal("wrong packet after one of its number was given up: ", p, ok)
+	}
+	// when too many are waited for, the one that is waited for the longest makes room
+	r = new(reassembly)
+	for id := range uint32(fragmentsMost) {
+		r.add(fragment(src, protoUDP, id, 0, 8, true, 1))
+	}
+	r.packets[fragments{src, dst, protoUDP, 7}].since = time.Now().Add(-time.Second)
+	r.add(fragment(src, protoUDP, fragmentsMost, 0, 8, true, 1))
+	if r.packets[fragments{src, dst, protoUDP, 7}] != nil || r.packets[fragments{src, dst, protoUDP, fragmentsMost}] == nil || waited(r) != fragmentsMost {
+		t.Fatal("not the one that was waited for the longest made room")
+	}
+}
+
+// The checksum is that of the 16-bit words added one by one.
+func TestChecksum(t *testing.T) {
+	b := make([]byte, 5000)
+	rand.Read(b)
+	for size := 0; size < len(b); size += 1 + size/64 {
+		expected := uint32(size)
+		for i := 0; i < size; i += 2 {
+			expected += uint32(b[i]) << 8
+			if i+1 < size {
+				expected += uint32(b[i+1])
+			}
+			expected = expected>>16 + expected&0xffff
+		}
+		if got := checksum(sum(b[:size], uint64(size))); got != ^uint16(expected) {
+			t.Fatal("checksum of ", size, " bytes: ", got, ", expected ", ^uint16(expected))
+		}
+	}
+}
diff --git a/third_party/xray-core/proxy/tun/tcp_lightweight.go b/third_party/xray-core/proxy/tun/tcp_lightweight.go
new file mode 100644
index 0000000000000000000000000000000000000000..efef58b9748722399a826d1bc5e2e983ba73bb8b
--- /dev/null
+++ b/third_party/xray-core/proxy/tun/tcp_lightweight.go
@@ -0,0 +1,1261 @@
+package tun
+
+import (
+	"context"
+	"encoding/binary"
+	"io"
+	"math"
+	"math/rand/v2"
+	"net/netip"
+	"slices"
+	"sync"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+)
+
+const (
+	tcpFin = 1 << iota
+	tcpSyn
+	tcpRst
+	tcpPsh
+	tcpAck
+)
+
+const (
+	// tcpWindow is what a connection takes from the system before its reader has to take it,
+	// and the most that it sends to the system before that is acknowledged. More than that, for several
+	// connections at once, is more packets than the queue of a tun holds (500 on Linux)
+	tcpWindow = 256 << 10
+	// tcpLargeWindow is the same for a tun that takes and gives segments that are larger than its MTU: those are
+	// few, and a way with a longer round trip, as a router has to what is behind it, is not held back by it
+	tcpLargeWindow = 1 << 20
+	// tcpWindowShift makes them fit the 16 bits of a window
+	tcpWindowShift = 5
+	// tcpHeld is how many segments wait for one that was lost before them,
+	// and of how many parts what the system says it has is known
+	tcpHeld = 1024
+	// tcpSmallest is the smallest mss that the system is believed, the one of Linux
+	tcpSmallest = 48
+	// tcpStamps is what the times of both sides take of the options of every segment that carries them (RFC 7323)
+	tcpStamps = 12
+	// tcpOpening is how many connections that the other side opens can be waiting for the answer to their SYN-ACK
+	tcpOpening = 65535
+	// tcpStart is how many segments are sent before any of them is acknowledged
+	tcpStart = 10
+	// tcpSegment is the largest payload of a segment that the tun splits by itself,
+	// tcpParts of how many parts of what was written it is made at most
+	tcpSegment = math.MaxUint16 - ipv6HeaderSize - tcpHeaderSize
+	tcpParts   = 7
+	// tcpKept is how large a payload is at least for the buffers that it was read into to be kept. A smaller one
+	// is copied to where the one before it ends, for a reader to get buffers that are full
+	tcpKept = buf.Size / 2
+
+	// tcpTick is how often a connection that waits for something looks at what it waits for
+	tcpTick = 100 * time.Millisecond
+	// ticks without anything acknowledged before it is sent again, twice as many every next time, a minute at most,
+	// while an open connection that waits sends again every two seconds at most or as often as an answer takes,
+	// twice as seldom every next minute: when its way was away for a while it goes on soon after the way is back,
+	// and the next segment still waits the doubled time, so that its answer can be timed
+	tcpRetransmitTicks     = 3
+	tcpRetransmitTicksOpen = 20
+	tcpRetransmitTicksMost = 600
+	tcpMinuteTicks         = int(time.Minute / tcpTick)
+	// an open connection is given up after four minutes of ticks without an acknowledgment since the timer first sent
+	// it again, as what is behind a wireless link may be away for a while (ticks, so that the time a computer sleeps
+	// is not counted), and one that never answered after it was sent again that many times, after twenty seconds
+	tcpGiveUpTicks    = 4 * tcpMinuteTicks
+	tcpSynRetransmits = 5
+	// ticks between the probes of a window that stays closed
+	tcpProbeTicks = 10
+	// tcpLinger is how long a closed connection waits for the system to close its side
+	tcpLinger = 30 * time.Second
+)
+
+var (
+	errTCPReset       = errors.New("connection reset")
+	errTCPTimeout     = errors.New("connection timed out")
+	errTCPRefused     = errors.New("connection refused")
+	errTCPUnreachable = errors.New("destination unreachable")
+)
+
+// tcpStarted is where the times that segments carry count from
+var tcpStarted = time.Now()
+
+// segment is a TCP segment that came from the tun
+type segment struct {
+	seq, ack uint32
+	flags    byte
+	window   uint16
+	options  []byte
+	// payload is without its last rest bytes when those are in other buffers of the stack, see stack.whole
+	payload []byte
+	rest    int
+}
+
+// nextOption returns the first option of o and what follows it, kind is zero when there is none
+func nextOption(o []byte) (kind byte, value, rest []byte) {
+	for len(o) > 0 && o[0] == 1 {
+		o = o[1:]
+	}
+	if len(o) < 2 || int(o[1]) < 2 || int(o[1]) > len(o) {
+		return 0, nil, nil
+	}
+	return o[0], o[2:o[1]], o[o[1]:]
+}
+
+// held is a segment that came before the one in front of it
+type held struct {
+	seq  uint32
+	data *buf.Buffer
+}
+
+// tcpConn is a TCP connection that the system opened through the tun, or one that was opened to it by DialTCP.
+// Mostly the two are on the same machine, with nothing but the queue of the tun in between, which drops what
+// does not fit. But the system may also pass on what others send, as a router does, and then the link to them
+// is in between. So a connection has windows that are small enough, keeps what came after a lost segment,
+// tells the system what it has (SACK), sends again what the system misses, and sends no more at once
+// than what has arrived before (slow start and congestion avoidance as in RFC 5681)
+type tcpConn struct {
+	stack    *stack
+	flow     flow
+	src, dst net.Destination
+	// ip is the IP header of what is sent, without the length
+	ip [ipv6HeaderSize]byte
+	// ipSize is the size of that header
+	ipSize int
+	// mss is the largest payload of a segment that is sent
+	mss int
+	// window is tcpWindow or tcpLargeWindow
+	window int32
+	// sndShift and rcvShift are the window scale of what the system and we advertise
+	sndShift, rcvShift uint8
+	// sack is set if the system takes selective acknowledgments
+	sack bool
+	// stamps is set if every segment carries the time of this side and the last one that came of the other side,
+	// which sees by it how long its segments take, also the ones that it sent again (RFC 7323).
+	// stampBase is what the time of this side starts from, stampSent the one that the last segment carried
+	stamps               bool
+	stampBase, stampSent uint32
+
+	mu       sync.Mutex
+	readable sync.Cond
+	writable sync.Cond
+
+	established bool
+	// opened is there while DialTCP waits for the answer to its SYN, and closed when that wait is over
+	opened chan struct{}
+	// closed is set when Close is called
+	closed bool
+	// err is why the connection is gone
+	err error
+
+	rcvNxt uint32
+	// rcvAcked is the last acknowledgment number sent
+	rcvAcked uint32
+	// rcvAdvertised is the last window sent, in bytes
+	rcvAdvertised int32
+	rcvQueue      buf.MultiBuffer
+	rcvLen        int32
+	rcvFin        bool
+	// rcvEnd is where what the system sends ends, if rcvEnds: its FIN came with a segment that waits in rcvHeld
+	rcvEnd  uint32
+	rcvEnds bool
+	// rcvHeld is what came after something that did not, in the order of seq and without overlaps
+	rcvHeld []held
+	// rcvLast is the seq of the last one that was put into rcvHeld
+	rcvLast uint32
+	// stamp is the time of the other side that is sent back to it
+	stamp uint32
+
+	sndUna, sndNxt uint32
+	sndWnd         uint32
+	// sndQueue is what was sent and is not acknowledged
+	sndQueue buf.MultiBuffer
+	// sndBase is the sequence number of the first byte of sndQueue
+	sndBase uint32
+	sndFin  bool
+	// writing is how many of the last of sndQueue WriteMultiBuffer is sending, it is the only one to release them
+	writing int
+	// blocked is set while WriteMultiBuffer waits for the window
+	blocked bool
+	// sending is set while WriteMultiBuffer writes a segment without mu, ackWanted if sendAck was called meanwhile
+	sending, ackWanted bool
+	dupAcks            int
+	// cwnd is how much the way to the system takes at once, as far as that is known: it grows while what is sent
+	// arrives, by as much as arrives below ssthresh, and is cut when something is lost
+	cwnd, ssthresh uint32
+	// sacked is what the system says it has past sndUna, in order and apart from each other
+	sacked [][2]uint32
+	// recovering is set from a sign of loss until what was sent by then, up to recover, is acknowledged
+	recovering bool
+	recover    uint32
+	// lost is the end of what is lost past the last of sacked, resent the end of what was sent again since then
+	lost, resent uint32
+	// headAt is when the segment at sndUna was sent again, or took that place while something was lost.
+	// It is zero when that segment is not sent once more for the system still asking for it: it was already
+	headAt time.Time
+	// timed is the end of a segment that was sent at timedAt and not again, to see how long its acknowledgment takes.
+	// The first one is the SYN-ACK
+	timed   uint32
+	timedAt time.Time
+	// srtt is how long an acknowledgment takes, rttvar how much that varies (RFC 6298)
+	srtt, rttvar time.Duration
+
+	timer *time.Timer
+	armed bool
+	// stalled counts ticks without an acknowledgment of what waits for one
+	stalled, retransmitTicks, retransmits int
+	// lostTicks counts the ticks since the timer sent again the first time since something was acknowledged
+	lostTicks int
+	lingered  bool
+}
+
+func newTCPConn(s *stack, f flow) *tcpConn {
+	c := &tcpConn{
+		stack:           s,
+		flow:            f,
+		src:             net.TCPDestination(net.IPAddress(f.src.Addr().AsSlice()), net.Port(f.src.Port())),
+		dst:             net.TCPDestination(net.IPAddress(f.dst.Addr().AsSlice()), net.Port(f.dst.Port())),
+		window:          s.window,
+		ssthresh:        uint32(s.window),
+		timedAt:         time.Now(),
+		retransmitTicks: tcpRetransmitTicks,
+	}
+	c.readable.L = &c.mu
+	c.writable.L = &c.mu
+	c.ipSize = putIPHeader(c.ip[:], protoTCP, f.dst.Addr(), f.src.Addr())
+	c.mss = s.mtu - c.ipSize - tcpHeaderSize
+	c.sndUna = rand.Uint32()
+	c.sndNxt = c.sndUna + 1
+	c.stampBase = rand.Uint32()
+	return c
+}
+
+// synchronize takes what the SYN of the other side says. c.mu is held, or nobody else has c yet
+func (c *tcpConn) synchronize(syn segment) {
+	c.rcvNxt = syn.seq + 1
+	c.sndWnd = uint32(syn.window)
+	c.sack, c.stamps, c.sndShift, c.rcvShift = false, false, 0, 0
+	for kind, value, o := nextOption(syn.options); kind != 0; kind, value, o = nextOption(o) {
+		switch {
+		case kind == 2 && len(value) == 2:
+			c.mss = min(c.mss, int(binary.BigEndian.Uint16(value)))
+		case kind == 3 && len(value) == 1:
+			c.sndShift = min(value[0], 14)
+			c.rcvShift = tcpWindowShift
+		case kind == 4:
+			c.sack = true
+		case kind == 8 && len(value) == 8 && c.stack.stamps:
+			c.stamps, c.stamp = true, binary.BigEndian.Uint32(value)
+		}
+	}
+	if c.stamps {
+		c.mss -= tcpStamps
+	}
+	c.mss = max(c.mss, tcpSmallest)
+	c.cwnd = tcpStart * uint32(c.mss)
+}
+
+// DialTCP implements Stack
+func (s *stack) DialTCP(ctx context.Context, remote netip.AddrPort) (net.Conn, error) {
+	remote = netip.AddrPortFrom(remote.Addr().Unmap(), remote.Port())
+	local, err := s.local(remote.Addr())
+	if err != nil {
+		return nil, err
+	}
+	opened := make(chan struct{})
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		return nil, io.ErrClosedPipe
+	}
+	f := flow{src: remote}
+	port, ok := ephemeral(func(port uint16) bool {
+		f.dst = netip.AddrPortFrom(local, port)
+		return s.conns[f] == nil
+	})
+	if !ok {
+		s.mu.Unlock()
+		return nil, errors.New("no port left to reach ", remote, " from")
+	}
+	f.dst = netip.AddrPortFrom(local, port)
+	c := newTCPConn(s, f)
+	// what the SYN offers, until the answer says what of it is taken
+	c.sack, c.stamps, c.rcvShift, c.opened = true, s.stamps, tcpWindowShift, opened
+	s.conns[f] = c
+	s.mu.Unlock()
+	s.opening.Add(1)
+	c.mu.Lock()
+	if c.err == nil {
+		c.sendSyn()
+		c.arm(tcpTick)
+	}
+	c.mu.Unlock()
+
+	select {
+	case <-opened:
+	case <-ctx.Done():
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.established {
+		if c.err == nil {
+			c.abort(ctx.Err())
+		}
+		return nil, c.err
+	}
+	return c, nil
+}
+
+// header writes the headers of a segment with size bytes of payload into b and returns their size.
+// The checksum of the segment is left to write. c.mu is held
+func (c *tcpConn) header(b []byte, seq uint32, flags byte, options []byte, size int) int {
+	n := copy(b, c.ip[:c.ipSize])
+	stamps := 0
+	if c.stamps {
+		stamps = tcpStamps
+	}
+	t := b[n : n+tcpHeaderSize+stamps+len(options)]
+	binary.BigEndian.PutUint16(t, c.flow.dst.Port())
+	binary.BigEndian.PutUint16(t[2:], c.flow.src.Port())
+	binary.BigEndian.PutUint32(t[4:], seq)
+	binary.BigEndian.PutUint32(t[8:], c.rcvNxt)
+	t[12] = byte(len(t)/4) << 4
+	t[13] = flags
+	window := max(c.window-c.rcvLen, 0)
+	if flags&tcpSyn != 0 {
+		// the window of a SYN is not scaled
+		binary.BigEndian.PutUint16(t[14:], uint16(min(window, math.MaxUint16)))
+	} else {
+		binary.BigEndian.PutUint16(t[14:], uint16(min(window>>c.rcvShift, math.MaxUint16)))
+	}
+	t[16], t[17], t[18], t[19] = 0, 0, 0, 0
+	if c.stamps {
+		o := t[tcpHeaderSize:]
+		o[0], o[1], o[2], o[3] = 1, 1, 8, 10
+		if !c.sending {
+			// what is sent while WriteMultiBuffer writes a segment has the time of that one: it may get to the tun
+			// first, and the other side drops a segment with a time before the last one that it took
+			c.stampSent = c.stampBase + uint32(time.Since(tcpStarted)/time.Millisecond)
+		}
+		binary.BigEndian.PutUint32(o[4:], c.stampSent)
+		binary.BigEndian.PutUint32(o[8:], c.stamp)
+	}
+	copy(t[tcpHeaderSize+stamps:], options)
+	setIPLength(b[:n], n+len(t)+size)
+	c.rcvAcked = c.rcvNxt
+	c.rcvAdvertised = window
+	return n + len(t)
+}
+
+// write completes the headers h with the checksum of the segment and writes it to the tun.
+// A segment that is not written is one that is lost: it is sent again when it is not acknowledged
+func (c *tcpConn) write(h, payload []byte) {
+	t := h[c.ipSize:]
+	binary.BigEndian.PutUint16(t[16:], transportChecksum(h[:c.ipSize], protoTCP, t, payload))
+	_ = c.stack.tun.WritePacket(h, payload)
+}
+
+// send writes a segment to the tun. c.mu is held
+func (c *tcpConn) send(seq uint32, flags byte, options, payload []byte) {
+	var b [ipv6HeaderSize + tcpHeaderSize + 40]byte
+	c.write(b[:c.header(b[:], seq, flags, options, len(payload))], payload)
+}
+
+// sendSyn sends the answer to the SYN of the other side, or the SYN of a connection that is opened from here
+func (c *tcpConn) sendSyn() {
+	options := [12]byte{2, 4}
+	binary.BigEndian.PutUint16(options[2:], uint16(c.stack.mtu-c.ipSize-tcpHeaderSize))
+	n := 4
+	if c.sack {
+		n += copy(options[n:], []byte{1, 1, 4, 2})
+	}
+	if c.rcvShift != 0 {
+		n += copy(options[n:], []byte{1, 3, 3, c.rcvShift})
+	}
+	flags := byte(tcpSyn | tcpAck)
+	if c.opened != nil {
+		flags = tcpSyn
+	}
+	c.send(c.sndUna, flags, options[:n], nil)
+}
+
+// sendAck acknowledges what was received, and tells what of rcvHeld waits for a lost segment
+func (c *tcpConn) sendAck() {
+	if c.sending {
+		// after the segment that is being written: it was made before, and what the system is told goes in that order
+		c.ackWanted = true
+		return
+	}
+	if !c.sack || len(c.rcvHeld) == 0 {
+		c.send(c.sndNxt, tcpAck, nil, nil)
+		return
+	}
+	// the block with the segment that came last goes first. Next to the times there is room for one less
+	var room [4][2]uint32
+	blocks := room[:]
+	if c.stamps {
+		blocks = room[:3]
+	}
+	n, last := 1, false
+	for i := 0; i < len(c.rcvHeld); {
+		start, end, recent := c.rcvHeld[i].seq, c.rcvHeld[i].seq, false
+		for ; i < len(c.rcvHeld) && c.rcvHeld[i].seq == end; i++ {
+			recent = recent || end == c.rcvLast
+			end += uint32(c.rcvHeld[i].data.Len())
+		}
+		if recent {
+			blocks[0], last = [2]uint32{start, end}, true
+		} else if n < len(blocks) {
+			blocks[n] = [2]uint32{start, end}
+			n++
+		}
+	}
+	list := blocks[:n]
+	if !last {
+		list = list[1:]
+	}
+	options := [36]byte{1, 1, 5, byte(2 + 8*len(list))}
+	for i, block := range list {
+		binary.BigEndian.PutUint32(options[4+8*i:], block[0])
+		binary.BigEndian.PutUint32(options[8+8*i:], block[1])
+	}
+	c.send(c.sndNxt, tcpAck, options[:4+8*len(list)], nil)
+}
+
+// stamped keeps the time that a segment of the other side carries, to send it back. It is the one of the segment
+// that the stream goes on with, so that the other side sees how long that one took, and not one of what came
+// before it. c.mu is held
+func (c *tcpConn) stamped(s segment) {
+	if int32(s.seq-c.rcvAcked) > 0 {
+		return
+	}
+	for kind, value, o := nextOption(s.options); kind != 0; kind, value, o = nextOption(o) {
+		if kind == 8 && len(value) == 8 {
+			if stamp := binary.BigEndian.Uint32(value); int32(stamp-c.stamp) > 0 {
+				c.stamp = stamp
+			}
+		}
+	}
+}
+
+// input takes a segment of the connection. It returns false if the connection is gone
+// and the segment is the start of another one
+func (c *tcpConn) input(s segment) bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.err != nil {
+		return s.flags&(tcpSyn|tcpAck|tcpRst) != tcpSyn
+	}
+	if c.opened != nil {
+		// only the answer to the SYN is waited for, or the word that nobody takes it
+		switch {
+		case s.flags&tcpAck == 0:
+		case s.ack != c.sndNxt:
+			// of a connection that the other side still has from before: it is told that there is none
+			if s.flags&tcpRst == 0 {
+				c.stack.refuse(c.flow, s)
+			}
+		case s.flags&tcpRst != 0:
+			c.abort(errTCPRefused)
+		case s.flags&tcpSyn != 0:
+			c.synchronize(s)
+			c.established = true
+			c.sndUna, c.sndBase = s.ack, s.ack
+			c.stalled, c.retransmits = 0, 0
+			if !c.timedAt.IsZero() {
+				c.clocked()
+			}
+			c.stack.opening.Add(-1)
+			close(c.opened)
+			c.opened = nil
+			c.sendAck()
+		}
+		return true
+	}
+	if s.flags&tcpRst != 0 {
+		// from where the system is, or was before its FIN, not from someone who knows no more than the addresses
+		if s.seq-c.rcvNxt <= uint32(c.window) || c.rcvFin && s.seq+1 == c.rcvNxt {
+			c.abort(errTCPReset)
+		}
+		return true
+	}
+	if s.flags&tcpSyn != 0 {
+		switch {
+		case !c.established && s.seq+1 == c.rcvNxt:
+			c.sendSyn()
+			c.timedAt = time.Time{}
+		case c.closed && s.flags&tcpAck == 0 && !c.stack.verify:
+			// the system of this machine opens the same ports again: it has let the old connection go.
+			// What comes through a tunnel is answered with what is expected instead, as anyone who knows
+			// the addresses could send it, and the other side answers that with a reset if it is gone
+			c.abort(errTCPReset)
+			return false
+		default:
+			c.sendAck()
+		}
+		return true
+	}
+	if s.flags&tcpAck == 0 {
+		return true
+	}
+	if c.stamps {
+		c.stamped(s)
+	}
+	if !c.established {
+		if s.ack != c.sndNxt {
+			return true
+		}
+		c.established = true
+		c.sndUna = s.ack
+		c.sndBase = s.ack
+		c.sndWnd = uint32(s.window) << c.sndShift
+		c.stalled, c.retransmits = 0, 0
+		if !c.timedAt.IsZero() {
+			c.clocked()
+		}
+		c.stack.opening.Add(-1)
+		go c.stack.handle(c, c.dst)
+	} else {
+		c.acknowledge(s)
+	}
+	c.receive(s)
+	if c.sndFin && c.rcvFin && c.sndUna == c.sndNxt {
+		// both sides have closed it and nothing waits to be acknowledged
+		c.abort(io.ErrClosedPipe)
+	}
+	return true
+}
+
+// acknowledge takes what a segment says about what was sent. c.mu is held
+func (c *tcpConn) acknowledge(s segment) {
+	acked, sent := s.ack-c.sndUna, c.sndNxt-c.sndUna
+	if acked > sent {
+		// older than the last one, or of what was not sent
+		return
+	}
+	window := uint32(s.window) << c.sndShift
+	if acked != 0 {
+		c.sndUna = s.ack
+		c.dupAcks, c.stalled, c.retransmits = 0, 0, 0
+		c.release()
+		n := 0
+		for n < len(c.sacked) && int32(c.sacked[n][0]-c.sndUna) <= 0 {
+			n++
+		}
+		c.sacked = slices.Delete(c.sacked, 0, n)
+		if int32(c.resent-c.sndUna) < 0 {
+			c.resent = c.sndUna
+		}
+		if !c.timedAt.IsZero() && int32(c.sndUna-c.timed) >= 0 {
+			c.clocked()
+		}
+		recovering := c.recovering
+		switch {
+		case c.recovering && int32(c.sndUna-c.recover) >= 0:
+			c.recovering = false
+		case c.recovering:
+			// what was sent again has arrived, and what was sent before it has not: the next segment is lost as well
+			if end := c.sndUna + min(uint32(c.mss), c.recover-c.sndUna); int32(end-c.lost) > 0 {
+				c.lost = end
+			}
+			c.headAt = time.Now()
+		}
+		// the way takes more if what it was given has arrived, as long as it was given about as much as it takes
+		if sent >= c.cwnd/2 {
+			if c.cwnd < c.ssthresh {
+				grow := acked
+				if recovering {
+					// after a timeout: one segment that is sent again can acknowledge all that came after it,
+					// which says nothing about how much the way takes at once
+					grow = min(grow, 2*uint32(c.mss))
+				}
+				c.cwnd = min(c.cwnd+grow, c.ssthresh)
+			} else if !c.recovering {
+				// a segment more for every cwnd that arrives
+				c.cwnd = min(c.cwnd+max(uint32(uint64(c.mss)*uint64(acked)/uint64(c.cwnd)), 1), uint32(c.window))
+			}
+		}
+	} else if sent != 0 && window == c.sndWnd && len(s.payload) == 0 && s.flags&tcpFin == 0 {
+		c.dupAcks++
+	}
+	if c.sack {
+		for kind, value, o := nextOption(s.options); kind != 0; kind, value, o = nextOption(o) {
+			for ; kind == 5 && len(value) >= 8; value = value[8:] {
+				// of what was sent and is not acknowledged
+				start, end := binary.BigEndian.Uint32(value)-c.sndUna, binary.BigEndian.Uint32(value[4:])-c.sndUna
+				if start != 0 && start < end && end <= c.sndNxt-c.sndUna {
+					c.sackAdd(c.sndUna+start, c.sndUna+end)
+				}
+			}
+		}
+	}
+	if !c.recovering && c.sndUna != c.sndNxt && (len(c.sacked) > 0 || !c.sack && c.dupAcks >= 3) {
+		// the system has something past sndUna, or says the same for the third time when it cannot say what it has:
+		// the segment at sndUna is lost. One that can say it repeats itself also for what it got twice
+		c.congested()
+		c.lost = c.sndUna + min(uint32(c.mss), c.sndNxt-c.sndUna)
+	}
+	if c.recovering {
+		if acked == 0 && c.srtt != 0 && !c.headAt.IsZero() && time.Since(c.headAt) > max(c.srtt+max(c.srtt/4, 4*c.rttvar), tcpTick/4) {
+			// the segment that the system waits for was sent again longer ago than an answer takes, and the system
+			// still answers what comes after it: that one was lost as well. It is sent once more, and only once:
+			// the timer would find it too, but late, and then nothing is known anymore of how much the way takes
+			if start, end := c.hole(c.sndUna); start == c.sndUna && start != end {
+				c.retransmit(start, start+min(end-start, uint32(c.mss)))
+				c.headAt, c.stalled = time.Time{}, 0
+			}
+		}
+		c.resend()
+	}
+	c.sndWnd = window
+	// the writer goes on when it can write a good part of the window, not for every segment that is acknowledged.
+	// Unless the way to the system is what holds it back: that takes what the acknowledgments say has left it,
+	// and what is sent as they come does not come to it all at once
+	limit := min(c.sndWnd, uint32(c.window))
+	enough := limit / 2
+	if c.cwnd < limit {
+		enough = uint32(c.mss)
+	}
+	if c.blocked && (c.sndUna == c.sndNxt || c.space() >= enough) {
+		c.writable.Broadcast()
+	}
+}
+
+// clocked takes the time since timedAt as how long an acknowledgment takes. The next ones are waited for as long
+// as that says and no less than a few ticks. Until there is such a time again, after something was sent again,
+// they are waited for as long as the last time. c.mu is held
+func (c *tcpConn) clocked() {
+	d := time.Since(c.timedAt)
+	c.timedAt = time.Time{}
+	if c.srtt == 0 {
+		c.srtt, c.rttvar = d, d/2
+	} else {
+		c.rttvar += ((c.srtt - d).Abs() - c.rttvar) / 4
+		c.srtt += (d - c.srtt) / 8
+	}
+	c.retransmitTicks = c.answerTicks()
+}
+
+// answerTicks is how many ticks an acknowledgment is waited for as long as nothing was sent again. c.mu is held
+func (c *tcpConn) answerTicks() int {
+	return max(tcpRetransmitTicks, int((c.srtt+4*c.rttvar)/tcpTick)+2)
+}
+
+// sackAdd puts what the system says it has into sacked. c.mu is held
+func (c *tcpConn) sackAdd(start, end uint32) {
+	i := 0
+	for i < len(c.sacked) && int32(c.sacked[i][1]-start) < 0 {
+		i++
+	}
+	j := i
+	for ; j < len(c.sacked) && int32(c.sacked[j][0]-end) <= 0; j++ {
+		if int32(c.sacked[j][0]-start) < 0 {
+			start = c.sacked[j][0]
+		}
+		if int32(c.sacked[j][1]-end) > 0 {
+			end = c.sacked[j][1]
+		}
+	}
+	if i == j && len(c.sacked) == tcpHeld {
+		return
+	}
+	c.sacked = slices.Replace(c.sacked, i, j, [2]uint32{start, end})
+}
+
+// congested is called when something is lost: the way to the system takes half of what it was given,
+// and what is lost is sent again from sndUna. c.mu is held
+func (c *tcpConn) congested() {
+	c.ssthresh = max(min(c.cwnd, c.sndNxt-c.sndUna)/2, 2*uint32(c.mss))
+	c.cwnd = c.ssthresh
+	c.recovering, c.recover, c.resent = true, c.sndNxt, c.sndUna
+	c.timedAt, c.headAt = time.Time{}, time.Time{}
+}
+
+// hole returns the first part at or after seq of what is lost: what the system does not have
+// before something that it says it has, or before lost. There is none if it ends where it starts. c.mu is held
+func (c *tcpConn) hole(seq uint32) (uint32, uint32) {
+	end := c.lost
+	for _, b := range c.sacked {
+		if int32(b[0]-seq) > 0 {
+			end = b[0]
+			break
+		}
+		if int32(b[1]-seq) > 0 {
+			seq = b[1]
+		}
+	}
+	if int32(end-seq) < 0 {
+		end = seq
+	}
+	return seq, end
+}
+
+// flight is how much of what was sent is on its way: not what the system says it has,
+// and not what is lost and was not sent again. c.mu is held
+func (c *tcpConn) flight() uint32 {
+	n := c.sndNxt - c.sndUna
+	if !c.recovering {
+		return n
+	}
+	seq := c.resent
+	for _, b := range c.sacked {
+		n -= b[1] - b[0]
+		if int32(b[0]-seq) > 0 {
+			n -= b[0] - seq
+		}
+		if int32(b[1]-seq) > 0 {
+			seq = b[1]
+		}
+	}
+	if int32(c.lost-seq) > 0 {
+		n -= c.lost - seq
+	}
+	return n
+}
+
+// resend sends again what is lost and was not yet: the segment that the system waits for at once,
+// the rest as the way to it takes it. c.mu is held
+func (c *tcpConn) resend() {
+	for {
+		start, end := c.hole(c.resent)
+		if start == end {
+			return
+		}
+		room := uint32(c.mss)
+		if start != c.sndUna {
+			flight := c.flight()
+			if flight+room > c.cwnd {
+				return
+			}
+			room = c.cwnd - flight
+		}
+		end = start + min(end-start, room)
+		if start == c.sndUna {
+			// its answer is waited for from now on
+			c.headAt, c.stalled = time.Now(), 0
+		}
+		c.retransmit(start, end)
+		c.resent = end
+	}
+}
+
+// space is how much can be sent now: what the system takes, and what the way to it takes. c.mu is held
+func (c *tcpConn) space() uint32 {
+	window, sent, flight := min(c.sndWnd, uint32(c.window)), c.sndNxt-c.sndUna, c.flight()
+	if sent >= window || flight >= c.cwnd {
+		return 0
+	}
+	return min(window-sent, c.cwnd-flight)
+}
+
+// receive takes the payload of a segment. c.mu is held
+func (c *tcpConn) receive(s segment) {
+	// what is large, the next and all taken stays in the buffers that it was read into
+	size := len(s.payload) + s.rest
+	keep := c.stack.bufs != nil && size >= tcpKept && s.seq == c.rcvNxt && size <= int(c.window-c.rcvLen)
+	if !keep {
+		s.payload = c.stack.whole(s.payload, s.rest)
+	}
+	seq, payload, fin := s.seq, s.payload, s.flags&tcpFin != 0
+	if len(payload) == 0 && !fin {
+		if int32(c.rcvNxt-seq) > 0 {
+			// a keepalive, or a probe of a window that the system has as closed: answered with what is expected
+			c.sendAck()
+		}
+		return
+	}
+	if before := int32(c.rcvNxt - seq); before > 0 {
+		if int(before) > len(payload) || int(before) == len(payload) && !fin {
+			// sent again, or a keepalive: answered with what is expected
+			c.sendAck()
+			return
+		}
+		seq, payload = c.rcvNxt, payload[before:]
+	}
+	if c.rcvFin {
+		c.sendAck()
+		return
+	}
+	if c.closed && len(payload) > 0 {
+		// nobody reads it anymore
+		c.reset()
+		return
+	}
+	// the system is told at once when something is wrong, or it sends more of the same
+	now := len(c.rcvHeld) > 0
+	if room := int(c.window - c.rcvLen - int32(seq-c.rcvNxt)); len(payload) > room {
+		payload, fin, now = payload[:max(room, 0)], false, true
+	}
+	if seq != c.rcvNxt {
+		// something before it was lost, it waits for that, and so does the end if this is it
+		c.hold(seq, payload)
+		if fin {
+			c.rcvEnd, c.rcvEnds = seq+uint32(len(payload)), true
+		}
+		c.sendAck()
+		return
+	}
+
+	if keep {
+		c.rcvQueue = c.stack.keep(c.rcvQueue, payload, s.rest)
+	} else {
+		size = len(payload)
+		c.rcvQueue = buf.MergeBytes(c.rcvQueue, payload)
+	}
+	c.rcvLen += int32(size)
+	c.rcvNxt += uint32(size)
+	for !fin && len(c.rcvHeld) > 0 && int32(c.rcvNxt-c.rcvHeld[0].seq) >= 0 {
+		h := c.rcvHeld[0]
+		if before := int32(c.rcvNxt - h.seq); before < h.data.Len() {
+			c.rcvQueue = buf.MergeBytes(c.rcvQueue, h.data.BytesFrom(before))
+			c.rcvLen += h.data.Len() - before
+			c.rcvNxt += uint32(h.data.Len() - before)
+		}
+		h.data.Release()
+		c.rcvHeld = c.rcvHeld[1:]
+	}
+	if fin = fin || c.rcvEnds && c.rcvNxt == c.rcvEnd; fin {
+		c.rcvFin = true
+		c.rcvNxt++
+	}
+	c.readable.Signal()
+	// the reader acknowledges what it takes, with one segment for all that came by then.
+	// It is not waited for when it does not read for long
+	if fin || now || c.rcvNxt-c.rcvAcked >= uint32(c.window/4) {
+		c.sendAck()
+	} else {
+		c.arm(tcpTick)
+	}
+}
+
+// release releases what of sndQueue is acknowledged. c.mu is held
+func (c *tcpConn) release() {
+	for len(c.sndQueue) > c.writing {
+		end := c.sndBase + uint32(c.sndQueue[0].Len())
+		if int32(c.sndUna-end) < 0 {
+			break
+		}
+		c.sndQueue[0].Release()
+		c.sndQueue[0] = nil
+		c.sndQueue = c.sndQueue[1:]
+		c.sndBase = end
+	}
+}
+
+// hold keeps a segment that is not the next one. c.mu is held
+func (c *tcpConn) hold(seq uint32, payload []byte) {
+	i := len(c.rcvHeld)
+	for i > 0 && int32(c.rcvHeld[i-1].seq-seq) >= 0 {
+		i--
+	}
+	// without what the one before and the one after have
+	if i > 0 {
+		if over := int32(c.rcvHeld[i-1].seq + uint32(c.rcvHeld[i-1].data.Len()) - seq); over > 0 {
+			if int(over) >= len(payload) {
+				return
+			}
+			seq, payload = seq+uint32(over), payload[over:]
+		}
+	}
+	if i < len(c.rcvHeld) {
+		if over := int32(seq + uint32(len(payload)) - c.rcvHeld[i].seq); over > 0 {
+			if int(over) >= len(payload) {
+				return
+			}
+			payload = payload[:len(payload)-int(over)]
+		}
+	}
+	if len(payload) == 0 || len(c.rcvHeld) == tcpHeld {
+		return
+	}
+	// as much memory as it carries: the room that is left counts bytes, and a thousand tiny segments in pooled
+	// buffers would take two megabytes
+	b := buf.FromBytes(slices.Clone(payload))
+	c.rcvHeld = slices.Insert(c.rcvHeld, i, held{seq, b})
+	c.rcvLast = seq
+}
+
+// retransmit sends again what was sent from seq to end. c.mu is held
+func (c *tcpConn) retransmit(seq, end uint32) {
+	fin := false
+	if int32(end-c.sndNxt) >= 0 {
+		end, fin = c.sndNxt, c.sndFin
+		if fin {
+			end--
+		}
+	}
+	for int32(end-seq) > 0 {
+		var part [1][]byte
+		_, n := c.queued(part[:0], seq, min(c.mss, int(end-seq)))
+		if n == 0 {
+			break
+		}
+		c.send(seq, tcpAck, nil, part[0])
+		seq += uint32(n)
+	}
+	if fin && seq == end {
+		c.send(end, tcpFin|tcpAck, nil, nil)
+	}
+}
+
+// queued adds to parts what of sndQueue starts at seq, size bytes at most and as many parts as it has room for,
+// and returns them with their size. c.mu is held
+func (c *tcpConn) queued(parts [][]byte, seq uint32, size int) ([][]byte, int) {
+	skip, n := int32(seq-c.sndBase), 0
+	for _, b := range c.sndQueue {
+		if skip >= b.Len() {
+			skip -= b.Len()
+			continue
+		}
+		if n == size || len(parts) == cap(parts) {
+			break
+		}
+		p := b.BytesFrom(skip)
+		skip = 0
+		p = p[:min(len(p), size-n)]
+		parts = append(parts, p)
+		n += len(p)
+	}
+	return parts, n
+}
+
+// shrink makes the segments fit a link on the way that takes packets of mtu bytes, when the one at seq did not.
+// None of what is on its way fits: it is sent again, the first segment at once and the others as they are
+// acknowledged. Only what is said about a segment that was sent and is not acknowledged is believed
+func (c *tcpConn) shrink(seq uint32, mtu int) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	mss := mtu - c.ipSize - tcpHeaderSize
+	if c.stamps {
+		mss -= tcpStamps
+	}
+	mss = max(mss, tcpSmallest)
+	if c.err != nil || !c.established || seq-c.sndUna >= c.sndNxt-c.sndUna || mss >= c.mss {
+		return
+	}
+	c.mss = mss
+	// as what is lost, without the way taking less for it: it is the size that it did not take
+	c.recovering, c.recover, c.lost = true, c.sndNxt, c.sndNxt
+	c.timedAt = time.Time{}
+	c.resent = c.sndUna + min(uint32(mss), c.sndNxt-c.sndUna)
+	c.headAt = time.Now()
+	c.retransmit(c.sndUna, c.resent)
+}
+
+// unreachable ends the wait for the answer to the SYN at seq, which a router on the way could not deliver
+func (c *tcpConn) unreachable(seq uint32) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.err == nil && c.opened != nil && seq == c.sndUna {
+		c.abort(errTCPUnreachable)
+	}
+}
+
+// arm makes tick run after d, unless it is going to run already. c.mu is held
+func (c *tcpConn) arm(d time.Duration) {
+	if c.armed {
+		return
+	}
+	c.armed = true
+	if c.timer == nil {
+		c.timer = time.AfterFunc(d, c.tick)
+	} else {
+		c.timer.Reset(d)
+	}
+}
+
+// tick does what was put off and what has to be done again
+func (c *tcpConn) tick() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.armed = false
+	if c.err != nil {
+		return
+	}
+	if c.rcvAcked != c.rcvNxt {
+		c.sendAck()
+	}
+	switch {
+	case c.sndUna != c.sndNxt:
+		c.stalled++
+		due := c.stalled >= c.retransmitTicks
+		if c.established && c.retransmits > 0 {
+			due = due || c.stalled >= max(tcpRetransmitTicksOpen, c.answerTicks())<<(c.lostTicks/tcpMinuteTicks)
+		}
+		if due {
+			if c.retransmits++; c.retransmits == 1 {
+				c.lostTicks = 0
+			} else {
+				c.lostTicks += c.stalled
+			}
+			if c.established && c.lostTicks > tcpGiveUpTicks || !c.established && c.retransmits > tcpSynRetransmits {
+				c.abort(errTCPTimeout)
+				return
+			}
+			c.stalled = 0
+			c.retransmitTicks = min(c.retransmitTicks*2, tcpRetransmitTicksMost)
+			if !c.established {
+				c.sendSyn()
+				c.timedAt = time.Time{}
+			} else {
+				// what the system does not say it has is lost, and the way to it is tried with a segment again.
+				// It takes half of what it took before the loss, not half of that again if the loss was seen already
+				ssthresh, recovering := c.ssthresh, c.recovering
+				c.congested()
+				if recovering {
+					c.ssthresh = ssthresh
+				}
+				c.cwnd, c.lost = uint32(c.mss), c.sndNxt
+				c.resend()
+			}
+		}
+		c.arm(tcpTick)
+	case c.blocked:
+		// the segment that opens the window may have been lost, this one is answered with the window
+		if c.stalled++; c.stalled%tcpProbeTicks == 0 {
+			c.send(c.sndUna-1, tcpAck, nil, nil)
+		}
+		c.arm(tcpTick)
+	case c.closed:
+		if c.lingered {
+			c.reset()
+			return
+		}
+		c.lingered = true
+		c.arm(tcpLinger)
+	}
+}
+
+// reset tells the system that the connection is gone. c.mu is held
+func (c *tcpConn) reset() {
+	c.send(c.sndNxt, tcpRst|tcpAck, nil, nil)
+	c.abort(io.ErrClosedPipe)
+}
+
+// abort ends the connection without another word to the system. What it has sent is still there to read.
+// c.mu is held
+func (c *tcpConn) abort(err error) {
+	if c.err != nil {
+		return
+	}
+	c.err = err
+	if c.timer != nil {
+		c.timer.Stop()
+	}
+	if c.opened != nil {
+		close(c.opened)
+		c.opened = nil
+	}
+	for _, h := range c.rcvHeld {
+		h.data.Release()
+	}
+	c.rcvHeld = nil
+	for _, b := range c.sndQueue[:len(c.sndQueue)-c.writing] {
+		b.Release()
+	}
+	c.sndQueue = nil
+	c.readable.Broadcast()
+	c.writable.Broadcast()
+	c.stack.remove(c)
+}
+
+// wait waits for something to read. c.mu is held
+func (c *tcpConn) wait() error {
+	for c.rcvLen == 0 && !c.rcvFin && !c.closed && c.err == nil {
+		c.readable.Wait()
+	}
+	switch {
+	case c.rcvLen > 0:
+		return nil
+	case c.err != nil && !c.rcvFin:
+		return c.err
+	}
+	return io.EOF
+}
+
+// taken is called when size bytes have been read. c.mu is held
+func (c *tcpConn) taken(size int32) {
+	c.rcvLen -= size
+	// the system may also have stopped at the window that it was told
+	if c.err == nil && (c.rcvAcked != c.rcvNxt || c.rcvAdvertised < c.window/2) {
+		c.sendAck()
+	}
+}
+
+// ReadMultiBuffer implements buf.Reader
+func (c *tcpConn) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if err := c.wait(); err != nil {
+		return nil, err
+	}
+	mb := c.rcvQueue
+	c.rcvQueue = nil
+	c.taken(c.rcvLen)
+	return mb, nil
+}
+
+// Read implements net.Conn
+func (c *tcpConn) Read(p []byte) (int, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if err := c.wait(); err != nil {
+		return 0, err
+	}
+	var n int
+	c.rcvQueue, n = buf.SplitBytes(c.rcvQueue, p)
+	c.taken(int32(n))
+	return n, nil
+}
+
+// WriteMultiBuffer implements buf.Writer. It is not called again before it returns
+func (c *tcpConn) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	// without the empty ones
+	n, size := 0, uint32(0)
+	for _, b := range mb {
+		if b.IsEmpty() {
+			b.Release()
+			continue
+		}
+		mb[n] = b
+		n++
+		size += uint32(b.Len())
+	}
+	mb = mb[:n]
+	if c.err != nil || c.closed {
+		buf.ReleaseMulti(mb)
+		return io.ErrClosedPipe
+	}
+	// what is written is in sndQueue until it is acknowledged, and is not released before all of it is sent
+	c.sndQueue = append(c.sndQueue, mb...)
+	c.writing = len(mb)
+	// a segment is one part of a Buffer, or as much as there is to send if the tun splits it by itself
+	var room [tcpParts][]byte
+	parts := room[:0:1]
+	if c.stack.segmenter != nil {
+		parts = room[:0]
+	}
+	for end := c.sndNxt + size; c.sndNxt != end; {
+		// not a part of a segment when all of it can go later, with what is acknowledged by then
+		for c.err == nil {
+			if space := c.space(); space >= min(end-c.sndNxt, uint32(c.mss)) || space != 0 && c.sndUna == c.sndNxt {
+				break
+			}
+			c.blocked = true
+			c.arm(tcpTick)
+			c.writable.Wait()
+			c.blocked = false
+		}
+		if c.err != nil {
+			break
+		}
+		// the mss may have become smaller while the last segment was written
+		most := min(c.mss, int(c.space()))
+		if c.stack.segmenter != nil {
+			most = min(tcpSegment, int(c.space()))
+		}
+		if most > c.mss {
+			// the same for what the tun splits
+			most -= most % c.mss
+		}
+		p, n := c.queued(parts, c.sndNxt, most)
+		flags := byte(tcpAck)
+		if c.sndNxt+uint32(n) == end {
+			flags |= tcpPsh
+		}
+		var b [ipv6HeaderSize + tcpHeaderSize + tcpStamps]byte
+		h := b[:c.header(b[:], c.sndNxt, flags, nil, n)]
+		if c.sndUna == c.sndNxt {
+			// the ticks without an acknowledgment are counted from the first segment that waits for one
+			c.stalled = 0
+		}
+		c.sndNxt += uint32(n)
+		if c.timedAt.IsZero() {
+			c.timed, c.timedAt = c.sndNxt, time.Now()
+		}
+		c.arm(tcpTick)
+		// segments that come in the meantime are taken while this one is written, and acknowledged after it
+		c.sending = true
+		c.mu.Unlock()
+		if s := c.stack.segmenter; s != nil {
+			t := h[c.ipSize:]
+			binary.BigEndian.PutUint16(t[16:], ^checksum(pseudoSum(h[:c.ipSize], protoTCP, len(t)+n)))
+			_ = s.WriteSegment(h, p, c.mss)
+		} else {
+			c.write(h, p[0])
+		}
+		c.mu.Lock()
+		c.sending = false
+		if c.ackWanted && c.err == nil {
+			c.sendAck()
+		}
+		c.ackWanted = false
+	}
+	c.writing = 0
+	if c.err != nil {
+		buf.ReleaseMulti(mb)
+		return io.ErrClosedPipe
+	}
+	c.release()
+	return nil
+}
+
+// Write implements net.Conn
+func (c *tcpConn) Write(p []byte) (int, error) {
+	if err := c.WriteMultiBuffer(buf.MergeBytes(nil, p)); err != nil {
+		return 0, err
+	}
+	return len(p), nil
+}
+
+// Close implements net.Conn
+func (c *tcpConn) Close() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed {
+		return nil
+	}
+	c.closed = true
+	unread := c.rcvLen > 0
+	c.rcvQueue, c.rcvLen = buf.ReleaseMulti(c.rcvQueue), 0
+	if c.err != nil {
+		return nil
+	}
+	if unread || c.writing != 0 {
+		// something was not read or not written, the system has to know
+		c.reset()
+		return nil
+	}
+	c.readable.Broadcast()
+	c.send(c.sndNxt, tcpFin|tcpAck, nil, nil)
+	c.sndFin = true
+	c.sndNxt++
+	c.arm(tcpTick)
+	return nil
+}
+
+func (c *tcpConn) LocalAddr() net.Addr {
+	return c.dst.RawNetAddr()
+}
+
+func (c *tcpConn) RemoteAddr() net.Addr {
+	return c.src.RawNetAddr()
+}
+
+func (c *tcpConn) SetDeadline(time.Time) error {
+	return nil
+}
+
+func (c *tcpConn) SetReadDeadline(time.Time) error {
+	return nil
+}
+
+func (c *tcpConn) SetWriteDeadline(time.Time) error {
+	return nil
+}
diff --git a/third_party/xray-core/proxy/tun/tun.go b/third_party/xray-core/proxy/tun/tun.go
new file mode 100644
index 0000000000000000000000000000000000000000..fd6777e9a3e2418c292a537b95680fbe7941b8b9
--- /dev/null
+++ b/third_party/xray-core/proxy/tun/tun.go
@@ -0,0 +1,29 @@
+package tun
+
+// packetRoom is what a tun may need in front of a packet in the buffer that it is read into
+const packetRoom = 16
+
+// Tun interface implements tun interface interaction
+type Tun interface {
+	Start() error
+	Close() error
+	Name() (string, error)
+	Index() (int, error)
+	// ReadPacket waits for a packet, reads it into b and returns it
+	ReadPacket(b []byte) ([]byte, error)
+	// WritePacket writes a packet that is in two parts, the second of which may be empty
+	WritePacket(header, payload []byte) error
+}
+
+// segmenter is a tun whose other side takes TCP segments that are larger than the MTU,
+// splits them only if it has to send them on, and completes their checksum then.
+// What it sends comes as it is too, not split to the MTU
+type segmenter interface {
+	// Segments reports whether ReadParts and WriteSegment can be used
+	Segments() bool
+	// ReadParts waits for a packet, reads it into parts, one after the other, and returns its size
+	ReadParts(parts [][]byte) (int, error)
+	// WriteSegment writes a packet with a TCP segment whose payload is in parts, to be sent on with mss bytes
+	// of it at most in one. Its checksum is that of the pseudo-header only, not inverted
+	WriteSegment(header []byte, payload [][]byte, mss int) error
+}
diff --git a/third_party/xray-core/proxy/tun/tun_android.go b/third_party/xray-core/proxy/tun/tun_android.go
new file mode 100644
index 0000000000000000000000000000000000000000..1017458f42999cfc5245a0ea38205d2ee2ca1e8a
--- /dev/null
+++ b/third_party/xray-core/proxy/tun/tun_android.go
@@ -0,0 +1,93 @@
+//go:build android
+
+package tun
+
+import (
+	"context"
+	"net"
+	"strconv"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/platform"
+	"golang.org/x/sys/unix"
+)
+
+type AndroidTun struct {
+	*fdTun
+	options *Config
+}
+
+// DefaultTun implements Tun
+var _ Tun = (*AndroidTun)(nil)
+
+// NewTun builds new tun interface handler
+func NewTun(options *Config) (Tun, error) {
+	fd, err := strconv.Atoi(platform.NewEnvFlag(platform.TunFdKey).GetValue(func() string { return "0" }))
+	errors.LogInfo(context.Background(), "read Android Tun Fd ", fd, err)
+
+	err = unix.SetNonblock(fd, true)
+	if err != nil {
+		_ = unix.Close(fd)
+		return nil, err
+	}
+
+	// the descriptor stays with the application, Close ends the reading of a duplicate
+	fd, err = unix.FcntlInt(uintptr(fd), unix.F_DUPFD_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+
+	return &AndroidTun{
+		fdTun:   newFdTun(fd, 0),
+		options: options,
+	}, nil
+}
+
+func (t *AndroidTun) Start() error {
+	return nil
+}
+
+func (t *AndroidTun) Close() error {
+	return t.closeFile()
+}
+
+func (t *AndroidTun) Name() (string, error) {
+	ifr, err := unix.NewIfreq("")
+	if err != nil {
+		return "", err
+	}
+	if err = unix.IoctlIfreq(t.fd, unix.TUNGETIFF, ifr); err != nil {
+		return "", err
+	}
+	return ifr.Name(), nil
+}
+
+func (t *AndroidTun) Index() (int, error) {
+	name, err := t.Name()
+	if err != nil {
+		return 0, err
+	}
+	iface, err := net.InterfaceByName(name)
+	if err != nil {
+		return 0, err
+	}
+	return iface.Index, nil
+}
+
+func setinterface(network, address string, fd uintptr, iface *net.Interface) error {
+	return unix.BindToDevice(int(fd), iface.Name)
+}
+
+func findOutboundInterface(tunIndex int, fixedName string) (*net.Interface, error) {
+	if fixedName == "" {
+		return nil, errors.New("automatic outbound interface selection is not supported on this platform")
+	}
+	iface, err := net.InterfaceByName(fixedName)
+	if err != nil {
+		return nil, err
+	}
+	if iface.Index == tunIndex {
+		return nil, errors.New("outbound interface cannot be the TUN interface")
+	}
+	return iface, nil
+}
diff --git a/third_party/xray-core/proxy/tun/tun_darwin.go b/third_party/xray-core/proxy/tun/tun_darwin.go
new file mode 100644
index 0000000000000000000000000000000000000000..a005681f47562138309350e56417c09df8528671
--- /dev/null
+++ b/third_party/xray-core/proxy/tun/tun_darwin.go
@@ -0,0 +1,794 @@
+//go:build darwin
+
+package tun
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"os"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"time"
+	"unsafe"
+
+	"github.com/xtls/xray-core/common/buf"
+	xerrors "github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/platform"
+	"golang.org/x/net/route"
+	"golang.org/x/sys/unix"
+)
+
+const (
+	utunControlName      = "com.apple.net.utun_control"
+	sysprotoControl      = 2
+	defaultDarwinGateway = "169.254.10.1/30"
+	utunHeaderSize       = 4
+	UTUN_OPT_IFNAME      = 2
+)
+
+const (
+	SIOCAIFADDR6          = 2155899162 // netinet6/in6_var.h
+	IN6_IFF_NODAD         = 0x0020     // netinet6/in6_var.h
+	IN6_IFF_SECURED       = 0x0400     // netinet6/in6_var.h
+	ND6_INFINITE_LIFETIME = 0xFFFFFFFF // netinet6/nd6.h
+)
+
+type DarwinTun struct {
+	tunFile *os.File
+	options *Config
+	tunFd   int
+	ownsFd  bool // true for macOS (we created the fd), false for iOS (fd from system)
+
+	// Genuinely blocks Wait() until tunFd is readable, instead of the
+	// previous procyield-only busy-spin (ReadPacket() reads and then calls
+	// Wait() in a tight
+	// loop with no other throttling whenever the queue is empty -- with
+	// only procyield(1), that pins a full CPU core for as long as the
+	// tunnel is up, observed causing severe device heating/thermal
+	// shutdown). nil if kqueue setup failed, in which case Wait() falls
+	// back to a bounded time.Sleep instead. See waitKqueue's own doc
+	// comment for why this is a dedicated type rather than a bare fd.
+	waitKq *waitKqueue
+
+	routeMonitor     *os.File
+	routeMonitorOnce sync.Once
+	systemRoutes     []netip.Prefix
+	gateway          netip.Prefix
+}
+
+// waitKqueue owns a kqueue fd used by DarwinTun.Wait() to block on
+// read-readiness. Closing and waiting can race from different goroutines
+// (Close() from the caller that tears down the tunnel, Wait() from
+// the goroutine that reads packets) -- reviewer feedback on XTLS/Xray-core#6580
+// found that a bare `int` fd field let Close() race Wait()'s use of the
+// same fd number, and on Darwin a closed fd number can be reused by an
+// unrelated concurrent open() before Wait() gets to call Kevent on it,
+// so Wait() could end up polling (or Close() could end up closing) a
+// completely unrelated file descriptor. This type makes closing
+// idempotent (sync.Once) and gates every Kevent call behind an atomic
+// "closed" flag checked immediately before the syscall, so Wait() never
+// issues a kevent syscall against a fd number that Close() has already
+// (or is concurrently) invalidated -- there's still a narrow window where
+// Wait() checks-then-uses the fd, but Close() only actually closes it
+// after Wait() cannot start a new syscall on it (the flag is set first,
+// synchronized with acquire/release semantics), which is sufficient since
+// Wait()'s Kevent call itself is what's being raced, not a fd read/write.
+type waitKqueue struct {
+	fd     int
+	closed atomic.Bool
+	once   sync.Once
+}
+
+// newWaitKqueue creates a kqueue registered for read-readiness on fd, for
+// Wait() to block on. Returns nil if anything fails, so callers can fall
+// back to a bounded sleep rather than error out of NewTun over what is
+// purely a CPU-efficiency concern.
+func newWaitKqueue(fd int) *waitKqueue {
+	kq, err := unix.Kqueue()
+	if err != nil {
+		return nil
+	}
+	_, err = unix.Kevent(kq, []unix.Kevent_t{{
+		Ident:  uint64(fd),
+		Filter: unix.EVFILT_READ,
+		Flags:  unix.EV_ADD | unix.EV_ENABLE,
+	}}, nil, nil)
+	if err != nil {
+		_ = unix.Close(kq)
+		return nil
+	}
+	return &waitKqueue{fd: kq}
+}
+
+// wait blocks until the registered fd is readable, timeout elapses, or a
+// benign interrupt occurs -- all three are "this kqueue is still healthy,
+// the caller should just try again" and return true; the caller
+// (DarwinTun.Wait) doesn't need to distinguish them since ReadPacket()
+// reads right after anyway, and that already handles "nothing was
+// actually there" by waiting again. Returns false only when the kqueue
+// itself is no longer usable -- already closed, or the kevent syscall
+// failed for a reason other than EINTR -- see its own call site in
+// DarwinTun.Wait for why a persistent failure must not be silently
+// retried forever (reviewer feedback, XTLS/Xray-core#6580 P2).
+func (w *waitKqueue) wait(timeout time.Duration) (ok bool) {
+	if w.closed.Load() {
+		return false
+	}
+	events := make([]unix.Kevent_t, 1)
+	ts := unix.NsecToTimespec(timeout.Nanoseconds())
+	_, err := unix.Kevent(w.fd, nil, events, &ts)
+	if err != nil {
+		return errors.Is(err, unix.EINTR)
+	}
+	return true
+}
+
+// close marks the kqueue as unusable (so any Wait() call that hasn't yet
+// entered the kevent syscall bails out instead) and closes the underlying
+// fd exactly once, regardless of how many times close is called or
+// whether it races a Wait() already inside its kevent syscall (that call
+// either completes against the still-open fd or returns an error safely
+// -- either way, no other goroutine can be handed this fd number in
+// between the atomic flag flip and the actual close, since nothing else
+// in this type ever creates a new kqueue with the same field).
+func (w *waitKqueue) close() {
+	w.once.Do(func() {
+		w.closed.Store(true)
+		_ = unix.Close(w.fd)
+	})
+}
+
+var _ Tun = (*DarwinTun)(nil)
+
+func NewTun(options *Config) (Tun, error) {
+	// Check if fd is provided via environment (iOS mode)
+	fdStr := platform.NewEnvFlag(platform.TunFdKey).GetValue(func() string { return "" })
+	if fdStr != "" {
+		// iOS: use provided fd from NetworkExtension
+		providedFd, err := strconv.Atoi(fdStr)
+		if err != nil {
+			return nil, err
+		}
+
+		// duplicate NetworkExtension fd so Xray can close its own handle
+		// without closing the original.
+		fd, err := unix.FcntlInt(uintptr(providedFd), unix.F_DUPFD_CLOEXEC, 0)
+		if err != nil {
+			return nil, err
+		}
+
+		if err = unix.SetNonblock(fd, true); err != nil {
+			_ = unix.Close(fd)
+			return nil, err
+		}
+
+		return &DarwinTun{
+			tunFile: os.NewFile(uintptr(fd), "utun"),
+			options: options,
+			tunFd:   fd,
+			ownsFd:  false,
+			waitKq:  newWaitKqueue(fd),
+		}, nil
+	}
+
+	// macOS: create our own utun interface
+	tunFile, err := open(options.Name)
+	if err != nil {
+		return nil, err
+	}
+
+	gateway, err := selectDarwinGateway(options.Gateway)
+	if err != nil {
+		_ = tunFile.Close()
+		return nil, err
+	}
+
+	err = setup(options.Name, options.MTU, gateway)
+	if err != nil {
+		_ = tunFile.Close()
+		return nil, err
+	}
+
+	return &DarwinTun{
+		tunFile: tunFile,
+		options: options,
+		tunFd:   int(tunFile.Fd()),
+		ownsFd:  true,
+		waitKq:  newWaitKqueue(int(tunFile.Fd())),
+		gateway: gateway,
+	}, nil
+}
+
+func (t *DarwinTun) Start() error {
+	if !t.ownsFd {
+		return nil
+	}
+
+	if err := t.setSystemRoutes(); err != nil {
+		return err
+	}
+
+	if updater != nil {
+		fd, err := unix.Socket(unix.AF_ROUTE, unix.SOCK_RAW, 0)
+		if err != nil {
+			_ = t.unsetSystemRoutes()
+			return err
+		}
+		t.routeMonitor = os.NewFile(uintptr(fd), "xray-route-monitor")
+		go t.monitorRouteChanges()
+	}
+	return nil
+}
+
+func (t *DarwinTun) Close() error {
+	t.routeMonitorOnce.Do(func() {
+		if t.routeMonitor != nil {
+			_ = t.routeMonitor.Close()
+		}
+	})
+	if t.waitKq != nil {
+		t.waitKq.close()
+	}
+	routeErr := t.unsetSystemRoutes()
+	return xerrors.Combine(routeErr, t.tunFile.Close())
+}
+
+func (t *DarwinTun) monitorRouteChanges() {
+	buffer := make([]byte, 64*1024)
+	for {
+		if _, err := t.routeMonitor.Read(buffer); err != nil {
+			if !errors.Is(err, os.ErrClosed) {
+				xerrors.LogInfoInner(context.Background(), err, "[tun] failed to monitor route changes")
+			}
+			return
+		}
+		if updater != nil {
+			updater.Update()
+		}
+	}
+}
+
+func (t *DarwinTun) Name() (string, error) {
+	return unix.GetsockoptString(t.tunFd, sysprotoControl, UTUN_OPT_IFNAME)
+}
+
+func (t *DarwinTun) Index() (int, error) {
+	name, err := t.Name()
+	if err != nil {
+		return 0, err
+	}
+	iface, err := net.InterfaceByName(name)
+	if err != nil {
+		return 0, err
+	}
+	return iface.Index, nil
+}
+
+// WritePacket implements Tun: the two parts are copied behind the header that the system wants in front of a packet
+func (t *DarwinTun) WritePacket(header, payload []byte) error {
+	var family byte
+	switch header[0] >> 4 {
+	case 4:
+		family = unix.AF_INET
+	case 6:
+		family = unix.AF_INET6
+	default:
+		return xerrors.New("not an ip packet")
+	}
+
+	// request memory to write from reusable buffer pool
+	b := buf.NewWithSize(int32(utunHeaderSize + len(header) + len(payload)))
+	defer b.Release()
+	b.Extend(utunHeaderSize)[3] = family
+	_, _ = b.Write(header)
+	_, _ = b.Write(payload)
+
+	_, err := t.tunFile.Write(b.Bytes())
+	return err
+}
+
+// ReadPacket implements Tun: it reads into b, the packet follows the header that the system puts in front of it
+func (t *DarwinTun) ReadPacket(b []byte) ([]byte, error) {
+	for {
+		n, err := t.tunFile.Read(b)
+		if errors.Is(err, unix.EAGAIN) || errors.Is(err, unix.EINTR) || err == nil && n <= utunHeaderSize {
+			// nothing on the line, or an empty packet
+			t.Wait()
+			continue
+		}
+		if err != nil {
+			return nil, err
+		}
+		return b[utunHeaderSize:n], nil
+	}
+}
+
+// Wait blocks until tunFd is readable (or a short timeout elapses), rather
+// than spinning the CPU -- see the waitKq field's own doc comment. A bounded
+// timeout (not an indefinite wait) keeps this responsive to a Close() that
+// happens to race a call already parked here.
+//
+// Reviewer feedback (XTLS/Xray-core#6580, P2): the original version
+// discarded every error from the underlying kevent syscall. ReadPacket()
+// reads and then calls Wait() in an
+// unconditional tight loop -- if kevent started failing at runtime for a
+// persistent reason (not just a benign EINTR), Wait() returning
+// immediately every time reintroduces exactly the busy-spin this whole
+// change exists to remove, just routed through a failing syscall instead
+// of procyield. waitKq.wait's own bool return distinguishes "genuinely
+// interrupted, try again" from "this kqueue is unusable now" -- Wait()
+// permanently falls back to the sleep path once that happens, rather than
+// retrying the same broken kqueue forever.
+func (t *DarwinTun) Wait() {
+	if t.waitKq != nil && t.waitKq.wait(time.Second) {
+		return
+	}
+	if t.waitKq != nil {
+		// Persistent kevent failure (not a benign EINTR, and not just
+		// "the 1s timeout elapsed with nothing to read" -- wait() already
+		// returned true for both of those cases above). Stop trusting
+		// this kqueue for the rest of this DarwinTun's lifetime instead of
+		// re-attempting a syscall that's already shown it won't succeed.
+		t.waitKq.close()
+		t.waitKq = nil
+	}
+	// Reviewer feedback (XTLS/Xray-core#6580): procyield here is the same
+	// busy-spin this whole change exists to remove, just gated behind an
+	// edge case (kqueue setup failing, which practically never happens on
+	// real Darwin systems, or having just failed permanently above)
+	// instead of always -- a genuine bounded sleep actually yields the CPU
+	// instead of being a near-instant scheduler hint that lets the tight
+	// loop of ReadPacket() spin just as hot as before.
+	time.Sleep(time.Millisecond)
+}
+
+// open the interface, by creating new utunN if in the system and returning its file descriptor
+func open(name string) (*os.File, error) {
+	ifIndex := -1
+	_, err := fmt.Sscanf(name, "utun%d", &ifIndex)
+	if err != nil || ifIndex < 0 {
+		return nil, errors.New("interface name must be utunN, where N is a number, e.g. utun9, utun11 and so on")
+	}
+
+	fd, err := unix.Socket(unix.AF_SYSTEM, unix.SOCK_DGRAM, sysprotoControl)
+	if err != nil {
+		return nil, err
+	}
+
+	ctlInfo := &unix.CtlInfo{}
+	copy(ctlInfo.Name[:], utunControlName)
+	if err := unix.IoctlCtlInfo(fd, ctlInfo); err != nil {
+		_ = unix.Close(fd)
+		return nil, err
+	}
+
+	sockaddr := &unix.SockaddrCtl{
+		ID:   ctlInfo.Id,
+		Unit: uint32(ifIndex) + 1,
+	}
+	if err := unix.Connect(fd, sockaddr); err != nil {
+		_ = unix.Close(fd)
+		return nil, err
+	}
+
+	if err := unix.SetNonblock(fd, true); err != nil {
+		_ = unix.Close(fd)
+		return nil, err
+	}
+
+	return os.NewFile(uintptr(fd), name), nil
+}
+
+// setup the interface by name
+func setup(name string, MTU uint32, gateway netip.Prefix) error {
+	if err := setMTU(name, MTU); err != nil {
+		return err
+	}
+
+	/*
+	 * Darwin routing require tunnel type interface to have local and remote address, to be routable.
+	 * To simplify inevitable task, assign the interface static ip address.
+	 */
+	if err := setIPAddress(name, gateway); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+func selectDarwinGateway(configured []string) (netip.Prefix, error) {
+	if len(configured) == 0 {
+		return netip.ParsePrefix(defaultDarwinGateway)
+	}
+
+	for _, value := range configured {
+		prefix, err := netip.ParsePrefix(value)
+		if err != nil {
+			return netip.Prefix{}, xerrors.New("invalid macOS gateway ", value).Base(err)
+		}
+		if !prefix.Addr().Is4() {
+			continue
+		}
+		local, ok := nextDarwinLocalIPv4(prefix)
+		if !ok || !prefix.Contains(local) {
+			return netip.Prefix{}, xerrors.New("macOS gateway ", value, " must contain at least one usable local IPv4 address after the gateway address")
+		}
+		return prefix, nil
+	}
+
+	return netip.Prefix{}, xerrors.New("macOS gateway requires at least one IPv4 prefix")
+}
+
+func nextDarwinLocalIPv4(gateway netip.Prefix) (netip.Addr, bool) {
+	local4 := gateway.Addr().As4()
+	for i := len(local4) - 1; i >= 0; i-- {
+		local4[i]++
+		if local4[i] != 0 {
+			return netip.AddrFrom4(local4), true
+		}
+	}
+	return netip.Addr{}, false
+}
+
+// setMTU sets MTU on the interface by given name
+func setMTU(name string, mtu uint32) error {
+	socket, err := unix.Socket(unix.AF_INET, unix.SOCK_DGRAM, 0)
+	if err != nil {
+		return err
+	}
+	defer unix.Close(socket)
+
+	ifr := unix.IfreqMTU{MTU: int32(mtu)}
+	copy(ifr.Name[:], name)
+	return unix.IoctlSetIfreqMTU(socket, &ifr)
+}
+
+type ifAliasReq4 struct {
+	Name    [unix.IFNAMSIZ]byte
+	Addr    unix.RawSockaddrInet4
+	Dstaddr unix.RawSockaddrInet4
+	Mask    unix.RawSockaddrInet4
+}
+
+type ifAliasReq6 struct {
+	Name     [unix.IFNAMSIZ]byte
+	Addr     unix.RawSockaddrInet6
+	Dstaddr  unix.RawSockaddrInet6
+	Mask     unix.RawSockaddrInet6
+	Flags    uint32
+	Lifetime addrLifetime6
+}
+
+type addrLifetime6 struct {
+	Expire    float64
+	Preferred float64
+	Vltime    uint32
+	Pltime    uint32
+}
+
+// setIPAddress sets ipv4 and ipv6 addresses to the interface, required for the routing to work
+func setIPAddress(name string, gateway netip.Prefix) error {
+	socket4, err := unix.Socket(unix.AF_INET, unix.SOCK_DGRAM, 0)
+	if err != nil {
+		return err
+	}
+	defer unix.Close(socket4)
+
+	// assume local ip address is next one from the remote address
+	local, ok := nextDarwinLocalIPv4(gateway)
+	if !ok || !gateway.Contains(local) {
+		return xerrors.New("macOS gateway ", gateway.String(), " must contain at least one usable local IPv4 address after the gateway address")
+	}
+	local4 := local.As4()
+
+	// fill the configuration for ipv4
+	ifReq4 := ifAliasReq4{
+		Addr: unix.RawSockaddrInet4{
+			Len:    unix.SizeofSockaddrInet4,
+			Family: unix.AF_INET,
+			Addr:   local4,
+		},
+		Dstaddr: unix.RawSockaddrInet4{
+			Len:    unix.SizeofSockaddrInet4,
+			Family: unix.AF_INET,
+			Addr:   gateway.Addr().As4(),
+		},
+		Mask: unix.RawSockaddrInet4{
+			Len:    unix.SizeofSockaddrInet4,
+			Family: unix.AF_INET,
+			Addr:   netip.MustParseAddr(net.IP(net.CIDRMask(gateway.Bits(), 32)).String()).As4(),
+		},
+	}
+	copy(ifReq4.Name[:], name)
+	if err = ioctlPtr(socket4, unix.SIOCAIFADDR, unsafe.Pointer(&ifReq4)); err != nil {
+		return os.NewSyscallError("SIOCAIFADDR", err)
+	}
+
+	socket6, err := unix.Socket(unix.AF_INET6, unix.SOCK_DGRAM, 0)
+	if err != nil {
+		return err
+	}
+	defer unix.Close(socket6)
+
+	// link-local ipv6 address with suffix from ipv6
+	local6 := netip.AddrFrom16([16]byte{0: 0xfe, 1: 0x80, 12: local4[0], 13: local4[1], 14: local4[2], 15: local4[3]})
+
+	// fill the configuration for ipv6
+	// only link-local address without the destination is enough for it
+	ifReq6 := ifAliasReq6{
+		Addr: unix.RawSockaddrInet6{
+			Len:    unix.SizeofSockaddrInet6,
+			Family: unix.AF_INET6,
+			Addr:   local6.As16(),
+		},
+		Mask: unix.RawSockaddrInet6{
+			Len:    unix.SizeofSockaddrInet6,
+			Family: unix.AF_INET6,
+			Addr:   netip.MustParseAddr(net.IP(net.CIDRMask(64, 128)).String()).As16(),
+		},
+		Flags: IN6_IFF_NODAD,
+		Lifetime: addrLifetime6{
+			Vltime: ND6_INFINITE_LIFETIME,
+			Pltime: ND6_INFINITE_LIFETIME,
+		},
+	}
+	// assign link-local ipv6 address to the interface.
+	// this will additionally trigger OS level autoconfiguration, which will result two different link-local
+	// addresses - the requested one, and autoconfigured one.
+	// this really has no known side effects, just look excessive. and actually considered pretty normal way to
+	// enable the ipv6 on the interface by macOS concepts.
+	copy(ifReq6.Name[:], name)
+	if err = ioctlPtr(socket6, SIOCAIFADDR6, unsafe.Pointer(&ifReq6)); err != nil {
+		return os.NewSyscallError("SIOCAIFADDR6", err)
+	}
+
+	return nil
+}
+
+func ioctlPtr(fd int, req uint, arg unsafe.Pointer) error {
+	_, _, errno := unix.Syscall(unix.SYS_IOCTL, uintptr(fd), uintptr(req), uintptr(arg))
+	if errno != 0 {
+		return errno
+	}
+	return nil
+}
+
+func setinterface(network, address string, fd uintptr, iface *net.Interface) error {
+	switch network {
+	case "tcp6", "udp6", "ip6":
+		// IPV6_BOUND_IF binds the IPv4 traffic of a dual-stack socket as
+		// well, and an IPv6 socket rejects IP_BOUND_IF with EINVAL.
+		return unix.SetsockoptInt(int(fd), unix.IPPROTO_IPV6, unix.IPV6_BOUND_IF, iface.Index)
+	case "tcp4", "udp4", "ip4":
+		return unix.SetsockoptInt(int(fd), unix.IPPROTO_IP, unix.IP_BOUND_IF, iface.Index)
+	default:
+		panic(network + " " + address)
+	}
+}
+
+func findOutboundInterface(tunIndex int, fixedName string) (*net.Interface, error) {
+	if fixedName != "" {
+		iface, err := net.InterfaceByName(fixedName)
+		if err != nil {
+			return nil, err
+		}
+		if iface.Index == tunIndex {
+			return nil, errors.New("outbound interface cannot be the TUN interface")
+		}
+		return iface, nil
+	}
+
+	rib, err := route.FetchRIB(unix.AF_UNSPEC, route.RIBTypeRoute, 0)
+	if err != nil {
+		return nil, err
+	}
+	messages, err := route.ParseRIB(route.RIBTypeRoute, rib)
+	if err != nil {
+		return nil, err
+	}
+
+	var ipv6Index int
+	for _, message := range messages {
+		routeMessage, ok := message.(*route.RouteMessage)
+		if !ok || routeMessage.Index == tunIndex {
+			continue
+		}
+		if routeMessage.Flags&unix.RTF_UP == 0 || routeMessage.Flags&unix.RTF_GATEWAY == 0 {
+			continue
+		}
+
+		family, ok := defaultRouteFamily(routeMessage)
+		if !ok {
+			continue
+		}
+		if family == unix.AF_INET {
+			return usableDarwinInterface(routeMessage.Index)
+		}
+		if family == unix.AF_INET6 && ipv6Index == 0 {
+			ipv6Index = routeMessage.Index
+		}
+	}
+
+	if ipv6Index != 0 {
+		return usableDarwinInterface(ipv6Index)
+	}
+	return nil, errors.New("default route not found")
+}
+
+func defaultRouteFamily(message *route.RouteMessage) (int, bool) {
+	if len(message.Addrs) <= unix.RTAX_NETMASK {
+		return 0, false
+	}
+
+	switch destination := message.Addrs[unix.RTAX_DST].(type) {
+	case *route.Inet4Addr:
+		mask, ok := message.Addrs[unix.RTAX_NETMASK].(*route.Inet4Addr)
+		if !ok || destination.IP != netip.IPv4Unspecified().As4() {
+			return 0, false
+		}
+		ones, bits := net.IPMask(mask.IP[:]).Size()
+		return unix.AF_INET, ones == 0 && bits == 32
+	case *route.Inet6Addr:
+		mask, ok := message.Addrs[unix.RTAX_NETMASK].(*route.Inet6Addr)
+		if !ok || destination.IP != netip.IPv6Unspecified().As16() {
+			return 0, false
+		}
+		ones, bits := net.IPMask(mask.IP[:]).Size()
+		return unix.AF_INET6, ones == 0 && bits == 128
+	default:
+		return 0, false
+	}
+}
+
+func usableDarwinInterface(index int) (*net.Interface, error) {
+	iface, err := net.InterfaceByIndex(index)
+	if err != nil {
+		return nil, err
+	}
+	if iface.Flags&net.FlagUp == 0 || iface.Flags&net.FlagLoopback != 0 {
+		return nil, errors.New("default route interface is not usable")
+	}
+	return iface, nil
+}
+
+func (t *DarwinTun) setSystemRoutes() error {
+	routes, err := buildDarwinSystemRoutes(t.options.AutoSystemRoutingTable)
+	if err != nil {
+		return err
+	}
+	if len(routes) == 0 {
+		return nil
+	}
+
+	tunIndex, err := t.Index()
+	if err != nil {
+		return err
+	}
+	for _, destination := range routes {
+		if err := execDarwinRoute(unix.RTM_ADD, tunIndex, destination, t.gateway); err != nil {
+			_ = t.unsetSystemRoutes()
+			return xerrors.New("failed to add system route ", destination).Base(err)
+		}
+		t.systemRoutes = append(t.systemRoutes, destination)
+	}
+	return nil
+}
+
+func (t *DarwinTun) unsetSystemRoutes() error {
+	var errs []error
+	tunIndex, indexErr := t.Index()
+	if indexErr != nil && len(t.systemRoutes) > 0 {
+		errs = append(errs, indexErr)
+	}
+	for i := len(t.systemRoutes) - 1; i >= 0; i-- {
+		destination := t.systemRoutes[i]
+		if err := execDarwinRoute(unix.RTM_DELETE, tunIndex, destination, t.gateway); err != nil && !errors.Is(err, unix.ESRCH) {
+			errs = append(errs, xerrors.New("failed to delete system route ", destination).Base(err))
+		}
+	}
+	t.systemRoutes = nil
+	return xerrors.Combine(errs...)
+}
+
+func buildDarwinSystemRoutes(configured []string) ([]netip.Prefix, error) {
+	routes := make([]netip.Prefix, 0, len(configured))
+	seen := make(map[netip.Prefix]struct{})
+
+	appendRoute := func(prefix netip.Prefix) {
+		prefix = prefix.Masked()
+		if _, found := seen[prefix]; found {
+			return
+		}
+		seen[prefix] = struct{}{}
+		routes = append(routes, prefix)
+	}
+
+	for _, value := range configured {
+		prefix, err := netip.ParsePrefix(value)
+		if err != nil {
+			return nil, xerrors.New("invalid system route ", value).Base(err)
+		}
+		prefix = prefix.Masked()
+		if prefix.Bits() == 0 {
+			for _, protected := range darwinProtectedDefaultRoutes(prefix.Addr().Is4()) {
+				appendRoute(protected)
+			}
+			continue
+		}
+		appendRoute(prefix)
+	}
+
+	return routes, nil
+}
+
+func darwinProtectedDefaultRoutes(ipv4 bool) []netip.Prefix {
+	routes := make([]netip.Prefix, 0, 8)
+	for i := 0; i < 8; i++ {
+		if ipv4 {
+			var address [4]byte
+			address[0] = 1 << i
+			routes = append(routes, netip.PrefixFrom(netip.AddrFrom4(address), 8-i))
+		} else {
+			var address [16]byte
+			address[0] = 1 << i
+			routes = append(routes, netip.PrefixFrom(netip.AddrFrom16(address), 8-i))
+		}
+	}
+	return routes
+}
+
+func execDarwinRoute(messageType int, interfaceIndex int, destination netip.Prefix, gateway netip.Prefix) error {
+	message := route.RouteMessage{
+		Type:    messageType,
+		Version: unix.RTM_VERSION,
+		Flags:   unix.RTF_STATIC | unix.RTF_GATEWAY,
+		Seq:     1,
+	}
+	if messageType == unix.RTM_ADD {
+		message.Flags |= unix.RTF_UP
+	}
+
+	if destination.Addr().Is4() {
+		message.Addrs = []route.Addr{
+			unix.RTAX_DST:     &route.Inet4Addr{IP: destination.Addr().As4()},
+			unix.RTAX_NETMASK: &route.Inet4Addr{IP: prefixMask4(destination.Bits())},
+			unix.RTAX_GATEWAY: &route.Inet4Addr{IP: gateway.Addr().As4()},
+		}
+	} else {
+		message.Flags &^= unix.RTF_GATEWAY
+		message.Index = interfaceIndex
+		message.Addrs = []route.Addr{
+			unix.RTAX_DST:     &route.Inet6Addr{IP: destination.Addr().As16()},
+			unix.RTAX_NETMASK: &route.Inet6Addr{IP: prefixMask6(destination.Bits())},
+			unix.RTAX_GATEWAY: &route.LinkAddr{Index: interfaceIndex},
+		}
+	}
+
+	request, err := message.Marshal()
+	if err != nil {
+		return err
+	}
+	fd, err := unix.Socket(unix.AF_ROUTE, unix.SOCK_RAW, 0)
+	if err != nil {
+		return err
+	}
+	defer unix.Close(fd)
+	_, err = unix.Write(fd, request)
+	return err
+}
+
+func prefixMask4(bits int) [4]byte {
+	var mask [4]byte
+	copy(mask[:], net.CIDRMask(bits, 32))
+	return mask
+}
+
+func prefixMask6(bits int) [16]byte {
+	var mask [16]byte
+	copy(mask[:], net.CIDRMask(bits, 128))
+	return mask
+}
diff --git a/third_party/xray-core/proxy/tun/tun_darwin_test.go b/third_party/xray-core/proxy/tun/tun_darwin_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2656e62b6dd115cec356423469520d021b47e157
--- /dev/null
+++ b/third_party/xray-core/proxy/tun/tun_darwin_test.go
@@ -0,0 +1,273 @@
+//go:build darwin
+
+package tun
+
+import (
+	"context"
+	"net"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func TestSelectDarwinGatewayDefault(t *testing.T) {
+	gateway, err := selectDarwinGateway(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := gateway.String(); got != defaultDarwinGateway {
+		t.Fatalf("unexpected default gateway: got %s, want %s", got, defaultDarwinGateway)
+	}
+}
+
+func TestSelectDarwinGatewayConfiguredIPv4(t *testing.T) {
+	gateway, err := selectDarwinGateway([]string{"198.18.0.1/15"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := gateway.String(); got != "198.18.0.1/15" {
+		t.Fatalf("unexpected gateway: got %s", got)
+	}
+}
+
+func TestSelectDarwinGatewaySkipsIPv6(t *testing.T) {
+	gateway, err := selectDarwinGateway([]string{"fc00::1/64", "198.18.0.1/15"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := gateway.String(); got != "198.18.0.1/15" {
+		t.Fatalf("unexpected gateway: got %s", got)
+	}
+}
+
+func TestSelectDarwinGatewayRequiresIPv4(t *testing.T) {
+	if _, err := selectDarwinGateway([]string{"fc00::1/64"}); err == nil {
+		t.Fatal("expected error")
+	}
+}
+
+func TestSelectDarwinGatewayRequiresUsableLocalAddress(t *testing.T) {
+	if _, err := selectDarwinGateway([]string{"198.18.0.1/32"}); err == nil {
+		t.Fatal("expected error")
+	}
+}
+
+// newTestSocketpair returns a connected AF_UNIX/SOCK_DGRAM pair -- a real
+// fd DarwinTun.Wait's kqueue can register EVFILT_READ against, without
+// needing an actual utun interface (which requires root/network
+// entitlements this test environment doesn't have). Datagram sockets
+// (unlike pipes) support both "write makes readable" and "close makes
+// readable" the same way a tun fd's read-readiness behaves.
+func newTestSocketpair(t *testing.T) (a, b int) {
+	t.Helper()
+	fds, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_DGRAM, 0)
+	if err != nil {
+		t.Fatalf("socketpair: %v", err)
+	}
+	t.Cleanup(func() {
+		_ = unix.Close(fds[0])
+		_ = unix.Close(fds[1])
+	})
+	return fds[0], fds[1]
+}
+
+// Reviewer feedback, XTLS/Xray-core#6580: "blocking with no data" case --
+// wait() must not return before the timeout when nothing is written.
+func TestWaitKqueueBlocksWithNoData(t *testing.T) {
+	a, _ := newTestSocketpair(t)
+	kq := newWaitKqueue(a)
+	if kq == nil {
+		t.Fatal("newWaitKqueue returned nil")
+	}
+	defer kq.close()
+
+	start := time.Now()
+	ok := kq.wait(150 * time.Millisecond)
+	elapsed := time.Since(start)
+
+	if !ok {
+		t.Fatal("wait() returned false on a healthy kqueue with a plain timeout")
+	}
+	if elapsed < 100*time.Millisecond {
+		t.Fatalf("wait() returned after only %v, expected it to block close to the 150ms timeout", elapsed)
+	}
+}
+
+// Reviewer feedback: "wake up with a readable fd" case.
+func TestWaitKqueueWakesOnReadable(t *testing.T) {
+	a, b := newTestSocketpair(t)
+	kq := newWaitKqueue(a)
+	if kq == nil {
+		t.Fatal("newWaitKqueue returned nil")
+	}
+	defer kq.close()
+
+	done := make(chan bool, 1)
+	go func() {
+		done <- kq.wait(5 * time.Second)
+	}()
+
+	time.Sleep(20 * time.Millisecond) // let wait() actually enter the syscall first
+	if _, err := unix.Write(b, []byte{0x1}); err != nil {
+		t.Fatalf("write: %v", err)
+	}
+
+	select {
+	case ok := <-done:
+		if !ok {
+			t.Fatal("wait() returned false after the fd became readable")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("wait() did not wake up within 2s of the fd becoming readable")
+	}
+}
+
+// Reviewer feedback: "timeout" case, explicitly (distinct from the
+// no-data test above, which also checks blocking duration -- this one
+// only checks the return value).
+func TestWaitKqueueTimesOut(t *testing.T) {
+	a, _ := newTestSocketpair(t)
+	kq := newWaitKqueue(a)
+	if kq == nil {
+		t.Fatal("newWaitKqueue returned nil")
+	}
+	defer kq.close()
+
+	if !kq.wait(50 * time.Millisecond) {
+		t.Fatal("wait() returned false on a plain timeout with no error condition")
+	}
+}
+
+// Reviewer feedback: "Close() wakes a blocked wait" case, and the
+// no-double-close/no-fd-reuse concern (P1) -- close() while wait() is
+// parked in its syscall must not panic, must not leave wait() hung, and a
+// second close() call (from a caller that, say, calls Close() twice on
+// the same DarwinTun) must be safe.
+func TestWaitKqueueCloseDuringWaitIsSafe(t *testing.T) {
+	a, _ := newTestSocketpair(t)
+	kq := newWaitKqueue(a)
+	if kq == nil {
+		t.Fatal("newWaitKqueue returned nil")
+	}
+
+	started := make(chan struct{})
+	done := make(chan bool, 1)
+	go func() {
+		close(started)
+		done <- kq.wait(5 * time.Second)
+	}()
+
+	<-started
+	time.Sleep(20 * time.Millisecond) // let wait() actually enter the syscall first
+	kq.close()
+	kq.close() // double-close must be idempotent, not panic or double-free the fd
+
+	select {
+	case <-done:
+		// Either true (the close-of-the-underlying-fd unblocked kevent, a
+		// real kqueue behavior) or false (wait() observed the closed flag
+		// first) is acceptable -- what matters is that it returned at all,
+		// promptly, without hanging or crashing.
+	case <-time.After(2 * time.Second):
+		t.Fatal("wait() did not return within 2s of close() being called")
+	}
+
+	// A wait() call *after* close() must return false immediately (the
+	// closed-flag fast path), not attempt a syscall against the
+	// already-closed (and potentially since-reused, on a real system) fd
+	// number.
+	if kq.wait(time.Second) {
+		t.Fatal("wait() returned true after close() -- should short-circuit via the closed flag")
+	}
+}
+
+// Reviewer feedback: "multiple/concurrent close guard" case -- many
+// goroutines calling close() concurrently must close the underlying fd
+// exactly once.
+func TestWaitKqueueConcurrentCloseIsSafe(t *testing.T) {
+	a, _ := newTestSocketpair(t)
+	kq := newWaitKqueue(a)
+	if kq == nil {
+		t.Fatal("newWaitKqueue returned nil")
+	}
+
+	var wg sync.WaitGroup
+	for range 20 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			kq.close()
+		}()
+	}
+	wg.Wait()
+
+	if !kq.closed.Load() {
+		t.Fatal("closed flag not set after concurrent close() calls")
+	}
+}
+
+// Reviewer feedback: "kevent runtime failure without spinning" case (P2).
+// Simulates a kqueue that has gone bad (closed out from under it, as if a
+// concurrent/erroneous close happened) and confirms wait() reports it as
+// unusable (false) rather than silently returning true forever, which is
+// what DarwinTun.Wait relies on to permanently fall back to the sleep
+// path instead of re-entering a failing syscall on every dispatchLoop
+// iteration.
+func TestWaitKqueueReportsPersistentFailure(t *testing.T) {
+	a, _ := newTestSocketpair(t)
+	kq := newWaitKqueue(a)
+	if kq == nil {
+		t.Fatal("newWaitKqueue returned nil")
+	}
+	// Close the underlying kqueue fd directly (bypassing kq.close(), which
+	// would also set the closed flag) to simulate the fd going bad for a
+	// reason other than this type's own close() -- e.g. some other code
+	// path in the process closing it, or the kernel invalidating it.
+	_ = unix.Close(kq.fd)
+
+	for i := 0; i < 5; i++ {
+		if kq.wait(50 * time.Millisecond) {
+			t.Fatalf("wait() call %d returned true against a closed underlying fd -- should report failure, not spin", i)
+		}
+	}
+}
+
+// TestSetinterfaceSocketFamilies binds each kind of socket Xray's dialers
+// open to lo0, including the dual-stack one Go opens for UDP.
+func TestSetinterfaceSocketFamilies(t *testing.T) {
+	lo, err := net.InterfaceByName("lo0")
+	if err != nil {
+		t.Skip(err)
+	}
+	lc := net.ListenConfig{Control: func(network, address string, c syscall.RawConn) error {
+		var err error
+		if controlErr := c.Control(func(fd uintptr) {
+			err = setinterface(network, address, fd, lo)
+		}); controlErr != nil {
+			return controlErr
+		}
+		return err
+	}}
+	for _, s := range []struct{ network, address string }{
+		{"udp", "0.0.0.0:0"}, // dual-stack
+		{"udp4", "127.0.0.1:0"},
+		{"udp6", "[::1]:0"},
+		{"tcp4", "127.0.0.1:0"},
+		{"tcp6", "[::1]:0"},
+	} {
+		var closer interface{ Close() error }
+		if s.network[:3] == "udp" {
+			closer, err = lc.ListenPacket(context.Background(), s.network, s.address)
+		} else {
+			closer, err = lc.Listen(context.Background(), s.network, s.address)
+		}
+		if err != nil {
+			t.Errorf("%s %s: %v", s.network, s.address, err)
+			continue
+		}
+		closer.Close()
+	}
+}
