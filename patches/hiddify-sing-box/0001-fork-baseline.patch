+
+	common.Must(internet.RegisterListenerController(func(network, address string, c syscall.RawConn) error {
+		return c.Control(func(fd uintptr) {
+			gotFd = fd
+		})
+	}))
+
+	conn, err := internet.ListenSystemPacket(context.Background(), &net.UDPAddr{
+		IP: net.IPv4zero,
+	}, nil)
