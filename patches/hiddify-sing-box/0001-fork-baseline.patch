+					{
+						Account: serial.ToTypedMessage(&vless.Account{
+							Id:   "27848739-7e62-4138-9fd3-098a63964b6b",
+							Flow: "xtls-rprx-vision",
+						}),
+						Level: 0,
+						Email: "love@example.com",
+					},
+				},
+				Decryption: "none",
+				Fallbacks: []*inbound.Fallback{
+					{
+						Alpn: "",
+						Path: "",
+						Type: "tcp",
+						Dest: "localhost:80",
+						Xver: 0,
+					},
+					{
+						Alpn: "h2",
+						Path: "",
+						Type: "unix",
+						Dest: "@/dev/shm/domain.socket",
+						Xver: 2,
+					},
+					{
+						Alpn: "",
+						Path: "/innerws",
+						Type: "serve",
+						Dest: "serve-ws-none",
