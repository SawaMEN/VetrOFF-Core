new file mode 100644
index 0000000000000000000000000000000000000000..20ca72d7c93127d86ae1dae27a770fdadae7f9bf
--- /dev/null
+++ b/third_party/xray-core/common/base64/encode.go
@@ -0,0 +1,29 @@
+package base64
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/base64"
+
+	"github.com/xtls/xray-core/common/errors"
+)
+
+// Encode returns prefixed Base64 text, optionally compressed with gzip at the highest level.
+func Encode(data []byte, zip bool) (string, error) {
+	if !zip {
+		return Prefix + base64.StdEncoding.EncodeToString(data), nil
+	}
+
+	var buf bytes.Buffer
+	writer, err := gzip.NewWriterLevel(&buf, gzip.BestCompression)
+	if err != nil {
+		return "", errors.New("failed to compress gzip").Base(err)
+	}
+	if _, err := writer.Write(data); err != nil {
+		return "", errors.New("failed to compress gzip").Base(err)
+	}
+	if err := writer.Close(); err != nil {
+		return "", errors.New("failed to compress gzip").Base(err)
+	}
+	return GzipPrefix + base64.StdEncoding.EncodeToString(buf.Bytes()), nil
+}
diff --git a/third_party/xray-core/common/base64/encode_test.go b/third_party/xray-core/common/base64/encode_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..0616d345b32d379c2c4892ea6f0b25eb375d2550
--- /dev/null
