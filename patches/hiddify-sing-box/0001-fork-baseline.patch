+func mustSendRecvTcp(
+	t *testing.T,
+	from net.Conn,
+	to net.Conn,
+	msg []byte,
+) {
+	t.Helper()
+
+	waitCh := make(chan error)
+
+	go func() {
+		_, err := from.Write(msg)
+		if err != nil {
+			t.Fatal(err)
+		}
+		close(waitCh)
+	}()
+
+	buf := make([]byte, 1024)
+	n, err := io.ReadFull(to, buf[:len(msg)])
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if n != len(msg) {
+		t.Fatalf("unexpected size: %d", n)
+	}
+
+	if !bytes.Equal(buf[:n], msg) {
+		t.Fatalf("unexpected data %q", buf[:n])
+	}
+
+	<-waitCh
+}
