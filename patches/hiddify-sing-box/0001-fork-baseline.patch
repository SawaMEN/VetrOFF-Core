+	t.Cleanup(func() { conn.Close() })
+
+	require.NoError(t, conn.AssignAddresses(nil))
+	select {
+	case <-writeStarted:
+	case <-time.After(time.Second):
+		t.Fatal("capsule write did not start")
+	}
+
+	for range maxQueuedCapsules {
+		require.NoError(t, conn.AssignAddresses(nil))
+	}
+	go func() {
+		conn.Routes(context.Background())
