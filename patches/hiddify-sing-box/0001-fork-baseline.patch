+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	connCtx := &afterFuncs{Context: ctx}
+	client := newServiceClient(connCtx, new(sync.Map), &internet.MemoryStreamConfig{}, 5*time.Second, 8)
+
+	for range 4 {
+		resp, err := client.Get(server.URL)
+		if err != nil {
+			t.Fatal(err)
+		}
+		resp.Body.Close()
