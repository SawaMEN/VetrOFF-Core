index 0000000000000000000000000000000000000000..34c95e5427a651550195ac3811366c8dd4c3db35
--- /dev/null
+++ b/third_party/xray-core/proxy/tun/udp_queue_bench_test.go
@@ -0,0 +1,82 @@
+package tun
+
+import (
+	"runtime"
+	"testing"
+
+	"github.com/xtls/xray-core/common/buf"
+)
+
+const benchBatch = 64
+
+// Raw cost of queueing and draining a small burst, as one flow's reader does.
+func BenchmarkQueueBurstChan(b *testing.B) {
+	ch := make(chan *buf.Buffer, udpQueueLimit)
+	p := &buf.Buffer{}
+	b.ReportAllocs()
+	for i := 0; i < b.N; i++ {
