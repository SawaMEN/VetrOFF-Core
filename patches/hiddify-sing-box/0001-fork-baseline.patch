+	if dest.Address.Family().IsDomain() {
+		return M.ParseSocksaddrHostPort(dest.Address.Domain(), uint16(dest.Port))
+	}
+	return M.SocksaddrFrom(M.AddrFromIP(dest.Address.IP()), uint16(dest.Port))
