 	text := string(content)
 	for _, scrubber := range reportScrubbers {
 		text = scrubber.pattern.ReplaceAllString(text, scrubber.replacement)
 	}
-	return []byte(text)
+	return []byte(scrubDomains(scrubIPv6(text)))
 }
