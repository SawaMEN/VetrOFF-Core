+)
+
+func TestNormalizeEnvName(t *testing.T) {
+	cases := []struct {
+		input  string
+		output string
+	}{
+		{
+			input:  "a",
+			output: "A",
+		},
+		{
+			input:  "a.a",
+			output: "A_A",
+		},
+		{
+			input:  "A.A.B",
+			output: "A_A_B",
+		},
+	}
+	for _, test := range cases {
+		if v := NormalizeEnvName(test.input); v != test.output {
+			t.Error("unexpected output: ", v, " want ", test.output)
+		}
+	}
+}
+
+func TestEnvFlag(t *testing.T) {
+	v := EnvFlag{
+		Name: "xxxxx.y",
+	}.GetValueAsInt(10)
+	if v != 10 {
+		t.Error("env value: ", v)
+	}
+}
