+func (c *rateLimitedConn) Read(b []byte) (int, error) {
+	n, err := c.Conn.Read(b)
+	if n != 0 {
+		if c.After > 0 {
+			c.After -= int64(n)
+		} else {
+			c.Bucket.Wait(int64(n))
+		}
+	}
+	return n, err
+}
