+func (c *realityMirrorConn) Read(b []byte) (int, error) {
+	c.Unlock()
+	runtime.Gosched()
+	n, err := c.Conn.Read(b)
+	c.Lock() // calling c.Lock() before c.Target.Write(), to make sure that this goroutine has the priority to make the next move
+	if n != 0 {
+		c.Target.Write(b[:n])
+	}
+	if err != nil {
+		c.Target.Close()
+	}
+	return n, err
+}
