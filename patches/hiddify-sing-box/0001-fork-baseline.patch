index 0000000000000000000000000000000000000000..4c2f07fb1d3702df79899f635ff052b8b04282d6
--- /dev/null
+++ b/transport/compat/sudoku/pkg/obfs/httpmask/masker.go
@@ -0,0 +1,227 @@
+/*
