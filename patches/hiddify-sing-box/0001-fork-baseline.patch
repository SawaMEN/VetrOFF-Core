+func liveDriveConfig(t *testing.T) *Config {
+	t.Helper()
+
+	path := os.Getenv(liveSecretsEnv)
+	if path == "" {
+		t.Skipf("set %s to run this test", liveSecretsEnv)
+	}
+
+	payload, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("reading %s: %v", path, err)
