+func TestXUIPanelBalancerCloseBeforeStart(t *testing.T) {
+	state, err := newBalanceState(context.Background(), option.XrayBalancerOptions{Strategy: "random", ProbeURL: "http://127.0.0.1:1/"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	state.Close()
+	target := &probeOutbound{Adapter: outbound.NewAdapter("direct", "never", nil, nil), fail: true}
+	state.postStart(map[string]adapter.Outbound{"never": target})
+	state.Close()
+	if target.calls.Load() != 0 {
+		t.Fatal("probe after shutdown")
+	}
+}
+
+func TestXUIPanelBalancerRejectsNullCost(t *testing.T) {
+	_, err := newBalanceState(context.Background(), option.XrayBalancerOptions{Strategy: "leastLoad", ProbeURL: "http://127.0.0.1/probe", Settings: []byte(`{"costs":[null]}`)})
+	if err == nil {
+		t.Fatal("null cost accepted")
+	}
+}
+
+func TestXUIPanelLeastLoadAdvancedSettings(t *testing.T) {
+	ctx := context.Background()
+	state, err := newBalanceState(ctx, option.XrayBalancerOptions{
+		Strategy: "leastLoad",
+		ProbeURL: "https://example.org/",
+		Fallback: "backup",
+		Settings: []byte(`{"costs":[{"match":"a","value":9}],"maxRTT":"1s","expected":1,"tolerance":0.5}`),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer state.Close()
+	state.record("a", 10*time.Millisecond, nil)
+	state.record("b", 20*time.Millisecond, nil)
+	tag, err := state.pick([]string{"a", "b"})
+	if err != nil || tag != "b" {
+		t.Fatalf("cost-weighted leastLoad should prefer b, got %q: %v", tag, err)
+	}
+	state.record("b", 0, fmt.Errorf("offline"))
+	tag, err = state.pick([]string{"a", "b"})
+	if err != nil || tag != "a" {
+		t.Fatalf("failed outbound still selected: %q: %v", tag, err)
+	}
+
+	baselines, err := newBalanceState(ctx, option.XrayBalancerOptions{
+		Strategy: "leastLoad",
+		ProbeURL: "https://example.org/",
+		Fallback: "backup",
+		Settings: []byte(`{"baselines":["1ms"]}`),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer baselines.Close()
+	baselines.record("a", 40*time.Millisecond, nil)
+	tag, err = baselines.pick([]string{"a"})
+	if err != nil || tag != "backup" {
+		t.Fatalf("fallback must handle rejected baseline: %q: %v", tag, err)
+	}
+}
+
+func TestXUIPanelLeastLoadRejectsMalformedSettings(t *testing.T) {
+	for _, settings := range []string{
+		`{"costs":[null]}`,
+		`{"costs":[{"match":"(","regexp":true}]}`,
+		`{"maxRTT":"nonsense"}`,
+		`{"baselines":["not-duration"]}`,
+		`{"unknown":1}`,
+	} {
+		if _, err := newBalanceState(context.Background(), option.XrayBalancerOptions{
+			Strategy: "leastLoad",
+			ProbeURL: "https://example.org/",
+			Settings: []byte(settings),
+		}); err == nil {
+			t.Fatalf("accepted malformed settings: %s", settings)
+		}
+	}
+}
+
+func TestXUIPanelBalancerBurstSampling(t *testing.T) {
+	state, err := newBalanceState(context.Background(), option.XrayBalancerOptions{
+		Strategy: "leastLoad",
+		ProbeURL: "http://127.0.0.1:1/probe",
+		Fallback: "backup",
+		Burst:    true,
+		Sampling: 3,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer state.Close()
+	state.record("node", 10*time.Millisecond, nil)
+	state.record("node", 0, fmt.Errorf("temporary probe failure"))
+	selected, err := state.pick([]string{"node"})
+	if err != nil || selected != "node" {
+		t.Fatalf("a single failed sample must not mark burst node offline: %q %v", selected, err)
+	}
+	state.record("node", 0, fmt.Errorf("second probe failure"))
+	selected, err = state.pick([]string{"node"})
+	if err != nil || selected != "node" {
+		t.Fatalf("one successful sample must keep burst node alive: %q %v", selected, err)
+	}
+	state.record("node", 0, fmt.Errorf("third probe failure"))
+	selected, err = state.pick([]string{"node"})
+	if err != nil || selected != "backup" {
+		t.Fatalf("all failed samples must trigger fallback: %q %v", selected, err)
+	}
+}
+
+func TestXUIPanelBalancerConnectivityOutageDoesNotEvictHealthySnapshot(t *testing.T) {
+	// If the probe target AND the independent connectivity URL are
+	// unreachable, do not interpret the local network outage as evidence
+	// that a previously healthy outbound has gone offline.
+	state, err := newBalanceState(context.Background(), option.XrayBalancerOptions{
+		Strategy:     "leastPing",
+		ProbeURL:     "http://127.0.0.1:1/probe",
+		Connectivity: "http://127.0.0.1:1/connectivity",
+		Fallback:     "backup",
+		Timeout:      100000000, // 100ms
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer state.Close()
+	state.record("node", 15*time.Millisecond, nil)
+	dead := &probeOutbound{Adapter: outbound.NewAdapter("direct", "node", nil, nil), fail: true}
+	state.targets = map[string]adapter.Outbound{"node": dead}
+	state.probe()
+	if dead.calls.Load() != 1 {
+		t.Fatalf("expected exactly one outbound probe, got %d", dead.calls.Load())
+	}
+	selected, err := state.pick([]string{"node"})
+	if err != nil || selected != "node" {
+		t.Fatalf("local connectivity outage must preserve last healthy snapshot: %q %v", selected, err)
+	}
+}
+
+func TestXUIPanelBalancerRejectsOverflowingFreshnessWindow(t *testing.T) {
+	// Burst freshness multiplies interval * samples * 2. A wrapped
+	// negative duration could keep a stale proxy marked healthy.
+	_, err := newBalanceState(context.Background(), option.XrayBalancerOptions{
+		Strategy: "leastPing",
+		ProbeURL: "http://127.0.0.1:1/probe",
+		Interval: badoption.Duration(1 << 62),
+		Sampling: 2,
+	})
+	if err == nil {
+		t.Fatal("accepted an overflowing probe observation horizon")
+	}
+}
