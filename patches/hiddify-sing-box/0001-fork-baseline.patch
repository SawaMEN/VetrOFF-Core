+		if err != nil {
+			return n, addr, err
+		}
+		buf := b[:n]
+
+		sum := 0
+		for _, size := range c.sizes {
+			sum += size
+		}
+
+		if n < sum {
+			errors.LogError(context.Background(), "[mask] drop packet from ", addr, " with size ", n)
+			continue
+		}
+
+		for i := range c.conns {
+			n, _, err = c.conns[i].ReadFrom(buf)
+			if err != nil {
