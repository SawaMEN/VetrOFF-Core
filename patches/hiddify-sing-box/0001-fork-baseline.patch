diff --git a/protocol/hiddify/soar/h_soar_test.go b/protocol/hiddify/soar/h_soar_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..880bf2c68d36108dd03e5b4fcd7763964ee729bf
--- /dev/null
+++ b/protocol/hiddify/soar/h_soar_test.go
@@ -0,0 +1,322 @@
+package soar
+
+import (
+	"context"
+	"crypto/ed25519"
+	"encoding/base64"
+	"encoding/hex"
+	"io"
+	"net"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/getlantern/soar"
+	"github.com/miekg/dns"
+	"github.com/stretchr/testify/require"
+)
+
+const testZone = "t.example.com"
+
+func testKey(t *testing.T) (ed25519.PublicKey, ed25519.PrivateKey) {
+	t.Helper()
+	pub, priv, err := ed25519.GenerateKey(nil)
+	require.NoError(t, err)
+	return pub, priv
+}
+
+func newTestOutbound(t *testing.T, options option.SoarOptions) *Outbound {
+	t.Helper()
+	out, err := NewOutbound(context.Background(), nil, log.NewNOPFactory().Logger(), "soar-out", options)
+	require.NoError(t, err)
+	t.Cleanup(func() { out.(*Outbound).Close() })
+	return out.(*Outbound)
+}
+
+func TestH_SoarParsePublicKey(t *testing.T) {
+	t.Parallel()
+	pub, _ := testKey(t)
+	for _, form := range []string{
+		base64.StdEncoding.EncodeToString(pub),
+		base64.RawStdEncoding.EncodeToString(pub),
+		base64.URLEncoding.EncodeToString(pub),
+		base64.RawURLEncoding.EncodeToString(pub),
+		hex.EncodeToString(pub),
+		" " + base64.StdEncoding.EncodeToString(pub) + "\n",
+	} {
+		key, err := ParsePublicKey(form)
+		require.NoError(t, err, form)
+		require.Equal(t, pub, key)
+	}
+	for _, bad := range []string{"", "not a key", base64.StdEncoding.EncodeToString(pub[:16])} {
+		_, err := ParsePublicKey(bad)
+		require.Error(t, err, bad)
+	}
+}
+
+func TestH_SoarNewOutbound(t *testing.T) {
+	t.Parallel()
+	pub, _ := testKey(t)
+	key := base64.StdEncoding.EncodeToString(pub)
+
+	// resolvers written: the smart pool (on by default) carries them, no discovery
+	out := newTestOutbound(t, option.SoarOptions{Domain: testZone + ".", PublicKey: key, Resolvers: []string{"8.8.8.8", "dot://1.1.1.1:853"}})
+	require.Equal(t, C.TypeSoar, out.Type())
+	require.Equal(t, []string{N.NetworkTCP}, out.Network())
+	require.Equal(t, "Soar", out.DisplayType())
+	require.NotNil(t, out.pool)
+	require.False(t, out.discover)
+	cfg := out.Config()
+	require.Equal(t, testZone, cfg.Zone)
+	require.Equal(t, []string{out.pool.Addr()}, cfg.Resolvers)
+	require.False(t, cfg.Discovery.Enabled)
+	require.Equal(t, "off", cfg.TCP)
+	require.Equal(t, 128, cfg.MaxPathWindow)
+	require.Len(t, out.candidates, 2)
+	require.Equal(t, defaultConnectTimeout, out.connectTimeout)
+	require.Equal(t, "www.google.com", out.options.PreTestDomain)
+
+	// no resolvers, or "auto" alone: Soar's own discovery, no pool
+	for _, resolvers := range [][]string{nil, {"auto"}} {
+		out = newTestOutbound(t, option.SoarOptions{Domain: testZone, PublicKey: key, Resolvers: resolvers, SmartPool: &option.SmartPoolOptions{Enabled: true, Discovery: &option.ResolverDiscoveryOptions{Country: "ir", SampleRanges: 8, Want: 4}}})
+		require.Nil(t, out.pool)
+		cfg = out.Config()
+		require.Empty(t, cfg.Resolvers)
+		require.True(t, cfg.Discovery.Enabled)
+		require.Equal(t, "ir", cfg.Discovery.Country)
+		require.Equal(t, 8, cfg.Discovery.SampleRanges)
+		require.Equal(t, 4, cfg.Discovery.Want)
+	}
+
+	// resolvers and "auto": the pool for the written ones, discovery besides
+	out = newTestOutbound(t, option.SoarOptions{Domain: testZone, PublicKey: key, Resolvers: []string{"8.8.8.8", "auto"}})
+	require.NotNil(t, out.pool)
+	require.True(t, out.discover)
+	cfg = out.Config()
+	require.Equal(t, []string{out.pool.Addr()}, cfg.Resolvers)
+	require.True(t, cfg.Discovery.Enabled)
+	require.Equal(t, "", cfg.TCP)
+	require.Equal(t, 0, cfg.MaxPathWindow)
+
+	// smart_pool off: every resolver is a path of the client's own
+	out = newTestOutbound(t, option.SoarOptions{Domain: testZone, PublicKey: key, Resolvers: []string{"8.8.8.8", "1.1.1.1:5353", "[2001:db8::1]"}, SmartPool: &option.SmartPoolOptions{}, TCP: "ON", MaxPathWindow: 16})
+	require.Nil(t, out.pool)
+	cfg = out.Config()
+	require.Equal(t, []string{"8.8.8.8:53", "1.1.1.1:5353", "[2001:db8::1]:53"}, cfg.Resolvers)
+	require.False(t, cfg.Discovery.Enabled)
+	require.Equal(t, "on", cfg.TCP)
+	require.Equal(t, 16, cfg.MaxPathWindow)
+}
+
+func TestH_SoarNewOutboundValidation(t *testing.T) {
+	t.Parallel()
+	pub, _ := testKey(t)
+	key := base64.StdEncoding.EncodeToString(pub)
+	off := &option.SmartPoolOptions{}
+	cases := map[string]option.SoarOptions{
+		"domain":       {PublicKey: key},
+		"domain label": {Domain: "t..example.com", PublicKey: key},
+		"key":          {Domain: testZone},
+		"short key":    {Domain: testZone, PublicKey: "AAAA"},
+		"tcp":          {Domain: testZone, PublicKey: key, TCP: "maybe"},
+		"pool quic":    {Domain: testZone, PublicKey: key, Resolvers: []string{"quic://1.1.1.1"}},
+		"no pool doh":  {Domain: testZone, PublicKey: key, Resolvers: []string{"https://dns.google/dns-query"}, SmartPool: off},
+		"no pool bad":  {Domain: testZone, PublicKey: key, Resolvers: []string{"not an ip"}, SmartPool: off},
+	}
+	for name, options := range cases {
+		_, err := NewOutbound(context.Background(), nil, log.NewNOPFactory().Logger(), "soar-out", options)
+		require.Error(t, err, name)
+	}
+}
+
+// startSoarServer runs a Soar server on the loopback whose streams all reach target.
+func startSoarServer(t *testing.T, priv ed25519.PrivateKey, target string) string {
+	t.Helper()
+	pc, err := net.ListenPacket("udp", "127.0.0.1:0")
+	require.NoError(t, err)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_ = soar.Serve(ctx, pc, soar.ServerConfig{
+			Zone:       testZone,
+			PrivateKey: priv,
+			Dial: func(ctx context.Context, network, addr string) (net.Conn, error) {
+				var d net.Dialer
+				return d.DialContext(ctx, "tcp", target)
+			},
+		})
+	}()
+	t.Cleanup(func() {
+		cancel()
+		pc.Close()
+		<-done
+	})
+	return pc.LocalAddr().String()
+}
+
+// startEcho runs a TCP echo server.
+func startEcho(t *testing.T) string {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	t.Cleanup(func() { ln.Close() })
+	go func() {
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				defer conn.Close()
+				_, _ = io.Copy(conn, conn)
+			}()
+		}
+	}()
+	return ln.Addr().String()
+}
+
+// startRelay runs a recursive resolver stand-in: it answers found.test, and forwards every
+// other query to the Soar server, the authority for the tunnel zone.
+func startRelay(t *testing.T, authority string) string {
+	t.Helper()
+	handler := dns.HandlerFunc(func(w dns.ResponseWriter, r *dns.Msg) {
+		if r.Question[0].Name == "found.test." {
+			m := new(dns.Msg)
+			m.SetReply(r)
+			rr, _ := dns.NewRR("found.test. 60 IN A 192.0.2.1")
+			m.Answer = append(m.Answer, rr)
+			_ = w.WriteMsg(m)
+			return
+		}
+		client := &dns.Client{Net: "udp", UDPSize: 4096, Timeout: 3 * time.Second}
+		resp, _, err := client.Exchange(r, authority)
+		if err != nil {
+			return
+		}
+		_ = w.WriteMsg(resp)
+	})
+	pc, err := net.ListenPacket("udp", "127.0.0.1:0")
+	require.NoError(t, err)
+	server := &dns.Server{PacketConn: pc, Handler: handler, UDPSize: 4096}
+	go server.ActivateAndServe()
+	t.Cleanup(func() { server.Shutdown() })
+	return pc.LocalAddr().String()
+}
+
+func echoThrough(t *testing.T, out *Outbound) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	conn, err := out.DialContext(ctx, N.NetworkTCP, M.ParseSocksaddr("example.com:443"))
+	require.NoError(t, err)
+	defer conn.Close()
+	message := []byte("hello through soar")
+	_, err = conn.Write(message)
+	require.NoError(t, err)
+	reply := make([]byte, len(message))
+	require.NoError(t, conn.SetReadDeadline(time.Now().Add(20*time.Second)))
+	_, err = io.ReadFull(conn, reply)
+	require.NoError(t, err)
+	require.Equal(t, message, reply)
+	require.Equal(t, adapter.StatusReady, out.Status())
+}
+
+// The outbound carries a connection through a Soar server, the server as the client's resolver.
+func TestH_SoarEndToEnd(t *testing.T) {
+	t.Parallel()
+	pub, priv := testKey(t)
+	server := startSoarServer(t, priv, startEcho(t))
+	out := newTestOutbound(t, option.SoarOptions{
+		Domain:    testZone,
+		PublicKey: base64.StdEncoding.EncodeToString(pub),
+		Resolvers: []string{server},
+		SmartPool: &option.SmartPoolOptions{},
+	})
+	require.NoError(t, out.PreStart())
+	require.NoError(t, out.PostStart())
+	echoThrough(t, out)
+	require.Contains(t, out.DisplayType(), "1 resolvers")
+}
+
+// The same through the smart pool: the resolver passes the probe and joins the pool, and the
+// client's queries go through it.
+func TestH_SoarEndToEndSmartPool(t *testing.T) {
+	t.Parallel()
+	pub, priv := testKey(t)
+	relay := startRelay(t, startSoarServer(t, priv, startEcho(t)))
+	out := newTestOutbound(t, option.SoarOptions{
+		Domain:        testZone,
+		PublicKey:     base64.StdEncoding.EncodeToString(pub),
+		Resolvers:     []string{"127.0.0.1:1", relay},
+		PreTestDomain: "found.test",
+	})
+	require.NoError(t, out.PreStart())
+	require.NoError(t, out.PostStart())
+	echoThrough(t, out)
+	require.Equal(t, 1, out.PoolResolvers())
+}
+
+// Datagrams to the pool go through the loopback socket, the rest through the outside one, and
+// replies from both are read.
+func TestH_SoarSplitPacketConn(t *testing.T) {
+	t.Parallel()
+	echoUDP := func() *net.UDPConn {
+		conn, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+		require.NoError(t, err)
+		t.Cleanup(func() { conn.Close() })
+		go func() {
+			buffer := make([]byte, 1500)
+			for {
+				n, addr, err := conn.ReadFrom(buffer)
+				if err != nil {
+					return
+				}
+				_ = n
+				_, _ = conn.WriteTo([]byte(addr.String()), addr) // who sent it
+			}
+		}()
+		return conn
+	}
+	pool, other := echoUDP(), echoUDP()
+	var outside net.PacketConn
+	conn, err := newSplitPacketConn(context.Background(), pool.LocalAddr().(*net.UDPAddr), func(ctx context.Context) (net.PacketConn, error) {
+		var err error
+		outside, err = net.ListenPacket("udp", "127.0.0.1:0")
+		return outside, err
+	})
+	require.NoError(t, err)
+	defer conn.Close()
+	require.Equal(t, outside.LocalAddr(), conn.LocalAddr())
+
+	seen := map[string]string{}
+	for _, target := range []*net.UDPConn{pool, other} {
+		_, err := conn.WriteTo([]byte(target.LocalAddr().String()), target.LocalAddr())
+		require.NoError(t, err)
+	}
+	buffer := make([]byte, 1500)
+	for range 2 {
+		require.NoError(t, conn.SetReadDeadline(time.Now().Add(5*time.Second)))
+		n, addr, err := conn.ReadFrom(buffer)
+		require.NoError(t, err)
+		seen[addr.String()] = string(buffer[:n])
+	}
+	// the pool saw the loopback socket, the other resolver the outside one
+	require.NotEmpty(t, seen[pool.LocalAddr().String()])
+	require.NotEqual(t, outside.LocalAddr().String(), seen[pool.LocalAddr().String()])
+	require.Equal(t, outside.LocalAddr().String(), seen[other.LocalAddr().String()])
+
+	require.NoError(t, conn.SetReadDeadline(time.Now().Add(50*time.Millisecond)))
+	_, _, err = conn.ReadFrom(buffer)
+	require.ErrorIs(t, err, os.ErrDeadlineExceeded)
+	require.NoError(t, conn.Close())
+	_, _, err = conn.ReadFrom(buffer)
+	require.ErrorIs(t, err, net.ErrClosed)
+}
diff --git a/protocol/hiddify/soar/logger.go b/protocol/hiddify/soar/logger.go
new file mode 100644
index 0000000000000000000000000000000000000000..cdc2cc6858dd1beecec4c92c20009e637ff79f12
--- /dev/null
+++ b/protocol/hiddify/soar/logger.go
@@ -0,0 +1,61 @@
+package soar
+
+import (
+	"context"
+	"log/slog"
+	"strings"
+
+	"github.com/sagernet/sing/common/logger"
+)
+
+// slogHandler writes the Soar client's slog records to the outbound's logger at the same level,
+// with their attributes as key=value.
+type slogHandler struct {
+	logger logger.ContextLogger
+	attrs  []slog.Attr
+}
+
+func newSlogLogger(l logger.ContextLogger) *slog.Logger {
+	return slog.New(&slogHandler{logger: l})
+}
+
+func (h *slogHandler) Enabled(context.Context, slog.Level) bool {
+	return true
+}
+
+func (h *slogHandler) Handle(ctx context.Context, record slog.Record) error {
+	var b strings.Builder
+	b.WriteString("soar: ")
+	b.WriteString(record.Message)
+	write := func(attr slog.Attr) bool {
+		b.WriteByte(' ')
+		b.WriteString(attr.Key)
+		b.WriteByte('=')
+		b.WriteString(attr.Value.String())
+		return true
+	}
+	for _, attr := range h.attrs {
+		write(attr)
+	}
+	record.Attrs(write)
+	message := b.String()
+	switch {
+	case record.Level >= slog.LevelError:
+		h.logger.ErrorContext(ctx, message)
+	case record.Level >= slog.LevelWarn:
+		h.logger.WarnContext(ctx, message)
+	case record.Level >= slog.LevelInfo:
+		h.logger.InfoContext(ctx, message)
+	default:
+		h.logger.DebugContext(ctx, message)
+	}
+	return nil
+}
+
+func (h *slogHandler) WithAttrs(attrs []slog.Attr) slog.Handler {
+	return &slogHandler{logger: h.logger, attrs: append(append([]slog.Attr(nil), h.attrs...), attrs...)}
+}
+
+func (h *slogHandler) WithGroup(string) slog.Handler {
+	return h
+}
diff --git a/protocol/hiddify/soar/outbound.go b/protocol/hiddify/soar/outbound.go
new file mode 100644
index 0000000000000000000000000000000000000000..ff490beebbb1706e090c0f3838bce8671efa0d0b
--- /dev/null
+++ b/protocol/hiddify/soar/outbound.go
@@ -0,0 +1,471 @@
+// Package soar is the soar outbound: a Soar client (github.com/getlantern/soar) that carries TCP
+// connections inside DNS queries, through recursive resolvers, to a Soar server that is the
+// authority for the tunnel zone.
+//
+// The client keeps one session with the server and multiplexes the connections over it. The
+// resolvers written in the config go through the outbound's smart pool (common/dnspool) by
+// default, which the client sees as one resolver; with smart_pool off the client uses each as a
+// path of its own. "auto", or no resolvers, turns on the client's own resolver discovery (its
+// bundled per-country lists), whose resolvers are paths of their own either way.
+package soar
+
+import (
+	"context"
+	"crypto/ed25519"
+	"encoding/base64"
+	"encoding/hex"
+	"fmt"
+	"net"
+	"net/netip"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/common/dialer"
+	"github.com/sagernet/sing-box/common/dnspool"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+
+	"github.com/getlantern/soar"
+)
+
+const (
+	defaultConnectTimeout = 90 * time.Second
+
+	// poolHistoryKey names the saved resolver scores of the smart pool in the cache file;
+	// discoveryCacheKey the resolvers the client's own discovery found.
+	poolHistoryKey    = "soar_resolvers"
+	discoveryCacheKey = "soar_discovery"
+	// poolMaxResolvers is how many working resolvers the smart pool keeps.
+	poolMaxResolvers = 10
+	// poolProbeConcurrency is how many resolvers are probed at once.
+	poolProbeConcurrency = 100
+)
+
+func RegisterOutbound(registry *outbound.Registry) {
+	outbound.Register[option.SoarOptions](registry, C.TypeSoar, NewOutbound)
+}
+
+var _ adapter.Outbound = (*Outbound)(nil)
+
+type Outbound struct {
+	outbound.Adapter
+	ctx            context.Context
+	logger         logger.ContextLogger
+	tag            string
+	options        option.SoarOptions
+	config         soar.Config
+	connectTimeout time.Duration
+	cache          adapter.CacheFile
+
+	// smart pool: the client's one resolver is the pool, fed with the candidates that pass the probe
+	pool       *dnspool.Pool
+	candidates []dnspool.Candidate
+	discover   bool          // the client's own discovery runs too
+	poolReady  chan struct{} // closed when the first resolver joined the pool
+	poolOnce   sync.Once
+
+	mu        sync.Mutex
+	client    *soar.Client
+	ready     chan struct{} // closed when client is set
+	runCancel context.CancelFunc
+	runDone   chan struct{}
+}
+
+// ParsePublicKey reads the server's Ed25519 public key: base64 as soar-server prints it, with or
+// without padding, base64url, or hex.
+func ParsePublicKey(value string) (ed25519.PublicKey, error) {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return nil, E.New("public_key is required: the server's key, from soar-server pubkey")
+	}
+	for _, encoding := range []*base64.Encoding{base64.StdEncoding, base64.RawStdEncoding, base64.URLEncoding, base64.RawURLEncoding} {
+		if key, err := encoding.DecodeString(value); err == nil && len(key) == ed25519.PublicKeySize {
+			return key, nil
+		}
+	}
+	if key, err := hex.DecodeString(value); err == nil && len(key) == ed25519.PublicKeySize {
+		return key, nil
+	}
+	return nil, E.New("public_key: not a ", ed25519.PublicKeySize, "-byte Ed25519 key in base64 or hex")
+}
+
+// validateZone checks the tunnel zone as far as a config can be checked: a DNS name.
+func validateZone(zone string) error {
+	zone = strings.TrimSuffix(strings.TrimSpace(zone), ".")
+	if zone == "" {
+		return E.New("domain is required: the tunnel zone of your Soar server")
+	}
+	if len(zone) > 200 {
+		return E.New("domain ", strconv.Quote(zone), " is too long to carry data under it")
+	}
+	for label := range strings.SplitSeq(zone, ".") {
+		if label == "" || len(label) > 63 {
+			return E.New("domain ", strconv.Quote(zone), " is not a DNS name")
+		}
+	}
+	return nil
+}
+
+func NewOutbound(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, options option.SoarOptions) (adapter.Outbound, error) {
+	if err := validateZone(options.Domain); err != nil {
+		return nil, err
+	}
+	serverKey, err := ParsePublicKey(options.PublicKey)
+	if err != nil {
+		return nil, err
+	}
+	switch strings.ToLower(options.TCP) {
+	case "", "auto", "on", "only", "off":
+	default:
+		return nil, E.New("tcp must be auto, on, only or off, not ", strconv.Quote(options.TCP))
+	}
+	if options.PreTestDomain == "" {
+		options.PreTestDomain = "www.google.com"
+	}
+	if options.PreTestRecordType == "" {
+		options.PreTestRecordType = "a"
+	}
+	if options.Detour != "" {
+		logger.Warn("soar: detour is not supported, the DNS queries go out directly")
+	}
+	explicit := make([]string, 0, len(options.Resolvers))
+	for _, resolver := range options.Resolvers {
+		if resolver = strings.TrimSpace(resolver); resolver != "" && !strings.EqualFold(resolver, dnspool.AutoResolver) {
+			explicit = append(explicit, resolver)
+		}
+	}
+	// "auto", or no resolvers at all: Soar's own discovery, from its bundled lists
+	discover := len(explicit) == 0 || dnspool.HasAuto(options.Resolvers)
+	// the smart pool (on unless turned off) carries the resolvers written in the config
+	smartPool := options.SmartPool.IsEnabledOr(true) && len(explicit) > 0
+
+	out := &Outbound{
+		Adapter:        outbound.NewAdapterWithDialerOptions(C.TypeSoar, tag, []string{N.NetworkTCP}, options.DialerOptions),
+		ctx:            ctx,
+		logger:         logger,
+		tag:            tag,
+		options:        options,
+		connectTimeout: durationOr(options.ConnectTimeout, defaultConnectTimeout),
+		discover:       discover,
+		poolReady:      make(chan struct{}),
+		ready:          make(chan struct{}),
+	}
+	config := soar.Config{
+		Zone:          strings.TrimSuffix(strings.TrimSpace(options.Domain), "."),
+		ServerKey:     serverKey,
+		SafeQName:     options.SafeQName,
+		MaxQName:      options.MaxQName,
+		Hold:          time.Duration(options.Hold),
+		MaxInflight:   options.MaxInflight,
+		MaxPathWindow: options.MaxPathWindow,
+		MaxAnswer:     options.MaxAnswer,
+		StreamWindow:  uint64(max(options.StreamWindow, 0)),
+		SendBuffer:    options.SendBuffer,
+		MaxStreams:    options.MaxStreams,
+		SessionIdle:   time.Duration(options.SessionIdle),
+		TCP:           strings.ToLower(options.TCP),
+		Logger:        newSlogLogger(logger),
+	}
+
+	// smart_pool.discovery steers it, the same settings as the other DNS tunnels'
+	config.Discovery = dnspool.SoarDiscovery(options.SmartPool.DiscoveryOptions())
+	config.Discovery.Enabled = discover
+	// the resolver sockets go out like any outbound's (bind_interface, routing_mark, the
+	// platform's protect), or on a VPN their queries loop back into the tunnel
+	dialerOptions := options.DialerOptions
+	dialerOptions.Detour = ""
+	defaultDialer, err := dialer.NewDefault(ctx, dialerOptions)
+	if err != nil {
+		return nil, err
+	}
+	listenOutside := func(ctx context.Context) (net.PacketConn, error) {
+		return defaultDialer.ListenPacket(ctx, M.Socksaddr{})
+	}
+	config.ListenPacket = func(ctx context.Context, network, address string) (net.PacketConn, error) {
+		return listenOutside(ctx)
+	}
+	config.DialTCP = func(ctx context.Context, network, address string) (net.Conn, error) {
+		return defaultDialer.DialContext(ctx, N.NetworkTCP, M.ParseSocksaddr(address))
+	}
+
+	if smartPool {
+		candidates := dnspool.Expand(explicit)
+		for _, candidate := range candidates {
+			if err := dnspool.ValidateResolver(candidate.Address); err != nil {
+				return nil, E.Cause(err, "resolver ", strconv.Quote(candidate.Address), ": with smart_pool write host:port, tcp://host:port, dot://host:port, https://host/path or auto")
+			}
+		}
+		dial, err := dnspool.DialFunc(ctx, options.DialerOptions)
+		if err != nil {
+			return nil, err
+		}
+		pool, err := dnspool.StartPool(logger, tag, dnspool.PoolOptionsFrom(options.SmartPool), dial)
+		if err != nil {
+			return nil, err
+		}
+		poolAddr, err := net.ResolveUDPAddr("udp", pool.Addr())
+		if err != nil {
+			_ = pool.Close()
+			return nil, err
+		}
+		out.pool = pool
+		out.candidates = candidates
+		// the client sees the pool as one resolver on the loopback, which reaches the resolvers
+		// (over TCP too) itself; discovered resolvers, if any, are paths of their own. Datagrams
+		// to the pool skip the protected socket, which may be bound to the outside interface.
+		config.Resolvers = []string{pool.Addr()}
+		config.ListenPacket = func(ctx context.Context, network, address string) (net.PacketConn, error) {
+			return newSplitPacketConn(ctx, poolAddr, listenOutside)
+		}
+		if !discover {
+			config.TCP = "off"
+			if config.MaxPathWindow <= 0 {
+				// the client's per-resolver window would cap the whole pool
+				config.MaxPathWindow = max(config.MaxInflight, 128)
+			}
+		}
+		logger.InfoContext(ctx, "soar smart_pool listening on ", pool.Addr())
+	} else {
+		for i, resolver := range explicit {
+			if _, err := netip.ParseAddrPort(withPort(resolver)); err != nil {
+				return nil, E.New("resolver ", strconv.Quote(resolver), ": without smart_pool Soar uses plain resolvers only, write an IP or IP:port")
+			}
+			explicit[i] = withPort(resolver)
+		}
+		config.Resolvers = explicit
+	}
+	out.config = config
+	return out, nil
+}
+
+// orDefault is value, or fallback when value is not set.
+func orDefault(value, fallback int) int {
+	if value > 0 {
+		return value
+	}
+	return fallback
+}
+
+// withPort adds port 53 to a resolver written without one.
+func withPort(resolver string) string {
+	if _, _, err := net.SplitHostPort(resolver); err == nil {
+		return resolver
+	}
+	return net.JoinHostPort(strings.Trim(resolver, "[]"), "53")
+}
+
+func durationOr(value interface{ Build() time.Duration }, fallback time.Duration) time.Duration {
+	if d := value.Build(); d > 0 {
+		return d
+	}
+	return fallback
+}
+
+func (h *Outbound) PreStart() error {
+	h.cache = service.FromContext[adapter.CacheFile](h.ctx)
+	return nil
+}
+
+func (h *Outbound) PostStart() error {
+	config := h.config
+	if config.Discovery.Enabled && h.cache != nil {
+		config.Discovery.Cache = &discoveryCache{cache: h.cache, key: discoveryCacheKey + ":" + h.tag}
+	}
+	client, err := soar.NewClient(config)
+	if err != nil {
+		_ = h.pool.Close()
+		return E.Cause(err, "soar")
+	}
+	runCtx, cancel := context.WithCancel(h.ctx)
+	done := make(chan struct{})
+	h.mu.Lock()
+	h.client = client
+	h.runCancel = cancel
+	h.runDone = done
+	h.mu.Unlock()
+	close(h.ready)
+	go func() {
+		defer close(done)
+		if h.pool != nil {
+			h.fillPool(runCtx)
+		}
+	}()
+	return nil
+}
+
+// fillPool puts the candidate resolvers that answer the probe into the pool, the ones that
+// worked before first, up to poolMaxResolvers working ones, and probes more whenever fewer work.
+func (h *Outbound) fillPool(ctx context.Context) {
+	history := dnspool.LoadHistory(h.cache, poolHistoryKey)
+	history.Sort(h.candidates)
+	qtype := dnspool.QueryType(h.options.PreTestRecordType)
+	discovery := h.options.SmartPool.DiscoveryOptions()
+	added := h.pool.Fill(ctx, h.logger, dnspool.FillOptions{
+		Candidates: h.candidates,
+		Probe: func(ctx context.Context, address string) error {
+			response, err := dnspool.Probe(ctx, h.logger, address, h.options.PreTestDomain, qtype, h.options.DialerOptions)
+			return dnspool.CheckAnswer(address, response, err)
+		},
+		Want:        orDefault(discovery.Want, poolMaxResolvers),
+		Concurrency: orDefault(discovery.Concurrency, poolProbeConcurrency),
+		Pace:        discovery.Pace.Build(),
+		History:     history,
+		Cache:       h.cache,
+		HistoryKey:  poolHistoryKey,
+		OnFirst:     func() { h.poolOnce.Do(func() { close(h.poolReady) }) },
+	})
+	if ctx.Err() == nil && added == 0 {
+		h.logger.ErrorContext(ctx, "soar: none of the ", len(h.candidates), " resolvers answered the probe")
+	}
+}
+
+// PoolResolvers is the number of resolvers in the smart pool, 0 without one.
+func (h *Outbound) PoolResolvers() int {
+	if h.pool == nil {
+		return 0
+	}
+	return len(h.pool.Manager().Resolvers())
+}
+
+// Config is the Soar client configuration in use.
+func (h *Outbound) Config() soar.Config {
+	return h.config
+}
+
+func (h *Outbound) currentClient() *soar.Client {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return h.client
+}
+
+// Status is ready once the session with the server is up; the client opens it at the first
+// connection and again after it ends, so it never reports failed.
+func (h *Outbound) Status() adapter.Status {
+	if client := h.currentClient(); client != nil && client.Established() {
+		return adapter.StatusReady
+	}
+	return adapter.StatusConnecting
+}
+
+// verifiedPaths is the number of resolvers that carried an authenticated answer.
+func verifiedPaths(client *soar.Client) int {
+	n := 0
+	for _, stat := range client.PathStats() {
+		if stat.Verified && !stat.Suspended {
+			n++
+		}
+	}
+	return n
+}
+
+// waitClient waits for the client (started in PostStart) and, when the pool is its only way
+// out, for the pool's first resolver.
+func (h *Outbound) waitClient(ctx context.Context) (*soar.Client, error) {
+	select {
+	case <-h.ready:
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+	if h.pool != nil && !h.discover {
+		select {
+		case <-h.poolReady:
+		case <-ctx.Done():
+			return nil, E.New("no resolver answered the probe yet: ", h.PoolResolvers(), " of ", len(h.candidates), " in the pool")
+		}
+	}
+	return h.currentClient(), nil
+}
+
+func (h *Outbound) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	switch N.NetworkName(network) {
+	case N.NetworkTCP:
+	default:
+		return nil, E.New("network ", network, " not supported by soar")
+	}
+	dialCtx, cancel := context.WithTimeout(ctx, h.connectTimeout)
+	defer cancel()
+	client, err := h.waitClient(dialCtx)
+	if err != nil {
+		return nil, E.Cause(err, "soar connect to ", destination)
+	}
+	if client == nil {
+		return nil, E.New("outbound is closed")
+	}
+	ctx, metadata := adapter.ExtendContext(ctx)
+	metadata.Outbound = h.Tag()
+	metadata.Destination = destination
+	h.logger.InfoContext(ctx, "outbound connection to ", destination)
+	conn, err := client.DialContext(dialCtx, N.NetworkTCP, destination.String())
+	if err != nil {
+		return nil, E.Cause(err, "soar connect to ", destination)
+	}
+	return conn, nil
+}
+
+func (h *Outbound) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	return nil, E.New("UDP is not supported by soar")
+}
+
+func (h *Outbound) DisplayType() string {
+	// the status is shown on its own; the resolvers in use are not, also while connecting
+	str := C.ProxyDisplayName(h.Type())
+	active := h.PoolResolvers()
+	if client := h.currentClient(); client != nil {
+		active += verifiedPaths(client)
+	}
+	if active == 0 {
+		return str
+	}
+	return fmt.Sprint(str, " · ", active, " resolvers")
+}
+
+func (h *Outbound) Close() error {
+	h.mu.Lock()
+	cancel := h.runCancel
+	done := h.runDone
+	client := h.client
+	h.runCancel = nil
+	h.client = nil
+	h.mu.Unlock()
+	if cancel != nil {
+		cancel()
+		select {
+		case <-done:
+		case <-time.After(3 * time.Second):
+			h.logger.Warn("soar resolver pool did not stop in time")
+		}
+	}
+	if client != nil {
+		_ = client.Close()
+	}
+	return h.pool.Close()
+}
+
+// discoveryCache keeps the resolvers the client's discovery verified in the cache file, so the
+// next start tries them first.
+type discoveryCache struct {
+	cache adapter.CacheFile
+	key   string
+}
+
+func (c *discoveryCache) Load() []string {
+	saved := c.cache.LoadBinary(c.key)
+	if saved == nil || len(saved.Content) == 0 {
+		return nil
+	}
+	return strings.Split(string(saved.Content), "\n")
+}
+
+func (c *discoveryCache) Store(resolvers []string) {
+	_ = c.cache.SaveBinary(c.key, &adapter.SavedBinary{LastUpdated: time.Now(), Content: []byte(strings.Join(resolvers, "\n"))})
+}
diff --git a/protocol/hiddify/soar/split_conn.go b/protocol/hiddify/soar/split_conn.go
new file mode 100644
index 0000000000000000000000000000000000000000..5cef760f276d361e44c8780e9f3df4950c3b9d53
--- /dev/null
+++ b/protocol/hiddify/soar/split_conn.go
@@ -0,0 +1,144 @@
+package soar
+
+import (
+	"context"
+	"net"
+	"os"
+	"sync"
+	"time"
+)
+
+// splitPacketConn is the Soar client's one UDP socket when it has the smart pool and discovered
+// resolvers at once: datagrams to the pool go through a plain loopback socket, the rest through
+// the outbound's protected socket, which may be bound to the outside interface and so unable to
+// reach the loopback. Reads come from both.
+type splitPacketConn struct {
+	pool    *net.UDPAddr
+	local   net.PacketConn // to the pool
+	outside net.PacketConn // to the resolvers
+
+	packets   chan packet
+	done      chan struct{}
+	closeOnce sync.Once
+
+	deadlineMu sync.Mutex
+	deadlineCh chan struct{} // replaced on every SetReadDeadline, closed when it passes
+}
+
+type packet struct {
+	data []byte
+	addr net.Addr
+	err  error
+}
+
+func newSplitPacketConn(ctx context.Context, pool *net.UDPAddr, listenOutside func(context.Context) (net.PacketConn, error)) (net.PacketConn, error) {
+	var lc net.ListenConfig
+	local, err := lc.ListenPacket(ctx, "udp", net.JoinHostPort(pool.IP.String(), "0"))
+	if err != nil {
+		return nil, err
+	}
+	outside, err := listenOutside(ctx)
+	if err != nil {
+		local.Close()
+		return nil, err
+	}
+	c := &splitPacketConn{
+		pool:       pool,
+		local:      local,
+		outside:    outside,
+		packets:    make(chan packet, 64),
+		done:       make(chan struct{}),
+		deadlineCh: make(chan struct{}),
+	}
+	go c.readLoop(local)
+	go c.readLoop(outside)
+	return c, nil
+}
+
+func (c *splitPacketConn) readLoop(conn net.PacketConn) {
+	for {
+		buffer := make([]byte, 65535)
+		n, addr, err := conn.ReadFrom(buffer)
+		select {
+		case c.packets <- packet{data: buffer[:n], addr: addr, err: err}:
+		case <-c.done:
+			return
+		}
+		if err != nil {
+			return
+		}
+	}
+}
+
+func (c *splitPacketConn) ReadFrom(p []byte) (int, net.Addr, error) {
+	select { // closed is closed, even with a deadline that passed too
+	case <-c.done:
+		return 0, nil, net.ErrClosed
+	default:
+	}
+	c.deadlineMu.Lock()
+	deadlineCh := c.deadlineCh
+	c.deadlineMu.Unlock()
+	select {
+	case pk := <-c.packets:
+		if pk.err != nil {
+			return 0, nil, pk.err
+		}
+		return copy(p, pk.data), pk.addr, nil
+	case <-deadlineCh:
+		return 0, nil, os.ErrDeadlineExceeded
+	case <-c.done:
+		return 0, nil, net.ErrClosed
+	}
+}
+
+func (c *splitPacketConn) WriteTo(p []byte, addr net.Addr) (int, error) {
+	if udpAddr, ok := addr.(*net.UDPAddr); ok && udpAddr.IP.Equal(c.pool.IP) && udpAddr.Port == c.pool.Port {
+		return c.local.WriteTo(p, addr)
+	}
+	return c.outside.WriteTo(p, addr)
+}
+
+func (c *splitPacketConn) Close() error {
+	c.closeOnce.Do(func() {
+		close(c.done)
+		c.local.Close()
+		c.outside.Close()
+	})
+	return nil
+}
+
+func (c *splitPacketConn) LocalAddr() net.Addr {
+	return c.outside.LocalAddr()
+}
+
+func (c *splitPacketConn) SetDeadline(t time.Time) error {
+	_ = c.SetWriteDeadline(t)
+	return c.SetReadDeadline(t)
+}
+
+func (c *splitPacketConn) SetReadDeadline(t time.Time) error {
+	c.deadlineMu.Lock()
+	defer c.deadlineMu.Unlock()
+	ch := make(chan struct{})
+	c.deadlineCh = ch
+	if !t.IsZero() {
+		if wait := time.Until(t); wait <= 0 {
+			close(ch)
+		} else {
