diff --git a/third_party/xray-core/common/protocol/time.go b/third_party/xray-core/common/protocol/time.go
new file mode 100644
index 0000000000000000000000000000000000000000..195496ed457fb04283faf0dc72800181fb9d2a1a
--- /dev/null
+++ b/third_party/xray-core/common/protocol/time.go
@@ -0,0 +1,22 @@
+package protocol
+
+import (
+	"time"
+
+	"github.com/xtls/xray-core/common/dice"
+)
+
+type Timestamp int64
+
+type TimestampGenerator func() Timestamp
+
+func NowTime() Timestamp {
+	return Timestamp(time.Now().Unix())
+}
+
+func NewTimestampGenerator(base Timestamp, delta int) TimestampGenerator {
+	return func() Timestamp {
+		rangeInDelta := dice.Roll(delta*2) - delta
+		return base + Timestamp(rangeInDelta)
+	}
+}
