+	for _, sigScheme := range signatureAlgorithms.Algorithms {
+		if sigScheme == "GREASE" {
+			e.SupportedSignatureAlgorithms = append(e.SupportedSignatureAlgorithms, GREASE_PLACEHOLDER)
+			continue
+		}
