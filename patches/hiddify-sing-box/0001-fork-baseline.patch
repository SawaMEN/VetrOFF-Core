+
+func TestFileLogger(t *testing.T) {
+	f, err := os.CreateTemp("", "vtest")
+	common.Must(err)
+	path := f.Name()
+	common.Must(f.Close())
+	defer os.Remove(path)
+
+	creator, err := CreateFileLogWriter(path)
+	common.Must(err)
