+++ b/common/dnspool/pool.go
@@ -0,0 +1,251 @@
+package dnspool
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"runtime"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/sagernet/sing-box/common/dialer"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+
+	multidns "github.com/hiddify/hmrd_multi_resolver_dns"
+)
+
+// PoolOptions tune a resolver pool, from an outbound's smart_pool block. Zero values take the
+// pool's defaults: a 5 s deadline, 2 s per try (less once a resolver's latency is known), a 5 s
+// probe interval, down after 8 failures, auto load balancing.
+type PoolOptions struct {
+	LoadBalance   string // roundrobin, weighted or lowest_latency
+	Deadline      time.Duration
+	PerAttempt    time.Duration
+	ProbeInterval time.Duration
+	DownAfter     int
+	Duplicate     int // resolvers each query is sent to, copies included (see multidns.Options)
+	// FailFast answers a query that finds every resolver at its rate cap with SERVFAIL at once
+	// instead of holding it up to 300 ms for a token (multidns.Options.PacingMaxWait). For a
+	// tunnel whose client times its own retransmissions by the round trip (DNSTT's KCP) a held
+	// query inflates the round trip and shrinks its window; a failed one is retransmitted.
+	FailFast bool
+}
+
+// PoolOptionsFrom reads an outbound's smart_pool block; nil means the defaults.
+func PoolOptionsFrom(options *option.SmartPoolOptions) PoolOptions {
+	if options == nil {
+		return PoolOptions{}
+	}
+	return PoolOptions{
+		LoadBalance:   options.LoadBalance,
+		Deadline:      time.Duration(options.Deadline),
+		PerAttempt:    time.Duration(options.PerAttempt),
+		ProbeInterval: time.Duration(options.ProbeInterval),
+		DownAfter:     options.DownAfter,
+		Duplicate:     options.Duplicate,
+	}
+}
+
+func managerOptions(logger log.ContextLogger, tag string, options PoolOptions) multidns.Options {
+	return multidns.Options{
+		DefaultDeadline:        options.Deadline,
+		DefaultResolverTimeout: options.PerAttempt,
+		ProbeInterval:          options.ProbeInterval,
+		DownAfterFailures:      options.DownAfter,
+		LoadBalance:            LBFromString(options.LoadBalance),
+		PacingMaxWait:          pacingMaxWait(options.FailFast),
+		Logger:                 NewLoggerAdapter(logger, tag),
+	}
+}
+
+// pacingMaxWait is multidns' wait for capacity: its default, or none.
+func pacingMaxWait(failFast bool) time.Duration {
+	if failFast {
+		return -1
+	}
+	return 0
+}
+
+// DialFunc returns the dial function the pool's resolver sockets use: a
+// sing-box default dialer with the outbound's dialer options, so
+// bind_interface, routing_mark and the platform's socket protection apply
+// and, on a VPN, the queries do not loop back into the tunnel.
+func DialFunc(ctx context.Context, dialerOptions option.DialerOptions) (multidns.DialFunc, error) {
+	dialerOptions.Detour = ""
+	d, err := dialer.NewDefault(ctx, dialerOptions)
+	if err != nil {
+		return nil, err
+	}
+	return func(ctx context.Context, network, address string) (net.Conn, error) {
+		return d.DialContext(ctx, network, M.ParseSocksaddr(address))
+	}, nil
+}
+
+// Pool is an outbound's own resolver pool, with a local DNS listener on 127.0.0.1: the DNS
+// tunnel points at Addr() as its one resolver, and the pool spreads the queries over the
+// resolvers added to it, slows down for one that rate-limits and skips one that stops answering.
+// Each outbound runs its own.
+type Pool struct {
+	manager *multidns.Manager
+	addr    string
+	dial    multidns.DialFunc
+}
+
+// StartPool starts a pool listening on a free local port. It is bound when this returns. dial,
+// when set, opens every resolver socket (see DialFunc).
+func StartPool(logger log.ContextLogger, tag string, options PoolOptions, dial multidns.DialFunc) (*Pool, error) {
+	manager, addr, err := startLocalWithRetry(managerOptions(logger, tag, options), multidns.StartLocal)
+	if err != nil {
+		return nil, E.Cause(err, "start resolver pool")
+	}
+	return &Pool{manager: manager, addr: addr, dial: dial}, nil
+}
+
+// The resolver library reserves a UDP port before binding TCP on the same
+// port. Another listener can claim it in between; on Windows, a UDP ephemeral
+// port may also fall into a TCP-excluded range (WSAEACCES / 10013). Since each
+// new attempt gets a fresh ephemeral port, retry only these bind errors.
+func startLocalWithRetry(options multidns.Options, start func(multidns.Options) (*multidns.Manager, string, error)) (*multidns.Manager, string, error) {
+	const (
+		busyPortAttempts            = 5
+		windowsExcludedPortAttempts = 256
+	)
+	for attempt := range windowsExcludedPortAttempts {
+		manager, addr, err := start(options)
+		if err == nil {
+			return manager, addr, nil
+		}
+		busyPort := errors.Is(err, syscall.EADDRINUSE) && attempt+1 < busyPortAttempts
+		excludedPort := windowsExcludedTCPPort(err) && attempt+1 < windowsExcludedPortAttempts
+		if !busyPort && !excludedPort {
+			return manager, addr, err
+		}
+		// Bound the retry delay even if the excluded Windows port range is large.
+		time.Sleep(time.Duration(min(attempt+1, 5)) * time.Millisecond)
+	}
+	panic("unreachable")
+}
+
+// Windows can reject a TCP bind to a UDP-selected ephemeral port with 10013.
+// Do not retry unrelated permission errors or failed UDP binds.
+func windowsExcludedTCPPort(err error) bool {
+	if runtime.GOOS != "windows" || !errors.Is(err, syscall.Errno(10013)) {
+		return false
+	}
+	var opErr *net.OpError
+	return errors.As(err, &opErr) && opErr.Op == "listen" && opErr.Net == "tcp"
+}
+
+// Addr is the local "127.0.0.1:port" the tunnel sends its queries to.
+func (p *Pool) Addr() string {
+	return p.addr
+}
+
+// Add puts a resolver in the pool: "1.1.1.1:53" or "1.1.1.1" (UDP), "udp://", "tcp://",
+// "dot://host:853" or "https://host/dns-query".
+func (p *Pool) Add(resolver string) error {
+	config, err := multidns.ParseResolverURL(resolver)
+	if err != nil {
+		return err
+	}
+	config.Dialer = p.dial
+	_, err = p.manager.AddResolver(config)
+	return err
+}
+
+// Manager gives access to the pool's manager, for statistics.
+func (p *Pool) Manager() *multidns.Manager {
+	return p.manager
+}
+
+// Close stops the listener and the pool.
+func (p *Pool) Close() error {
+	if p == nil || p.manager == nil {
+		return nil
+	}
+	return p.manager.Close()
+}
+
+// ValidateResolver checks that a resolver is written in a form the pool accepts: "host:port" or
+// "host" (UDP), "udp://", "tcp://", "dot://host:853" or "https://host/dns-query".
+func ValidateResolver(address string) error {
+	config, err := multidns.ParseResolverURL(address)
+	if err != nil {
+		return err
+	}
+	if config.Protocol == multidns.ProtoDoH {
+		return nil
+	}
+	host, _, err := net.SplitHostPort(config.Address)
+	if err != nil {
+		return E.Cause(err, "resolver ", address)
+	}
+	if host == "" || strings.ContainsAny(host, "/ ") {
+		return E.New("resolver ", address, ": not a host or IP")
+	}
+	return nil
+}
+
+// ProtocolFromString reads an upstream type: udp (also ""), tcp, tls or dot, https or doh.
+func ProtocolFromString(s string) (multidns.Protocol, error) {
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "udp", "":
+		return multidns.ProtoUDP, nil
+	case "tcp":
+		return multidns.ProtoTCP, nil
+	case "tls", "dot":
+		return multidns.ProtoDoT, nil
+	case "https", "doh":
+		return multidns.ProtoDoH, nil
+	default:
+		return "", fmt.Errorf("unsupported upstream type %q (want udp|tcp|tls|https)", s)
+	}
+}
+
+// LBFromString reads a load balance strategy. Empty and unknown values mean auto: each query
+// goes to the resolver with the most spare capacity, within the rate each one is learned to take.
+func LBFromString(s string) multidns.LBStrategy {
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "roundrobin", "round_robin", "round-robin":
+		return multidns.LBRoundRobin
+	case "weighted":
+		return multidns.LBWeighted
+	case "lowest_latency", "lowest-latency":
+		return multidns.LBLowestLatency
+	default:
+		return multidns.LBAuto
+	}
+}
+
+// LoggerAdapter bridges sing-box's logger to the pool's printf-style logger, with a tag prefix so
+// the lines of each pool can be told apart.
+type LoggerAdapter struct {
+	logger log.ContextLogger
+	tag    string
+}
+
+// NewLoggerAdapter returns the pool logger for a sing-box logger.
+func NewLoggerAdapter(logger log.ContextLogger, tag string) *LoggerAdapter {
+	return &LoggerAdapter{logger: logger, tag: tag}
+}
+
+func (l *LoggerAdapter) Debugf(format string, args ...any) {
+	l.logger.Debug(l.tag, ": ", fmt.Sprintf(format, args...))
+}
+
+func (l *LoggerAdapter) Infof(format string, args ...any) {
+	l.logger.Info(l.tag, ": ", fmt.Sprintf(format, args...))
+}
+
+func (l *LoggerAdapter) Warnf(format string, args ...any) {
+	l.logger.Warn(l.tag, ": ", fmt.Sprintf(format, args...))
+}
+
+func (l *LoggerAdapter) Errorf(format string, args ...any) {
+	l.logger.Error(l.tag, ": ", fmt.Sprintf(format, args...))
+}
diff --git a/common/dnspool/probe.go b/common/dnspool/probe.go
new file mode 100644
index 0000000000000000000000000000000000000000..6f33954062ab25aa90571194fb9e07047572dfbf
--- /dev/null
+++ b/common/dnspool/probe.go
@@ -0,0 +1,138 @@
+package dnspool
+
+import (
+	"context"
+	"net"
+	"net/url"
+	"strconv"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/dns/transport"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+
+	multidns "github.com/hiddify/hmrd_multi_resolver_dns"
+	mDNS "github.com/miekg/dns"
+)
+
+// ProbeTimeout is how long one probe may take.
+const ProbeTimeout = 5 * time.Second
+
+// QueryType reads a record type name (a, aaaa, cname, mx, ns, ptr, soa, srv, txt); anything else
+// is A.
+func QueryType(record string) uint16 {
+	switch record {
+	case "a":
+		return mDNS.TypeA
+	case "aaaa":
+		return mDNS.TypeAAAA
+	case "cname":
+		return mDNS.TypeCNAME
+	case "mx":
+		return mDNS.TypeMX
+	case "ns":
+		return mDNS.TypeNS
+	case "ptr":
+		return mDNS.TypePTR
+	case "soa":
+		return mDNS.TypeSOA
+	case "srv":
+		return mDNS.TypeSRV
+	case "txt":
+		return mDNS.TypeTXT
+	default:
+		return mDNS.TypeA
+	}
+}
+
+// BuildQuery builds a recursive query for name and qtype.
+func BuildQuery(name string, qtype uint16) *mDNS.Msg {
+	m := new(mDNS.Msg)
+	m.SetQuestion(mDNS.Fqdn(name), qtype)
+	m.RecursionDesired = true
+	return m
+}
+
+// Probe sends one ordinary query for name to a resolver and returns the answer. It is the check
+// a tunnel runs before it uses a resolver: a resolver that does not answer a normal query will
+// not carry a tunnel either. The resolver is written as the pool reads it ("1.1.1.1:53",
+// "tcp://...", "dot://host:853", "https://host/dns-query"); the query uses sing-box's DNS
+// transports with the given dialer options, so bind_interface and the platform's socket
+// protection apply.
+func Probe(ctx context.Context, logger log.ContextLogger, resolver string, name string, qtype uint16, dialerOptions option.DialerOptions) (*mDNS.Msg, error) {
+	config, err := multidns.ParseResolverURL(resolver)
+	if err != nil {
+		return nil, err
+	}
+	local := option.RawLocalDNSServerOptions{DialerOptions: dialerOptions}
+	var trans adapter.DNSTransport
+	switch config.Protocol {
+	case multidns.ProtoDoH:
+		u, err := url.Parse(config.Address)
+		if err != nil {
+			return nil, err
+		}
+		port := uint16(443)
+		if p := u.Port(); p != "" {
+			n, err := strconv.ParseUint(p, 10, 16)
+			if err != nil {
+				return nil, E.Cause(err, "resolver port")
+			}
+			port = uint16(n)
+		}
+		trans, err = transport.NewHTTPS(ctx, logger, "probe", option.RemoteHTTPSDNSServerOptions{
+			RawLocalDNSServerOptions: local,
+			Server:                   u.Hostname(), ServerPort: port,
+			Path: u.Path,
+		})
+		if err != nil {
+			return nil, err
+		}
+	default:
+		host, portStr, err := net.SplitHostPort(config.Address)
+		if err != nil {
+			return nil, err
+		}
+		n, err := strconv.ParseUint(portStr, 10, 16)
+		if err != nil {
+			return nil, E.Cause(err, "resolver port")
+		}
+		remote := option.RemoteDNSServerOptions{
+			RawLocalDNSServerOptions: local,
+			Server:                   host, ServerPort: uint16(n),
+		}
+		switch config.Protocol {
+		case multidns.ProtoTCP:
+			trans, err = transport.NewTCP(ctx, logger, "probe", remote)
+		case multidns.ProtoDoT:
+			trans, err = transport.NewTLS(ctx, logger, "probe", option.RemoteTLSDNSServerOptions{RemoteDNSServerOptions: remote})
+		default:
+			trans, err = transport.NewUDP(ctx, logger, "probe", remote)
+		}
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	scope := adapter.NewScope(ctx, logger) // the transport lives only for this query
+	defer scope.Close()
+	if err := scope.Start("dns/probe", trans, adapter.StartStateStart); err != nil {
+		return nil, err
+	}
+	queryCtx, cancel := context.WithTimeout(ctx, ProbeTimeout)
+	defer cancel()
+	return trans.Exchange(queryCtx, BuildQuery(name, qtype))
+}
+
+// CheckAnswer is the probe's verdict: an error when the answer is missing or empty.
+func CheckAnswer(resolver string, response *mDNS.Msg, err error) error {
+	if err != nil {
+		return err
+	}
+	if response == nil || len(response.Answer) == 0 {
+		return E.New("no record in the answer of resolver ", resolver)
+	}
+	return nil
+}
diff --git a/common/dnspool/resolvers.go b/common/dnspool/resolvers.go
new file mode 100644
index 0000000000000000000000000000000000000000..03b5c3dfbee1044f24fabd644762c43935a4e907
--- /dev/null
+++ b/common/dnspool/resolvers.go
@@ -0,0 +1,143 @@
+// Package dnspool is what the DNS tunnel outbounds share: the built-in list of public resolvers,
+// the saved score of each resolver, a plain DNS probe that tells whether a resolver answers, and
+// the resolver pool (github.com/hiddify/hmrd_multi_resolver_dns) each outbound runs for itself
+// to spread its queries over many resolvers. The dnstt, masterdns and soar outbounds are built on it,
+// so every DNS tunnel has the same resolver handling and the same smart_pool options.
+package dnspool
+
+import (
+	_ "embed"
+	"encoding/json"
+	"strings"
+	"sync"
+
+	"github.com/sagernet/sing-box/option"
+
+	"github.com/getlantern/soar"
+)
+
+//go:embed resolvers_by_country.json
+var builtinResolversJSON []byte
+
+var (
+	loadBuiltin = sync.OnceFunc(func() {
+		_ = json.Unmarshal(builtinResolversJSON, &countryResolvers)
+		resolverCountry = make(map[string]string)
+		for country, resolvers := range countryResolvers {
+			for _, resolver := range resolvers {
+				resolverCountry[resolver] = country
+			}
+		}
+	})
+	countryResolvers map[string][]string
+	resolverCountry  map[string]string
+)
+
+// AutoResolver is the resolver entry that stands for the built-in list; an empty entry means
+// the same.
+const AutoResolver = "auto"
+
+// BuiltinResolvers returns the built-in public resolvers by IP, with the country of each. The
+// list is loaded once, on first use.
+func BuiltinResolvers() map[string]string {
+	loadBuiltin()
+	return resolverCountry
+}
+
+// BuiltinResolversByCountry returns the built-in public resolvers grouped by country code.
+func BuiltinResolversByCountry() map[string][]string {
+	loadBuiltin()
+	return countryResolvers
+}
+
+// Country returns the country code of a built-in resolver IP, or "".
+func Country(ip string) string {
+	loadBuiltin()
+	return resolverCountry[ip]
+}
+
+// The tiers of "auto" candidates, the order History.Sort keeps among equal scores: the
+// candidates of Soar's discovery, then the built-in list.
+const (
+	TierDiscovery = iota
+	TierBuiltin
+)
+
+// Candidate is one resolver an outbound may use: the address as the pool and the probe read it
+// ("1.1.1.1:53", "dot://1.1.1.1:853", "https://dns.google/dns-query"), whether it came from
+// "auto", and for those, its tier.
+type Candidate struct {
+	Address string
+	Auto    bool
+	Tier    int
+}
+
+// Expand reads an outbound's resolver entries with the default discovery.
+func Expand(entries []string) []Candidate {
+	return ExpandWith(entries, option.ResolverDiscoveryOptions{})
+}
+
+// ExpandWith reads an outbound's resolver entries. "auto" and "" add, once, the candidates of
+// Soar's discovery for the discovery settings (the device's own resolvers, the country's bundled
+// list, global public resolvers, sampled addresses of the country's ranges), then every built-in
+// resolver on port 53; every other entry is kept as written. Entries are trimmed; nothing is
+// validated here, each tunnel checks the forms it supports.
+func ExpandWith(entries []string, discovery option.ResolverDiscoveryOptions) []Candidate {
+	var candidates []Candidate
+	autoAdded := false
+	for _, entry := range entries {
+		entry = strings.TrimSpace(entry)
+		if entry == "" || strings.EqualFold(entry, AutoResolver) {
+			if !autoAdded {
+				autoAdded = true
+				candidates = append(candidates, autoCandidates(discovery)...)
+			}
+			continue
+		}
+		candidates = append(candidates, Candidate{Address: entry})
+	}
+	return candidates
+}
+
+// autoCandidates is what "auto" stands for, each address once.
+func autoCandidates(discovery option.ResolverDiscoveryOptions) []Candidate {
+	seen := make(map[string]bool)
+	var candidates []Candidate
+	add := func(address string, tier int) {
+		if !seen[address] {
+			seen[address] = true
+			candidates = append(candidates, Candidate{Address: address, Auto: true, Tier: tier})
+		}
+	}
+	for _, address := range SoarDiscovery(discovery).List() {
+		add(address, TierDiscovery)
+	}
+	for ip := range BuiltinResolvers() {
+		add(ip+":53", TierBuiltin)
+	}
+	return candidates
+}
+
+// SoarDiscovery is a Soar discovery configuration for the discovery settings, unset ones left to
+// Soar's defaults.
+func SoarDiscovery(discovery option.ResolverDiscoveryOptions) soar.Discovery {
+	return soar.Discovery{
+		Enabled:      true,
+		Country:      discovery.Country,
+		SampleRanges: discovery.SampleRanges,
+		Want:         discovery.Want,
+		Concurrency:  discovery.Concurrency,
+		Pace:         discovery.Pace.Build(),
+	}
+}
+
+// HasAuto reports whether the entries ask for the built-in list.
+func HasAuto(entries []string) bool {
+	for _, entry := range entries {
+		entry = strings.TrimSpace(entry)
+		if entry == "" || strings.EqualFold(entry, AutoResolver) {
+			return true
+		}
+	}
+	return false
+}
