+		if err := s.sendUDP(make([]byte, 100), netip.MustParseAddrPort(test.src), netip.MustParseAddrPort(test.dst)); err == nil {
+			t.Fatal("no error with an MTU of ", test.mtu)
+		}
+	}
+}
