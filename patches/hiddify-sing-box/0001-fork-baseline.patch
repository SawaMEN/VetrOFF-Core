+type fakeCookieProvider struct {
+	mu  sync.Mutex
+	jar map[string]string
+}
+
+func (f *fakeCookieProvider) FetchCookies() (map[string]string, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
