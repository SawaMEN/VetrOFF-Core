+func singlePeer(peers []option.AwgPeerOptions) netip.AddrPort {
+	if len(peers) != 1 || peers[0].Port == 0 {
+		return netip.AddrPort{}
+	}
+	address, err := netip.ParseAddr(peers[0].Address)
+	if err != nil {
+		return netip.AddrPort{}
+	}
+	return netip.AddrPortFrom(address, peers[0].Port)
+}
