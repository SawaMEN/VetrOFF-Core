+)
+
+// writeRecorder records each Write that reaches it.
+type writeRecorder struct {
+	net.Conn
+	mu     sync.Mutex
+	writes [][]byte
+}
+
+func (r *writeRecorder) Write(p []byte) (int, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.writes = append(r.writes, append([]byte(nil), p...))
+	return len(p), nil
+}
+
+func (r *writeRecorder) Close() error { return nil }
+
+func (r *writeRecorder) recorded() [][]byte {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return append([][]byte(nil), r.writes...)
+}
+
+// The merge mask holds quick writes and sends them as one, times times; then writes pass through.
+func TestH_FinalMaskMerge(t *testing.T) {
+	masks, err := Build(parseOptions(t, `{"tcp":[{"type":"merge","settings":{"times":1,"delayMs":30,"maxBytes":16384}}]}`))
+	require.NoError(t, err)
+	recorder := &writeRecorder{}
+	conn, err := wrapTCP(masks, recorder)
+	require.NoError(t, err)
+
+	conn.Write([]byte("hello "))
+	conn.Write([]byte("world"))
+	require.Empty(t, recorder.recorded(), "held until the idle time")
+	require.Eventually(t, func() bool { return len(recorder.recorded()) == 1 }, time.Second, 5*time.Millisecond)
+	require.Equal(t, "hello world", string(recorder.recorded()[0]))
+
+	conn.Write([]byte("later"))
+	require.Len(t, recorder.recorded(), 2, "the budget is spent: straight through")
+
+	// maxBytes flushes at once; Close sends what is held
+	masks, err = Build(parseOptions(t, `{"tcp":[{"type":"merge","settings":{"times":0,"maxBytes":4}}]}`))
+	require.NoError(t, err)
+	recorder = &writeRecorder{}
+	conn, _ = wrapTCP(masks, recorder)
+	conn.Write([]byte("abcdef"))
+	require.Equal(t, [][]byte{[]byte("abcdef")}, recorder.recorded())
+	conn.Write([]byte("x"))
+	require.NoError(t, conn.Close())
+	require.Equal(t, "x", string(recorder.recorded()[1]))
+
+	_, err = Build(parseOptions(t, `{"tcp":[{"type":"merge","settings":{"delayMs":-1}}]}`))
+	require.Error(t, err)
+}
+
+// The oob mask sends the first writes with an urgent byte; the server's TCP stack takes it out of
+// the stream, so the server reads exactly what was written.
+func TestH_FinalMaskOOB(t *testing.T) {
+	masks, err := Build(parseOptions(t, `{"tcp":[{"type":"oob","settings":{"bytes":[0,65]}}]}`))
+	require.NoError(t, err)
+
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer listener.Close()
+	received := make(chan []byte, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		data, _ := io.ReadAll(conn)
+		received <- data
+	}()
+
+	raw, err := net.Dial("tcp", listener.Addr().String())
+	require.NoError(t, err)
+	conn, err := wrapTCP(masks, raw)
+	require.NoError(t, err)
+	for _, part := range []string{"first ", "second ", "third"} {
+		n, err := conn.Write([]byte(part))
+		require.NoError(t, err)
+		require.Equal(t, len(part), n, "the urgent byte is not counted")
+		time.Sleep(20 * time.Millisecond) // separate segments
+	}
+	require.NoError(t, conn.Close())
+	select {
+	case data := <-received:
+		require.Equal(t, "first second third", string(data))
+	case <-time.After(3 * time.Second):
+		t.Fatal("nothing received")
+	}
+
+	// a connection that is not a socket is left as it is
+	recorder := &writeRecorder{}
+	conn, _ = wrapTCP(masks, recorder)
+	conn.Write([]byte("plain"))
+	require.Equal(t, "plain", string(recorder.recorded()[0]))
+
+	for _, settings := range []string{`{}`, `{"bytes":[]}`, `{"bytes":[256]}`, `{"bytes":[-1]}`} {
+		_, err := Build(parseOptions(t, `{"tcp":[{"type":"oob","settings":`+settings+`}]}`))
+		require.Error(t, err, settings)
+	}
+	_, err = Build(parseOptions(t, `{"udp":[{"type":"oob","settings":{"bytes":[0]}}]}`))
+	require.Error(t, err, "oob is a tcp mask")
+}
diff --git a/hiddify/finalmask/h_mirage.go b/hiddify/finalmask/h_mirage.go
new file mode 100644
index 0000000000000000000000000000000000000000..3c45ccbfa92910f76a04d5af2efcbc999b779ecf
--- /dev/null
+++ b/hiddify/finalmask/h_mirage.go
@@ -0,0 +1,109 @@
+// The mirage mask wraps PoriyaVali/mirage (https://github.com/PoriyaVali/mirage, MIT License,
+// branch mirage-reliability-20261024), which does the splitting.
+
+package finalmask
+
+import (
+	"encoding/binary"
+	"errors"
+	"net"
+	"sync"
+
+	"github.com/PoriyaVali/mirage"
+	xnet "github.com/xtls/xray-core/common/net"
+	xfinalmask "github.com/xtls/xray-core/transport/internet/finalmask"
+)
+
+const (
+	mirageLayoutSeparate = "separate"
+	mirageLayoutSingle   = "single"
+)
+
+// MirageMask splits the TLS ClientHello that opens a connection into two TLS records, the first
+// offset bytes of the handshake long. A filter that matches the server name in one record misses
+// it; the real server reassembles the handshake. layout "separate" (the default) writes each
+// record on its own, layout "single" writes both in one write; which one a filter lets through
+// changes by network and over time. Anything that is not a complete ClientHello with a server
+// name is sent unchanged. Replies are not changed. Put it last in tcp, or after the masks that
+// must see the plain ClientHello.
+type MirageMask struct {
+	Offset int    `json:"offset"`
+	Layout string `json:"layout"`
+}
+
+func (c *MirageMask) BuildTcpmask() (xfinalmask.TCPMask, error) {
+	if c.Offset < 0 || c.Offset >= 1<<14 {
+		return nil, errors.New("offset must be from 0 to 16383")
+	}
+	switch c.Layout {
+	case "", mirageLayoutSeparate:
+		return &mirageTcpmask{offset: c.Offset}, nil
+	case mirageLayoutSingle:
+		return &mirageTcpmask{offset: c.Offset, single: true}, nil
+	}
+	return nil, errors.New(`layout must be "separate" or "single"`)
+}
+
+type mirageTcpmask struct {
+	offset int // 0 is mirage's default
+	single bool
+}
+
+func (m *mirageTcpmask) WrapConnClient(conn net.Conn, _ *xnet.Destination, _ *xfinalmask.Dialer) (net.Conn, error) {
+	if m.single {
+		return &mirageSingleConn{Conn: conn, offset: m.offset}, nil
+	}
+	return mirage.NewConn(conn, m.offset), nil
+}
+
+// WrapConnServer leaves the connection as it is: mirage only shapes what a client sends.
+func (m *mirageTcpmask) WrapConnServer(conn net.Conn) (net.Conn, error) {
+	return conn, nil
+}
+
+// mirageSingleConn sends the split ClientHello, and any bytes after it in the same write, in one
+// write (mirage.Split). Only the first non-empty write is looked at.
+type mirageSingleConn struct {
+	net.Conn
+	offset int
+
+	mu      sync.Mutex
+	started bool
+}
+
+func (c *mirageSingleConn) Write(b []byte) (int, error) {
+	if len(b) == 0 {
+		return 0, nil
+	}
+	c.mu.Lock()
+	if c.started {
+		c.mu.Unlock()
+		return c.Conn.Write(b)
+	}
+	defer c.mu.Unlock()
+	c.started = true
+	if len(b) < 5 {
+		return c.Conn.Write(b)
+	}
+	end := 5 + int(binary.BigEndian.Uint16(b[3:5]))
+	if end > len(b) {
+		return c.Conn.Write(b)
+	}
+	split, err := mirage.Split(b[:end], c.offset)
+	if err != nil {
+		return c.Conn.Write(b)
+	}
+	split = append(split, b[end:]...)
+	n, err := c.Conn.Write(split)
+	if err != nil {
+		// The second record's header is framing the caller did not write.
+		if n -= 5; n < 0 {
+			n = 0
+		}
+		if n > len(b) {
+			n = len(b)
+		}
+		return n, err
+	}
+	return len(b), nil
+}
diff --git a/hiddify/finalmask/h_mirage_test.go b/hiddify/finalmask/h_mirage_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..eb343dc123838a9a697a3b5993172d471e7ed351
--- /dev/null
+++ b/hiddify/finalmask/h_mirage_test.go
@@ -0,0 +1,93 @@
+package finalmask
+
+import (
+	"crypto/tls"
+	"io"
+	"net"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// clientHelloRecord is the first TLS record a Go client writes for serverName.
+func clientHelloRecord(t *testing.T, serverName string) []byte {
+	client, server := net.Pipe()
+	defer server.Close()
+	go func() { _ = tls.Client(client, &tls.Config{ServerName: serverName}).Handshake() }()
+	defer client.Close()
+	header := make([]byte, 5)
+	_, err := io.ReadFull(server, header)
+	require.NoError(t, err)
+	record := make([]byte, 5+(int(header[3])<<8|int(header[4])))
+	copy(record, header)
+	_, err = io.ReadFull(server, record[5:])
+	require.NoError(t, err)
+	return record
+}
+
+// The mirage mask writes a ClientHello as two TLS records, each on its own, with the same
+// handshake bytes; other writes pass through.
+func TestH_FinalMaskMirage(t *testing.T) {
+	hello := clientHelloRecord(t, "blocked.example.com")
+	masks, err := Build(parseOptions(t, `{"tcp":[{"type":"mirage","settings":{"offset":4}}]}`))
+	require.NoError(t, err)
+	recorder := &writeRecorder{}
+	conn, err := wrapTCP(masks, recorder)
+	require.NoError(t, err)
+
+	n, err := conn.Write(hello)
+	require.NoError(t, err)
+	require.Equal(t, len(hello), n)
+	writes := recorder.recorded()
+	require.Len(t, writes, 2)
+	require.Equal(t, 5+4, len(writes[0]))
+	require.Equal(t, byte(0x16), writes[0][0])
+	require.Equal(t, byte(0x16), writes[1][0])
+	require.Equal(t, hello[5:], append(append([]byte(nil), writes[0][5:]...), writes[1][5:]...))
+	require.NotContains(t, string(writes[0]), "blocked.example.com")
+	require.NotContains(t, string(writes[1][:5]), "blocked")
+
+	_, err = conn.Write([]byte("later"))
+	require.NoError(t, err)
+	require.Len(t, recorder.recorded(), 3)
+}
+
+// layout "single" sends both records, and the bytes after them, in one write.
+func TestH_FinalMaskMirageSingle(t *testing.T) {
+	hello := clientHelloRecord(t, "blocked.example.com")
+	masks, err := Build(parseOptions(t, `{"tcp":[{"type":"mirage","settings":{"offset":2,"layout":"single"}}]}`))
+	require.NoError(t, err)
+	recorder := &writeRecorder{}
+	conn, err := wrapTCP(masks, recorder)
+	require.NoError(t, err)
+
+	n, err := conn.Write(append(append([]byte(nil), hello...), "tail"...))
+	require.NoError(t, err)
+	require.Equal(t, len(hello)+4, n)
+	writes := recorder.recorded()
+	require.Len(t, writes, 1)
+	out := writes[0]
+	require.Len(t, out, len(hello)+5+4)
+	require.Equal(t, []byte{0x16, hello[1], hello[2], 0, 2}, out[:5])
+	require.Equal(t, byte(0x16), out[7])
+	require.Equal(t, hello[5:], append(append([]byte(nil), out[5:7]...), out[12:len(out)-4]...))
+	require.Equal(t, "tail", string(out[len(out)-4:]))
+
+	_, err = Build(parseOptions(t, `{"tcp":[{"type":"mirage","settings":{"layout":"both"}}]}`))
+	require.Error(t, err)
+}
+
+// A first write that is not a complete ClientHello is sent unchanged.
+func TestH_FinalMaskMirageNotClientHello(t *testing.T) {
+	masks, err := Build(parseOptions(t, `{"tcp":[{"type":"mirage"}]}`))
+	require.NoError(t, err)
+	recorder := &writeRecorder{}
+	conn, err := wrapTCP(masks, recorder)
+	require.NoError(t, err)
+	_, err = conn.Write([]byte("GET / HTTP/1.1\r\n\r\n"))
+	require.NoError(t, err)
+	require.Len(t, recorder.recorded(), 1)
+
+	_, err = Build(parseOptions(t, `{"tcp":[{"type":"mirage","settings":{"offset":-1}}]}`))
+	require.Error(t, err)
+}
diff --git a/hiddify/finalmask/h_oob_unix_test.go b/hiddify/finalmask/h_oob_unix_test.go
