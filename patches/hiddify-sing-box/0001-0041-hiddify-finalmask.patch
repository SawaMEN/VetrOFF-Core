--- /dev/null
+++ b/hiddify/finalmask/h_oob_unix_test.go
@@ -0,0 +1,49 @@
+//go:build unix
+
+package finalmask
+
+import (
+	"io"
+	"net"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// With SO_OOBINLINE the server keeps urgent bytes in the stream: they show the oob mask really
+// sends each of the first writes with its byte as urgent data, not as a plain write.
+func TestH_FinalMaskOOBSendsUrgentBytes(t *testing.T) {
+	masks, err := Build(parseOptions(t, `{"tcp":[{"type":"oob","settings":{"bytes":[0,65]}}]}`))
+	require.NoError(t, err)
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer listener.Close()
+	received := make(chan []byte, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		raw, _ := conn.(*net.TCPConn).SyscallConn()
+		raw.Control(func(fd uintptr) {
+			syscall.SetsockoptInt(int(fd), syscall.SOL_SOCKET, syscall.SO_OOBINLINE, 1)
+		})
+		data, _ := io.ReadAll(conn)
+		received <- data
+	}()
+	raw, err := net.Dial("tcp", listener.Addr().String())
+	require.NoError(t, err)
+	conn, err := wrapTCP(masks, raw)
+	require.NoError(t, err)
+	time.Sleep(50 * time.Millisecond) // the server sets SO_OOBINLINE before data arrives
+	for _, part := range []string{"first ", "second ", "third"} {
+		_, err := conn.Write([]byte(part))
+		require.NoError(t, err)
+		time.Sleep(20 * time.Millisecond)
+	}
+	require.NoError(t, conn.Close())
+	require.Equal(t, "first \x00second Athird", string(<-received))
+}
diff --git a/hiddify/finalmask/h_xdns_legacy.go b/hiddify/finalmask/h_xdns_legacy.go
new file mode 100644
index 0000000000000000000000000000000000000000..b6308a2cbae093800c4a9725c5a728d823991d14
--- /dev/null
+++ b/hiddify/finalmask/h_xdns_legacy.go
@@ -0,0 +1,139 @@
+package finalmask
+
+import (
+	"encoding/json"
+	"slices"
+	"strings"
+
+	E "github.com/sagernet/sing/common/exceptions"
+
+	"google.golang.org/protobuf/proto"
+)
+
+// xdnsSettings is the xdns mask with the settings of earlier Xray versions still accepted, so
+// links and profiles made for them keep loading:
+//
+//   - v26.7 to v26.9: "domains": ["t.example.com"] for a server and
+//     "resolvers": ["t.example.com+udp://8.8.8.8:53"] for a client;
+//   - v26.9.30: domains as {"name": ...} and resolvers as {"type": "udp", "addr": ...}.
+//
+// Both become the current form, {"names": [...]} and {"addrs": [...]}. The client sends through
+// every resolver for every domain, so a resolver string's domain joins the domains.
+type xdnsSettings struct {
+	XDNS
+}
+
+func (c *xdnsSettings) UnmarshalJSON(data []byte) error {
+	var raw map[string]json.RawMessage
+	if err := json.Unmarshal(data, &raw); err != nil {
+		return err
+	}
+	var domainNames []string
+	var domains, resolvers []json.RawMessage
+	if err := unmarshalOptional(raw["domains"], &domains); err != nil {
+		return E.Cause(err, "domains")
+	}
+	if err := unmarshalOptional(raw["resolvers"], &resolvers); err != nil {
+		return E.Cause(err, "resolvers")
+	}
+	newDomains := make([]json.RawMessage, 0, len(domains))
+	for _, domain := range domains {
+		var name string
+		if json.Unmarshal(domain, &name) == nil {
+			domainNames = appendUnique(domainNames, name)
+			continue
+		}
+		newDomains = append(newDomains, renameField(domain, "name", "names"))
+	}
+	newResolvers := make([]json.RawMessage, 0, len(resolvers))
+	for _, resolver := range resolvers {
+		var value string
+		if json.Unmarshal(resolver, &value) == nil {
+			name, addr, found := strings.Cut(value, "+")
+			if !found || !strings.Contains(addr, "://") {
+				return E.New("invalid resolver ", value)
+			}
+			domainNames = appendUnique(domainNames, name)
+			newResolvers = append(newResolvers, mustMarshal(map[string]any{"addrs": []string{addr}}))
+			continue
+		}
+		newResolvers = append(newResolvers, legacyResolverObject(resolver))
+	}
+	if len(domainNames) > 0 {
+		newDomains = append(newDomains, mustMarshal(map[string]any{"names": domainNames}))
+	}
+	if len(newDomains) == 0 && len(newResolvers) == 0 {
+		return E.New("empty domains & empty resolvers")
+	}
+	raw["domains"] = mustMarshal(newDomains)
+	raw["resolvers"] = mustMarshal(newResolvers)
+	return json.Unmarshal(mustMarshal(raw), &c.XDNS)
+}
+
+func (c *xdnsSettings) Build() (proto.Message, error) {
+	return c.XDNS.Build()
+}
+
+// legacyResolverObject turns {"type": "udp", "addr": "8.8.8.8:53"} into
+// {"addrs": ["udp://8.8.8.8:53"]}; a resolver that already has addrs is left as it is.
+func legacyResolverObject(resolver json.RawMessage) json.RawMessage {
+	var object map[string]json.RawMessage
+	if json.Unmarshal(resolver, &object) != nil {
+		return resolver
+	}
+	if _, hasAddrs := object["addrs"]; hasAddrs {
+		return resolver
+	}
+	var addr, resolverType string
+	if json.Unmarshal(object["addr"], &addr) != nil || addr == "" {
+		return resolver
+	}
+	_ = json.Unmarshal(object["type"], &resolverType)
+	if resolverType != "" && !strings.Contains(addr, "://") {
+		addr = resolverType + "://" + addr
+	}
+	delete(object, "addr")
+	delete(object, "type")
+	object["addrs"] = mustMarshal([]string{addr})
+	return mustMarshal(object)
+}
+
+// renameField turns {"name": "x"} into {"names": ["x"]}.
+func renameField(object json.RawMessage, from, to string) json.RawMessage {
+	var fields map[string]json.RawMessage
+	if json.Unmarshal(object, &fields) != nil {
+		return object
+	}
+	if _, hasNew := fields[to]; hasNew {
+		return object
+	}
+	value, hasOld := fields[from]
+	if !hasOld {
+		return object
+	}
+	delete(fields, from)
+	fields[to] = mustMarshal([]json.RawMessage{value})
+	return mustMarshal(fields)
+}
+
+func unmarshalOptional(data json.RawMessage, value any) error {
+	if len(data) == 0 || string(data) == "null" {
+		return nil
+	}
+	return json.Unmarshal(data, value)
+}
+
+func appendUnique(list []string, value string) []string {
+	if value == "" || slices.Contains(list, value) {
+		return list
+	}
+	return append(list, value)
+}
+
+func mustMarshal(value any) json.RawMessage {
+	data, err := json.Marshal(value)
+	if err != nil {
+		panic(err)
+	}
+	return data
+}
diff --git a/hiddify/finalmask/h_xray_v26_10_test.go b/hiddify/finalmask/h_xray_v26_10_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..327d41fed652b6ffbb886b18f14156ad26308d69
--- /dev/null
+++ b/hiddify/finalmask/h_xray_v26_10_test.go
@@ -0,0 +1,207 @@
+package finalmask
+
+import (
+	"context"
+	"encoding/json"
+	"net"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/stretchr/testify/require"
+	"github.com/xtls/xray-core/transport/internet/finalmask/udphop"
+	"github.com/xtls/xray-core/transport/internet/finalmask/xdns"
+)
+
+// The masks and settings of Xray-core v26.10: xdns over DoH, noise "exp" and "script", udpHop.
+func TestH_FinalMaskXray2610Settings(t *testing.T) {
+	for _, content := range []string{
+		`{"udp":[{"type":"xdns","settings":{"domains":[{"names":["t.example.com"]}],"resolvers":[{"addrs":["https://1.1.1.1/dns-query"],"tlsConfig":{"serverName":"cloudflare-dns.com","alpn":["h2"],"fingerprint":"chrome"}}]}}]}`,
+		`{"udp":[{"type":"xdns","settings":{"domains":[{"names":["t.example.com"],"types":[16]}],"resolvers":[{"addrs":["https://1.1.1.1/dns-query"],"tlsConfig":{"serverName":"cloudflare-dns.com","alpn":["h3"]},"quicConfig":{"congestion":"bbr"}}]}}]}`,
+		`{"udp":[{"type":"xdns","settings":{"domains":[{"names":["t.example.com"]}],"resolvers":[{"addrs":["8.8.8.8","tcp://9.9.9.9:53"],"worker":8}],"extraPoll":2}}]}`,
+		`{"udp":[{"type":"noise","settings":{"noise":[{"type":"exp","packet":"<b 0x1700> <r 10-20> <t> <c>","delay":"5"}]}}]}`,
+		`{"udp":[{"type":"udphop","settings":{"mode":"intervalRemote","interval":"10-20","remotePorts":"20000-20010,443"}}]}`,
+	} {
+		masks, err := Build(parseOptions(t, content))
+		require.NoError(t, err, content)
+		require.True(t, masks.HasUDP(), content)
+	}
+
+	masks, err := Build(parseOptions(t, `{"udp":[{"type":"udphop","settings":{"mode":"perConnRemote","remotePorts":"20000-20002,443","remoteIPs":["10.0.0.1","10.1.0.0/16"]}}]}`))
+	require.NoError(t, err)
+	hop := masks.udp[0].(*udphop.Config)
+	require.Equal(t, []uint32{20000, 20001, 20002, 443}, hop.RemotePorts)
+	require.Equal(t, []string{"10.0.0.1/32", "10.1.0.0/16"}, hop.RemoteIPs)
+	require.Equal(t, int64(30), hop.IntervalMin)
+
+	for _, content := range []string{
+		`{"udp":[{"type":"udphop","settings":{"mode":"sometimes"}}]}`,
+		`{"udp":[{"type":"udphop","settings":{"mode":"intervalLocal","interval":"1"}}]}`,
+		`{"udp":[{"type":"noise","settings":{"noise":[{"type":"exp","packet":"<zz>"}]}}]}`,
+		`{"udp":[{"type":"xdns","settings":{"domains":[{"names":["t.example.com"]}],"resolvers":[{"addrs":["ftp://8.8.8.8"]}]}}]}`,
+		`{"udp":[{"type":"xdns","settings":{"domains":[{"names":["t.example.com"]}],"resolvers":[{"addrs":["https://1.1.1.1/dns-query"],"tlsConfig":{"allowInsecure":true}}]}}]}`,
+	} {
+		_, err := Build(parseOptions(t, content))
+		require.Error(t, err, content)
+	}
+}
+
+// Settings of Xray v26.7 to v26.9 become the current xdns form.
+func TestH_FinalMaskXDNSLegacySettings(t *testing.T) {
+	for _, test := range []struct {
+		content   string
+		domains   []string
+		resolvers []string
+	}{
+		{`{"resolvers":["t.example.com+udp://8.8.8.8:53","t.example.com+udp://1.1.1.1:53"]}`, []string{"t.example.com"}, []string{"8.8.8.8:53", "1.1.1.1:53"}},
+		{`{"domains":["t.example.com"]}`, []string{"t.example.com"}, nil},
+		{`{"domains":[{"name":"t.example.com"}],"resolvers":[{"type":"tcp","addr":"8.8.8.8:53"}]}`, []string{"t.example.com"}, []string{"8.8.8.8:53"}},
+	} {
+		var settings xdnsSettings
+		require.NoError(t, json.Unmarshal([]byte(test.content), &settings), test.content)
+		message, err := settings.Build()
+		require.NoError(t, err, test.content)
+		config := message.(*xdns.Config)
+		var domains, resolvers []string
+		for _, domain := range config.Domains {
+			domains = append(domains, domain.Name)
+		}
+		for _, resolver := range config.Resolvers {
+			resolvers = append(resolvers, resolver.Addr)
+		}
+		require.Equal(t, test.domains, domains, test.content)
+		require.Equal(t, test.resolvers, resolvers, test.content)
+	}
+}
+
+// xdns carries a UDP flow in DNS queries to its resolvers, which the mask dials itself through
+// the dialer; here the server is the resolver.
+func TestH_FinalMaskXDNSRoundTrip(t *testing.T) {
+	rawServer, err := net.ListenPacket("udp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer rawServer.Close()
+	serverMasks, err := Build(parseOptions(t, `{"udp":[{"type":"xdns","settings":{"domains":[{"names":["t.example.com"]}]}}]}`))
+	require.NoError(t, err)
+	server, err := serverMasks.WrapPacketConnServer(rawServer)
+	require.NoError(t, err)
+	defer server.Close()
+	go func() {
+		buf := make([]byte, 4096)
+		for {
+			n, addr, err := server.ReadFrom(buf)
+			if err != nil {
+				return
+			}
+			server.WriteTo(buf[:n], addr)
+		}
+	}()
+
+	port := M.SocksaddrFromNet(rawServer.LocalAddr()).Port
+	clientMasks, err := Build(parseOptions(t, `{"udp":[{"type":"xdns","settings":{"domains":[{"names":["t.example.com"]}],"resolvers":[{"addrs":["udp://127.0.0.1:`+strconv.Itoa(int(port))+`"],"worker":2}]}}]}`))
+	require.NoError(t, err)
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	var resolverDials, otherDials atomic.Int32
+	count := func(destination M.Socksaddr) {
+		if destination.Port == port {
+			resolverDials.Add(1)
+		} else {
+			otherDials.Add(1)
+		}
+	}
+	conn, err := clientMasks.DialContext(ctx, N.NetworkUDP, M.ParseSocksaddr("192.0.2.1:443"), func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+		count(destination)
+		return N.SystemDialer.DialContext(ctx, network, destination)
+	}, func(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+		count(destination)
+		return N.SystemDialer.ListenPacket(ctx, destination)
+	})
+	require.NoError(t, err)
+	defer conn.Close()
+
+	payload := []byte("hello over xdns")
+	got := make([]byte, 4096)
+	conn.SetReadDeadline(time.Now().Add(10 * time.Second))
+	for {
+		_, err = conn.Write(payload)
+		require.NoError(t, err)
+		n, err := conn.Read(got)
+		require.NoError(t, err)
+		if n == len(payload) {
+			require.Equal(t, payload, got[:n])
+			break
+		}
+	}
+	require.Positive(t, resolverDials.Load(), "the resolvers are dialed through the dialer")
+	require.Zero(t, otherDials.Load(), "nothing is dialed to the destination itself")
+}
+
+// udphop sends to the server ports it picks: one per connection with perConnRemote, and a new one
+// on every hop with intervalRemote, on the same unconnected socket.
+func TestH_FinalMaskUDPHop(t *testing.T) {
+	var ports []string
+	received := make(chan uint16, 64)
+	// A larger pool makes a repeated random selection vanishingly unlikely.
+	for range 8 {
+		server, err := net.ListenPacket("udp", "127.0.0.1:0")
+		require.NoError(t, err)
+		defer server.Close()
+		port := M.SocksaddrFromNet(server.LocalAddr()).Port
+		ports = append(ports, strconv.Itoa(int(port)))
+		go func() {
+			buf := make([]byte, 2048)
+			for {
+				n, addr, err := server.ReadFrom(buf)
+				if err != nil {
+					return
+				}
+				received <- port
+				server.WriteTo(buf[:n], addr)
+			}
+		}()
+	}
+	exchange := func(conn net.Conn) uint16 {
+		t.Helper()
+		_, err := conn.Write([]byte("hop"))
+		require.NoError(t, err)
+		got := make([]byte, 16)
+		conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+		n, err := conn.Read(got)
+		require.NoError(t, err)
+		require.Equal(t, "hop", string(got[:n]))
+		return <-received
+	}
+	ctx := context.Background()
+	destination := M.ParseSocksaddr("127.0.0.1:9")
+
+	masks, err := Build(parseOptions(t, `{"udp":[{"type":"udphop","settings":{"mode":"perConnRemote","remotePorts":"`+strings.Join(ports, ",")+`"}}]}`))
+	require.NoError(t, err)
+	seen := map[uint16]bool{}
+	for range 20 {
+		conn, err := dial(ctx, masks, N.NetworkUDP, destination)
+		require.NoError(t, err)
+		seen[exchange(conn)] = true
+		conn.Close()
+	}
+	require.Greater(t, len(seen), 1, "connections go to different server ports")
+
+	masks, err = Build(parseOptions(t, `{"udp":[{"type":"udphop","settings":{"mode":"intervalRemote","interval":"5","remotePorts":"`+strings.Join(ports, ",")+`"}}]}`))
+	require.NoError(t, err)
+	conn, err := dial(ctx, masks, N.NetworkUDP, destination)
+	require.NoError(t, err)
+	defer conn.Close()
+	first := exchange(conn)
+	deadline := time.Now().Add(20 * time.Second)
+	for time.Now().Before(deadline) {
+		time.Sleep(time.Second)
+		if exchange(conn) != first {
+			return
+		}
+	}
+	t.Fatal("the connection never hopped to another server port")
+}
diff --git a/hiddify/finalmask/merge.go b/hiddify/finalmask/merge.go
new file mode 100644
index 0000000000000000000000000000000000000000..7323685a37c8c54b0b10bf8da7fba616c581b639
--- /dev/null
+++ b/hiddify/finalmask/merge.go
@@ -0,0 +1,172 @@
+// The merge mask is ported from patterniha/Xray-core transport/internet/finalmask/merge
+// (https://github.com/patterniha/xray-core, Mozilla Public License 2.0). Changes: it is built from
+// its JSON settings here instead of a protobuf message, and implements the TCPMask interface of
+// the Xray-core version this package uses.
+
+package finalmask
+
+import (
+	"errors"
+	"net"
+	"sync"
+	"syscall"
+	"time"
+
+	xnet "github.com/xtls/xray-core/common/net"
+	xfinalmask "github.com/xtls/xray-core/transport/internet/finalmask"
+)
+
+const (
+	defaultMergeDelayMs  = 30
+	defaultMergeMaxBytes = 16384
+)
+
+// MergeMask coalesces the first writes of a TCP connection: each write is held until no new one
+// comes for delayMs, or the held bytes reach maxBytes, and then goes out as one write. After times
+// such writes the connection passes writes straight through; times 0 or less means for its whole
+// life. Replies are not changed.
+type MergeMask struct {
+	Times    int32 `json:"times"`
+	DelayMs  int32 `json:"delayMs"`
+	MaxBytes int32 `json:"maxBytes"`
+}
+
+func (c *MergeMask) BuildTcpmask() (xfinalmask.TCPMask, error) {
+	if c.DelayMs < 0 || c.MaxBytes < 0 {
+		return nil, errors.New("delayMs and maxBytes can't be negative")
+	}
+	mask := *c
+	if mask.DelayMs == 0 {
+		mask.DelayMs = defaultMergeDelayMs
+	}
+	if mask.MaxBytes == 0 {
+		mask.MaxBytes = defaultMergeMaxBytes
+	}
+	return &mask, nil
+}
+
+func (c *MergeMask) WrapConnClient(conn net.Conn, _ *xnet.Destination, _ *xfinalmask.Dialer) (net.Conn, error) {
+	return newMergeConn(conn, int(c.Times), int(c.MaxBytes), time.Duration(c.DelayMs)*time.Millisecond), nil
+}
+
+// WrapConnServer leaves the connection as it is: merge only shapes what a client sends.
+func (c *MergeMask) WrapConnServer(conn net.Conn) (net.Conn, error) {
+	return conn, nil
+}
+
+type mergeConn struct {
+	net.Conn
+
+	delay     time.Duration
+	maxBytes  int
+	unlimited bool
+
+	mu        sync.Mutex
+	buf       []byte
+	remaining int
+	epoch     uint64
+	timer     *time.Timer
+	closed    bool
+	err       error
+}
+
+func newMergeConn(conn net.Conn, times, maxBytes int, delay time.Duration) net.Conn {
+	c := &mergeConn{Conn: conn, delay: delay, maxBytes: maxBytes}
+	if times <= 0 {
+		c.unlimited = true
+	} else {
+		c.remaining = times
+	}
+	return c
+}
+
+func (c *mergeConn) Write(p []byte) (int, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.err != nil {
+		return 0, c.err
+	}
+	if !c.unlimited && c.remaining == 0 {
+		n, err := c.Conn.Write(p)
+		if err != nil {
+			c.err = err
+		}
+		return n, err
+	}
+	c.buf = append(c.buf, p...) // a copy: the caller may reuse p once Write returns
+	if len(c.buf) >= c.maxBytes {
+		if err := c.flushLocked(); err != nil {
+			return 0, err
+		}
+		return len(p), nil
+	}
+	c.armTimerLocked()
+	return len(p), nil
+}
+
+// armTimerLocked restarts the idle timer. A new epoch turns a timer that already fired but still
+// waits for the lock into a no-op.
+func (c *mergeConn) armTimerLocked() {
+	c.epoch++
+	epoch := c.epoch
+	if c.timer != nil {
+		c.timer.Stop()
+	}
+	c.timer = time.AfterFunc(c.delay, func() { c.onTimer(epoch) })
+}
+
+func (c *mergeConn) onTimer(epoch uint64) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed || c.err != nil || epoch != c.epoch {
+		return
+	}
+	_ = c.flushLocked()
+}
+
+// flushLocked sends the held bytes as one write and counts it; c.mu is held.
+func (c *mergeConn) flushLocked() error {
+	if len(c.buf) == 0 {
+		return nil
+	}
+	c.epoch++
+	if c.timer != nil {
+		c.timer.Stop()
+	}
+	data := c.buf
+	c.buf = nil
+	if _, err := c.Conn.Write(data); err != nil {
+		c.err = err
+		return err
+	}
+	if !c.unlimited {
+		c.remaining--
+	}
+	return nil
+}
+
+func (c *mergeConn) Close() error {
+	c.mu.Lock()
+	c.closed = true
+	c.epoch++
+	if c.timer != nil {
+		c.timer.Stop()
+	}
+	if len(c.buf) > 0 && c.err == nil {
+		data := c.buf
+		c.buf = nil
+		if _, err := c.Conn.Write(data); err != nil {
+			c.err = err
+		}
+	}
+	c.mu.Unlock()
+	return c.Conn.Close()
+}
+
+// SyscallConn keeps the read side's fast path; writes always go through Write.
+func (c *mergeConn) SyscallConn() (syscall.RawConn, error) {
+	if sc, ok := c.Conn.(syscall.Conn); ok {
+		return sc.SyscallConn()
+	}
+	return nil, errors.New("merge: the connection is not a syscall.Conn")
+}
diff --git a/hiddify/finalmask/oob.go b/hiddify/finalmask/oob.go
new file mode 100644
index 0000000000000000000000000000000000000000..29a77067ee5968ee085004c17574429cb6bffd93
--- /dev/null
+++ b/hiddify/finalmask/oob.go
@@ -0,0 +1,111 @@
+// The oob mask is ported from patterniha/Xray-core's "oob." dialMode
+// (https://github.com/patterniha/xray-core, transport/internet/dialmode_oob*.go, Mozilla Public
+// License 2.0). Changes: it is a tcp mask with a bytes setting instead of a dialMode string.
+
+package finalmask
+
+import (
+	"errors"
+	"net"
+	"syscall"
+
+	xnet "github.com/xtls/xray-core/common/net"
+	xfinalmask "github.com/xtls/xray-core/transport/internet/finalmask"
+)
+
+// OOBMask sends each of the first len(bytes) writes of a TCP connection with one more byte,
+// bytes[i] for write i, as TCP urgent (out-of-band) data; later writes pass through. The server's
+// TCP stack takes the urgent byte out of the stream, while a filter that mishandles the urgent
+// pointer reads those segments (a TLS ClientHello) wrong. It is Xray's dialMode "oob.<b>,<b>,...".
+// It must be the last tcp mask, the one next to the socket; a connection that is not a socket is
+// left as it is.
+type OOBMask struct {
+	Bytes []int `json:"bytes"`
+}
+
+func (c *OOBMask) BuildTcpmask() (xfinalmask.TCPMask, error) {
+	if len(c.Bytes) == 0 {
+		return nil, errors.New("bytes is empty")
+	}
+	for _, b := range c.Bytes {
+		if b < 0 || b > 255 {
+			return nil, errors.New("bytes must be from 0 to 255")
+		}
+	}
+	return &oobTcpmask{bytes: append([]int(nil), c.Bytes...)}, nil
+}
+
+type oobTcpmask struct {
+	bytes []int
+}
+
+func (m *oobTcpmask) WrapConnClient(conn net.Conn, _ *xnet.Destination, _ *xfinalmask.Dialer) (net.Conn, error) {
+	oobBytes := make([]byte, len(m.bytes))
+	for i, b := range m.bytes {
+		oobBytes[i] = byte(b)
+	}
+	return &oobConn{Conn: conn, oobBytes: oobBytes}, nil
+}
+
+func (m *oobTcpmask) WrapConnServer(conn net.Conn) (net.Conn, error) {
+	return conn, nil
+}
+
+type oobConn struct {
+	net.Conn
+	oobBytes []byte
+	index    int
+}
+
+func (c *oobConn) Write(p []byte) (int, error) {
+	if c.index >= len(c.oobBytes) {
+		return c.Conn.Write(p)
+	}
+	oobByte := c.oobBytes[c.index]
+	c.index++
+	sc, ok := c.Conn.(syscall.Conn)
+	if !ok || !oobSupported {
+		return c.Conn.Write(p)
+	}
+	raw, err := sc.SyscallConn()
+	if err != nil {
+		return c.Conn.Write(p)
+	}
+	data := make([]byte, len(p)+1)
+	copy(data, p)
+	data[len(p)] = oobByte
+	var (
+		sent    int
+		sendErr error
+	)
+	controlErr := raw.Write(func(fd uintptr) bool {
+		n, err := sendOOB(fd, data)
+		if err == syscall.EAGAIN || err == syscall.EWOULDBLOCK {
+			return false // not writable yet: wait and send again
+		}
+		sent, sendErr = n, err
+		return true
+	})
+	if controlErr != nil {
+		return 0, controlErr
+	}
+	if sendErr != nil {
+		return 0, sendErr
+	}
+	if sent > len(p) {
+		sent = len(p) // the urgent byte is not the caller's
+	}
+	if sent < len(p) {
+		n, err := c.Conn.Write(p[sent:])
+		return sent + n, err
+	}
+	return len(p), nil
+}
+
+// SyscallConn keeps the read side's fast path.
+func (c *oobConn) SyscallConn() (syscall.RawConn, error) {
+	if sc, ok := c.Conn.(syscall.Conn); ok {
+		return sc.SyscallConn()
+	}
+	return nil, errors.New("oob: the connection is not a syscall.Conn")
+}
