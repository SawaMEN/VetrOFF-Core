diff --git a/hiddify/finalmask/oob_unix.go b/hiddify/finalmask/oob_unix.go
new file mode 100644
index 0000000000000000000000000000000000000000..6c533e20217456445a56a51cfe9393d947f596e6
--- /dev/null
+++ b/hiddify/finalmask/oob_unix.go
@@ -0,0 +1,16 @@
+//go:build unix
+
+package finalmask
+
+import "golang.org/x/sys/unix"
+
+const oobSupported = true
+
+// sendOOB sends b on the connected socket fd as TCP urgent data. unix.Send reports no byte count:
+// no error means all of b was sent.
+func sendOOB(fd uintptr, b []byte) (int, error) {
+	if err := unix.Send(int(fd), b, unix.MSG_OOB); err != nil {
+		return 0, err
+	}
+	return len(b), nil
+}
diff --git a/hiddify/finalmask/oob_windows.go b/hiddify/finalmask/oob_windows.go
