+package xhttp
+
+import (
+	"testing"
+)
+
+func TestXUIPanelUploadQueueZeroCapacityAndRead(t *testing.T) {
+	queue := NewUploadQueue(0)
+	defer queue.Close()
+	if queue.maxPackets != 1 || cap(queue.pushedPackets) != 1 {
+		t.Fatalf("zero-capacity queue not clamped: max=%d cap=%d", queue.maxPackets, cap(queue.pushedPackets))
+	}
+	if n, err := queue.Read(nil); n != 0 || err != nil {
+		t.Fatalf("zero-length read must not block or consume packets: %d %v", n, err)
+	}
+	if err := queue.Push(Packet{Seq: 0, Payload: []byte("a")}); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := queue.Read([]byte{}); n != 0 || err != nil {
+		t.Fatalf("empty read unexpectedly consumed packet: %d %v", n, err)
+	}
+	buf := make([]byte, 1)
+	n, err := queue.Read(buf)
+	if err != nil || n != 1 || string(buf[:n]) != "a" {
+		t.Fatalf("packet lost after zero-length read: %q %d %v", buf, n, err)
+	}
+}
diff --git a/transport/v2rayxhttp/xui_wait_read_closer_test.go b/transport/v2rayxhttp/xui_wait_read_closer_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..5ede5f819fb46a12a03ff63835cf911191c52f4f
--- /dev/null
+++ b/transport/v2rayxhttp/xui_wait_read_closer_test.go
@@ -0,0 +1,80 @@
+package xhttp
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+type xuiCloseCountReader struct {
+	io.Reader
+	closes atomic.Int32
+}
+
+func (r *xuiCloseCountReader) Close() error {
+	r.closes.Add(1)
+	return nil
+}
+
+func TestXUIWaitReadCloserRejectsNilBody(t *testing.T) {
+	w := &WaitReadCloser{ctx: context.Background(), Wait: make(chan struct{})}
+	w.Set(nil)
+	select {
+	case <-w.Wait:
+		t.Fatal("nil body must not publish a response")
+	default:
+	}
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-w.Wait:
+	default:
+		t.Fatal("closing the waiter must wake readers")
+	}
+	if _, err := w.Read(make([]byte, 1)); err != io.ErrClosedPipe {
+		t.Fatalf("Read after Close: got %v, want io.ErrClosedPipe", err)
+	}
+}
+
+func TestXUIWaitReadCloserSetCloseRace(t *testing.T) {
+	for range 128 {
+		w := &WaitReadCloser{ctx: context.Background(), Wait: make(chan struct{})}
+		first := &xuiCloseCountReader{Reader: bytes.NewReader([]byte("one"))}
+		var group sync.WaitGroup
+		group.Add(2)
+		go func() {
+			defer group.Done()
+			w.Set(first)
+		}()
+		go func() {
+			defer group.Done()
+			if err := w.Close(); err != nil {
+				t.Errorf("close: %v", err)
+			}
+		}()
+		group.Wait()
+		select {
+		case <-w.Wait:
+		default:
+			t.Fatal("Close or Set did not release waiter")
+		}
+		if got := first.closes.Load(); got != 1 {
+			t.Fatalf("first body closed %d times, want exactly once", got)
+		}
+		late := &xuiCloseCountReader{Reader: bytes.NewReader([]byte("two"))}
+		w.Set(late)
+		if got := late.closes.Load(); got != 1 {
+			t.Fatalf("late body closed %d times, want exactly once", got)
+		}
+		if err := w.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if got := first.closes.Load(); got != 1 {
+			t.Fatalf("repeat Close closed first body %d times", got)
+		}
+	}
+}
