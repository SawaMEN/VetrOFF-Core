+package warp
+
+import (
+	"net/netip"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestH_WARPInterfaceAddresses(t *testing.T) {
+	for _, tc := range []struct {
+		name, ipv4, ipv6 string
+		want             []netip.Prefix
+	}{
+		{"ipv4", "172.16.9.2", "", []netip.Prefix{netip.MustParsePrefix("172.16.9.2/32")}},
+		{"ipv6", "", "2606:4700::2", []netip.Prefix{netip.MustParsePrefix("2606:4700::2/128")}},
+		{"dual", "172.16.9.2", "2606:4700::2", []netip.Prefix{netip.MustParsePrefix("172.16.9.2/32"), netip.MustParsePrefix("2606:4700::2/128")}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			addresses, err := warpInterfaceAddressPair(tc.ipv4, tc.ipv6)
+			require.NoError(t, err)
+			require.Equal(t, tc.want, []netip.Prefix(addresses))
+		})
+	}
+	for _, tc := range [][2]string{{"", ""}, {"not-ip", ""}, {"::1", ""}, {"", "127.0.0.1"}} {
+		_, err := warpInterfaceAddressPair(tc[0], tc[1])
+		require.Error(t, err)
+	}
+}
diff --git a/protocol/warp/h_link_device.go b/protocol/warp/h_link_device.go
new file mode 100644
index 0000000000000000000000000000000000000000..90f531f439a07913d97676fd657694f5caf91555
--- /dev/null
+++ b/protocol/warp/h_link_device.go
@@ -0,0 +1,102 @@
+//go:build with_masque
+
+package warp
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"strings"
+ "sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-box/protocol/masque"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/service"
+)
+
+// A masque:// link to WARP carries a device enrolled elsewhere: masque.device. The endpoint uses
+// it before its saved devices and before registering one. When Cloudflare refuses it (its key was
+// never enrolled, or the device was deleted), the endpoint remembers that in the cache file,
+// takes a saved device or registers one as for any WARP config, and does not try the link's
+// device again while the config carries it.
+
+// refusedLinkDeviceSuffix is the cache key, after the unique_identifier, of the link device
+// Cloudflare refused: the SHA-256 of its key.
+const refusedLinkDeviceSuffix = "/refused-masque-device"
+
+// validateMASQUEDevice fails a config whose link device cannot work: a key that does not parse,
+// no address, no endpoint.
+func validateMASQUEDevice(options *option.WARPEndpointOptions) error {
+	if options.MASQUE == nil || options.MASQUE.Device == nil {
+		return nil
+	}
+	if _, err := masque.DeviceConfig(options.MASQUE.Device); err != nil {
+		return E.Cause(err, "warp masque.device")
+	}
+	return nil
+}
+
+// linkMASQUEProfile is the link's device as a profile, or nil when there is none or Cloudflare
+// refused it. Like a WireGuard config written inline, it is never pooled nor retired.
+func (w *WARPEndpoint) linkMASQUEProfile() *warpProfile {
+	if w.options.MASQUE == nil || w.options.MASQUE.Device == nil || w.linkDeviceWasRefused() {
+		return nil
+	}
+	device := w.options.MASQUE.Device
+	config, err := masque.DeviceConfig(device)
+	if err != nil { // checked when the config loaded
+		return nil
+	}
+	content, err := json.Marshal(config)
+	if err != nil {
+		return nil
+	}
+	return &warpProfile{Kind: kindMASQUE, ID: device.ID, MASQUE: content, inline: true}
+}
+
+func (w *WARPEndpoint) linkDeviceKey() string {
+	sum := sha256.Sum256([]byte(strings.TrimSpace(w.options.MASQUE.Device.PrivateKey)))
+	return hex.EncodeToString(sum[:])
+}
+
+func (w *WARPEndpoint) linkDeviceWasRefused() bool {
+	if w.linkRefused.Load() {
+		return true
+	}
+	cacheFile := service.FromContext[adapter.CacheFile](w.ctx)
+	if cacheFile == nil || !cacheFile.StoreWARPConfig() {
+		return false
+	}
+	saved := cacheFile.LoadBinary(w.uniqueID + refusedLinkDeviceSuffix)
+	refused := saved != nil && string(saved.Content) == w.linkDeviceKey()
+	w.linkRefused.Store(refused)
+	return refused
+}
+
+// linkDeviceRefused is the tunnel's answer to Cloudflare refusing the link's device: remember it,
+// and start again with a saved or a registered device. Once. The tunnel calls it from its connect,
+// which closing the tunnel waits for, so the restart runs on its own.
+func (w *WARPEndpoint) linkDeviceRefused(err error) {
+	if w.rememberLinkDeviceRefused() {
+		go w.restart("Cloudflare refused the link's MASQUE device (" + err.Error() + "), taking another device")
+	}
+}
+
+// rememberLinkDeviceRefused marks the link's device refused, in the cache file too; false when it
+// was already.
+func (w *WARPEndpoint) rememberLinkDeviceRefused() bool {
+	if !w.linkRefused.CompareAndSwap(false, true) {
+		return false
+	}
+	if cacheFile := service.FromContext[adapter.CacheFile](w.ctx); cacheFile != nil && cacheFile.StoreWARPConfig() {
+		if err := cacheFile.SaveBinary(w.uniqueID+refusedLinkDeviceSuffix, &adapter.SavedBinary{LastUpdated: time.Now(), Content: []byte(w.linkDeviceKey())}); err != nil {
+			w.logger.WarnContext(w.ctx, "WARP: remember the refused link device: ", err)
+		}
+	}
+	return true
+}
+
+type masqueLinkState struct { linkRefused atomic.Bool }
diff --git a/protocol/warp/h_link_device_test.go b/protocol/warp/h_link_device_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..bb03ee0866107a873b06642dde6c1982f566da06
--- /dev/null
+++ b/protocol/warp/h_link_device_test.go
@@ -0,0 +1,74 @@
+//go:build with_masque
+
+package warp
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/json"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/service"
+
+	"github.com/stretchr/testify/require"
+)
+
+func hLinkDevice(t *testing.T) *option.MASQUEDeviceOptions {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	der, err := x509.MarshalECPrivateKey(key)
+	require.NoError(t, err)
+	return &option.MASQUEDeviceOptions{PrivateKey: base64.StdEncoding.EncodeToString(der), IPv4: "172.16.0.2", EndpointV6: "[2606:4700:103::2]:443", ID: "link-device"}
+}
+
+func hLinkOptions(device *option.MASQUEDeviceOptions) option.WARPEndpointOptions {
+	return option.WARPEndpointOptions{UniqueIdentifier: "link", Mode: "masque", MASQUE: &option.WARPMASQUEOptions{Device: device}}
+}
+
+// A link device that cannot work fails the config, as a masque outbound's does.
+func TestH_WARPLinkDeviceIsChecked(t *testing.T) {
+	_, err := NewWARPEndpoint(hTestContext(t), nil, hLogger(), "warp-tag", hLinkOptions(&option.MASQUEDeviceOptions{PrivateKey: "junk", IPv4: "172.16.0.2"}))
+	require.ErrorContains(t, err, "warp masque.device")
+}
+
+// A masque:// link's device is used first, before the saved devices and registering; once
+// Cloudflare refuses it, a saved device is taken, and the link's is not tried again while the
+// config carries it, also after a restart of the app.
+func TestH_WARPLinkDeviceThenPool(t *testing.T) {
+	cache := &hFakeCacheFile{store: map[string]*adapter.SavedBinary{}}
+	ctx := service.ContextWith[adapter.CacheFile](hShortContext(t), cache)
+	device := hLinkDevice(t)
+	ep := hNewWARP(t, ctx, hLinkOptions(device))
+	done := make(chan struct{})
+	defer close(done)
+
+	profile := ep.obtainProfile(done, kindMASQUE)
+	require.NotNil(t, profile)
+	require.True(t, profile.inline, "the link's device, never pooled")
+	require.Equal(t, "link-device", profile.ID)
+	var config struct {
+		PrivateKey string `json:"private_key"`
+	}
+	require.NoError(t, json.Unmarshal(profile.MASQUE, &config))
+	require.NotEmpty(t, config.PrivateKey)
+
+	pooled, err := json.Marshal(map[string]string{"private_key": config.PrivateKey, "ipv4": "172.16.0.3"})
+	require.NoError(t, err)
+	ep.profiles.add(&warpProfile{Kind: kindMASQUE, ID: "pooled", Token: "token", MASQUE: pooled})
+
+	require.True(t, ep.rememberLinkDeviceRefused())
+	require.False(t, ep.rememberLinkDeviceRefused(), "once")
+	profile = ep.obtainProfile(done, kindMASQUE)
+	require.NotNil(t, profile)
+	require.Equal(t, "pooled", profile.ID, "a saved device after the refusal")
+
+	again := hNewWARP(t, ctx, hLinkOptions(device))
+	require.Nil(t, again.linkMASQUEProfile(), "remembered in the cache file")
+	other := hNewWARP(t, ctx, hLinkOptions(hLinkDevice(t)))
+	require.NotNil(t, other.linkMASQUEProfile(), "a link with another device is tried")
+}
