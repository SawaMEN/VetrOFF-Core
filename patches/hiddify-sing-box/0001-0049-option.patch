+)
+
+func TestH_XDriveLegacyTemplate(t *testing.T) {
+	for _, encoded := range []string{
+		`{"service":"template","template":"{\"put\":{\"url\":\"https://storage.example/put\"}}","front_address":"192.0.2.1","front_port":443}`,
+		`{"service":"template","template":{"put":{"url":"https://storage.example/put"}},"front_address":"192.0.2.1","front_port":443}`,
