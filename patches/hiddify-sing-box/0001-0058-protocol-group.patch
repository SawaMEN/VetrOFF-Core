+	state.Close()
+	target := &probeOutbound{Adapter: outbound.NewAdapter("direct", "never", nil, nil), fail: true}
+	state.postStart(map[string]adapter.Outbound{"never": target})
+	state.Close()
+	if target.calls.Load() != 0 {
+		t.Fatal("probe after shutdown")
+	}
+}
