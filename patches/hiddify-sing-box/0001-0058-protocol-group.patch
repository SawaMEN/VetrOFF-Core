+func TestXUIPanelBalancerCloseBeforeStart(t *testing.T) {
+	state, err := newBalanceState(context.Background(), option.XrayBalancerOptions{Strategy: "random", ProbeURL: "http://127.0.0.1:1/"})
+	if err != nil {
