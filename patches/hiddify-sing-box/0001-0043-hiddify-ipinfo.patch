+	}
+	if len(body) > maxResponseSize {
+		return nil, 65535, fmt.Errorf("response from [%s] exceeds %d bytes", p.URL, maxResponseSize)
+	}
+	ms := time.Since(start) / time.Millisecond
+	if ms >= 65535 {
+		ms = 65534
+	}
+	return body, uint16(ms), nil
