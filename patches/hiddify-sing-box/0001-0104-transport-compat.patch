+func (f *fakeCookieProvider) ApplyCookies(jar map[string]string) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.jar = make(map[string]string, len(jar))
+	maps.Copy(f.jar, jar)
