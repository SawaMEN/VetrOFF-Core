+type writeOnlyConn struct {
+	io.Writer
+}
+
+func (c writeOnlyConn) Read([]byte) (int, error)       { return 0, io.EOF }
+func (c writeOnlyConn) Write(p []byte) (int, error)    { return c.Writer.Write(p) }
+func (writeOnlyConn) Close() error                     { return nil }
