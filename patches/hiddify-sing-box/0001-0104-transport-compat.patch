+	jar, err := m.FetchCookiesFor("yandex")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if jar["a"] != "1" {
+		t.Fatalf("fetch = %v", jar)
+	}
+	if err := m.ApplyCookiesFor("yandex", map[string]string{"b": "2"}); err != nil {
+		t.Fatal(err)
