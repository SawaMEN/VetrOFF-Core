diff --git a/transport/compat/sudoku/pkg/connutil/write_buffers.go b/transport/compat/sudoku/pkg/connutil/write_buffers.go
new file mode 100644
index 0000000000000000000000000000000000000000..8f363ade33a0fd80436f4b60c608c7786ce15ed1
--- /dev/null
+++ b/transport/compat/sudoku/pkg/connutil/write_buffers.go
@@ -0,0 +1,48 @@
+package connutil
+
+import (
+	"io"
+	"net"
+)
+
+// BuffersWriter coalesces slices without retaining or modifying them. Wrappers
+// can preserve this optional capability without exposing their underlying conn.
+type BuffersWriter interface {
+	WriteBuffers(net.Buffers) (int64, error)
+}
+
+// WriteBuffers writes all slices in order, using the writer's coalescing path
+// when available. The fallback handles short writes without copying the payload.
+func WriteBuffers(w io.Writer, buffers net.Buffers) (int64, error) {
+	if writer, ok := w.(BuffersWriter); ok {
+		n, err := writer.WriteBuffers(buffers)
+		if err == nil {
+			var want int64
+			for _, p := range buffers {
+				want += int64(len(p))
+			}
+			if n != want {
+				err = io.ErrShortWrite
+			}
+		}
+		return n, err
+	}
+	var total int64
+	for _, p := range buffers {
+		for len(p) > 0 {
+			n, err := w.Write(p)
+			if n < 0 || n > len(p) {
+				return total, io.ErrShortWrite
+			}
+			total += int64(n)
+			p = p[n:]
+			if err != nil {
+				return total, err
+			}
+			if n == 0 {
+				return total, io.ErrShortWrite
+			}
+		}
+	}
+	return total, nil
+}
diff --git a/transport/compat/sudoku/pkg/connutil/write_buffers_test.go b/transport/compat/sudoku/pkg/connutil/write_buffers_test.go
