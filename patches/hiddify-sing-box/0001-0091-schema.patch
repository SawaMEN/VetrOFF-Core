diff --git a/schema/h_prefixable.go b/schema/h_prefixable.go
new file mode 100644
index 0000000000000000000000000000000000000000..77a5436b33db33127393108d0bab20f21e3aa72f
--- /dev/null
+++ b/schema/h_prefixable.go
@@ -0,0 +1,27 @@
+package schema
+
+import (
+	"reflect"
+
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// hPrefixableField describes the fork's string-backed CIDR options accurately.
+func (g *generator) hPrefixableField(fieldType reflect.Type) (*Node, error) {
+	listable := isListable(fieldType)
+	valueType := fieldType
+	if listable {
+		valueType = fieldType.Elem()
+	}
+	if valueType.Kind() != reflect.String {
+		return nil, E.New("prefixable schema tag requires strings")
+	}
+	node, err := g.Describe(prefixableType)
+	if err != nil {
+		return nil, err
+	}
+	if listable {
+		return ListableOf(node), nil
+	}
+	return node, nil
+}
diff --git a/schema/h_prefixable_test.go b/schema/h_prefixable_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a1e8dae124c099f913a87f210778c17001aea9ae
--- /dev/null
+++ b/schema/h_prefixable_test.go
@@ -0,0 +1,29 @@
+package schema
+
+import (
+	"context"
+	"reflect"
+	"testing"
+
+	"github.com/sagernet/sing/common/json/badoption"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestH_PrefixableSchema(t *testing.T) {
+	type options struct {
+		CIDRs badoption.Listable[string] `json:"ip_cidr" schema:"prefixable"`
+	}
+	data, err := Generate(context.Background(), reflect.TypeFor[options]())
+	require.NoError(t, err)
+	require.Contains(t, string(data), `"ip_cidr"`)
+	require.Contains(t, string(data), "IPAddressOrPrefix")
+}
+
+func TestH_PrefixableSchemaRejectsNonString(t *testing.T) {
+	type options struct {
+		CIDR int `json:"ip_cidr" schema:"prefixable"`
+	}
+	_, err := Generate(context.Background(), reflect.TypeFor[options]())
+	require.ErrorContains(t, err, "prefixable schema tag requires strings")
+}
