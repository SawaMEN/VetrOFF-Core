diff --git a/transport/v2rayxdrive/h_lifecycle.go b/transport/v2rayxdrive/h_lifecycle.go
new file mode 100644
index 0000000000000000000000000000000000000000..353a15c238e2f4a7d3aa5546be0c08909956b4bc
--- /dev/null
+++ b/transport/v2rayxdrive/h_lifecycle.go
@@ -0,0 +1,57 @@
+package v2rayxdrive
+
+import (
+	"net"
+	"sync"
+)
+
+// Keep transport ownership when the canonical storage implementation creates the connections.
+type hTrackedConn struct {
+	net.Conn
+	owner *Client
+	once  sync.Once
+	err   error
+}
+
+func (c *hTrackedConn) Upstream() any { return c.Conn }
+
+func (c *hTrackedConn) Close() error {
+	c.once.Do(func() {
+		c.err = c.Conn.Close()
+		c.owner.access.Lock()
+		delete(c.owner.connections, c)
+		c.owner.access.Unlock()
+	})
+	return c.err
+}
+
+func (c *Client) track(conn net.Conn) (net.Conn, error) {
+	c.access.Lock()
+	defer c.access.Unlock()
+	if c.closed {
+		conn.Close()
+		return nil, net.ErrClosed
+	}
+	tracked := &hTrackedConn{Conn: conn, owner: c}
+	c.connections[tracked] = struct{}{}
+	return tracked, nil
+}
+
+func (c *Client) closeConnections() error {
+	c.access.Lock()
+	if c.closed {
+		c.access.Unlock()
+		return nil
+	}
+	c.closed = true
+	c.cancel()
+	connections := make([]*hTrackedConn, 0, len(c.connections))
+	for conn := range c.connections {
+		connections = append(connections, conn)
+	}
+	c.access.Unlock()
+	for _, conn := range connections {
+		conn.Close()
+	}
+	return nil
+}
diff --git a/transport/v2rayxdrive/h_lifecycle_test.go b/transport/v2rayxdrive/h_lifecycle_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..de9b8180b43d01918f0d8cd71832e531fea7e1c2
--- /dev/null
+++ b/transport/v2rayxdrive/h_lifecycle_test.go
@@ -0,0 +1,30 @@
+package v2rayxdrive
+
+import (
+	"context"
+	"net"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestH_ClientCloseOwnsActiveConnections(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	c := &Client{ctx: ctx, cancel: cancel, connections: make(map[*hTrackedConn]struct{})}
+	a, b := net.Pipe()
+	defer b.Close()
+	conn, err := c.track(a)
+	require.NoError(t, err)
+	require.NoError(t, c.Close())
+	require.NoError(t, c.Close())
+	require.ErrorIs(t, ctx.Err(), context.Canceled)
+	_, err = conn.Write([]byte("closed"))
+	require.Error(t, err)
+	require.Empty(t, c.connections)
+	a2, b2 := net.Pipe()
+	defer b2.Close()
+	_, err = c.track(a2)
+	require.ErrorIs(t, err, net.ErrClosed)
+	_, err = a2.Write([]byte("late dial"))
+	require.Error(t, err)
+}
