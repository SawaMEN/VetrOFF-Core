@@ -42,3 +42,26 @@ func UnescapedPath(serviceName string) string {
 	}
 	return unescaped
 }
+
+// MultiPath selects Xray's TunMulti RPC method. Custom paths can declare
+// "/service/Tun|TunMulti"; without a pipe Xray uses the same custom stream
+// name for both methods.
+func MultiPath(serviceName string) string {
+	if !strings.HasPrefix(serviceName, "/") {
+		return "/" + url.PathEscape(serviceName) + "/TunMulti"
+	}
+	service, stream := Names(serviceName)
+	if ending := serviceName[strings.LastIndex(serviceName, "/")+1:]; strings.Contains(ending, "|") {
+		stream = url.PathEscape(strings.SplitN(ending, "|", 2)[1])
+	}
+	return "/" + service + "/" + stream
+}
+
+func UnescapedMultiPath(serviceName string) string {
+	path := MultiPath(serviceName)
+	unescaped, err := url.PathUnescape(path)
+	if err != nil {
+		return path
+	}
+	return unescaped
+}
diff --git a/common/grpcname/h_grpcname_test.go b/common/grpcname/h_grpcname_test.go
index 529231ca6162982860c7284b039e8414b5843b9e..b9294040c92b110248a876f9cae66ab2ca79572c 100644
--- a/common/grpcname/h_grpcname_test.go
+++ b/common/grpcname/h_grpcname_test.go
@@ -30,3 +30,19 @@ func TestH_Names(t *testing.T) {
 		require.Equal(t, test.path, Path(test.name), test.name)
 	}
 }
+
+func TestH_MultiPaths(t *testing.T) {
+	for _, tc := range []struct {
+		name, path, decoded string
+	}{
+		{"", "//TunMulti", "//TunMulti"},
+		{"TunService", "/TunService/TunMulti", "/TunService/TunMulti"},
+		{"a b", "/a%20b/TunMulti", "/a b/TunMulti"},
+		{"/my/path/Tun|TunMulti", "/my/path/TunMulti", "/my/path/TunMulti"},
+		{"/my/path/method", "/my/path/method", "/my/path/method"},
+		{"/a b/c d|e f", "/a%20b/e%20f", "/a b/e f"},
+	} {
+		require.Equal(t, tc.path, MultiPath(tc.name), tc.name)
+		require.Equal(t, tc.decoded, UnescapedMultiPath(tc.name), tc.name)
+	}
+}
