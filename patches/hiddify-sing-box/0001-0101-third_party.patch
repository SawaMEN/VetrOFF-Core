+				],
+				"balancers": [
+					{
+						"tag": "b1",
+						"selector": ["test"],
+						"fallbackTag": "fall"
+					},
+					{
+						"tag": "b2",
+						"selector": ["test"],
+						"strategy": {
+							"type": "leastload",
+							"settings": {
+								"healthCheck": {
+									"interval": "5m0s",
+									"sampling": 2,
+									"timeout": "5s",
+									"destination": "dest",
+									"connectivity": "conn"
+								},
+								"costs": [
+									{
+										"regexp": true,
+										"match": "\\d+(\\.\\d+)",
