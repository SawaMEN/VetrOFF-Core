+		header = &wechat{}
+	case WIREGUARD:
+		header = &wireguard{}
+	default:
+		return nil, errors.New("invalid id ", c.ID)
+	}
+	return &headerConn{
+		PacketConn: raw,
+		header:     header,
+	}, nil
+}
