+func startQuickClosingTCPServer() (net.Listener, error) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		return nil, err
+	}
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				break
+			}
+			b := make([]byte, 1024)
+			conn.Read(b)
+			conn.Close()
+		}
+	}()
+	return listener, nil
+}
+
