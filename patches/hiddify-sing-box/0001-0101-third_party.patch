+	_ = c.icmp4.Close()
+	_ = c.icmp6.Close()
+	c.wg.Wait()
+	close(c.readCh)
+	return nil
+}
+
+func (c *xicmpConnServer) LocalAddr() net.Addr {
+	return &net.UDPAddr{IP: []byte{0, 0, 0, 0}}
+}
+
+func (c *xicmpConnServer) SetDeadline(t time.Time) error {
+	_ = c.icmp4.SetDeadline(t)
+	_ = c.icmp6.SetDeadline(t)
+	return nil
+}
