+func (l *Listener) handleClient(conn *quic.Conn) {
+	handler := &httpHandler{
+		validator:   l.validator,
+		config:      l.config,
+		masqHandler: l.masqHandler,
+		quicParams:  l.quicParams,
+		addConn:     l.addConn,
+		conn:        conn,
+	}
+	h3s := http3.Server{
