+}
diff --git a/third_party/xray-core/transport/internet/grpc/config_test.go b/third_party/xray-core/transport/internet/grpc/config_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..04a995a433f2b657c88e6773dd67f32c2fe8aa3f
--- /dev/null
