+	}
+
+	allBytes := append(append([]byte{}, flattenChunks(c2s)...), flattenChunks(s2c)...)
+	totalMetrics := metricFromBytes(allBytes)
+	rotationSeen := len(unionKeys(c2sUsed, s2cUsed))
+
+	return caseResult{
