+		require.Empty(t, icmp)
+
+		packet := []byte{
+			0x60, 0x00, 0x00, 0x00,
+			0x00, 0x00,
+			0x00, 0x2A,
+			0x20, 0x01, 0x0d, 0xb8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01,
+			0x20, 0x01, 0x48, 0x60, 0x48, 0x60, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x88, 0x88,
