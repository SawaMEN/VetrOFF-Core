+package conf_test
+
+import (
+	"testing"
+
+	"github.com/xtls/xray-core/common"
+	. "github.com/xtls/xray-core/infra/conf"
+)
+
+func TestBufferSize(t *testing.T) {
+	cases := []struct {
+		Input  int32
+		Output int32
+	}{
+		{
+			Input:  0,
+			Output: 0,
+		},
+		{
+			Input:  -1,
+			Output: -1,
+		},
+		{
+			Input:  1,
+			Output: 1024,
+		},
+	}
+
+	for _, c := range cases {
+		bs := c.Input
+		pConf := Policy{
+			BufferSize: &bs,
+		}
+		p, err := pConf.Build()
+		common.Must(err)
+		if p.Buffer.Connection != c.Output {
+			t.Error("expected buffer size ", c.Output, " but got ", p.Buffer.Connection)
+		}
+	}
+}
