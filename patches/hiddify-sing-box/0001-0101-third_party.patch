@@ -0,0 +1,70 @@
+package noise
+
+import "testing"
+
+func benchmarkEngine(b *testing.B, script string) *scriptEngine {
+	b.Helper()
+	engine, err := newScriptEngine(writeScript(b, script))
+	if err != nil {
+		b.Fatal(err)
+	}
+	b.Cleanup(engine.pool.Close)
+	return engine
+}
+
+func benchmarkPackets(b *testing.B, engine *scriptEngine, want int) {
+	b.Helper()
+	b.ReportAllocs()
+	var buf []scriptPacket
+	for i := 0; i < b.N; i++ {
+		packets, err := engine.packets("192.0.2.1:443", buf[:0])
+		if err != nil {
+			b.Fatal(err)
+		}
+		if len(packets) != want {
+			b.Fatalf("got %d packets, want %d", len(packets), want)
+		}
+		buf = packets
+	}
+}
+
+func BenchmarkLuaNoiseHook(b *testing.B) {
+	benchmarkPackets(b, benchmarkEngine(b, `function HandleNoise(plan, address) end`), 0)
+}
+
+func BenchmarkLuaNoisePackets(b *testing.B) {
+	b.Run("add", func(b *testing.B) {
+		benchmarkPackets(b, benchmarkEngine(b, `
+local noise = require("xray.finalmask.noise")
+
+function HandleNoise(plan, address)
+    plan:Add(noise.Random(64))
+    plan:Add(noise.Random(64), 0)
+end
+`), 2)
+	})
+
+	b.Run("addrandom", func(b *testing.B) {
+		benchmarkPackets(b, benchmarkEngine(b, `
+function HandleNoise(plan, address)
+    plan:AddRandom(64)
+    plan:AddRandom(64, 0)
+end
+`), 2)
+	})
+
+	b.Run("static", func(b *testing.B) {
+		conn := &noiseConn{config: &Config{Items: []*Item{
+			{RandMin: 64, RandMax: 64, RandRangeMax: 255},
+			{RandMin: 64, RandMax: 64, RandRangeMax: 255},
+		}}}
+		b.ReportAllocs()
+		for i := 0; i < b.N; i++ {
+			for _, item := range conn.config.Items {
+				if len(conn.buildPacket(item)) != 64 {
+					b.Fatal("unexpected packet size")
+				}
+			}
+		}
+	})
+}
diff --git a/third_party/xray-core/transport/internet/finalmask/noise/script.go b/third_party/xray-core/transport/internet/finalmask/noise/script.go
new file mode 100644
index 0000000000000000000000000000000000000000..0e5512efdfe747fe1f98a98299d6c473443e5ac4
--- /dev/null
+++ b/third_party/xray-core/transport/internet/finalmask/noise/script.go
@@ -0,0 +1,107 @@
+package noise
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/log"
+	xlua "github.com/xtls/xray-core/common/lua"
+	lua "github.com/yuin/gopher-lua"
+)
+
+const (
+	scriptExecutionTimeout = time.Second
+	scriptInitTimeout      = 120 * time.Second
+)
+
+type scriptEngine struct {
+	pool *xlua.Pool
+}
+
+type scriptPacket struct {
+	packet []byte
+	delay  time.Duration
+}
+
+// TODO: close the pool of a mask whose inbound or outbound the API removed.
+var (
+	scriptsMu sync.Mutex
+	scripts   = make(map[*Config]*scriptEngine)
+)
+
+func (c *Config) engine() (*scriptEngine, error) {
+	scriptsMu.Lock()
+	defer scriptsMu.Unlock()
+
+	if engine := scripts[c]; engine != nil {
+		return engine, nil
+	}
+
+	engine, err := newScriptEngine(c.Script)
+	if err != nil {
+		return nil, err
+	}
+	scripts[c] = engine
+	return engine, nil
+}
+
+func newScriptEngine(script string) (*scriptEngine, error) {
+	program, err := xlua.Compile(script)
+	if err != nil {
+		return nil, err
+	}
+
+	pool, err := xlua.NewPool(context.Background(), scriptExecutionTimeout, program.NewStateFactory(
+		scriptInitTimeout,
+		256,
+		func(L *lua.LState) {
+			log.RegisterLua(L)
+			RegisterLua(L)
+			registerPlan(L)
+		},
+		func(L *lua.LState) error {
+			if L.GetGlobal("HandleNoise").Type() != lua.LTFunction {
+				return errors.New("noise script must define HandleNoise(...)")
+			}
+			return nil
+		}))
+	if err != nil {
+		return nil, err
+	}
+
+	return &scriptEngine{pool: pool}, nil
+}
+
+func (e *scriptEngine) packets(addr string, into []scriptPacket) ([]scriptPacket, error) {
+	var noise []scriptPacket
+	var reported error
+	if err := e.pool.WithState(nil, 0, func(L *lua.LState) error {
+		var err error
+		noise, reported, err = callHook(L, addr, into)
+		return err
+	}); err != nil {
+		return nil, err
+	}
+	return noise, reported
+}
+
+func callHook(L *lua.LState, addr string, into []scriptPacket) (packets []scriptPacket, reported error, err error) {
+	data, plan, err := luaPlan(L)
+	if err != nil {
+		return nil, nil, err
+	}
+	hook := L.GetGlobal("HandleNoise")
+	if hook.Type() != lua.LTFunction {
+		return nil, nil, errors.New("noise script must define HandleNoise(...)")
+	}
+
+	plan.packets, plan.bytes, plan.open = into[:0], 0, true
+	defer func() { plan.packets, plan.open = nil, false }()
+
+	if err := L.CallByParam(lua.P{Fn: hook, NRet: 1, Protect: true}, data, lua.LString(addr)); err != nil {
+		return nil, nil, err
+	}
+	return plan.packets, xlua.ReadError(L.Get(-1), "noise script error must be an error or a string"), nil
+}
