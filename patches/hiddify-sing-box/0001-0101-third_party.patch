+			domain:        "",
+			wantErr:       true,
+			needsMoreData: false,
+		},
+		{
+			name:          "DNS Packet Server",
+			hexData:       "",
+			domain:        "",
+			wantErr:       true,
+			needsMoreData: false,
+		},
+		{
+			name:          "DNS Packet Server",
+			hexData:       "",
+			domain:        "",
+			wantErr:       true,
+			needsMoreData: false,
+		},
