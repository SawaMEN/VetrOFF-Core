+		select {
+		case <-c.closeCh:
+			return
+		case <-c.poolCh:
+			delay = initPollDelay
+		case <-ticker.C:
+			delay *= pollDelayMultiplier
+			if delay > maxPollDelay {
+				delay = maxPollDelay
+			}
+		}
