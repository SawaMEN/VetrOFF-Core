+func clientIDToAddr(clientID [8]byte) *net.UDPAddr {
+	ip := make(net.IP, 16)
+
+	ip[0] = 0xfd
+	ip[1] = 0x00
+
+	copy(ip[8:], clientID[:])
+
+	return &net.UDPAddr{IP: ip}
+}
+
+type record struct {
+	id   int
+	seq  int
+	addr net.Addr
+	dst  net.IP
+	last time.Time
