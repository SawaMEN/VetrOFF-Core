+func mustSendRecv(
+	t *testing.T,
+	from net.PacketConn,
+	to net.PacketConn,
+	msg []byte,
+) {
+	t.Helper()
+
+	go func() {
+		_, err := from.WriteTo(msg, to.LocalAddr())
+		if err != nil {
+			t.Error(err)
+		}
+	}()
+
+	buf := make([]byte, 1024)
+	n, _, err := to.ReadFrom(buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if n != len(msg) {
+		t.Fatalf("unexpected size: %d", n)
+	}
+
+	if !bytes.Equal(buf[:n], msg) {
+		t.Fatalf("unexpected data")
+	}
+}
