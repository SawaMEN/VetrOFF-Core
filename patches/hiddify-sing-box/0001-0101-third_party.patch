+			id:   echo.ID,
+			seq:  echo.Seq,
+			addr: addr,
+			dst:  cm.Dst,
+			last: time.Now(),
+		}
+		c.mu.Unlock()
+
+		p := pool.Get().([]byte)[:len(echo.Data[8:])]
+		copy(p, echo.Data[8:])
+
+		select {
+		case c.readCh <- packet{
+			p:    p,
+			addr: cAddr,
+		}:
+		case <-c.closeCh:
+			pool.Put(p)
+			return
+		}
+	}
+}
