diff --git a/third_party/xray-core/proxy/dns/config.proto b/third_party/xray-core/proxy/dns/config.proto
new file mode 100644
index 0000000000000000000000000000000000000000..cfa3e28d3371b1094d89b7fc9c7789bc2e5ff9c1
