+	"github.com/xtls/xray-core/transport/internet"
+)
+
+const protocolName = "masque"
+
+const DefaultPath = "/.well-known/masque/ip/*/*/"
+
+func (c *Config) keepAlivePeriod() time.Duration {
+	if c.Xmux == nil {
+		return 0
