+	toRead <- (&routeAdvertisementCapsule{IPAddressRanges: []IPRoute{route6, route4a}}).append(nil)
+	ctx, cancel := context.WithTimeout(t.Context(), time.Second)
+	defer cancel()
+	_, err := conn.Routes(ctx)
+	require.ErrorIs(t, err, net.ErrClosed)
+}
