index 0000000000000000000000000000000000000000..7518125f6eac188652944019dfc74872e299caf3
--- /dev/null
+++ b/route/rule/xui_panel_sniff_test.go
@@ -0,0 +1,30 @@
+package rule
+
+import (
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json"
+	"github.com/sagernet/sing/common/logger"
+)
+
+func TestXUIPanelSniffOverrideAction(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		raw := `{"action":"sniff","sniffer":["http","tls"],"override_destination":false}`
+		if enabled {
+			raw = `{"action":"sniff","sniffer":["http","tls"],"override_destination":true}`
+		}
+		var options option.RuleAction
+		if err := json.Unmarshal([]byte(raw), &options); err != nil {
+			t.Fatal(err)
+		}
+		action, err := NewRuleAction(logger.NOP(), options)
+		if err != nil {
+			t.Fatal(err)
+		}
+		sniff, ok := action.(*RuleActionSniff)
+		if !ok || sniff.OverrideDestination != enabled || len(sniff.StreamSniffers) != 2 {
+			t.Fatalf("native decoder/action lost sniff policy: %#v", action)
+		}
+	}
+}
