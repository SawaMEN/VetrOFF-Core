diff --git a/protocol/shadowsocks/h_method.go b/protocol/shadowsocks/h_method.go
new file mode 100644
index 0000000000000000000000000000000000000000..f7612bd89df786b1b11f61e00fa9ac4169deabd8
--- /dev/null
+++ b/protocol/shadowsocks/h_method.go
@@ -0,0 +1,25 @@
+package shadowsocks
+
+import "strings"
+
+// methodAliases maps the cipher names Xray accepts to the names sing-shadowsocks knows.
+// Subscriptions written for Xray clients use these names (for example "chacha20-poly1305"),
+// and sing-shadowsocks rejects them with "unknown method".
+var methodAliases = map[string]string{
+	"aead_aes_128_gcm":        "aes-128-gcm",
+	"aead_aes_256_gcm":        "aes-256-gcm",
+	"chacha20-poly1305":       "chacha20-ietf-poly1305",
+	"aead_chacha20_poly1305":  "chacha20-ietf-poly1305",
+	"xchacha20-poly1305":      "xchacha20-ietf-poly1305",
+	"aead_xchacha20_poly1305": "xchacha20-ietf-poly1305",
+	"plain":                   "none",
+}
+
+// normalizeMethod returns the sing-shadowsocks name of a cipher given in a user's config.
+func normalizeMethod(method string) string {
+	lower := strings.ToLower(strings.TrimSpace(method))
+	if alias, ok := methodAliases[lower]; ok {
+		return alias
+	}
+	return lower
+}
diff --git a/protocol/shadowsocks/h_method_test.go b/protocol/shadowsocks/h_method_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..13087820c1f7f04219d9eb347d8b4d2cabfb0020
--- /dev/null
+++ b/protocol/shadowsocks/h_method_test.go
@@ -0,0 +1,43 @@
+package shadowsocks
+
+import (
+	"context"
+	"testing"
+
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+
+	"github.com/stretchr/testify/require"
+)
+
+// Subscriptions written for Xray clients name ciphers the way Xray does (hiddify/hiddify-app#2622).
+func TestH_ShadowsocksXrayMethodNames(t *testing.T) {
+	logger := log.NewNOPFactory().NewLogger("test")
+	for _, method := range []string{
+		"chacha20-poly1305", "aead_chacha20_poly1305", "CHACHA20-POLY1305",
+		"xchacha20-poly1305", "aead_xchacha20_poly1305",
+		"aead_aes_128_gcm", "aead_aes_256_gcm", "plain",
+	} {
+		t.Run(method, func(t *testing.T) {
+			_, err := NewOutbound(context.Background(), newTestRouter(), logger, "out", option.ShadowsocksOutboundOptions{
+				Server:     "127.0.0.1",
+				ServerPort: 1,
+				Method:     method,
+				Password:   "password",
+			})
+			require.NoError(t, err)
+			_, err = NewInbound(context.Background(), newTestRouter(), logger, "in", option.ShadowsocksInboundOptions{
+				Method:   method,
+				Password: "password",
+			})
+			require.NoError(t, err)
+		})
+	}
+}
+
+func TestH_ShadowsocksXrayMethodNamesMatchCiphers(t *testing.T) {
+	require.Equal(t, "chacha20-ietf-poly1305", normalizeMethod("chacha20-poly1305"))
+	require.Equal(t, "xchacha20-ietf-poly1305", normalizeMethod("aead_xchacha20_poly1305"))
+	require.Equal(t, "2022-blake3-chacha20-poly1305", normalizeMethod("2022-blake3-chacha20-poly1305"))
+	require.Equal(t, "unknown-cipher", normalizeMethod("unknown-cipher"))
+}
