+//go:build linux
+
+package oomprofile
+
+import (
+    "os"
+    "strconv"
+    "strings"
+)
+
+// readMapping parses /proc/self/maps without relying on the unexported
+// runtime/pprof.parseProcSelfMaps symbol removed from recent Go toolchains.
+func (b *profileBuilder) readMapping() {
+    data, _ := os.ReadFile("/proc/self/maps")
+    for _, line := range strings.Split(string(data), "\n") {
+        fields := strings.Fields(line)
+        if len(fields) < 5 { continue }
+        region := strings.SplitN(fields[0], "-", 2)
+        if len(region) != 2 { continue }
+        lo, errLo := strconv.ParseUint(region[0], 16, 64)
+        hi, errHi := strconv.ParseUint(region[1], 16, 64)
+        offset, errOffset := strconv.ParseUint(fields[2], 16, 64)
+        if errLo != nil || errHi != nil || errOffset != nil || hi <= lo { continue }
+        file := ""
+        if len(fields) > 5 { file = strings.Join(fields[5:], " ") }
+        b.addMappingEntry(lo, hi, offset, file, "", false)
+    }
+    if len(b.mem) == 0 {
+        b.addMappingEntry(0, 0, 0, "", "", true)
+    }
+}
