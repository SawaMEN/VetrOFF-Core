diff --git a/h_xray_xdrive_interop_test.go b/h_xray_xdrive_interop_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..68e2dd7f5ab0fb897cbb5df08094b00801d0779c
--- /dev/null
