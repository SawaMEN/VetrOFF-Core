+		got := make([]byte, 2048)
+		n, addr, err := packet.ReadFrom(got)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(got[:n], payload) || addr.String() != dest.String() {
+			t.Fatal("UDP fallback corruption")
