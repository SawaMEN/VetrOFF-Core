diff --git a/replace/utls-native/internal/helper/typeconv.go b/replace/utls-native/internal/helper/typeconv.go
new file mode 100644
index 0000000000000000000000000000000000000000..73ec0583e38bfa7efb3f3043c4c0fc98bd9c619f
--- /dev/null
+++ b/replace/utls-native/internal/helper/typeconv.go
@@ -0,0 +1,23 @@
+package helper
+
+import (
+	"errors"
+
+	"golang.org/x/crypto/cryptobyte"
+)
+
+// Uint8to16 converts a slice of uint8 to a slice of uint16.
+// e.g. []uint8{0x00, 0x01, 0x00, 0x02} -> []uint16{0x0001, 0x0002}
+func Uint8to16(in []uint8) ([]uint16, error) {
+	s := cryptobyte.String(in)
+	var out []uint16
+	for !s.Empty() {
+		var v uint16
+		if s.ReadUint16(&v) {
+			out = append(out, v)
+		} else {
+			return nil, errors.New("ReadUint16 failed")
+		}
+	}
+	return out, nil
+}
diff --git a/replace/utls-native/internal/hkdf/hkdf.go b/replace/utls-native/internal/hkdf/hkdf.go
new file mode 100644
index 0000000000000000000000000000000000000000..94caaf1478b37a8c35c9c1e73d367323d3a41486
