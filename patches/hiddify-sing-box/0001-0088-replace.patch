+			ivLen:  cs.IvLen,
+			ka:     cs.Ka,
+			flags:  cs.Flags,
+			cipher: cs.Cipher,
+			mac:    cs.Mac,
+			aead:   cs.Aead,
+		}
+	}
+}
+
+func (cs *cipherSuite) getPublicObj() PubCipherSuite {
+	if cs == nil {
+		return PubCipherSuite{}
+	} else {
