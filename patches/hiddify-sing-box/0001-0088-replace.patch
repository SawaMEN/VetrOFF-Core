diff --git a/replace/utls-native/internal/cpu/cpu_arm64_openbsd.go b/replace/utls-native/internal/cpu/cpu_arm64_openbsd.go
new file mode 100644
index 0000000000000000000000000000000000000000..f89eba61170f11f8d21fdf997a0d796fb4e676dd
--- /dev/null
