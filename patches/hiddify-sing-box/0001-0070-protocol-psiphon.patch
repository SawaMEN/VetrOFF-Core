+func (p *Psiphon) onNotice(event NoticeEvent, notify func()) {
+	if event.Type != "Tunnels" {
+		return
+	}
+	count, ok := noticeCount(event.Data)
+	if !ok {
+		return
+	}
+	p.mu.RLock()
+	closed, controller := p.closed, p.controller
+	p.mu.RUnlock()
