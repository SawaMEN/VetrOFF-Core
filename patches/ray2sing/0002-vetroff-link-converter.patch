diff --git a/ray2sing/vetroff.go b/ray2sing/vetroff.go
new file mode 100644
--- /dev/null
+++ b/ray2sing/vetroff.go
@@ -0,0 +1,15 @@
+package ray2sing
+
+import (
+    "errors"
+    sdk "github.com/SawaMEN/VetroffProxy"
+    C "github.com/sagernet/sing-box/constant"
+    T "github.com/sagernet/sing-box/option"
+)
+// VetroffSingbox validates the canonical URI without logging its credentials.
+func VetroffSingbox(link string) (*T.Outbound, error) {
+    if _, err := sdk.ClientConfigFromLink(link); err != nil {
+        return nil, errors.New("invalid VetrOFF connection link")
+    }
+    return &T.Outbound{Type: C.TypeVetrOFF, Tag: "VetrOFFProxy", Options: &T.VetrOFFOutboundOptions{Link: link}}, nil
+}
diff --git a/ray2sing/vetroff_test.go b/ray2sing/vetroff_test.go
new file mode 100644
--- /dev/null
+++ b/ray2sing/vetroff_test.go
@@ -0,0 +1,19 @@
+package ray2sing
+
+import (
+    "encoding/base64"
+    "testing"
+    C "github.com/sagernet/sing-box/constant"
+    T "github.com/sagernet/sing-box/option"
+)
+func TestVetroffShareLink(t *testing.T) {
+    raw := `{"v":1,"servers":["https://edge.example.com"],"username":"alice","password":"secret"}`
+    link := "vetroff://" + base64.RawURLEncoding.EncodeToString([]byte(raw))
+    out, err := VetroffSingbox(link)
+    if err != nil { t.Fatal(err) }
+    if out.Type != C.TypeVetrOFF || out.Options.(*T.VetrOFFOutboundOptions).Link != link { t.Fatal("invalid conversion") }
+}
+func TestVetroffInvalidLinkDoesNotLeakSecrets(t *testing.T) {
+    _, err := VetroffSingbox("vetroff://private-password")
+    if err == nil || err.Error() != "invalid VetrOFF connection link" { t.Fatal("invalid or revealing error") }
+}
