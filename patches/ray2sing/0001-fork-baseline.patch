+
+// awgHeaderProtectionKey returns the key as the 64 hex digits amneziawg-go reads; links and
+// configs also write it in base64, like the other WireGuard keys.
+func awgHeaderProtectionKey(s string) string {
+	s = linkKey(s)
+	if len(s) == 64 {
+		if _, err := hex.DecodeString(s); err == nil {
+			return s
+		}
+	}
+	if key, err := base64.StdEncoding.DecodeString(s); err == nil && len(key) == 32 {
+		return hex.EncodeToString(key)
+	}
+	return s
+}
+
+// awgBool reads an AmneziaWG 3.1 flag. amneziawg-tools writes "on" or "off" in a .conf and also
+// reads a number (true when not 0); links write true or false.
+func awgBool(value string) bool {
