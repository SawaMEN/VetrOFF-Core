+
+// Without sni, the SNI is the transport host, then the server address (left to sing-box as empty).
+func TestTLSServerNameFallsBackToHost(t *testing.T) {
+	cases := []struct{ link, want string }{
+		// CDN IP as address, domain only in host: the issue #2466 link shape
+		{"vless://" + testUUID + "@104.16.1.1:443?type=ws&encryption=none&path=/ws&host=example.com&security=tls&fp=&alpn=http%2F1.1#t", "example.com"},
+		// sni wins over host
+		{"vless://" + testUUID + "@104.16.1.1:443?type=ws&path=/ws&host=example.com&sni=sni.example.com&security=tls#t", "sni.example.com"},
+		// first of several hosts, port dropped
+		{"vless://" + testUUID + "@104.16.1.1:443?type=ws&path=/ws&host=a.example.com%3A8443%2Cb.example.com&security=tls#t", "a.example.com"},
+		// neither: sing-box uses the server address
+		{"vless://" + testUUID + "@example.com:443?type=ws&path=/ws&security=tls#t", ""},
+	}
+	for _, c := range cases {
+		tls := convertOne(t, c.link).Options.(*option.VLESSOutboundOptions).TLS
+		if tls == nil || tls.ServerName != c.want {
+			t.Errorf("%s: server_name %+v, want %q", c.link, tls, c.want)
+		}
+	}
+}
diff --git a/ray2sing_test/xdrive_test.go b/ray2sing_test/xdrive_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..6a0ad08dc2a4087190db55d6f40a39cb4f8aa231
--- /dev/null
+++ b/ray2sing_test/xdrive_test.go
@@ -0,0 +1,42 @@
+package ray2sing_test
+
+import (
+	"net/url"
+	"testing"
+
+	"github.com/hiddify/ray2sing/ray2sing"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/experimental/libbox"
+	"github.com/sagernet/sing-box/option"
+)
+
+// An XDRIVE link carries Xray's xdriveSettings as JSON in xdrive=, with VLESS encryption.
+func TestXDriveLink(t *testing.T) {
+	settings := `{"service":"google-drive","remoteFolder":"1AbC","secrets":["id","secret","token"],"pollIntervalMs":100,"sessionTtlSeconds":77,"xmux":{"maxConnections":"2-4"},"address":"216.239.38.120","port":443}`
+	link := "vless://dffb7646-1656-427a-8187-9c056a6a5fd5@127.0.0.1:1?encryption=mlkem768x25519plus.native.0rtt.9zy0chrl2-czYBSv11y34twAmvJlMoJIDhhMGc--lDo&security=tls&fp=chrome&type=xdrive&xdrive=" + url.QueryEscape(settings) + "#xdrive"
+	options, err := ray2sing.Ray2SingboxOptions(libbox.BaseContext(nil), link, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	vless := options.Outbounds[0].Options.(*option.VLESSOutboundOptions)
+	if vless.Transport == nil || vless.Transport.Type != C.V2RayTransportTypeXDrive {
+		t.Fatalf("transport %+v", vless.Transport)
+	}
+	xdrive := vless.Transport.XDriveOptions
+	if xdrive.Service != "google-drive" || xdrive.RemoteFolder != "1AbC" || len(xdrive.Secrets) != 3 || xdrive.PollIntervalMs != 100 || xdrive.SessionTtlSeconds != 77 {
+		t.Fatalf("xdrive %+v", xdrive)
+	}
+	if xdrive.Xmux == nil || xdrive.Xmux.MaxConnections.From != 2 || xdrive.Xmux.MaxConnections.To != 4 {
+		t.Fatalf("xmux %+v", xdrive.Xmux)
+	}
+	if xdrive.FrontingAddress != "216.239.38.120" || xdrive.FrontingPort != 443 {
+		t.Fatalf("fronting %s:%d", xdrive.FrontingAddress, xdrive.FrontingPort)
+	}
+	if vless.Encryption == "" {
+		t.Fatal("encryption dropped")
+	}
+
+	if _, err := ray2sing.Ray2SingboxOptions(libbox.BaseContext(nil), "vless://dffb7646-1656-427a-8187-9c056a6a5fd5@127.0.0.1:1?type=xdrive#x", false); err == nil {
+		t.Fatal("a link without xdrive= must fail")
+	}
+}
diff --git a/ray2sing_test/xhttp_extra_test.go b/ray2sing_test/xhttp_extra_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..97a7deaa3e0d56ebbddb17f70d046646f31125e4
--- /dev/null
+++ b/ray2sing_test/xhttp_extra_test.go
@@ -0,0 +1,37 @@
+package ray2sing_test
+
+import (
+	"net/url"
+	"testing"
+)
+
+// Xray writes the XHTTP extra in camelCase (xPaddingKey, scMaxEachPostBytes, noGRPCHeader, xmux's
+// hMaxRequestTimes, downloadSettings' tlsSettings.serverName...); every value reaches the sing-box
+// options, whose keys are snake_case. Header names are kept as written. hiddify-app#2479
+func TestXHTTPExtraCamelCase(t *testing.T) {
+	extra := `{"xPaddingHeader":"9267f8","xPaddingKey":"_826c26","xPaddingMethod":"tokenish","xPaddingObfsMode":true,` +
+		`"xPaddingPlacement":"header","xPaddingBytes":"250-950","scMaxEachPostBytes":"500000-1000000","noGRPCHeader":true,` +
+		`"uplinkHTTPMethod":"PUT","headers":{"User-Agent":"curl/8","X-Custom":"1"},` +
+		`"xmux":{"maxConcurrency":"16-32","cMaxReuseTimes":"0","hMaxRequestTimes":"600-900","hMaxReusableSecs":"1800-3000","hKeepAlivePeriod":60},` +
+		`"downloadSettings":{"address":"dl.example.com","port":8443,"security":"tls","tlsSettings":{"serverName":"dl.example.com","allowInsecure":true,"alpn":["h2"],"fingerprint":"chrome"},` +
+		`"xhttpSettings":{"path":"/down","host":"dl.example.com"},"xPaddingKey":"dlkey"}}`
+	got := convert(t, "vless://bf000d23-0752-40b4-affe-68f7707a9661@example.com:443?type=xhttp&mode=stream-one&security=tls&fp=firefox&sni=example.com&path=%2Fx&extra="+
+		url.QueryEscape(extra)+"#t")
+	wantAll(t, got,
+		`"x_padding_header":"9267f8"`, `"x_padding_key":"_826c26"`, `"x_padding_method":"tokenish"`,
+		`"x_padding_obfs_mode":true`, `"x_padding_placement":"header"`, `"x_padding_bytes":"250-950"`,
+		`"sc_max_each_post_bytes":"500000-1000000"`, `"no_grpc_header":true`, `"uplink_http_method":"PUT"`,
+		`"User-Agent":"curl/8"`, `"X-Custom":"1"`,
+		`"max_concurrency":"16-32"`, `"h_max_request_times":"600-900"`, `"h_max_reusable_secs":"1800-3000"`, `"h_keep_alive_period":60`,
+		`"server":"dl.example.com"`, `"server_port":8443`, `"path":"/down"`, `"x_padding_key":"dlkey"`,
+		`"server_name":"dl.example.com"`, `"insecure":true`,
+	)
+}
+
+// sing-box style snake_case keys in extra keep working.
+func TestXHTTPExtraSnakeCase(t *testing.T) {
+	extra := `{"x_padding_key":"k1","x_padding_method":"tokenish","x_padding_obfs_mode":true}`
+	got := convert(t, "vless://bf000d23-0752-40b4-affe-68f7707a9661@example.com:443?type=xhttp&mode=packet-up&security=tls&sni=example.com&path=%2Fx&extra="+
+		url.QueryEscape(extra)+"#t")
+	wantAll(t, got, `"x_padding_key":"k1"`, `"x_padding_method":"tokenish"`, `"x_padding_obfs_mode":true`)
+}
