diff --git a/ray2sing/slipnet.go b/ray2sing/slipnet.go
new file mode 100644
index 0000000000000000000000000000000000000000..f7848fbd3f8f62c5272273d4bd9f933eb2b44232
--- /dev/null
+++ b/ray2sing/slipnet.go
@@ -0,0 +1,293 @@
+package ray2sing
+
+import (
+	"fmt"
+	"net"
+	"net/url"
+	"strconv"
+	"strings"
+
+	T "github.com/sagernet/sing-box/option"
+)
+
+// A slipnet:// link is a SlipNet profile: base64 of fields separated by "|" (the app's export
+// format, version 18). The DNS tunnel types become a dnstt outbound with the outbound the SlipNet
+// server forwards to in front of it, as the chain "front -> dnstt://...", so that the existing
+// link parsers build both:
+//
+//   - dnstt and sayedns (NoizDNS): the original DNSTT wire format; the NoizDNS server reads it,
+//     and NoizDNS's shorter names are kept. Its stealth label splitting and cover traffic are
+//     client-side only and are not reproduced.
+//   - vaydns: the VayDNS wire format with the profile's record type, name length, rate and
+//     client id size.
+//   - the _ssh variants: an ssh outbound through the tunnel; the others a socks outbound with the
+//     profile's SOCKS user and password.
+//
+// A standalone ssh profile becomes an ssh:// link. slipnet-enc:// (locked) profiles, Slipstream,
+// NaiveProxy, Tor, DoH and VLESS profiles are not read.
+
+// slipnetProfile holds the fields of a profile this converter uses.
+type slipnetProfile struct {
+	tunnelType   string
+	name         string
+	domain       string
+	resolvers    string // "8.8.8.8:53:0,1.1.1.1:53:0"
+	publicKey    string
+	socksUser    string
+	socksPass    string
+	sshUser      string
+	sshPass      string
+	sshPort      int
+	sshHost      string
+	dnsTransport string // udp, tcp, tls (DoT), https (DoH)
+	dohURL       string
+	payloadSize  int // KCP MTU, 0 = full
+
+	vaydnsDnsttCompat  bool
+	vaydnsRecordType   string
+	vaydnsMaxQnameLen  int
+	vaydnsRps          float64
+	vaydnsMaxNumLabels int
+	vaydnsClientIDSize int
+
+	sshTLS, sshWS bool
+	sshHTTPProxy  string
+}
+
+func parseSlipnetProfile(link string) (*slipnetProfile, error) {
+	lower := strings.ToLower(link)
+	if strings.HasPrefix(lower, "slipnet-enc://") {
+		return nil, fmt.Errorf("slipnet-enc:// locked profiles are not supported, export the profile as a plain slipnet:// link")
+	}
+	if !strings.HasPrefix(lower, "slipnet://") {
+		return nil, fmt.Errorf("not a slipnet:// link")
+	}
+	body := strings.Join(strings.Fields(link[len("slipnet://"):]), "")
+	if i := strings.IndexByte(body, '#'); i >= 0 {
+		body = body[:i]
+	}
+	decoded, err := decodeBase64FaultTolerant(body)
+	if err != nil {
+		return nil, fmt.Errorf("slipnet link: %w", err)
+	}
+	fields := strings.Split(decoded, "|")
+	if len(fields) < 12 {
+		return nil, fmt.Errorf("slipnet link: %d fields, at least 12 needed", len(fields))
+	}
+	field := func(i int) string {
+		if i < len(fields) {
+			return fields[i]
+		}
+		return ""
+	}
+	intField := func(i int) int {
+		v, _ := strconv.Atoi(field(i))
+		return v
+	}
+	p := &slipnetProfile{
+		tunnelType:   strings.ToLower(field(1)),
+		name:         field(2),
+		domain:       field(3),
+		resolvers:    field(4),
+		publicKey:    field(11),
+		socksUser:    field(12),
+		socksPass:    field(13),
+		dohURL:       field(21),
+		dnsTransport: strings.ToLower(field(22)),
+		payloadSize:  intField(39),
+	}
+	if len(fields) > 19 {
+		p.sshUser = field(15)
+		p.sshPass = field(16)
+		p.sshPort = intField(17)
+		if p.sshPort <= 0 {
+			p.sshPort = 22
+		}
+		p.sshHost = field(19)
+	}
+	if len(fields) > 49 {
+		p.vaydnsDnsttCompat = field(41) == "1"
+		p.vaydnsRecordType = field(42)
+		p.vaydnsMaxQnameLen = intField(43)
+		p.vaydnsRps, _ = strconv.ParseFloat(field(44), 64)
+		p.vaydnsMaxNumLabels = intField(48)
+		p.vaydnsClientIDSize = intField(49)
+	}
+	if len(fields) > 59 {
+		p.sshTLS = field(50) == "1"
+		p.sshHTTPProxy = field(52)
+		p.sshWS = field(55) == "1"
+	}
+	return p, nil
+}
+
+// dnsttResolvers writes the profile's resolvers for the dnstt outbound, in the profile's DNS
+// transport: plain UDP "host:port", DoT "dot://host:port" or DoH "https://...".
+func (p *slipnetProfile) dnsttResolvers() []string {
+	var resolvers []string
+	for _, entry := range strings.Split(p.resolvers, ",") {
+		parts := strings.Split(strings.TrimSpace(entry), ":")
+		host := parts[0]
+		if host == "" {
+			continue
+		}
+		port := "53"
+		if len(parts) >= 2 && parts[1] != "" {
+			port = parts[1]
+		}
+		switch p.dnsTransport {
+		case "https", "doh":
+			if p.dohURL != "" {
+				return []string{p.dohURL}
+			}
+			resolvers = append(resolvers, "https://"+host+"/dns-query")
+		case "tls", "dot":
+			if port == "53" {
+				port = "853"
+			}
+			resolvers = append(resolvers, "dot://"+net.JoinHostPort(host, port))
+		default: // udp; tcp DNS is not supported, plain UDP is used
+			resolvers = append(resolvers, net.JoinHostPort(host, port))
+		}
+	}
+	if len(resolvers) == 0 {
+		resolvers = []string{"auto"}
+	}
+	return resolvers
+}
+
+// chain writes the links the profile stands for, joined with " -> " (the first goes through the
+// second).
+func (p *slipnetProfile) chain() (string, error) {
+	sshMode := strings.HasSuffix(p.tunnelType, "_ssh")
+	base := strings.TrimSuffix(p.tunnelType, "_ssh")
+	switch base {
+	case "dnstt", "sayedns", "vaydns", "":
+	case "ssh", "direct":
+		if p.sshTLS || p.sshWS || p.sshHTTPProxy != "" {
+			return "", fmt.Errorf("slipnet profile %q: SSH over TLS, WebSocket or an HTTP proxy is not supported", p.name)
+		}
+		if p.sshHost == "" {
+			return "", fmt.Errorf("slipnet profile %q: the SSH server address is missing", p.name)
+		}
+		return p.sshLink(p.sshHost, p.sshPort), nil
+	default:
+		return "", fmt.Errorf("slipnet profile %q: tunnel type %q is not supported (DNSTT, NoizDNS, VayDNS and SSH are)", p.name, p.tunnelType)
+	}
+	if p.publicKey == "" {
+		return "", fmt.Errorf("slipnet profile %q: the server's public key is missing", p.name)
+	}
+	if p.domain == "" {
+		return "", fmt.Errorf("slipnet profile %q: the tunnel domain is missing", p.name)
+	}
+
+	query := url.Values{}
+	query.Set("domain", p.domain)
+	query.Set("pubkey", p.publicKey)
+	query.Set("resolver", strings.Join(p.dnsttResolvers(), ","))
+	switch base {
+	case "vaydns":
+		query.Set("dnstt-compat", boolParam(p.vaydnsDnsttCompat))
+		if p.vaydnsRecordType != "" {
+			query.Set("record-type", p.vaydnsRecordType)
+		}
+		if p.vaydnsMaxQnameLen > 0 {
+			query.Set("max-qname-len", strconv.Itoa(p.vaydnsMaxQnameLen))
+		}
+		if p.vaydnsRps > 0 {
+			query.Set("rps", strconv.FormatFloat(p.vaydnsRps, 'f', -1, 64))
+		}
+		if p.vaydnsMaxNumLabels > 0 {
+			query.Set("max-num-labels", strconv.Itoa(p.vaydnsMaxNumLabels))
+		}
+		if p.vaydnsClientIDSize > 0 {
+			query.Set("clientid-size", strconv.Itoa(p.vaydnsClientIDSize))
+		}
+	case "sayedns":
+		query.Set("dnstt-compat", "1")
+		query.Set("max-qname-len", "150") // NoizDNS keeps names short
+	default:
+		query.Set("dnstt-compat", "1")
+	}
+	if p.payloadSize > 0 {
+		query.Set("mtu", strconv.Itoa(p.payloadSize))
+	}
+	tunnel := url.URL{Scheme: "dnstt", Host: p.domain, RawQuery: query.Encode(), Fragment: p.name}
+
+	var front string
+	if sshMode {
+		user, pass := p.sshUser, p.sshPass
+		if user == "" {
+			user, pass = p.socksUser, p.socksPass
+		}
+		if user == "" {
+			return "", fmt.Errorf("slipnet profile %q: the SSH user is missing", p.name)
+		}
+		front = p.sshLinkWith(user, pass, "127.0.0.1", p.sshPort)
+	} else {
+		socks := url.URL{Scheme: "socks", Host: "127.0.0.1:1080", Fragment: p.name}
+		if p.socksUser != "" {
+			socks.User = url.UserPassword(p.socksUser, p.socksPass)
+		}
+		front = socks.String()
+	}
+	return front + " -> " + tunnel.String(), nil
+}
+
+func (p *slipnetProfile) sshLink(host string, port int) string {
+	user, pass := p.sshUser, p.sshPass
+	if user == "" {
+		user, pass = p.socksUser, p.socksPass
+	}
+	return p.sshLinkWith(user, pass, host, port)
+}
+
+func (p *slipnetProfile) sshLinkWith(user, pass, host string, port int) string {
+	u := url.URL{Scheme: "ssh", Host: net.JoinHostPort(host, strconv.Itoa(port)), Fragment: p.name}
+	if user != "" {
+		u.User = url.UserPassword(user, pass)
+	}
+	return u.String()
+}
+
+func boolParam(v bool) string {
+	if v {
+		return "1"
+	}
+	return "0"
+}
+
+// expandLinks rewrites links that stand for a chain of outbounds into the " -> " chain form.
+func expandLinks(config string) string {
+	return expandDnstLink(expandSlipnetLink(expandInnerLinks(expandAetherLink(config))))
+}
+
+// expandSlipnetLink turns a slipnet:// profile into its chain of links. A profile that cannot be
+// converted is left as it is, so SlipnetSingbox reports why.
+func expandSlipnetLink(config string) string {
+	if !strings.HasPrefix(strings.ToLower(config), "slipnet://") {
+		return config
+	}
+	profile, err := parseSlipnetProfile(config)
+	if err != nil {
+		return config
+	}
+	chain, err := profile.chain()
+	if err != nil {
+		return config
+	}
+	return chain
+}
+
+// SlipnetSingbox is reached for a slipnet:// link that expandSlipnetLink could not convert, and
+// for slipnet-enc:// links; it reports why.
+func SlipnetSingbox(link string) (*T.Outbound, error) {
+	profile, err := parseSlipnetProfile(link)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := profile.chain(); err != nil {
+		return nil, err
+	}
+	return nil, fmt.Errorf("slipnet profile %q stands for several outbounds and is read as a chain", profile.name)
+}
diff --git a/ray2sing/soar.go b/ray2sing/soar.go
new file mode 100644
index 0000000000000000000000000000000000000000..83733a48bfddf82a2a88facf743050959ef38a10
--- /dev/null
+++ b/ray2sing/soar.go
@@ -0,0 +1,281 @@
+package ray2sing
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+
+	C "github.com/sagernet/sing-box/constant"
+	T "github.com/sagernet/sing-box/option"
+	soaroutbound "github.com/sagernet/sing-box/protocol/hiddify/soar"
+)
+
+// SoarSingbox reads a soar:// link into a soar outbound (a Soar client,
+// github.com/getlantern/soar). Soar defines no link of its own; two forms are read:
+//
+//	soar://<base64url of a WhiteDNS profile JSON>
+//	soar://t.example.com?pk=<server public key>&resolvers=8.8.8.8,1.1.1.1&country=ir#name
+//	soar://<server public key in base64url>@t.example.com?resolvers=8.8.8.8#name
+//
+// The first is the profile WhiteDNS exports and imports (schema "whitedns.profile": the server's
+// domain and public_key, its resolvers and soarSettings). In the URL form the query keys are the
+// soar outbound's fields (resolvers, smart_pool, tcp, safe_qname, max_qname, max_answer, hold,
+// max_inflight, max_path_window, max_streams, ...) and the discovery ones of smart_pool
+// (country, sample_ranges, discovery_want, discovery_concurrency, discovery_pace); a standard
+// base64 key in the query is percent-encoded, or written in base64url.
+//
+// Resolvers left out, or "auto", turn on Soar's own resolver discovery. The resolvers written
+// go through the outbound's smart pool unless smart_pool=0.
+func SoarSingbox(link string) (*T.Outbound, error) {
+	if params, name, ok := whiteDNSProfileLink(link, "soar://"); ok {
+		return soarOutbound(params, name)
+	}
+	u, err := ParseUrl(link, 53)
+	if err != nil {
+		return nil, err
+	}
+	params := u.Params
+	if u.Hostname != "" && getOneOfN(params, "", "domain", "zone") == "" {
+		params["domain"] = u.Hostname
+	}
+	if u.Username != "" && soarKeyParam(params) == "" {
+		params["publickey"] = u.Username
+	}
+	return soarOutbound(params, u.Name)
+}
+
+func soarKeyParam(params map[string]string) string {
+	return getOneOfN(params, "", "public_key", "pk", "pubkey", "publickey", "server_key", "key")
+}
+
+func soarOutbound(params map[string]string, name string) (*T.Outbound, error) {
+	domain := strings.TrimSuffix(getOneOfN(params, "", "domain", "zone"), ".")
+	if domain == "" {
+		return nil, fmt.Errorf("soar link: the tunnel domain is missing")
+	}
+	// a "+" of a standard base64 key in a query arrives as a space
+	rawKey := soarKeyParam(params)
+	key := strings.ReplaceAll(rawKey, " ", "+")
+	if _, err := soaroutbound.ParsePublicKey(key); err != nil {
+		key = strings.ReplaceAll(strings.TrimSpace(rawKey), " ", "+")
+	}
+	if _, err := soaroutbound.ParsePublicKey(key); err != nil {
+		return nil, fmt.Errorf("soar link: %w", err)
+	}
+	options := &T.SoarOptions{
+		DialerOptions:     getDialerOptions(params),
+		Domain:            domain,
+		PublicKey:         key,
+		Resolvers:         splitMasterdnsList(getOneOfN(params, "", "resolvers", "resolver", "dns")),
+		SmartPool:         soarSmartPoolOption(getOneOfN(params, "", "smart_pool", "smart-pool")),
+		PreTestDomain:     getOneOfN(params, "", "pretest_domain"),
+		PreTestRecordType: getOneOfN(params, "", "pretest_record_type"),
+		TCP:               strings.ToLower(getOneOfN(params, "", "tcp", "transport")),
+		SafeQName:         toInt(getOneOfN(params, "", "safe_qname")),
+		MaxQName:          toInt(getOneOfN(params, "", "max_qname")),
+		MaxAnswer:         toInt(getOneOfN(params, "", "max_answer")),
+		Hold:              durationOrSeconds(getOneOfN(params, "", "hold")),
+		MaxInflight:       toInt(getOneOfN(params, "", "max_inflight")),
+		MaxPathWindow:     toInt(getOneOfN(params, "", "max_path_window")),
+		MaxStreams:        toInt(getOneOfN(params, "", "max_streams")),
+		StreamWindow:      toInt(getOneOfN(params, "", "stream_window")),
+		SendBuffer:        toInt(getOneOfN(params, "", "send_buffer")),
+		SessionIdle:       durationOrSeconds(getOneOfN(params, "", "session_idle")),
+		ConnectTimeout:    durationOrSeconds(getOneOfN(params, "", "connect_timeout")),
+	}
+	options.SmartPool = withDiscovery(options.SmartPool, params, true)
+	if toBool(getOneOfN(params, "", "discovery"), false) && len(options.Resolvers) > 0 {
+		options.Resolvers = append(options.Resolvers, "auto")
+	}
+	if name == "" {
+		name = "soar"
+	}
+	return &T.Outbound{
+		Type:    C.TypeSoar,
+		Tag:     name,
+		Options: options,
+	}, nil
+}
+
+// discoveryOption reads the resolver discovery parameters shared by the DNS tunnel links
+// (country, sample_ranges, discovery_want, discovery_concurrency, discovery_pace); nil when the
+// link sets none.
+func discoveryOption(params map[string]string) *T.ResolverDiscoveryOptions {
+	discovery := &T.ResolverDiscoveryOptions{
+		Country:      strings.ToLower(getOneOfN(params, "", "country", "cc")),
+		SampleRanges: toInt(getOneOfN(params, "", "sample_ranges")),
+		Want:         toInt(getOneOfN(params, "", "discovery_want")),
+		Concurrency:  toInt(getOneOfN(params, "", "discovery_concurrency")),
+		Pace:         durationOrSeconds(getOneOfN(params, "", "discovery_pace")),
+	}
+	if *discovery == (T.ResolverDiscoveryOptions{}) {
+		return nil
+	}
+	return discovery
+}
+
+// withDiscovery puts the link's discovery parameters into its smart_pool block, making one with
+// the pool's default state (enabled) when the link has none.
+func withDiscovery(pool *T.SmartPoolOptions, params map[string]string, enabled bool) *T.SmartPoolOptions {
+	discovery := discoveryOption(params)
+	if discovery == nil {
+		return pool
+	}
+	if pool == nil {
+		pool = &T.SmartPoolOptions{Enabled: enabled}
+	}
+	pool.Discovery = discovery
+	return pool
+}
+
+// soarSmartPoolOption reads smart_pool for an outbound whose pool is on by default: empty keeps
+// the default (nil), 0/false turns it off, 1/true is the pool with its defaults, anything else is
+// the pool's load balance strategy.
+func soarSmartPoolOption(value string) *T.SmartPoolOptions {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return nil
+	}
+	if enabled := toBoolN(value); enabled != nil {
+		return &T.SmartPoolOptions{Enabled: *enabled}
+	}
+	return &T.SmartPoolOptions{Enabled: true, LoadBalance: value}
+}
+
+// whiteDNSProfileLink reads the profile link of WhiteDNS: scheme://<base64url JSON> with schema
+// "whitedns.profile". It returns the profile as parameters keyed like the URL form (normalized
+// keys): name, domain, the key (public_key for Soar, key and encryption for MasterDnsVPN),
+// resolvers, and the Soar settings with WhiteDNS's defaults.
+func whiteDNSProfileLink(link, scheme string) (map[string]string, string, bool) {
+	if !strings.HasPrefix(strings.ToLower(link), scheme) {
+		return nil, "", false
+	}
+	body := link[len(scheme):]
+	name := ""
+	if i := strings.IndexByte(body, '#'); i >= 0 {
+		name, _ = url.PathUnescape(body[i+1:])
+		body = body[:i]
+	}
+	if i := strings.IndexByte(body, '?'); i >= 0 {
+		body = body[:i]
+	}
+	body = strings.TrimSpace(body)
+	if body == "" || strings.ContainsAny(body, "@.:") {
+		return nil, "", false
+	}
+	decoded, err := decodeBase64FaultTolerant(body)
+	if err != nil {
+		return nil, "", false
+	}
+	var root struct {
+		Schema  string `json:"schema"`
+		Profile struct {
+			Name   string `json:"name"`
+			Server struct {
+				Domain           string `json:"domain"`
+				PublicKey        string `json:"public_key"`
+				EncryptionKey    string `json:"encryption_key"`
+				EncryptionMethod *int   `json:"encryption_method"`
+			} `json:"server"`
+			Resolvers    []string                   `json:"resolvers"`
+			SoarSettings map[string]json.RawMessage `json:"soarSettings"`
+		} `json:"profile"`
+	}
+	if err := json.Unmarshal([]byte(decoded), &root); err != nil || root.Schema != "whitedns.profile" {
+		return nil, "", false
+	}
+	profile := root.Profile
+	params := map[string]string{
+		"domain": strings.TrimSuffix(strings.TrimSpace(profile.Server.Domain), "."),
+	}
+	if profile.Server.PublicKey != "" {
+		params["publickey"] = profile.Server.PublicKey
+	}
+	if profile.Server.EncryptionKey != "" {
+		params["key"] = profile.Server.EncryptionKey
+	}
+	if profile.Server.EncryptionMethod != nil {
+		params["encryption"] = strconv.Itoa(*profile.Server.EncryptionMethod)
+	}
+	if len(profile.Resolvers) > 0 {
+		params["resolvers"] = strings.Join(profile.Resolvers, ",")
+	}
+	if scheme == "soar://" {
+		whiteDNSSoarSettings(params, profile.SoarSettings)
+	}
+	if name == "" {
+		name = profile.Name
+	}
+	return params, name, true
+}
+
+// whiteDNSSoarSettings maps WhiteDNS's soarSettings onto the soar outbound's parameters. Without
+// the block WhiteDNS's defaults apply: discovery on, for Iran.
+func whiteDNSSoarSettings(params map[string]string, settings map[string]json.RawMessage) {
+	str := func(key string) (string, bool) {
+		raw, ok := settings[key]
+		if !ok {
+			return "", false
+		}
+		var s string
+		if json.Unmarshal(raw, &s) == nil {
+			return s, true
+		}
+		return strings.Trim(string(raw), `"`), true
+	}
+	set := func(param, key string, scale func(string) string) {
+		if value, ok := str(key); ok && value != "" {
+			if scale != nil {
+				value = scale(value)
+			}
+			params[param] = value
+		}
+	}
+	unit := func(d time.Duration) func(string) string {
+		return func(v string) string {
+			n, err := strconv.Atoi(v)
+			if err != nil {
+				return ""
+			}
+			return (time.Duration(n) * d).String()
+		}
+	}
+	kib := func(v string) string {
+		n, err := strconv.Atoi(v)
+		if err != nil {
+			return ""
+		}
+		return strconv.Itoa(n * 1024)
+	}
+
+	discovery, country := "true", "ir"
+	if settings != nil {
+		discovery, _ = str("discovery")
+		country, _ = str("country") // "" for GLOBAL
+	}
+	params["discovery"] = discovery
+	if !toBool(discovery, false) && params["resolvers"] == "" {
+		params["resolvers"] = "1.1.1.1" // WhiteDNS's resolver for a profile without any
+	}
+	if country = strings.ToLower(strings.TrimSpace(country)); len(country) == 2 {
+		params["country"] = country
+	}
+	set("tcp", "transport", nil)
+	set("discoverywant", "discoveryWant", nil)
+	set("discoveryconcurrency", "discoveryConcurrency", nil)
+	set("discoverypace", "discoveryPaceMs", unit(time.Millisecond))
+	set("safeqname", "safeQName", nil)
+	set("maxqname", "maxQName", nil)
+	set("maxanswer", "maxAnswer", nil)
+	set("hold", "holdMs", unit(time.Millisecond))
+	set("maxinflight", "maxInflight", nil)
+	set("maxpathwindow", "maxPathWindow", nil)
+	set("maxstreams", "maxStreams", nil)
+	set("streamwindow", "streamWindowKiB", kib)
+	set("sendbuffer", "sendBufferKiB", kib)
+	set("sessionidle", "sessionIdleSeconds", unit(time.Second))
+	set("connecttimeout", "dialTimeoutSeconds", unit(time.Second))
+}
