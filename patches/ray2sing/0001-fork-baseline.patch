diff --git a/ray2sing_test/masterdns_test.go b/ray2sing_test/masterdns_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..d9e5a5caa8fe20746fc839d3aa9f7cd58f8d2814
--- /dev/null
+++ b/ray2sing_test/masterdns_test.go
@@ -0,0 +1,137 @@
+package ray2sing_test
+
+import (
+	"context"
+	"encoding/base64"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/hiddify/ray2sing/ray2sing"
+	C "github.com/sagernet/sing-box/constant"
+	T "github.com/sagernet/sing-box/option"
+)
+
+func TestMasterdnsLink(t *testing.T) {
+	url := "masterdns://v.example.com?key=0123456789abcdef0123456789abcdef&resolvers=8.8.8.8,1.1.1.1:5353,10.0.0.0/30&encryption=aes-256-gcm&mode=tcp&balancing=least-loss&dup=3&setup_dup=4&ucomp=zstd&dcomp=2&base_encode=1&min_upload_mtu=40&max_upload_mtu=160&max_download_mtu=900&mtu_test_timeout=1.5&mtu_test_retries=3&auto_remove_low_mtu_resolvers=false&workers=2&arq_window=700&ready_timeout=10s&connect_timeout=20&log_level=DEBUG&uot=1#My%20Tunnel"
+	expectedJSON := `
+	{
+		"outbounds": [
+		  {
+			"type": "masterdns",
+			"tag": "My Tunnel § 0",
+			"domains": ["v.example.com"],
+			"resolvers": ["8.8.8.8", "1.1.1.1:5353", "10.0.0.0/30"],
+			"encryption": "aes-256-gcm",
+			"key": "0123456789abcdef0123456789abcdef",
+			"mode": "tcp",
+			"balancing": "least-loss",
+			"packet_duplication": 3,
+			"setup_packet_duplication": 4,
+			"upload_compression": "zstd",
+			"download_compression": "lz4",
+			"base_encode": true,
+			"min_upload_mtu": 40,
+			"max_upload_mtu": 160,
+			"max_download_mtu": 900,
+			"mtu_test_timeout": "1.5s",
+			"mtu_test_retries": 3,
+			"auto_remove_low_mtu_resolvers": false,
+			"workers": 2,
+			"arq_window": 700,
+			"ready_timeout": "10s",
+			"connect_timeout": "20s",
+			"log_level": "debug",
+			"udp_over_tcp": {"enabled": true}
+		  }
+		]
+	  }
+	`
+	ray2sing.CheckUrlAndJson(url, expectedJSON, t)
+}
+
+// The key may stand before the "@", and a minimal link keeps every default.
+func TestMasterdnsKeyLink(t *testing.T) {
+	out, err := ray2sing.MasterdnsSingbox("masterdns://secret-key@v.example.com?resolver=9.9.9.9#dns")
+	if err != nil {
+		t.Fatal(err)
+	}
+	options := out.Options.(*T.MasterDNSOptions)
+	if out.Type != C.TypeMasterDNS || out.Tag != "dns" || options.Key != "secret-key" || len(options.Domains) != 1 || options.Domains[0] != "v.example.com" ||
+		len(options.Resolvers) != 1 || options.Resolvers[0] != "9.9.9.9" || options.Encryption != "" || options.Mode != "" || options.UDPOverTCP != nil {
+		t.Fatalf("options: %+v", options)
+	}
+	if !options.SmartPool.IsEnabled() {
+		t.Fatal("the smart pool is on by default")
+	}
+	// no resolvers: the built-in list through the pool, or public resolvers without it
+	out, err = ray2sing.MasterdnsSingbox("masterdns://v.example.com?key=k")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if o := out.Options.(*T.MasterDNSOptions); !o.SmartPool.IsEnabled() || strings.Join(o.Resolvers, ",") != "auto" {
+		t.Fatalf("no resolvers: %+v", o)
+	}
+	out, err = ray2sing.MasterdnsSingbox("masterdns://v.example.com?key=k&smart_pool=0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if o := out.Options.(*T.MasterDNSOptions); o.SmartPool != nil || len(o.Resolvers) != 8 || o.Resolvers[0] != "8.8.8.8" {
+		t.Fatalf("no resolvers, no pool: %+v", o)
+	}
+	// a range is for the MasterDnsVPN client: no pool unless asked; a strategy turns it on
+	out, _ = ray2sing.MasterdnsSingbox("masterdns://v.example.com?key=k&resolvers=8.8.8.8,10.0.0.0/30")
+	if out.Options.(*T.MasterDNSOptions).SmartPool != nil {
+		t.Fatal("a range turned the pool on")
+	}
+	out, _ = ray2sing.MasterdnsSingbox("masterdns://v.example.com?key=k&smart_pool=weighted&pretest_domain=example.org&country=IR&discovery_want=5")
+	if o := out.Options.(*T.MasterDNSOptions); !o.SmartPool.IsEnabled() || o.SmartPool.LoadBalance != "weighted" || o.PreTestDomain != "example.org" ||
+		o.SmartPool.DiscoveryOptions().Country != "ir" || o.SmartPool.DiscoveryOptions().Want != 5 {
+		t.Fatalf("strategy: %+v", o)
+	}
+	if _, err := ray2sing.MasterdnsSingbox("masterdns://?key=k&resolvers=8.8.8.8"); err == nil {
+		t.Fatal("a link without a domain was accepted")
+	}
+}
+
+// The MasterDnsVPN client's own JSON configuration (its -json_base64 form) with a RESOLVERS list.
+func TestMasterdnsJSONLink(t *testing.T) {
+	doc := `{"DOMAINS":["v.example.com","w.example.com"],"ENCRYPTION_KEY":"abc","DATA_ENCRYPTION_METHOD":2,"PROTOCOL_TYPE":"SOCKS5","RESOLVERS":["8.8.8.8","1.1.1.1:5353"],"RESOLVER_BALANCING_STRATEGY":3,"PACKET_DUPLICATION_COUNT":2,"UPLOAD_COMPRESSION_TYPE":1,"MTU_TEST_TIMEOUT":2.0,"AUTO_DISABLE_TIMEOUT_SERVERS":false,"RX_TX_WORKERS":4,"NAME":"from json"}`
+	link := "masterdns://" + base64.StdEncoding.EncodeToString([]byte(doc))
+	options, err := ray2sing.Ray2SingboxOptions(context.Background(), link, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(options.Outbounds) != 1 {
+		t.Fatalf("outbounds: %+v", options.Outbounds)
+	}
+	out := options.Outbounds[0]
+	o := out.Options.(*T.MasterDNSOptions)
+	if out.Tag != "from json § 0" || len(o.Domains) != 2 || o.Domains[1] != "w.example.com" || o.Key != "abc" || o.Encryption != "2" || o.Mode != "socks5" ||
+		len(o.Resolvers) != 2 || o.Resolvers[1] != "1.1.1.1:5353" || o.Balancing != "3" || o.PacketDuplication != 2 || o.UploadCompression != "zstd" ||
+		time.Duration(o.MTUTestTimeout) != 2*time.Second || o.AutoDisableTimeoutResolvers == nil || *o.AutoDisableTimeoutResolvers || o.Workers != 4 {
+		t.Fatalf("options: %+v", o)
+	}
+	// the fragment names it
+	out2, err := ray2sing.MasterdnsSingbox(link + "#Named%20One")
+	if err != nil || out2.Tag != "Named One" {
+		t.Fatalf("%v %q", err, out2.Tag)
+	}
+}
+
+// The profile link of WhiteDNS (schema "whitedns.profile") for MasterDnsVPN.
+func TestMasterdnsWhiteDNSLink(t *testing.T) {
+	doc := `{"schema":"whitedns.profile","version":1,"profile":{"name":"Tehran","server":{"domain":"v.example.com.","encryption_key":"k3y","encryption_method":2}}}`
+	link := "masterdns://" + base64.RawURLEncoding.EncodeToString([]byte(doc))
+	out, err := ray2sing.MasterdnsSingbox(link)
+	if err != nil {
+		t.Fatal(err)
+	}
+	o := out.Options.(*T.MasterDNSOptions)
+	if out.Tag != "Tehran" || strings.Join(o.Domains, ",") != "v.example.com" || o.Key != "k3y" || o.Encryption != "2" || !o.SmartPool.IsEnabled() || strings.Join(o.Resolvers, ",") != "auto" {
+		t.Fatalf("options: %+v", o)
+	}
+	if out, err = ray2sing.MasterdnsSingbox(link + "#Other"); err != nil || out.Tag != "Other" {
+		t.Fatalf("%v %+v", err, out)
+	}
+}
diff --git a/ray2sing_test/slipnet_test.go b/ray2sing_test/slipnet_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..76b62fc513be5934ef7efd81e8df02cf857a6d18
--- /dev/null
+++ b/ray2sing_test/slipnet_test.go
@@ -0,0 +1,137 @@
+package ray2sing_test
+
+import (
+	"context"
+	"encoding/base64"
+	"strings"
+	"testing"
+
+	"github.com/hiddify/ray2sing/ray2sing"
+	C "github.com/sagernet/sing-box/constant"
+	T "github.com/sagernet/sing-box/option"
+)
+
+// slipnetLink builds a SlipNet profile link (version 18, fields separated by "|") with the given
+// field values by position.
+func slipnetLink(values map[int]string) string {
+	fields := make([]string, 70)
+	fields[0] = "18"
+	for i, v := range values {
+		fields[i] = v
+	}
+	return "slipnet://" + base64.StdEncoding.EncodeToString([]byte(strings.Join(fields, "|")))
+}
+
+const slipnetPubKey = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+
+func slipnetDNSFields(tunnelType string) map[int]string {
+	return map[int]string{1: tunnelType, 2: "Slip Test", 3: "t.example.com", 4: "8.8.8.8:53:0,1.1.1.1:5353:0", 11: slipnetPubKey, 12: "socksuser", 13: "p@ss:word"}
+}
+
+func parseSlipnet(t *testing.T, link string) (front T.Outbound, tunnel T.Outbound) {
+	t.Helper()
+	options, err := ray2sing.Ray2SingboxOptions(context.Background(), link, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(options.Outbounds) != 2 {
+		t.Fatalf("outbounds: %+v", options.Outbounds)
+	}
+	// the chain is written from the inside out: the dnstt outbound comes first
+	tunnel, front = options.Outbounds[0], options.Outbounds[1]
+	if tunnel.Type != C.TypeDNSTT || !strings.Contains(tunnel.Tag, "§hide§") {
+		t.Fatalf("tunnel: %s %s", tunnel.Type, tunnel.Tag)
+	}
+	if !strings.HasPrefix(front.Tag, "Slip Test") || strings.Contains(front.Tag, "§hide§") {
+		t.Fatalf("front: %s %s", front.Type, front.Tag)
+	}
+	return front, tunnel
+}
+
+// A DNSTT profile is a socks outbound (the SlipNet server forwards to a SOCKS server) through a
+// dnstt outbound in the original DNSTT wire format.
+func TestSlipnetDnsttProfile(t *testing.T) {
+	front, tunnel := parseSlipnet(t, slipnetLink(slipnetDNSFields("dnstt")))
+	socks := front.Options.(*T.SOCKSOutboundOptions)
+	if front.Type != C.TypeSOCKS || socks.Username != "socksuser" || socks.Password != "p@ss:word" || socks.Detour != tunnel.Tag {
+		t.Fatalf("front: %s %+v", front.Tag, socks)
+	}
+	dnstt := tunnel.Options.(*T.DnsttOptions)
+	if dnstt.Domain != "t.example.com" || dnstt.PublicKey != slipnetPubKey || !dnstt.DnsttCompat || dnstt.MaxQnameLen != nil || (dnstt.MTU != nil && *dnstt.MTU != 0) {
+		t.Fatalf("dnstt: %+v", dnstt)
+	}
+	if strings.Join(dnstt.Resolvers, " ") != "8.8.8.8:53 1.1.1.1:5353" {
+		t.Fatalf("resolvers: %v", dnstt.Resolvers)
+	}
+}
+
+// A NoizDNS profile ("sayedns") keeps the short names; DoT and DoH transports and the payload size
+// are carried over; an SSH variant puts an ssh outbound in front.
+func TestSlipnetNoizdnsSSHProfile(t *testing.T) {
+	fields := slipnetDNSFields("sayedns_ssh")
+	fields[14], fields[15], fields[16], fields[17], fields[19] = "1", "root", "s3cret", "2222", "1.2.3.4"
+	fields[22] = "tls"
+	fields[39] = "600"
+	front, tunnel := parseSlipnet(t, slipnetLink(fields))
+	ssh := front.Options.(*T.SSHOutboundOptions)
+	if front.Type != C.TypeSSH || ssh.User != "root" || ssh.Password != "s3cret" || ssh.ServerPort != 2222 || ssh.Server != "127.0.0.1" || ssh.Detour != tunnel.Tag {
+		t.Fatalf("front: %+v", ssh)
+	}
+	dnstt := tunnel.Options.(*T.DnsttOptions)
+	if !dnstt.DnsttCompat || dnstt.MaxQnameLen == nil || *dnstt.MaxQnameLen != 150 || dnstt.MTU == nil || *dnstt.MTU != 600 {
+		t.Fatalf("dnstt: %+v", dnstt)
+	}
+	if strings.Join(dnstt.Resolvers, " ") != "dot://8.8.8.8:853 dot://1.1.1.1:5353" {
+		t.Fatalf("resolvers: %v", dnstt.Resolvers)
+	}
+
+	fields[22], fields[21] = "https", "https://dns.google/dns-query"
+	_, tunnel = parseSlipnet(t, slipnetLink(fields))
+	if r := tunnel.Options.(*T.DnsttOptions).Resolvers; len(r) != 1 || r[0] != "https://dns.google/dns-query" {
+		t.Fatalf("doh resolvers: %v", r)
+	}
+}
+
+// A VayDNS profile carries its wire format fields.
+func TestSlipnetVaydnsProfile(t *testing.T) {
+	fields := slipnetDNSFields("vaydns")
+	fields[41], fields[42], fields[43], fields[44], fields[48], fields[49] = "0", "cname", "120", "15.5", "4", "4"
+	_, tunnel := parseSlipnet(t, slipnetLink(fields))
+	dnstt := tunnel.Options.(*T.DnsttOptions)
+	if dnstt.DnsttCompat || dnstt.RecordType != "cname" || *dnstt.MaxQnameLen != 120 || *dnstt.RPS != 15.5 || *dnstt.MaxNumLabels != 4 || *dnstt.ClientIDSize != 4 {
+		t.Fatalf("dnstt: %+v", dnstt)
+	}
+	fields[41] = "1"
+	_, tunnel = parseSlipnet(t, slipnetLink(fields))
+	if !tunnel.Options.(*T.DnsttOptions).DnsttCompat {
+		t.Fatal("dnstt-compat not carried")
+	}
+}
+
+// A standalone SSH profile is one ssh outbound; unsupported and locked profiles are refused with
+// a reason.
+func TestSlipnetOtherProfiles(t *testing.T) {
+	fields := map[int]string{1: "ssh", 2: "Just SSH", 14: "1", 15: "u", 16: "p", 17: "22", 19: "ssh.example.com"}
+	options, err := ray2sing.Ray2SingboxOptions(context.Background(), slipnetLink(fields), false)
+	if err != nil || len(options.Outbounds) != 1 || options.Outbounds[0].Type != C.TypeSSH {
+		t.Fatalf("%v %+v", err, options)
+	}
+	ssh := options.Outbounds[0].Options.(*T.SSHOutboundOptions)
+	if ssh.Server != "ssh.example.com" || ssh.User != "u" {
+		t.Fatalf("ssh: %+v", ssh)
+	}
+
+	for name, link := range map[string]string{
+		"slipstream": slipnetLink(map[int]string{1: "ss", 2: "x", 3: "t.example.com", 11: slipnetPubKey}),
+		"no pubkey":  slipnetLink(map[int]string{1: "dnstt", 2: "x", 3: "t.example.com"}),
+		"locked":     "slipnet-enc://" + base64.StdEncoding.EncodeToString([]byte("18|dnstt|x")),
+		"short":      "slipnet://" + base64.StdEncoding.EncodeToString([]byte("18|dnstt")),
+	} {
+		if _, err := ray2sing.SlipnetSingbox(link); err == nil {
+			t.Errorf("%s: accepted", name)
+		}
+		if _, err := ray2sing.Ray2SingboxOptions(context.Background(), link, false); err == nil {
+			t.Errorf("%s: converted", name)
+		}
+	}
+}
diff --git a/ray2sing_test/soar_test.go b/ray2sing_test/soar_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b21f4c14324a0e5831ee9e19f5fa77d396626a96
--- /dev/null
+++ b/ray2sing_test/soar_test.go
@@ -0,0 +1,138 @@
+package ray2sing_test
+
+import (
+	"context"
+	"crypto/ed25519"
+	"encoding/base64"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/hiddify/ray2sing/ray2sing"
+	C "github.com/sagernet/sing-box/constant"
+	T "github.com/sagernet/sing-box/option"
+)
+
+func soarTestKey(t *testing.T) ed25519.PublicKey {
+	t.Helper()
+	pub, _, err := ed25519.GenerateKey(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return pub
+}
+
+func soarOptions(t *testing.T, link string) (*T.Outbound, *T.SoarOptions) {
+	t.Helper()
+	out, err := ray2sing.SoarSingbox(link)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out.Type != C.TypeSoar {
+		t.Fatalf("type %q", out.Type)
+	}
+	return out, out.Options.(*T.SoarOptions)
+}
+
+// The URL form: the key in the query or before the "@", the outbound's fields as parameters.
+func TestSoarLink(t *testing.T) {
+	pub := soarTestKey(t)
+	std := base64.StdEncoding.EncodeToString(pub)
+
+	link := "soar://t.example.com?pk=" + url.QueryEscape(std) + "&resolvers=8.8.8.8,1.1.1.1:5353&country=IR&sample_ranges=16&tcp=on&safe_qname=101&max_qname=200&max_answer=512&hold=800ms&max_inflight=64&max_path_window=8&max_streams=32&stream_window=131072&session_idle=60&connect_timeout=30s&discovery_want=4&discovery_pace=0.1#My%20Soar"
+	out, o := soarOptions(t, link)
+	d := o.SmartPool.DiscoveryOptions()
+	if out.Tag != "My Soar" || o.Domain != "t.example.com" || o.PublicKey != std || strings.Join(o.Resolvers, ",") != "8.8.8.8,1.1.1.1:5353" ||
+		!o.SmartPool.IsEnabledOr(false) || d.Country != "ir" || d.SampleRanges != 16 || o.TCP != "on" || o.SafeQName != 101 || o.MaxQName != 200 || o.MaxAnswer != 512 ||
+		time.Duration(o.Hold) != 800*time.Millisecond || o.MaxInflight != 64 || o.MaxPathWindow != 8 || o.MaxStreams != 32 || o.StreamWindow != 131072 ||
+		time.Duration(o.SessionIdle) != time.Minute || time.Duration(o.ConnectTimeout) != 30*time.Second || d.Want != 4 ||
+		time.Duration(d.Pace) != 100*time.Millisecond {
+		t.Fatalf("options: %+v", o)
+	}
+
+	// an unescaped "+" of the key arrives as a space and is put back
+	_, o = soarOptions(t, "soar://t.example.com?pk="+std)
+	if o.PublicKey != std || len(o.Resolvers) != 0 {
+		t.Fatalf("raw key: %+v", o)
+	}
+
+	// the key before the "@", base64url; smart_pool=0 turns the pool off, discovery=1 adds "auto"
+	raw := base64.RawURLEncoding.EncodeToString(pub)
+	out, o = soarOptions(t, "soar://"+raw+"@t.example.com?resolver=9.9.9.9&smart_pool=0&discovery=1")
+	if out.Tag != "soar" || o.PublicKey != raw || strings.Join(o.Resolvers, ",") != "9.9.9.9,auto" || o.SmartPool == nil || o.SmartPool.Enabled {
+		t.Fatalf("user key: %+v", o)
+	}
+	_, o = soarOptions(t, "soar://t.example.com?pk="+raw+"&smart_pool=weighted")
+	if !o.SmartPool.IsEnabled() || o.SmartPool.LoadBalance != "weighted" {
+		t.Fatalf("strategy: %+v", o.SmartPool)
+	}
+
+	for _, bad := range []string{
+		"soar://t.example.com",
+		"soar://t.example.com?pk=short",
+		"soar://?pk=" + raw,
+	} {
+		if _, err := ray2sing.SoarSingbox(bad); err == nil {
+			t.Fatalf("accepted %s", bad)
+		}
+	}
+}
+
+// The profile link WhiteDNS exports for Soar: base64url JSON, schema "whitedns.profile".
+func TestSoarWhiteDNSLink(t *testing.T) {
+	pub := soarTestKey(t)
+	key := base64.StdEncoding.EncodeToString(pub)
+	doc := `{"schema":"whitedns.profile","version":1,"profile":{"name":"Soar IR","server":{"domain":"t.example.com","public_key":"` + key + `"},` +
+		`"soarSettings":{"transport":"auto","discovery":true,"country":"IR","discoveryWant":2,"discoveryConcurrency":2,"discoveryPaceMs":1000,"safeQName":101,"maxQName":253,"maxAnswer":1232,"holdMs":500,"maxInflight":128,"maxPathWindow":32,"maxStreams":128,"streamWindowKiB":256,"sendBufferKiB":64,"sessionIdleSeconds":90,"dialTimeoutSeconds":90},` +
+		`"resolvers":["2.188.21.130","5.202.100.100:53"]}}`
+	link := "soar://" + base64.RawURLEncoding.EncodeToString([]byte(doc))
+	out, o := soarOptions(t, link)
+	d := o.SmartPool.DiscoveryOptions()
+	if out.Tag != "Soar IR" || o.Domain != "t.example.com" || o.PublicKey != key || strings.Join(o.Resolvers, ",") != "2.188.21.130,5.202.100.100:53,auto" ||
+		!o.SmartPool.IsEnabledOr(false) || d.Country != "ir" || o.TCP != "auto" || d.Want != 2 || d.Concurrency != 2 || time.Duration(d.Pace) != time.Second ||
+		o.SafeQName != 101 || o.MaxQName != 253 || o.MaxAnswer != 1232 || time.Duration(o.Hold) != 500*time.Millisecond || o.MaxInflight != 128 ||
+		o.MaxPathWindow != 32 || o.MaxStreams != 128 || o.StreamWindow != 256*1024 || o.SendBuffer != 64*1024 ||
+		time.Duration(o.SessionIdle) != 90*time.Second || time.Duration(o.ConnectTimeout) != 90*time.Second {
+		t.Fatalf("options: %+v", o)
+	}
+
+	// GLOBAL (no country), discovery off, no resolvers: WhiteDNS's one resolver
+	doc = `{"schema":"whitedns.profile","version":1,"profile":{"name":"G","server":{"domain":"t.example.com","public_key":"` + key + `"},"soarSettings":{"discovery":false,"country":""}}}`
+	_, o = soarOptions(t, "soar://"+base64.RawURLEncoding.EncodeToString([]byte(doc))+"#Renamed")
+	if o.SmartPool.DiscoveryOptions().Country != "" || strings.Join(o.Resolvers, ",") != "1.1.1.1" {
+		t.Fatalf("global: %+v", o)
+	}
+
+	// no soarSettings: WhiteDNS's defaults, discovery for Iran
+	doc = `{"schema":"whitedns.profile","version":1,"profile":{"name":"D","server":{"domain":"t.example.com","public_key":"` + key + `"}}}`
+	_, o = soarOptions(t, "soar://"+base64.StdEncoding.EncodeToString([]byte(doc)))
+	if o.SmartPool.DiscoveryOptions().Country != "ir" || len(o.Resolvers) != 0 {
+		t.Fatalf("defaults: %+v", o)
+	}
+
+	// through the whole conversion
+	options, err := ray2sing.Ray2SingboxOptions(context.Background(), link, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(options.Outbounds) != 1 || options.Outbounds[0].Type != C.TypeSoar || options.Outbounds[0].Tag != "Soar IR § 0" {
+		t.Fatalf("outbounds: %+v", options.Outbounds)
+	}
+}
+
+// The discovery parameters of a dnstt link go into its smart_pool block, the pool off unless asked.
+func TestDnsttLinkDiscovery(t *testing.T) {
+	out, err := ray2sing.DnsttSingbox("dnstt://v.example.com?domain=v.example.com&pubkey=00&resolver=auto&country=ru&sample_ranges=4")
+	if err != nil {
+		t.Fatal(err)
+	}
+	o := out.Options.(*T.DnsttOptions)
+	if o.SmartPool == nil || o.SmartPool.Enabled || o.SmartPool.DiscoveryOptions().Country != "ru" || o.SmartPool.DiscoveryOptions().SampleRanges != 4 {
+		t.Fatalf("smart_pool: %+v", o.SmartPool)
+	}
+	out, _ = ray2sing.DnsttSingbox("dnstt://v.example.com?domain=v.example.com&pubkey=00&resolver=auto")
+	if out.Options.(*T.DnsttOptions).SmartPool != nil {
+		t.Fatal("a pool block without asking")
+	}
+}
