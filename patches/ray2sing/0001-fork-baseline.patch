diff --git a/ray2sing/h_masque_warp.go b/ray2sing/h_masque_warp.go
new file mode 100644
index 0000000000000000000000000000000000000000..adefc35f9f9f1dca4490f7994445bbc879971bea
--- /dev/null
+++ b/ray2sing/h_masque_warp.go
@@ -0,0 +1,133 @@
+package ray2sing
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"net"
+	"strconv"
+	"strings"
+
+	"github.com/sagernet/sing-box/common/cloudflare"
+	C "github.com/sagernet/sing-box/constant"
+	T "github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// MasqueLinkSingbox converts a masque:// link. A link to Cloudflare's WARP is a warp endpoint
+// with mode masque, since a masque outbound does not register WARP devices:
+//
+//   - with the link's device key, the endpoint uses that device (masque.device) until Cloudflare
+//     refuses it, then a saved device of the endpoint or a registered one;
+//   - without a key, a saved device or a registered one, as for any WARP config.
+//
+// A link is WARP when its endpoint is in WARP's ranges or under cloudflareclient.com, or its
+// server name is Cloudflare's (or missing, which is Cloudflare's). A link to another MASQUE
+// server stays a masque outbound, and needs its device key.
+func MasqueLinkSingbox(link string) (*T.Outbound, *T.Endpoint, error) {
+	out, err := MasqueSingbox(link)
+	if err != nil {
+		return nil, nil, err
+	}
+	options := out.Options.(*T.MASQUEOutboundOptions)
+	if isWARPMasque(options) {
+		return nil, masqueAsWARP(out.Tag, options), nil
+	}
+	if options.Device == nil || options.Device.PrivateKey == "" {
+		return nil, nil, E.New("masque link to a server that is not WARP has no device key")
+	}
+	return out, nil, nil
+}
+
+func isWARPMasque(options *T.MASQUEOutboundOptions) bool {
+	serverName := strings.ToLower(strings.TrimSpace(options.ServerName))
+	if serverName == "" || cloudflare.IsWARPHost(serverName) {
+		return true
+	}
+	if device := options.Device; device != nil {
+		for _, endpoint := range []string{device.EndpointV4, device.EndpointV6, device.EndpointH2V4, device.EndpointH2V6} {
+			if endpoint != "" && cloudflare.IsWARPHost(endpoint) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// masqueAsWARP is the warp endpoint of a masque:// link to WARP, with the link's settings.
+func masqueAsWARP(tag string, options *T.MASQUEOutboundOptions) *T.Endpoint {
+	device := options.Device
+	warp := &T.WARPEndpointOptions{
+		DialerOptions:    options.DialerOptions,
+		UniqueIdentifier: masqueWARPIdentifier(options),
+		Mode:             "masque",
+		MTU:              options.MTU,
+		UDPTimeout:       options.UDPTimeout,
+		Scanner:          options.Scanner,
+		MASQUE: &T.WARPMASQUEOptions{
+			Enabled:              true,
+			TLS:                  options.MASQUEOutboundTLSOptions,
+			UseIPv6:              options.UseIPv6,
+			UDPKeepalivePeriod:   options.UDPKeepalivePeriod,
+			UDPInitialPacketSize: options.UDPInitialPacketSize,
+			ReconnectDelay:       options.ReconnectDelay,
+			VHTTP:                options.VHTTP,
+			ServerName:           options.ServerName,
+		},
+	}
+	if device != nil {
+		warp.Profile.License = device.License
+	}
+	if device != nil && device.PrivateKey != "" {
+		warp.MASQUE.Device = device
+	} else if options.Scanner == nil || !options.Scanner.Enabled {
+		// no device of its own: the link's endpoint is the server, unless the scanner looks for one
+		warp.Server, warp.ServerPort = masqueLinkEndpoint(device)
+	}
+	if warp.MTU == 0 {
+		warp.MTU = 1280 // a masque outbound's default; the warp endpoint's is WireGuard's
+	}
+	return &T.Endpoint{Type: C.TypeWARP, Tag: tag, Options: warp}
+}
+
+// masqueWARPIdentifier names the endpoint's devices and scores: the link's device id, else a
+// hash of its key, else of its endpoints, so renaming the profile keeps them.
+func masqueWARPIdentifier(options *T.MASQUEOutboundOptions) string {
+	if options.UniqueIdentifier != "" {
+		return options.UniqueIdentifier
+	}
+	device := options.Device
+	if device == nil {
+		return ""
+	}
+	if device.ID != "" {
+		return device.ID
+	}
+	seed := device.PrivateKey
+	if seed == "" {
+		seed = strings.Join([]string{device.EndpointV4, device.EndpointV6, device.EndpointH2V4, device.EndpointH2V6, options.ServerName}, "|")
+	}
+	sum := sha256.Sum256([]byte(seed))
+	return "masque-" + hex.EncodeToString(sum[:6])
+}
+
+// masqueLinkEndpoint is the first endpoint of the link, as a host and a port.
+func masqueLinkEndpoint(device *T.MASQUEDeviceOptions) (string, uint16) {
+	if device == nil {
+		return "", 0
+	}
+	for _, endpoint := range []string{device.EndpointV4, device.EndpointV6, device.EndpointH2V4, device.EndpointH2V6} {
+		if endpoint == "" {
+			continue
+		}
+		host, port, err := net.SplitHostPort(endpoint)
+		if err != nil {
+			return strings.Trim(endpoint, "[]"), 443
+		}
+		value, _ := strconv.Atoi(port)
+		if value <= 0 || value > 65535 {
+			value = 443
+		}
+		return host, uint16(value)
+	}
+	return "", 0
+}
diff --git a/ray2sing/h_masque_warp_test.go b/ray2sing/h_masque_warp_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..6181404664464aba5699255235f79bd730c001dc
--- /dev/null
+++ b/ray2sing/h_masque_warp_test.go
@@ -0,0 +1,85 @@
+package ray2sing
+
+import (
+	"strings"
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+	T "github.com/sagernet/sing-box/option"
+)
+
+const (
+	hWARPEndpointKey = "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEIaU7MToJm9NKp8YfGxR6r+/h4mcG7SxI8tsW8OR1A5tv/zCzVbCRRh2t87/kxnP6lAy0lkr7qYwu+ox+k3dr6w=="
+	hDeviceKey       = "MHcCAQEEIOAf/+45FJQE8VnQncfKBRVFDjKLtzKs/mcxkgCesLVjoAoGCCqGSM49AwEHoUQDQgAE5IFfZVGC9X0L5RMZz+Sn+pptLvCxKuRlCyAc+U6Z2G+xCtHQpCx53SJ7VkK8cM9Ul9r0kbOt+uEpC1rTHCVbQQ=="
+)
+
+func hEscape(v string) string { return strings.NewReplacer("+", "%2B", "=", "%3D").Replace(v) }
+
+func hMasqueWARP(t *testing.T, link string) *T.WARPEndpointOptions {
+	t.Helper()
+	out, endpoint, err := MasqueLinkSingbox(link)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != nil || endpoint == nil || endpoint.Type != C.TypeWARP {
+		t.Fatalf("want a warp endpoint: %+v %+v", out, endpoint)
+	}
+	options := endpoint.Options.(*T.WARPEndpointOptions)
+	if options.Mode != "masque" || options.MASQUE == nil || !options.MASQUE.Enabled {
+		t.Fatalf("mode: %q %+v", options.Mode, options.MASQUE)
+	}
+	return options
+}
+
+// A masque:// link to WARP with its device key is a warp endpoint with mode masque that uses
+// that device first; a masque outbound does not register a device when Cloudflare refuses it.
+func TestMasqueWARPLinkWithKey(t *testing.T) {
+	link := "masque://[2606:4700:103::2]:443?publicKey=" + hEscape(hWARPEndpointKey) + "&privateKey=" + hEscape(hDeviceKey) +
+		"&ip=172.16.0.2&dns=1.1.1.1,%208.8.8.8&udp=1&cc=cubic&sni=www.deepseek.com&h2=1&flag=CDN#WARP-MASQUE"
+	options := hMasqueWARP(t, link)
+	device := options.MASQUE.Device
+	if device == nil || device.PrivateKey != hDeviceKey || device.EndpointV6 != "[2606:4700:103::2]:443" || device.IPv4 != "172.16.0.2" {
+		t.Fatalf("device: %+v", device)
+	}
+	if options.MASQUE.VHTTP != "h2" || options.MASQUE.ServerName != "www.deepseek.com" || options.MTU != 1280 {
+		t.Fatalf("masque: %+v mtu %d", options.MASQUE, options.MTU)
+	}
+	if options.Server != "" || !strings.HasPrefix(options.UniqueIdentifier, "masque-") {
+		t.Fatalf("server %q id %q", options.Server, options.UniqueIdentifier)
+	}
+	if again := hMasqueWARP(t, strings.Replace(link, "#WARP-MASQUE", "#renamed", 1)); again.UniqueIdentifier != options.UniqueIdentifier {
+		t.Fatalf("renaming changed the identifier: %q %q", again.UniqueIdentifier, options.UniqueIdentifier)
+	}
+}
+
+// Without a device key, the warp endpoint takes a saved device or registers one; the link
+// failed with "private_key is not an ECDSA key".
+func TestMasqueWARPLinkWithoutKey(t *testing.T) {
+	options := hMasqueWARP(t, "masque://162.159.198.1:443?sni=consumer-masque.cloudflareclient.com&license=abc-123#keyless")
+	if options.MASQUE.Device != nil || options.Profile.License != "abc-123" || !options.Scanner.Enabled || options.Server != "" {
+		t.Fatalf("scanning: %+v", options)
+	}
+	// with the scanner off, the link's endpoint is the server
+	options = hMasqueWARP(t, "masque://162.159.198.1:8095?sni=consumer-masque.cloudflareclient.com&scanner=0#keyless")
+	if options.Server != "162.159.198.1" || options.ServerPort != 8095 {
+		t.Fatalf("server: %q %d", options.Server, options.ServerPort)
+	}
+	// a device id names its devices; a host link a hash of its endpoint
+	if options := hMasqueWARP(t, "masque://3f8a6c1e-device?endpoint=162.159.198.1:443#id"); options.UniqueIdentifier != "3f8a6c1e-device" {
+		t.Fatalf("id: %q", options.UniqueIdentifier)
+	}
+	if options := hMasqueWARP(t, "masque://engage.cloudflareclient.com:2408?sni=masque.example.com#host"); !strings.HasPrefix(options.UniqueIdentifier, "masque-") {
+		t.Fatalf("host: %q", options.UniqueIdentifier)
+	}
+}
+
+// A link to another MASQUE server stays a masque outbound, and needs its device key.
+func TestMasqueOtherServerLink(t *testing.T) {
+	out, endpoint, err := MasqueLinkSingbox("masque://10.0.0.1:443?privateKey=" + hEscape(hDeviceKey) + "&sni=masque.example.com#mine")
+	if err != nil || endpoint != nil || out == nil || out.Type != C.TypeMASQUE {
+		t.Fatalf("%v %+v %+v", err, out, endpoint)
+	}
+	if _, _, err := MasqueLinkSingbox("masque://10.0.0.1:443?sni=masque.example.com#mine"); err == nil {
+		t.Fatal("a link to another server without a key")
+	}
+}
diff --git a/ray2sing/h_openvpn_test.go b/ray2sing/h_openvpn_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..8fc5cbcfcbbfd832d234a12c8c616ad020cf4f3f
--- /dev/null
+++ b/ray2sing/h_openvpn_test.go
@@ -0,0 +1,193 @@
+package ray2sing
+
+import (
+	"context"
+	"encoding/base64"
+	"strings"
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+	T "github.com/sagernet/sing-box/option"
+	"github.com/stretchr/testify/require"
+)
+
+const hOVPNProfile = `# a profile as servers hand it out
+client
+dev tun
+proto udp
+remote vpn.example.com 1194
+resolv-retry infinite
+nobind
+persist-key
+persist-tun
+remote-cert-tls server
+cipher AES-256-CBC
+auth SHA256
+comp-lzo
+verb 3
+key-direction 1
+auth-user-pass
+<ca>
+-----BEGIN CERTIFICATE-----
+MIIBszCCAVmgAwIBAgIUQ0FfY2VydGlmaWNhdGVfZm9yX3Rlc3RzMAoGCCqGSM49
+-----END CERTIFICATE-----
+</ca>
+<cert>
+-----BEGIN CERTIFICATE-----
+MIIBsTCCAVegAwIBAgIUQ2xpZW50X2NlcnRpZmljYXRlX2Zvcl90ZXN0czAKBggq
+-----END CERTIFICATE-----
+</cert>
+<key>
+-----BEGIN PRIVATE KEY-----
+MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgY2xpZW50X2tleQ==
+-----END PRIVATE KEY-----
+</key>
+<tls-auth>
+-----BEGIN OpenVPN Static key V1-----
+6acef03f62675b4b1bbd03e53b187727
+-----END OpenVPN Static key V1-----
+</tls-auth>
+<auth-user-pass>
+alice
+secret
+</auth-user-pass>
+`
+
+func hOpenVPN(t *testing.T, endpoint *T.Endpoint) *T.OpenVPNClientEndpointOptions {
+	t.Helper()
+	require.Equal(t, C.TypeOpenVPNClient, endpoint.Type)
+	opts, ok := endpoint.Options.(*T.OpenVPNClientEndpointOptions)
+	require.True(t, ok)
+	return opts
+}
+
+func TestOpenVPNProfile(t *testing.T) {
+	options, err := Ray2SingboxOptions(context.Background(), hOVPNProfile, false)
+	require.NoError(t, err)
+	require.Len(t, options.Endpoints, 1)
+	endpoint := options.Endpoints[0]
+	require.Equal(t, "vpn.example.com § 0", endpoint.Tag, "named after its server")
+	opts := hOpenVPN(t, &endpoint)
+
+	require.Equal(t, "tls", opts.Mode)
+	require.Equal(t, "vpn.example.com", opts.Server)
+	require.EqualValues(t, 1194, opts.ServerPort)
+	require.Equal(t, "udp", opts.Network)
+	require.Equal(t, "SHA256", opts.Auth)
+	require.Equal(t, "adaptive", opts.CompressionLZO)
+	require.Empty(t, opts.Cipher, "cipher is not allowed in TLS mode")
+	require.Equal(t, "AES-256-CBC", opts.DataCiphersFallback)
+	require.Equal(t, []string{"AES-256-CBC"}, []string(opts.DataCiphers))
+	require.Equal(t, "alice", opts.Username)
+	require.Equal(t, "secret", opts.Password)
+
+	require.NotNil(t, opts.TLS)
+	require.Equal(t, "server", opts.TLS.RemoteCertificateTLS)
+	require.Equal(t, "-----BEGIN CERTIFICATE-----", opts.TLS.Certificate[0], "the PEM lines as they are, not decoded")
+	require.Len(t, opts.TLS.ClientCertificate, 3)
+	require.Len(t, opts.TLS.ClientKey, 3)
+	require.NotNil(t, opts.TLS.ControlWrap)
+	require.Equal(t, "tls_auth", opts.TLS.ControlWrap.Type)
+	require.Equal(t, "client", opts.TLS.ControlWrap.Direction, "key-direction 1")
+	require.Len(t, opts.TLS.ControlWrap.Key, 3)
+
+	out, err := Ray2Singbox(context.Background(), hOVPNProfile, false)
+	require.NoError(t, err)
+	require.Contains(t, string(out), `"type":"openvpn-client"`)
+}
+
+func TestOpenVPNLink(t *testing.T) {
+	profile := strings.Replace(hOVPNProfile, "<auth-user-pass>\nalice\nsecret\n</auth-user-pass>\n", "", 1)
+	profile = strings.Replace(profile, "<tls-auth>", "<tls-crypt>", 1)
+	profile = strings.Replace(profile, "</tls-auth>", "</tls-crypt>", 1)
+	profile = strings.Replace(profile, "proto udp\n", "proto tcp-client\n", 1)
+	link := "ovpn://" + base64.StdEncoding.EncodeToString([]byte(profile)) + "?user=bob&pass=p%40ss#My%20VPN"
+
+	options, err := Ray2SingboxOptions(context.Background(), link+"\nvless://id@example.org:443?security=tls#other", false)
+	require.NoError(t, err)
+	require.Len(t, options.Endpoints, 1, "the link beside other links")
+	require.Len(t, options.Outbounds, 1)
+	endpoint := options.Endpoints[0]
+	require.True(t, strings.HasPrefix(endpoint.Tag, "My VPN § "), endpoint.Tag)
+	opts := hOpenVPN(t, &endpoint)
+	require.Equal(t, "tcp", opts.Network)
+	require.Equal(t, "bob", opts.Username, "the credentials of the link, as the profile has none inline")
+	require.Equal(t, "p@ss", opts.Password)
+	require.Equal(t, "tls_crypt", opts.TLS.ControlWrap.Type)
+	require.Empty(t, opts.TLS.ControlWrap.Direction, "tls-crypt has no direction")
+
+	// the link's base64 may be URL-safe and unpadded
+	link = "ovpn://" + base64.RawURLEncoding.EncodeToString([]byte(profile))
+	endpoint2, err := OpenVPNSingbox(link)
+	require.NoError(t, err)
+	require.Equal(t, "vpn.example.com", endpoint2.Tag)
+}
+
+func TestOpenVPNRemotesAndStaticKey(t *testing.T) {
+	profile := `client
+dev tun
+proto udp
+port 1195
+remote a.example.com
+remote b.example.com 443 tcp
+remote-random
+cipher AES-256-CBC
+secret [inline] 1
+<secret>
+-----BEGIN OpenVPN Static key V1-----
+6acef03f62675b4b1bbd03e53b187727
+-----END OpenVPN Static key V1-----
+</secret>
+`
+	endpoint, err := ParseOVPN(profile, "", "", "")
+	require.NoError(t, err)
+	opts := hOpenVPN(t, endpoint)
+	require.Empty(t, opts.Server)
+	require.Len(t, opts.Servers, 2)
+	require.Equal(t, "a.example.com", opts.Servers[0].Server)
+	require.EqualValues(t, 1195, opts.Servers[0].ServerPort, "the profile's port")
+	require.Equal(t, "udp", opts.Servers[0].Network, "the profile's proto")
+	require.EqualValues(t, 443, opts.Servers[1].ServerPort)
+	require.Equal(t, "tcp", opts.Servers[1].Network)
+	require.True(t, opts.RemoteRandom)
+
+	require.Equal(t, "static_key", opts.Mode)
+	require.Equal(t, "AES-256-CBC", opts.Cipher, "cipher is the static key's")
+	require.Equal(t, "client", opts.KeyDirection)
+	require.Len(t, opts.StaticKey, 3)
+	require.Nil(t, opts.TLS)
+}
+
+func TestOpenVPNRefusesWhatItCannotRun(t *testing.T) {
+	_, err := ParseOVPN(strings.Replace(hOVPNProfile, "dev tun", "dev tap", 1), "", "", "")
+	require.ErrorContains(t, err, "tap")
+
+	_, err = ParseOVPN("client\ndev tun\nremote a.example.com\nca ca.crt\n", "", "", "")
+	require.ErrorContains(t, err, "<ca>", "a certificate in a file beside it can not be read")
+
+	_, err = ParseOVPN("client\ndev tun\n", "", "", "")
+	require.ErrorContains(t, err, "remote")
+}
+
+func TestOpenVPNProfileDetection(t *testing.T) {
+	require.True(t, isOpenVPNProfile(hOVPNProfile))
+	require.False(t, isOpenVPNProfile("vless://id@remote.example.com:443#remote x"))
+	require.False(t, isOpenVPNProfile("[Interface]\nPrivateKey = a2V5\n[Peer]\nEndpoint = 1.2.3.4:51820"))
+	require.False(t, isOpenVPNProfile("remote 1.2.3.4"), "one line alone is not enough")
+}
+
+// Some profiles close an inline block on its last line, or open it on its first.
+func TestOpenVPNInlineBlockTagsOnContentLines(t *testing.T) {
+	profile := strings.NewReplacer(
+		"-----END PRIVATE KEY-----\n</key>", "-----END PRIVATE KEY-----</key>",
+		"<cert>\n-----BEGIN CERTIFICATE-----", "<cert>-----BEGIN CERTIFICATE-----",
+	).Replace(hOVPNProfile)
+	endpoint, err := ParseOVPN(profile, "", "", "")
+	require.NoError(t, err)
+	opts := hOpenVPN(t, endpoint)
+	require.Len(t, opts.TLS.ClientCertificate, 3)
+	require.Len(t, opts.TLS.ClientKey, 3)
+	require.Equal(t, "-----END PRIVATE KEY-----", opts.TLS.ClientKey[2])
+	require.Equal(t, "alice", opts.Username, "the blocks after it are still read")
+	require.Len(t, opts.TLS.ControlWrap.Key, 3)
+}
