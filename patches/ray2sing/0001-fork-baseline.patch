+	BlockBitsIPv4   int
+	BlockBitsIPv6   int
+}
+
+type testOptionalScanner struct {
+	EdgeSearchOptions testEdgeSearch
+	Enabled           *bool
+	Sets              []string
+	ServerNames       []string
+	CIDRs             []netip.Prefix
+	Candidates        int
+	Count             int
+	Concurrency       int
