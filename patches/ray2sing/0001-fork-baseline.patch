@@ -0,0 +1,124 @@
+package ray2sing_test
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/hiddify/ray2sing/ray2sing"
+	C "github.com/sagernet/sing-box/constant"
+	T "github.com/sagernet/sing-box/option"
+)
+
+func parseAether(t *testing.T, link string) *T.Options {
+	t.Helper()
+	options, err := ray2sing.Ray2SingboxOptions(context.Background(), link, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return options
+}
+
+func warpOf(t *testing.T, endpoint T.Endpoint) *T.WARPEndpointOptions {
+	t.Helper()
+	if endpoint.Type != C.TypeWARP {
+		t.Fatalf("not a warp endpoint: %+v", endpoint)
+	}
+	return endpoint.Options.(*T.WARPEndpointOptions)
+}
+
+// WireGuard over MASQUE: the WireGuard hop runs through the MASQUE one, which is at the link's outer
+// endpoint over HTTP/2 with Aether's server name.
+func TestAetherWgOverMasque(t *testing.T) {
+	options := parseAether(t, "aether://?protocol=wg-over-masque&scan=balanced&ip=v4&transport=h2&outer=1.1.1.1%3A443#Not%20YouTube%20")
+	if len(options.Endpoints) != 2 || len(options.Outbounds) != 0 {
+		t.Fatalf("endpoints %+v outbounds %+v", options.Endpoints, options.Outbounds)
+	}
+	outer, inner := warpOf(t, options.Endpoints[0]), warpOf(t, options.Endpoints[1])
+	if outer.Mode != "masque" || outer.Server != "1.1.1.1" || outer.ServerPort != 443 || outer.MASQUE.VHTTP != "h2" ||
+		outer.MASQUE.ServerName != "www.cloudflare.com" || outer.Detour != "" {
+		t.Fatalf("outer %+v %+v", outer, outer.MASQUE)
+	}
+	if inner.Mode != "wg" || inner.Server != "" || inner.Detour != options.Endpoints[0].Tag || inner.Scanner.Enabled {
+		t.Fatalf("inner %+v", inner)
+	}
+	if !strings.HasPrefix(options.Endpoints[0].Tag, "Not YouTube") || outer.UniqueIdentifier == inner.UniqueIdentifier ||
+		!strings.HasPrefix(outer.UniqueIdentifier, "aether-") {
+		t.Fatalf("tags %q %q ids %q %q", options.Endpoints[0].Tag, options.Endpoints[1].Tag, outer.UniqueIdentifier, inner.UniqueIdentifier)
+	}
+}
+
+func TestAetherSingleHops(t *testing.T) {
+	options := parseAether(t, "aether://188.114.99.93:891?protocol=wg&scan=balanced&ip=v4#A10\n"+
+		"aether://162.159.198.2:443?protocol=masque&scan=balanced&ip=v4&transport=h2&sni=consumer-masque.cloudflareclient.com&fragment=1#A11\n"+
+		"aether://?scan=turbo&noize=off#scan")
+	if len(options.Endpoints) != 3 {
+		t.Fatalf("endpoints %+v", options.Endpoints)
+	}
+	wg, masque, scan := warpOf(t, options.Endpoints[0]), warpOf(t, options.Endpoints[1]), warpOf(t, options.Endpoints[2])
+	if wg.Mode != "wg" || wg.Server != "188.114.99.93" || wg.ServerPort != 891 {
+		t.Fatalf("wg %+v", wg)
+	}
+	if masque.Mode != "masque" || masque.ServerPort != 443 || masque.MASQUE.ServerName != "consumer-masque.cloudflareclient.com" || !masque.MASQUE.TLS.Fragment {
+		t.Fatalf("masque %+v %+v", masque, masque.MASQUE)
+	}
+	if scan.Mode != "wg" || scan.Server != "" || !scan.Scanner.Enabled || scan.Scanner.SearchNoise || scan.Scanner.Count != 16 {
+		t.Fatalf("scan %+v %+v", scan, scan.Scanner)
+	}
+}
+
+func TestAetherTwoHops(t *testing.T) {
+	options := parseAether(t, "aether://?protocol=gool&outer=188.114.97.1%3A4500&inner=162.159.195.117%3A864#gool\n"+
+		"aether://?protocol=mim&transport=h2&outer=162.159.198.234%3A443&inner=162.159.198.18%3A443#mim")
+	if len(options.Endpoints) != 4 {
+		t.Fatalf("endpoints %+v", options.Endpoints)
+	}
+	gOuter, gInner := warpOf(t, options.Endpoints[0]), warpOf(t, options.Endpoints[1])
+	if gOuter.Mode != "wg" || gOuter.Server != "188.114.97.1" || gInner.Mode != "wg" || gInner.Server != "162.159.195.117" ||
+		gInner.ServerPort != 864 || gInner.Detour != options.Endpoints[0].Tag {
+		t.Fatalf("gool %+v %+v", gOuter, gInner)
+	}
+	mOuter, mInner := warpOf(t, options.Endpoints[2]), warpOf(t, options.Endpoints[3])
+	if mOuter.Mode != "masque" || mInner.Mode != "masque" || mInner.Server != "162.159.198.18" || mInner.Detour != options.Endpoints[2].Tag {
+		t.Fatalf("mim %+v %+v", mOuter, mInner)
+	}
+}
+
+func TestAetherCarriers(t *testing.T) {
+	// psiphon inside WARP: psiphon dials through the warp endpoint
+	options := parseAether(t, "aether://188.114.99.59:1180?protocol=wg&psiphon=chain&psiphon_mode=auto&region=FI#A13")
+	if len(options.Outbounds) != 1 || len(options.Endpoints) != 1 || options.Outbounds[0].Type != C.TypePsiphon {
+		t.Fatalf("%+v %+v", options.Outbounds, options.Endpoints)
+	}
+	psiphon := options.Outbounds[0].Options.(*T.PsiphonOutboundOptions)
+	if psiphon.EgressRegion != "FI" || psiphon.Detour != options.Endpoints[0].Tag {
+		t.Fatalf("psiphon %+v", psiphon)
+	}
+
+	// WARP through tor: MASQUE over HTTP/2, dialled through tor
+	options = parseAether(t, "aether://162.159.198.248:443?protocol=masque&tor=reverse#A4")
+	if len(options.Outbounds) != 1 || options.Outbounds[0].Type != C.TypeTor {
+		t.Fatalf("%+v", options.Outbounds)
+	}
+	warp := warpOf(t, options.Endpoints[0])
+	if warp.Detour != options.Outbounds[0].Tag || warp.MASQUE.VHTTP != "h2" {
+		t.Fatalf("warp %+v", warp)
+	}
+
+	options = parseAether(t, "aether://?protocol=wg&tor=only&tor_bridges=auto#A8")
+	if len(options.Outbounds) != 1 || len(options.Endpoints) != 0 || options.Outbounds[0].Type != C.TypeTor {
+		t.Fatalf("%+v %+v", options.Outbounds, options.Endpoints)
+	}
+}
+
+func TestAetherRefused(t *testing.T) {
+	for _, link := range []string{
+		"aether://?protocol=wg&tor=reverse#wg-through-tor",
+		"aether://?protocol=nope#unknown",
+		"aether://?protocol=masque&tor=chain&psiphon=chain#both-inside",
+	} {
+		if _, err := ray2sing.Ray2SingboxOptions(context.Background(), link, false); err == nil {
+			t.Errorf("%s: no error", link)
+		}
+	}
+}
diff --git a/ray2sing_test/awg3_link_test.go b/ray2sing_test/awg3_link_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..10ad2c19dd679985e63b7f23201304de873e5970
--- /dev/null
+++ b/ray2sing_test/awg3_link_test.go
@@ -0,0 +1,72 @@
+package ray2sing_test
+
+import (
+	"strings"
+	"testing"
+)
+
+// An AmneziaWG 3.x wg:// link: snake_case keys, base64 keys with an unescaped "+", a base64
+// header_protection_key, and the 3.x ranges and flags.
+func TestWgLinkAwg3(t *testing.T) {
+	pub := "EdvQI284oYKlm6YqUXn4gd6wWqZC+HAsJQCmm9+GdRQ%3D"
+	hpk := "XG1+gpKcCUzj/03OKxoXBusfUwCcZs5V/v20pJIsvPs%3D"
+	got := convert(t, "wg://198.51.100.1:51820?private_key="+strings.ReplaceAll(testPrivateKey, "=", "%3D")+
+		"&local_address=10.8.1.2/32&mtu=1280&enable_amnezia=true&jc=4&jmin=78&jmax=292&s1=87&s2=146&s3=15&s4=17"+
+		"&h1=13018123&h2=922202939&h3=1214307164&h4=1988128689&i1=%3Cr%20240%3E&header_protection_key="+hpk+
+		"&content_padding_addition=9-33&rekey_after_time=112-151&rekey_timeout=6-10&reject_after_time=200-285"+
+		"&keepalive_timeout=12-15&max_handshake_attempts=19-26&random_trailers=true&disable_cookies=true"+
+		"&public_key="+pub+"&persistent_keepalive_interval=25#%F0%9F%87%B5%F0%9F%87%B1%20Amnezia")
+	wantAll(t, got, `"type":"awg"`, `"address":"10.8.1.2/32"`, `"mtu":1280`,
+		`"public_key":"EdvQI284oYKlm6YqUXn4gd6wWqZC+HAsJQCmm9+GdRQ="`,
+		`"persistent_keepalive_interval":25`,
+		`"jc":4`, `"s4":17`, `"h4":"1988128689"`, `"i1":"<r 240>"`,
+		`"header_protection_key":"5c6d7e82929c094ce3ff4dce2b1a1706eb1f53009c66ce55fefdb4a4922cbcfb"`,
+		`"content_padding_addition":"9-33"`, `"rekey_after_time":"112-151"`, `"rekey_timeout":"6-10"`,
+		`"reject_after_time":"200-285"`, `"keepalive_timeout":"12-15"`, `"max_handshake_attempts":"19-26"`,
+		`"random_trailers":true`, `"disable_cookies":true`)
+}
+
+// The flags as amneziawg-tools writes them in a .conf ("awg showconf"): on or off, or a number.
+func TestAwgConf3Flags(t *testing.T) {
+	conf := func(trailers, cookies string) string {
+		return convert(t, `[Interface]
+PrivateKey = `+testPrivateKey+`
+Address = 10.8.1.2/32
+S1 = 87
+H1 = 13018123
+RandomTrailers = `+trailers+`
+DisableCookies = `+cookies+`
+
+[Peer]
+PublicKey = `+testPublicKey+`
+Endpoint = 198.51.100.1:51820
+`)
+	}
+	wantAll(t, conf("on", "On"), `"random_trailers":true`, `"disable_cookies":true`)
+	wantAll(t, conf("1", "2"), `"random_trailers":true`, `"disable_cookies":true`)
+	for _, got := range []string{conf("off", "0"), conf("OFF", "false")} {
+		if strings.Contains(got, "random_trailers") || strings.Contains(got, "disable_cookies") {
+			t.Errorf("flags turned on from off:\n%s", got)
+		}
+	}
+}
+
+// The same AmneziaWG 3.x values in a .conf.
+func TestAwgConf3(t *testing.T) {
+	got := convert(t, `[Interface]
+PrivateKey = `+testPrivateKey+`
+Address = 10.8.1.2/32
+S1 = 87
+S2 = 146
+HeaderProtectionKey = XG1+gpKcCUzj/03OKxoXBusfUwCcZs5V/v20pJIsvPs=
+ContentPaddingAddition = 9-33
+RandomTrailers = true
+
+[Peer]
+PublicKey = `+testPublicKey+`
+Endpoint = 198.51.100.1:51820
+`)
+	wantAll(t, got, `"type":"awg"`,
+		`"header_protection_key":"5c6d7e82929c094ce3ff4dce2b1a1706eb1f53009c66ce55fefdb4a4922cbcfb"`,
+		`"content_padding_addition":"9-33"`, `"random_trailers":true`)
+}
diff --git a/ray2sing_test/dnst_test.go b/ray2sing_test/dnst_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..839b1999a7e750f60f8b195b573c77e574e79587
--- /dev/null
+++ b/ray2sing_test/dnst_test.go
@@ -0,0 +1,177 @@
+package ray2sing_test
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"encoding/base64"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/hiddify/ray2sing/ray2sing"
+	C "github.com/sagernet/sing-box/constant"
+	T "github.com/sagernet/sing-box/option"
+)
+
+const dnstPubKey = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+
+func convertDnst(t *testing.T, link string) []T.Outbound {
+	t.Helper()
+	options, err := ray2sing.Ray2SingboxOptions(context.Background(), link, false)
+	if err != nil {
+		t.Fatalf("%s: %v", link, err)
+	}
+	return options.Outbounds
+}
+
+// DNSTT + SOCKS: a socks outbound through a dnstt outbound in the original wire format, with the
+// built-in resolvers.
+func TestDnstDnsttSocks(t *testing.T) {
+	outs := convertDnst(t, "dnst://t.example.com/dnstt/socks?pubkey="+dnstPubKey+"&user=foo&password=bar#my-tunnel")
+	if len(outs) != 2 || outs[0].Type != C.TypeDNSTT || outs[1].Type != C.TypeSOCKS {
+		t.Fatalf("outbounds: %+v", outs)
+	}
+	dnstt := outs[0].Options.(*T.DnsttOptions)
+	socks := outs[1].Options.(*T.SOCKSOutboundOptions)
+	if dnstt.Domain != "t.example.com" || dnstt.PublicKey != dnstPubKey || !dnstt.DnsttCompat || len(dnstt.Resolvers) != 1 || dnstt.Resolvers[0] != "auto" {
+		t.Fatalf("dnstt: %+v", dnstt)
+	}
+	if socks.Username != "foo" || socks.Password != "bar" || socks.Detour != outs[0].Tag || !strings.HasPrefix(outs[1].Tag, "my-tunnel") || !strings.Contains(outs[0].Tag, "§hide§") {
+		t.Fatalf("socks: %s %+v", outs[1].Tag, socks)
+	}
+}
+
+// VayDNS + SSH: the VayDNS wire fields, the durations, an extension parameter (resolver) and an
+// ssh outbound in front.
+func TestDnstVaydnsSSH(t *testing.T) {
+	outs := convertDnst(t, "dnst://t.example.com/vaydns/ssh?pubkey="+dnstPubKey+"&record-type=cname&clientid-size=4&keepalive=10s&idle-timeout=60s&resolver=8.8.8.8:53,dot://1.1.1.1:853&user=tunnel&password=s3cret#vay")
+	if len(outs) != 2 || outs[0].Type != C.TypeDNSTT || outs[1].Type != C.TypeSSH {
+		t.Fatalf("outbounds: %+v", outs)
+	}
+	dnstt := outs[0].Options.(*T.DnsttOptions)
+	if dnstt.DnsttCompat || dnstt.RecordType != "cname" || *dnstt.ClientIDSize != 4 || time.Duration(*dnstt.KeepAlive) != 10*time.Second || time.Duration(*dnstt.IdleTimeout) != 60*time.Second ||
+		strings.Join(dnstt.Resolvers, " ") != "8.8.8.8:53 dot://1.1.1.1:853" {
+		t.Fatalf("dnstt: %+v", dnstt)
+	}
+	ssh := outs[1].Options.(*T.SSHOutboundOptions)
+	if ssh.User != "tunnel" || ssh.Password != "s3cret" || ssh.Detour != outs[0].Tag || len(ssh.PrivateKey) != 0 {
+		t.Fatalf("ssh: %+v", ssh)
+	}
+
+	// dnstt-compat is honoured when written
+	outs = convertDnst(t, "dnst://t.example.com/vaydns/socks?pubkey="+dnstPubKey+"&record-type=txt&dnstt-compat=true#x")
+	if !outs[0].Options.(*T.DnsttOptions).DnsttCompat {
+		t.Fatal("dnstt-compat=true not carried")
+	}
+}
+
+// An SSH private key is base64url of the PEM body in the URL form; it becomes a PEM with the
+// matching header.
+func TestDnstSSHPrivateKey(t *testing.T) {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	der, err := x509.MarshalPKCS8PrivateKey(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pk := base64.RawURLEncoding.EncodeToString(der)
+	outs := convertDnst(t, "dnst://t.example.com/dnstt/ssh?pubkey="+dnstPubKey+"&user=tunnel&pk="+pk+"#k")
+	ssh := outs[1].Options.(*T.SSHOutboundOptions)
+	if len(ssh.PrivateKey) != 1 || !strings.HasPrefix(ssh.PrivateKey[0], "-----BEGIN PRIVATE KEY-----\n") || !strings.Contains(ssh.PrivateKey[0], "\n-----END PRIVATE KEY-----") || ssh.Password != "" {
+		t.Fatalf("ssh: %+v", ssh)
+	}
+	if _, err := ray2sing.DnstSingbox("dnst://t.example.com/dnstt/ssh?pubkey=" + dnstPubKey + "&user=u&pk=bm90LWEta2V5"); err == nil || !strings.Contains(err.Error(), "pk") {
+		t.Fatalf("bad key accepted: %v", err)
+	}
+}
+
+// Shadowsocks behind the tunnel.
+func TestDnstShadowsocks(t *testing.T) {
+	outs := convertDnst(t, "dnst://t.example.com/dnstt/shadowsocks?pubkey="+dnstPubKey+"&method=aes-256-gcm&password=secret#ss")
+	ss := outs[1].Options.(*T.ShadowsocksOutboundOptions)
+	if outs[1].Type != C.TypeShadowsocks || ss.Method != "aes-256-gcm" || ss.Password != "secret" || ss.Detour != outs[0].Tag {
+		t.Fatalf("ss: %+v", ss)
+	}
+}
+
+// MasterDNS + SOCKS is the masterdns outbound alone (the server connects to the destination),
+// with the built-in resolvers through its smart pool; custom is the server's TCP mode; a backend
+// goes in front of it.
+func TestDnstMasterdns(t *testing.T) {
+	outs := convertDnst(t, "dnst://v.example.com/masterdns/socks?mkey=abcdef1234&encryption=5&user=foo&password=bar#md")
+	if len(outs) != 1 || outs[0].Type != C.TypeMasterDNS || outs[0].Tag != "md § 0" {
+		t.Fatalf("outbounds: %+v", outs)
+	}
+	md := outs[0].Options.(*T.MasterDNSOptions)
+	if md.Key != "abcdef1234" || md.Encryption != "5" || md.Mode != "" || len(md.Domains) != 1 || md.Domains[0] != "v.example.com" || strings.Join(md.Resolvers, ",") != "auto" || !md.SmartPool.IsEnabled() {
+		t.Fatalf("masterdns: %+v", md)
+	}
+
+	outs = convertDnst(t, "dnst://v.example.com/masterdns/custom?mkey=abcdef1234&encryption=1&resolvers=9.9.9.9,10.0.0.0/30#tcp")
+	md = outs[0].Options.(*T.MasterDNSOptions)
+	if len(outs) != 1 || md.Mode != "tcp" || strings.Join(md.Resolvers, " ") != "9.9.9.9 10.0.0.0/30" {
+		t.Fatalf("custom: %+v", md)
+	}
+
+	outs = convertDnst(t, "dnst://v.example.com/masterdns/ssh?mkey=abcdef1234&encryption=2&user=root&password=pw#mssh")
+	if len(outs) != 2 || outs[0].Type != C.TypeMasterDNS || outs[1].Type != C.TypeSSH || outs[0].Options.(*T.MasterDNSOptions).Mode != "tcp" || outs[1].Options.(*T.SSHOutboundOptions).Detour != outs[0].Tag {
+		t.Fatalf("ssh: %+v", outs)
+	}
+
+	if _, err := ray2sing.DnstSingbox("dnst://v.example.com/masterdns/socks?encryption=5"); err == nil {
+		t.Fatal("missing mkey accepted")
+	}
+	outs = convertDnst(t, "dnst://v.example.com/masterdns/socks?encryption=0#plain")
+	if outs[0].Options.(*T.MasterDNSOptions).Encryption != "0" {
+		t.Fatal("encryption none needs no key")
+	}
+}
+
+// The base64url JSON form, with a PEM private key stored as is.
+func TestDnstJSONForm(t *testing.T) {
+	doc := `{"tag":"json tunnel","transport":{"type":"vaydns","domain":"t.example.com","pubkey":"` + dnstPubKey + `","record_type":"txt","dnstt_compat":false,"clientid_size":2,"idle_timeout":"60s","keepalive":"10s"},"backend":{"type":"ssh","user":"tunnel","password":"secret"}}`
+	link := "dnst://" + base64.RawURLEncoding.EncodeToString([]byte(doc))
+	outs := convertDnst(t, link)
+	if len(outs) != 2 || outs[0].Type != C.TypeDNSTT || outs[1].Type != C.TypeSSH || !strings.HasPrefix(outs[1].Tag, "json tunnel") {
+		t.Fatalf("outbounds: %+v", outs)
+	}
+	dnstt := outs[0].Options.(*T.DnsttOptions)
+	if dnstt.DnsttCompat || dnstt.RecordType != "txt" || *dnstt.ClientIDSize != 2 || time.Duration(*dnstt.IdleTimeout) != time.Minute {
+		t.Fatalf("dnstt: %+v", dnstt)
+	}
+
+	doc = `{"tag":"m","transport":{"type":"masterdns","domain":"v.example.com","mkey":"k","encryption":1},"backend":{"type":"custom"}}`
+	outs = convertDnst(t, "dnst://"+base64.RawURLEncoding.EncodeToString([]byte(doc)))
+	if len(outs) != 1 || outs[0].Type != C.TypeMasterDNS || outs[0].Options.(*T.MasterDNSOptions).Mode != "tcp" || outs[0].Options.(*T.MasterDNSOptions).Encryption != "1" {
+		t.Fatalf("masterdns json: %+v", outs)
+	}
+
+	// the spec's own example: slipstream is refused with a reason
+	specExample := "dnst:"
+	if _, err := ray2sing.DnstSingbox(specExample); err == nil || !strings.Contains(err.Error(), "slipstream") {
+		t.Fatalf("slipstream: %v", err)
+	}
+	if _, err := ray2sing.Ray2SingboxOptions(context.Background(), specExample, false); err == nil {
+		t.Fatal("slipstream converted")
+	}
+}
+
+func TestDnstErrors(t *testing.T) {
+	for name, link := range map[string]string{
+		"path":      "dnst://t.example.com/dnstt?pubkey=" + dnstPubKey,
+		"transport": "dnst://t.example.com/iodine/socks?pubkey=" + dnstPubKey,
+		"backend":   "dnst://t.example.com/dnstt/vmess?pubkey=" + dnstPubKey,
+		"ssh user":  "dnst://t.example.com/dnstt/ssh?pubkey=" + dnstPubKey + "&password=x",
+		"ss method": "dnst://t.example.com/dnstt/shadowsocks?pubkey=" + dnstPubKey + "&password=x",
+		"json":      "dnst://bm90LWpzb24",
+	} {
+		if _, err := ray2sing.DnstSingbox(link); err == nil {
+			t.Errorf("%s: accepted", name)
+		}
+	}
+}
diff --git a/ray2sing_test/finalmask_test.go b/ray2sing_test/finalmask_test.go
index 527d763ddb879509acfcb65cd67d21c3f3e7d60e..87c5114044544de865797c348e3d333cd4590918 100644
--- a/ray2sing_test/finalmask_test.go
+++ b/ray2sing_test/finalmask_test.go
@@ -41,12 +41,12 @@ func TestFinalMaskVless(t *testing.T) {
 		t.Fatalf("settings not kept: %s", fm.TCP[1].Settings)
 	}
 
-	// the converted config carries it as finalmask
+	// Both supported engine spellings retain the converted final mask.
 	out, err := ray2sing.Ray2Singbox(context.Background(), link, false)
 	if err != nil {
 		t.Fatal(err)
 	}
-	if !strings.Contains(string(out), `"finalmask"`) {
+	if !strings.Contains(string(out), `"finalmask"`) && !strings.Contains(string(out), `"final_mask"`) {
 		t.Fatalf("finalmask missing from %s", out)
 	}
 }
@@ -84,3 +84,40 @@ func TestFinalMaskInvalidIsRejected(t *testing.T) {
 		}
 	}
 }
+
+// patterniha's merge mask, and dialMode=oob.<bytes> as an oob mask after it, next to the socket.
+// The merge mask used to fail the whole link ("unknown mask type"), so the link was dropped.
+func TestFinalMaskMergeAndDialModeOOB(t *testing.T) {
+	fm := url.QueryEscape(`{"tcp": [{"type": "merge", "settings": {"times": 100, "delayMs": 30, "maxBytes": 16384}}]}`)
+	link := "vless://dffb7646-1656-427a-8187-9c056a6a5fd5@[2a06:98c1:3101::6812:202f]:443?encryption=none&security=tls&type=ws&host=example.com&path=%2Fws&sni=example.com&fp=hellochrome_120&fm=" + fm + "&dialMode=oob.0&packetEncoding=xudp#oob"
+	mask := finalMaskOf(t, link)
+	if mask == nil || len(mask.TCP) != 2 || mask.TCP[0].Type != "merge" || mask.TCP[1].Type != "oob" || string(mask.TCP[1].Settings) != `{"bytes":[0]}` {
+		t.Fatalf("finalmask: %+v", mask)
+	}
+
+	// dialMode alone, with several bytes
+	mask = finalMaskOf(t, "vless://dffb7646-1656-427a-8187-9c056a6a5fd5@1.2.3.4:443?security=tls&sni=example.com&dialMode=oob.0,32,65#oob")
+	if mask == nil || len(mask.TCP) != 1 || string(mask.TCP[0].Settings) != `{"bytes":[0,32,65]}` {
+		t.Fatalf("finalmask: %+v", mask)
+	}
+
+	for _, mode := range []string{"oob.", "oob.256", "tfo"} {
+		if _, err := ray2sing.Ray2SingboxOptions(context.Background(), "vless://dffb7646-1656-427a-8187-9c056a6a5fd5@1.2.3.4:443?security=tls&dialMode="+mode+"#x", false); err == nil {
+			t.Errorf("dialMode=%s accepted", mode)
+		}
+	}
+}
+
+// A mirage mask in fm= is kept, and a bad layout is refused like any bad mask.
+func TestFinalMaskMirage(t *testing.T) {
+	fm := finalMaskOf(t, "vless://25da296e-1d96-48ae-9867-4342796cd742@example.com:443?security=reality&sni=example.com&type=tcp&fm="+
+		url.QueryEscape(`{"tcp":[{"type":"mirage","settings":{"offset":4,"layout":"single"}}]}`)+"#mirage")
+	if fm == nil || len(fm.TCP) != 1 || fm.TCP[0].Type != "mirage" ||
+		!strings.Contains(string(fm.TCP[0].Settings), `"layout":"single"`) {
+		t.Fatalf("unexpected final mask: %+v", fm)
+	}
+	if _, err := ray2sing.Ray2SingboxOptions(context.Background(), "vless://25da296e-1d96-48ae-9867-4342796cd742@example.com:443?security=tls&type=tcp&fm="+
+		url.QueryEscape(`{"tcp":[{"type":"mirage","settings":{"layout":"both"}}]}`)+"#x", false); err == nil {
+		t.Fatal("a bad mirage layout was accepted")
+	}
+}
diff --git a/ray2sing_test/h_soar_key_test.go b/ray2sing_test/h_soar_key_test.go
