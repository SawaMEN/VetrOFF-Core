diff --git a/ray2sing_test/h_soar_key_test.go b/ray2sing_test/h_soar_key_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..770c830d1d454775e163f52b4a7b8e399ee81791
--- /dev/null
+++ b/ray2sing_test/h_soar_key_test.go
@@ -0,0 +1,22 @@
+package ray2sing_test
+
+import (
+	"encoding/base64"
+	"testing"
+
+	"github.com/hiddify/ray2sing/ray2sing"
+	"github.com/sagernet/sing-box/option"
+)
+
+func TestSoarRawBase64LeadingPlus(t *testing.T) {
+	key := make([]byte, 32)
+	key[0] = 0xfb
+	encoded := base64.StdEncoding.EncodeToString(key)
+	out, err := ray2sing.SoarSingbox("soar://t.example.com?pk=" + encoded)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := out.Options.(*option.SoarOptions).PublicKey; got != encoded {
+		t.Fatalf("key changed: %q != %q", got, encoded)
+	}
+}
