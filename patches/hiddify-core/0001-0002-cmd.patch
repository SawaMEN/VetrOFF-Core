diff --git a/cmd/cmd_xui_check.go b/cmd/cmd_xui_check.go
new file mode 100644
index 0000000000000000000000000000000000000000..f88be2052b96664955c5cd6957f9fed506064819
--- /dev/null
+++ b/cmd/cmd_xui_check.go
@@ -0,0 +1,24 @@
+package cmd
+
+import (
+	"fmt"
+
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	command := &cobra.Command{
+		Use:   "check",
+		Short: "Validate raw server configuration without starting listeners",
+		Args:  cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			if len(configPaths) == 0 && len(configDirectories) == 0 {
+				return fmt.Errorf("check requires --config or --config-directory")
+			}
+			return check()
+		},
+	}
+	command.Flags().StringArrayVarP(&configPaths, "config", "c", nil, "set configuration file path")
+	command.Flags().StringArrayVarP(&configDirectories, "config-directory", "C", nil, "set configuration directory path")
+	mainCommand.AddCommand(command)
+}
diff --git a/cmd/internal/build_root/main.go b/cmd/internal/build_root/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..fd308a7b0e0324a6a8df6a48d59dd9167ff3f35d
--- /dev/null
+++ b/cmd/internal/build_root/main.go
@@ -0,0 +1,26 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+
+	"github.com/hiddify/hiddify-core/cmd/internal/build_shared"
+)
+
+func main() {
+	build_shared.FindSDK()
+	compiler := filepath.Join(os.Getenv("ANDROID_NDK_HOME"), "toolchains", "llvm", "prebuilt", runtime.GOOS+"-x86_64", "bin", "aarch64-linux-android24-clang")
+	output := filepath.Join("bin", "libhiddify-root.so")
+	tags := "with_gvisor,with_quic,with_wireguard,with_utls,with_clash_api,with_grpc,with_awg,tfogo_checklinkname0,with_naive_outbound,with_conntrack,with_embedded_tor,with_openvpn,with_openconnect"
+	command := exec.Command("go", "build", "-trimpath", "-buildmode=pie", "-tags", tags, "-ldflags=-s -w -checklinkname=0 -extldflags=-Wl,-z,max-page-size=16384", "-o", output, "./cmd/android-root")
+	command.Env = append(os.Environ(), "GOOS=android", "GOARCH=arm64", "CGO_ENABLED=1", "CC="+compiler)
+	command.Stdout = os.Stdout
+	command.Stderr = os.Stderr
+	if err := command.Run(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
