+// workingRelative stores paths inside the working directory relative to it so they
+// survive moves of the application's data directory.
+func workingRelative(path string) string {
+	if sWorkingPath == "" || !filepath.IsAbs(path) {
+		return path
+	}
+	relative, err := filepath.Rel(sWorkingPath, path)
+	if err == nil && filepath.IsLocal(relative) {
+		return relative
+	}
+	return path
+}
+
+// inWorkingDir also recovers legacy absolute paths from a moved working directory.
+func inWorkingDir(path string) string {
+	if path == "" || sWorkingPath == "" {
+		return path
+	}
+	if !filepath.IsAbs(path) {
+		return filepath.Join(sWorkingPath, path)
+	}
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		return path
+	}
+	marker := string(filepath.Separator) + filepath.Base(sWorkingPath) + string(filepath.Separator)
+	if index := strings.LastIndex(path, marker); index >= 0 {
+		relative := path[index+len(marker):]
+		if filepath.IsLocal(relative) {
+			moved := filepath.Join(sWorkingPath, relative)
+			if _, err := os.Stat(moved); err == nil {
+				return moved
+			}
+		}
+	}
+	return path
+}
+
