diff --git a/v2/hcore/adminbgservice/status_test.go b/v2/hcore/adminbgservice/status_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..95485351395e9a3df701f8ac8949e99b29d73b90
--- /dev/null
+++ b/v2/hcore/adminbgservice/status_test.go
@@ -0,0 +1,38 @@
+package adminbgservice
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	hcommon "github.com/hiddify/hiddify-core/v2/hcommon"
+)
+
+func TestStatusAnswersDuringOperation(t *testing.T) {
+	s := &hiddifyAdminBG{}
+	stopped, err := s.Status(context.Background(), &hcommon.Empty{})
+	if err != nil || stopped == nil || stopped.Message != "stopped" {
+		t.Fatalf("initial status = %v, %v; want stopped", stopped, err)
+	}
+
+	s.running.Store(true)
+	s.mutex.Lock()
+	defer s.mutex.Unlock()
+	type result struct {
+		response *AdminBgResponse
+		err      error
+	}
+	answered := make(chan result, 1)
+	go func() {
+		response, err := s.Status(context.Background(), &hcommon.Empty{})
+		answered <- result{response: response, err: err}
+	}()
+	select {
+	case got := <-answered:
+		if got.err != nil || got.response == nil || got.response.Message != "started" {
+			t.Fatalf("status = %v, %v; want started", got.response, got.err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("status waited for the operation mutex")
+	}
+}
diff --git a/v2/hcore/last_start_path_test.go b/v2/hcore/last_start_path_test.go
