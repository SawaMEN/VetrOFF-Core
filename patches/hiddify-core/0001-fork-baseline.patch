+++ b/tools/test_prepare_panel_kernel.py
@@ -0,0 +1,141 @@
+import importlib.util
+from pathlib import Path
+import tempfile
+import unittest
+
+spec = importlib.util.spec_from_file_location("prep", Path(__file__).with_name("prepare-panel-kernel.py"))
+prep = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(prep)
+
+REVIEWED = sorted(prep.REQUIRED_FILES | {
+    "hiddify-sing-box/protocol/vless/xui_handshake_test.go",
+    "hiddify-sing-box/protocol/vless/xui_preconnect.go",
+    "hiddify-sing-box/protocol/vless/xui_reverse_native_test.go",
+    "hiddify-sing-box/common/tls/xui_reality_mldsa_handshake_test.go",
+    "hiddify-sing-box/protocol/group/xui_balancer_test.go",
+    "hiddify-sing-box/h_xray_kcp_test.go",
+    "hiddify-sing-box/transport/v2raykcp/h_kcp_test.go",
+    "hiddify-sing-box/transport/v2rayxhttp/xui_upload_queue_native_test.go",
+    "hiddify-sing-box/third_party/sing-vmess/vless/xui_vision_options.go",
+    "hiddify-sing-box/third_party/xray-core/go.mod",
+    "hiddify-sing-box/experimental/clashapi/trafficontrol/xui_panel_test.go",
+    "hiddify-sing-box/option/xui_panel_http1_test.go",
+    "hiddify-sing-box/transport/trojan/xui_stream_test.go",
+    "hiddify-sing-box/transport/v2rayhttpupgrade/xui_stream_test.go",
+})
+
+
+def fixture(root):
+    (root / "tools").mkdir()
+    script = ("python3 tools/verify-hiddify-build.py --upstream src\n"
+              "native_source_files\n"
+              "go mod tidy\n"
+              "go mod download packages\n"
+              "go build -buildvcs=true\n"
+              "CGO_ENABLED=0 go test github.com/metacubex/utls -run '^TestChrome155(CapturedClientHello|DefaultFingerprintRoundTrip|PresetOwnership)$' -count=1 -timeout=90s\n"
+              "if [[ ${HIDDIFY_VULNCHECK:-0} == 1 ]]; then true; fi\n"
+              "sha256sum\n")
+    (root / "tools/build-hiddify-core.sh").write_text(script)
+    return {
+        "panel_build": {"tags": sorted(prep.REQUIRED_TAGS), "native_source_files": REVIEWED},
+        "source_checks": [
+            {"path": "cmd/cmd_xui_check.go", "contains": 'Use:   "check"'},
+            {"path": "hiddify-sing-box/transport/masque/server.go", "contains": 'xuispeed.New("masque:"'},
+        ],
+    }
+
+
+class NativeBuildTest(unittest.TestCase):
+    def test_native_builder_has_no_panel_patches(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            lock = fixture(root)
+            self.assertIs(prep.verify_native_panel(root, lock), lock["panel_build"])
+
+    def test_reject_old_overlay_manifest(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            lock = fixture(root)
+            lock["panel_build"]["masque_overlay"] = "old.patch"
+            with self.assertRaises(ValueError):
+                prep.verify_native_panel(root, lock)
+
+    def test_reject_unverified_speed_broker(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            lock = fixture(root)
+            lock["panel_build"]["native_source_files"].remove("hiddify-sing-box/internal/xuispeed/client.go")
+            with self.assertRaises(ValueError):
+                prep.verify_native_panel(root, lock)
+
+    def test_reject_builder_reintroducing_git_patch(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            lock = fixture(root)
+            with (root / "tools/build-hiddify-core.sh").open("a") as script:
+                script.write("git apply --check removed.patch\n")
+            with self.assertRaises(ValueError):
+                prep.verify_native_panel(root, lock)
+
+    def test_reject_malformed_panel_builder_shell(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            lock = fixture(root)
+            with (root / "tools/build-hiddify-core.sh").open("a") as script:
+                script.write("echo 'unclosed quote\\n")
+            with self.assertRaisesRegex(ValueError, "Bash syntax"):
+                prep.verify_native_panel(root, lock)
+
+    def test_reject_duplicated_native_release_build(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            lock = fixture(root)
+            with (root / "tools/build-hiddify-core.sh").open("a") as script:
+                script.write("go build -buildvcs=true\\n")
+            with self.assertRaisesRegex(ValueError, "missing or duplicated"):
+                prep.verify_native_panel(root, lock)
+
+    def test_reject_missing_browser_fingerprint_test_gate(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            lock = fixture(root)
+            script_path = root / "tools/build-hiddify-core.sh"
+            script = script_path.read_text()
+            script_path.write_text(script.replace("github.com/metacubex/utls -run '^TestChrome155(",
+                                                  "github.com/metacubex/utls -run '^OldChrome133("))
+            with self.assertRaisesRegex(ValueError, "missing or duplicated"):
+                prep.verify_native_panel(root, lock)
+
+    def test_release_uses_matching_panel_go_toolchain(self):
+        workflow = (Path(__file__).parents[1] / ".github/workflows/panel-kernel-release.yml").read_text()
+        self.assertIn("go-version-file: panel-source/go.mod", workflow)
+        self.assertIn("cache-dependency-path: panel-source/go.sum", workflow)
+        self.assertLess(workflow.index("go-version-file: panel-source/go.mod"),
+                        workflow.index("name: MASQUE HTTP/2 CONNECT-IP"))
+        self.assertIn("if: matrix.arch == 'amd64'", workflow)
+
+    def test_masque_release_gate_requires_all_wire_protocols(self):
+        workflow = (Path(__file__).parents[1] / ".github/workflows/panel-kernel-release.yml").read_text()
+        self.assertIn('"TestMASQUESpeedLimits/HTTP1"', workflow)
+        self.assertIn('"TestMASQUESpeedLimits/HTTP2"', workflow)
+        self.assertIn('"TestMASQUESpeedLimits/HTTP3"', workflow)
+        self.assertIn('if results.get(name) != "pass"', workflow)
+        self.assertIn('MASQUE release E2E incomplete', workflow)
+
+    def test_validate_abi_suffix(self):
+        old = "sawamen-4f1b5e6b9b2b-4fe303071f4f-mask1-ciphers1-net62-sec1-stream1"
+        self.assertEqual("-mask1-ciphers1-net62-sec1-stream1", prep.patch_profile_suffix(old))
+        with self.assertRaises(ValueError):
+            prep.patch_profile_suffix("invalid-profile")
+
+    def test_release_versions_are_reviewed_and_distinct(self):
+        core, sing = "a" * 40, "b" * 40
+        self.assertEqual("sawamen-" + "a" * 12 + "-" + "b" * 12 + "-mask1",
+                         prep.release_tag(core, sing, "stable", "-mask1"))
+        self.assertTrue(prep.release_tag(core, sing, "dev", "-mask1").startswith("sawamen-dev-"))
+        with self.assertRaises(ValueError):
+            prep.release_tag(core, "bad", "stable", "-mask1")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/v2/config/app_chain_compat_test.go b/v2/config/app_chain_compat_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..0829c8d0df9c605240e5ad6af6b158208ab4273e
--- /dev/null
+++ b/v2/config/app_chain_compat_test.go
@@ -0,0 +1,82 @@
+package config
+
+import (
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/experimental/libbox"
+	"github.com/sagernet/sing-box/option"
+)
+
+func TestAndroidResolvedChainConsumesEditorStateOnce(t *testing.T) {
+	for _, direction := range []string{ChainStatusExtraSecurity, ChainStatusUnblocker} {
+		opts := DefaultHiddifyOptions()
+		opts.ChainStatus = direction
+		opts.ChainStage = &ChainStageOptions{Direction: direction, Mode: ChainModeProfile, ProfileContent: chainStageTestProfile}
+		built, err := BuildConfig(libbox.BaseContext(nil), opts, &ReadOptions{Content: chainTestProfile})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := libbox.CheckConfigOptions(built); err != nil {
+			t.Fatal(err)
+		}
+		if opts.ChainStatus != direction {
+			t.Fatal("persisted options mutated")
+		}
+		if direction == ChainStatusExtraSecurity && built.Route.Final != chainPrefix+OutboundSelectTag {
+			t.Fatal(built.Route.Final)
+		}
+		if direction == ChainStatusUnblocker && outboundDetour(t, built, "proxy-a") != chainPrefix+OutboundSelectTag {
+			t.Fatal("missing detour")
+		}
+	}
+}
+
+func TestAndroidProjectedWarpCreatesOneNativeHop(t *testing.T) {
+	built := buildChainConfig(t, `{"chain-status":"unblocker","unblocker":{"mode":"warp","warp":{"license-key":"key"}},"warp":{"enable":true,"mode":"proxy_over_warp","id":"key"}}`)
+	if len(built.Endpoints) != 1 || built.Endpoints[0].Type != C.TypeWARP {
+		t.Fatal("expected one WARP hop")
+	}
+	if built.Endpoints[0].Options.(*option.WARPEndpointOptions).Profile.License != "key" {
+		t.Fatal("license lost")
+	}
+}
+
+func TestLegacyWarpMigratesWithoutDroppingDetour(t *testing.T) {
+	built := buildChainConfig(t, `{"warp":{"enable":true,"mode":"proxy_over_warp","id":"old-key","clean-ip":"162.159.192.1","clean-port":2408}}`)
+	if outboundDetour(t, built, "proxy-a") != ChainHopTag(ChainStatusUnblocker, ChainModeWarp) {
+		t.Fatal("legacy WARP bypassed")
+	}
+	w := built.Endpoints[0].Options.(*option.WARPEndpointOptions)
+	if w.Profile.License != "old-key" || w.ServerPort != 2408 {
+		t.Fatal("legacy WARP options lost")
+	}
+}
+
+func TestChainCompatibilityRejectsAmbiguousOrForbiddenModes(t *testing.T) {
+	for _, settings := range []string{
+		`{"chain-status":"unblocker","chain-stage":{"direction":"extra_security","mode":"psiphon"}}`,
+		`{"warp2":{"enable":true}}`,
+		`{"warp":{"enable":true,"mode":"unknown"}}`,
+		`{"chain-status":"unblocker","unblocker":{"mode":"warp"},"privacy-modern-protocols-only":true}`,
+		`{"chain-status":"unblocker","unblocker":{"mode":"psiphon"},"enable-full-config":true}`,
+	} {
+		if _, err := BuildConfig(libbox.BaseContext(nil), chainTestOptions(t, settings), &ReadOptions{Content: chainTestProfile}); err == nil {
+			t.Fatalf("accepted %s", settings)
+		}
+	}
+}
+
+func TestNativePsiphonPreservesPairingAndNormalizesRegion(t *testing.T) {
