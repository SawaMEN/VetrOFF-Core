+package hcore
+
+import (
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/hiddify/hiddify-core/v2/config"
+	"github.com/sagernet/sing-box/experimental/libbox"
+)
+
+func TestPickTopProxies(t *testing.T) {
+	timeout := int32(maxPing)
+	tests := []struct {
+		name   string
+		delays map[string]int32
+		count  int
+		waited time.Duration
+		want   []string
+	}{
+		{"waits for the first pings", map[string]int32{"a": 100, "b": 0, "c": 0}, 2, time.Second, nil},
+		{"all in: the fastest", map[string]int32{"a": 300, "b": 100, "c": timeout, "d": 200}, 2, time.Second, []string{"b", "d"}},
+		{"fewer answer than count", map[string]int32{"a": 300, "b": timeout}, 10, time.Second, []string{"a"}},
+		{"none answers: none picked", map[string]int32{"a": timeout, "b": timeout}, 1, time.Hour, nil},
+		{"enough answered, the rest settle", map[string]int32{"a": 100, "b": 50, "c": 0}, 2, keepTopSettle, []string{"b", "a"}},
+		{"not enough answered yet", map[string]int32{"a": 100, "b": 0, "c": 0}, 2, keepTopSettle, nil},
+		{"waited long enough for any", map[string]int32{"a": 100, "b": 0, "c": 0}, 2, keepTopMaxWait, []string{"a"}},
+		{"ties go by tag", map[string]int32{"b": 100, "a": 100, "c": 100}, 2, time.Second, []string{"a", "b"}},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := pickTopProxies(test.delays, test.count, test.waited); !slices.Equal(got, test.want) {
+				t.Fatalf("got %v, want %v", got, test.want)
+			}
+		})
+	}
+}
+
+func TestWithSelectedKeepsTheCount(t *testing.T) {
+	tests := []struct {
+		name     string
+		pick     []string
+		count    int
+		selected string
+		want     []string
+	}{
+		{"no selection", []string{"a", "b"}, 2, "", []string{"a", "b"}},
+		{"selected among the fastest", []string{"a", "b"}, 2, "b", []string{"a", "b"}},
+		{"selected takes the slowest's place", []string{"a", "b", "c"}, 3, "x", []string{"a", "b", "x"}},
+		{"room left: selected joins", []string{"a"}, 3, "x", []string{"a", "x"}},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := withSelected(slices.Clone(test.pick), test.count, test.selected); !slices.Equal(got, test.want) {
+				t.Fatalf("got %v, want %v", got, test.want)
+			}
+		})
+	}
+}
+
+func TestBuildRunningConfigParsesImportedProfileFormats(t *testing.T) {
+	previous := static.HiddifyOptions
+	static.HiddifyOptions = config.DefaultHiddifyOptions()
+	t.Cleanup(func() { static.HiddifyOptions = previous })
+
+	// The app's import validator accepts these formats. Starting the same
+	// profile must not unconditionally JSON-decode the original share URI.
+	for _, profile := range []struct {
+		name, content string
+	}{
+		{"naive share URL", "naive://user:password@server.example:443?quic=0"},
+		{"trojan share URL", "trojan://password@server.example:443?security=tls"},
+		{"sing-box JSON", `{"outbounds":[{"type":"trojan","tag":"proxy","server":"server.example","server_port":443,"password":"password","tls":{"enabled":true}}]}`},
+	} {
+		t.Run(profile.name, func(t *testing.T) {
+			built, err := buildRunningConfig(libbox.BaseContext(nil), &StartRequest{ConfigContent: profile.content})
+			// The race-test build omits optional Naive support. Reaching the
+			// transport's explicit build-tag error still proves that startup
+			// ran the share-link parser instead of rejecting `naive://` as JSON.
+			if profile.name == "naive share URL" && err != nil &&
+				strings.Contains(err.Error(), "naive outbound is not included in this build") {
+				return
+			}
+			if err != nil {
+				t.Fatalf("importable profile failed to start: %v", err)
+			}
+			if built == nil || len(built.Outbounds) == 0 {
+				t.Fatal("no outbounds were built")
+			}
+		})
+	}
+}
diff --git a/v2/hcore/local_control_auth.go b/v2/hcore/local_control_auth.go
new file mode 100644
index 0000000000000000000000000000000000000000..c2e57276ca8b7f0e0790c10f8c84aa4106fbf476
--- /dev/null
+++ b/v2/hcore/local_control_auth.go
@@ -0,0 +1,58 @@
+package hcore
+
+import (
+	"context"
+	"crypto/subtle"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+)
+
+func localControlServerOptions(secret string) []grpc.ServerOption {
+	serverOptions := []grpc.ServerOption{
+		grpc.ChainUnaryInterceptor(func(ctx context.Context, req interface{}, _ *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (response interface{}, err error) {
+			defer func() {
+				if recovered := recover(); recovered != nil {
+					Log(LogLevel_ERROR, LogType_CORE, "RPC panic: ", recovered)
+					err = status.Error(codes.Internal, "core request failed")
+				}
+			}()
+			return handler(ctx, req)
+		}),
+		grpc.ChainStreamInterceptor(func(srv interface{}, stream grpc.ServerStream, _ *grpc.StreamServerInfo, handler grpc.StreamHandler) (err error) {
+			defer func() {
+				if recovered := recover(); recovered != nil {
+					Log(LogLevel_ERROR, LogType_CORE, "stream panic: ", recovered)
+					err = status.Error(codes.Internal, "core stream failed")
+				}
+			}()
+			return handler(srv, stream)
+		}),
+	}
+	if secret != "" {
+		check := func(ctx context.Context) error {
+			md, _ := metadata.FromIncomingContext(ctx)
+			values := md.Get("authorization")
+			if len(values) != 1 || subtle.ConstantTimeCompare([]byte(values[0]), []byte("Bearer "+secret)) != 1 {
+				return status.Error(codes.Unauthenticated, "local control authorization required")
+			}
+			return nil
+		}
+		serverOptions = append(serverOptions,
+			grpc.ChainUnaryInterceptor(func(ctx context.Context, req interface{}, _ *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (interface{}, error) {
+				if err := check(ctx); err != nil {
+					return nil, err
+				}
+				return handler(ctx, req)
+			}),
+			grpc.ChainStreamInterceptor(func(srv interface{}, stream grpc.ServerStream, _ *grpc.StreamServerInfo, handler grpc.StreamHandler) error {
+				if err := check(stream.Context()); err != nil {
+					return err
+				}
+				return handler(srv, stream)
+			}),
+		)
+	}
+	return serverOptions
+}
diff --git a/v2/hcore/local_control_auth_test.go b/v2/hcore/local_control_auth_test.go
