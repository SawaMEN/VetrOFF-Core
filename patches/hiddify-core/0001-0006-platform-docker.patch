diff --git a/platform/docker/Dockerfile b/platform/docker/Dockerfile
index 3ad655730d5cf5cedffb33dd3bc1f0cb8800621d..a92386512b0b0e1bf068950b3fa15cfb0cd8b622 100644
--- a/platform/docker/Dockerfile
+++ b/platform/docker/Dockerfile
@@ -1,31 +1,38 @@
 FROM alpine:latest
 ENV CONFIG='https://raw.githubusercontent.com/ircfspace/warpsub/main/export/warp#WARP%20(IRCF)'
-ENV VERSION=v5.4.0
+ENV VERSION=v5.5.5
 WORKDIR /hiddify
-RUN apk add  curl tar gzip libc6-compat # iptables ip6tables
+RUN apk add --no-cache curl tar gzip # iptables ip6tables
 
-RUN echo "architecture: $(apk --print-arch)" && \    
+# The release's Linux builds: the musl one where there is one (amd64, arm64, 386, armv7), statically
+# linked for Alpine; the others are statically linked as they are. Each archive holds a folder
+# (hiddify-core-linux-<build>/) with the hiddify-core binary; HiddifyCli, its old name, links to it
+# for a compose file that still runs that.
+RUN echo "architecture: $(apk --print-arch)" && \
     case "$(apk --print-arch)" in \
-            x86_64) ARCH=amd64 ;; \
-            i386|x86) ARCH=386 ;; \
-            aarch64) ARCH=arm64 ;; \
-            armv7) ARCH=armv7 ;; \
-            armv6|armhf) ARCH=armv6 ;; \
-            armv5) ARCH=armv5 ;; \
-            s390x) ARCH=s390x ;; \
+            x86_64) BUILD=amd64-musl ;; \
+            x86) BUILD=386-musl ;; \
+            aarch64) BUILD=arm64-musl ;; \
+            armv7) BUILD=armv7-musl ;; \
+            armhf) BUILD=armv6 ;; \
+            s390x) BUILD=s390x ;; \
             *) echo "Unsupported architecture: $(apk --print-arch) $(uname -m)" && exit 1 ;; \
         esac && \
-        echo "Downloading https://github.com/hiddify/hiddify-core/releases/download/${VERSION}/hiddify-core-linux-$ARCH.tar.gz" && \
-        curl -L -o hiddify-core.tar.gz https://github.com/hiddify/hiddify-core/releases/download/${VERSION}/hiddify-core-linux-$ARCH.tar.gz && \
-        tar -xzf hiddify-core.tar.gz && rm hiddify-core.tar.gz
+        URL="https://github.com/hiddify/hiddify-core/releases/download/${VERSION}/hiddify-core-linux-$BUILD.tar.gz" && \
+        echo "Downloading $URL" && \
+        curl -fL -o hiddify-core.tar.gz "$URL" && \
+        tar -xzf hiddify-core.tar.gz --strip-components=1 && rm hiddify-core.tar.gz && \
+        chmod +x hiddify-core && \
+        ln -s hiddify-core HiddifyCli
 COPY hiddify.sh .
 RUN chmod +x hiddify.sh
 
 EXPOSE 12334
 EXPOSE 12335
-EXPOSE 16756
-EXPOSE 12335
+EXPOSE 12336
 EXPOSE 12337
+EXPOSE 12338
+EXPOSE 16756
 
 
 ENTRYPOINT [ "/hiddify/hiddify.sh" ]
