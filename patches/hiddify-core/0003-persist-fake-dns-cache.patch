+func TestExperimentalFakeDNSCacheFollowsSetting(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		opt := DefaultHiddifyOptions()
+		opt.EnableFakeDNS = enabled
+		var options option.Options
+		setExperimental(&options, opt)
+		if got := options.Experimental.CacheFile.StoreFakeIP; got != enabled {
+			t.Errorf("StoreFakeIP = %t with EnableFakeDNS = %t", got, enabled)
+		}
+	}
