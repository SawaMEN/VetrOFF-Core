diff --git a/v2/config/inbound_ports.go b/v2/config/inbound_ports.go
new file mode 100644
index 0000000000000000000000000000000000000000..8f9a380e6e3e76c9aee95f04bf3bc622073a4df4
--- /dev/null
+++ b/v2/config/inbound_ports.go
@@ -0,0 +1,113 @@
+package config
+
+import (
+	"net/netip"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing/common/auth"
+
+	"github.com/hiddify/hiddify-core/v2/hutils"
+)
+
+// ProxyUser is the user name of the mixed port; its password is the proxy secret.
+const ProxyUser = "hiddify"
+
+// transparentPortsOpen says whether tproxy, redirect and direct open: they serve no app in VPN
+// mode, and take no password, so there only while the VPN is shared (a Linux gateway).
+func transparentPortsOpen(hopt *HiddifyOptions) bool {
+	return !hopt.EnableTun || hopt.AllowConnectionFromLAN
+}
+
+// portEnabled says whether a port opens: set, and its switch on, or unset and on by default.
+func portEnabled(enabled *bool, port uint16, byDefault bool) bool {
+	if enabled == nil {
+		return port > 0 && byDefault
+	}
+	return port > 0 && *enabled
+}
+
+// localPortOpen says whether this device's own proxy port (the mixed port, on loopback) opens: in
+// proxy and system proxy mode; in VPN mode, where every app already goes through the TUN, only when
+// the user asked for it.
+func localPortOpen(hopt *HiddifyOptions) bool {
+	return portEnabled(hopt.EnableMixedPort, hopt.MixedPort, true) && (!hopt.EnableTun || hopt.LocalProxyInVpn)
+}
+
+// localUsers are the users the local port asks for: none unless the user asked for the secret, as
+// browsers can not send a SOCKS5 password; and none as the system proxy, which can not pass one.
+func localUsers(hopt *HiddifyOptions) []auth.User {
+	if !hopt.LocalProxyAuth || hopt.SetSystemProxy {
+		return secretUsers("")
+	}
+	return secretUsers(hopt.LanSharingPassword)
+}
+
+// secretUsers is the one user of a port that asks for [secret], or none for no secret.
+func secretUsers(secret string) []auth.User {
+	if secret == "" {
+		return nil
+	}
+	return []auth.User{{Username: ProxyUser, Password: secret}}
+}
+
+// proxyListener is one address and port a mixed inbound listens on, with the users it asks for.
+type proxyListener struct {
+	tag   string
+	addr  netip.Addr
+	port  uint16
+	users []auth.User
+	// systemProxy: this listener is the one the system proxy points at
+	systemProxy bool
+}
+
+// proxyListeners are the mixed inbounds: this device's local port on loopback (localPortOpen), and
+// while the VPN is shared, the LAN sharing port on every address, always asking for the secret
+// (open only if the user removed it). The two are apart, so the local port can stay without a
+// password; on the same port, the shared one takes both, asking for the secret.
+//
+// Only the IPv4 loopback listener sets the system proxy: each listener that does so overwrites the
+// setting as it starts, and the ::1 one, starting last, left Windows pointed at http://[::1]:port,
+// which Telegram and other apps that read the system proxy can not use (5.5.1).
+func proxyListeners(hopt *HiddifyOptions, ipv6 bool) []proxyListener {
+	shared := hopt.AllowConnectionFromLAN && hopt.LanSharingPort > 0
+	var listeners []proxyListener
+	if localPortOpen(hopt) && !(shared && hopt.LanSharingPort == hopt.MixedPort) {
+		loopback := []netip.Addr{netip.MustParseAddr("127.0.0.1")}
+		if ipv6 {
+			loopback = append(loopback, netip.MustParseAddr("::1"))
+		}
+		for _, addr := range loopback {
+			listeners = append(listeners, proxyListener{
+				tag:         InboundMixedTag + addr.String(),
+				addr:        addr,
+				port:        hopt.MixedPort,
+				users:       localUsers(hopt),
+				systemProxy: hopt.SetSystemProxy && addr.Is4(),
+			})
+		}
+	}
+	if shared {
+		every := netip.MustParseAddr("0.0.0.0")
+		if ipv6 {
+			every = netip.MustParseAddr("::")
+		}
+		listeners = append(listeners, proxyListener{
+			tag:         InboundLanSharingTag + every.String(),
+			addr:        every,
+			port:        hopt.LanSharingPort,
+			users:       secretUsers(hopt.LanSharingPassword),
+			systemProxy: hopt.SetSystemProxy && hopt.LanSharingPort == hopt.MixedPort && localPortOpen(hopt),
+		})
+	}
+	return listeners
+}
+
+// tproxyAvailable: tproxy needs Linux's transparent sockets, which only root may open.
+func tproxyAvailable() bool {
+	return C.IsLinux && !C.IsAndroid && hutils.IsAdmin()
+}
+
+// redirectAvailable: redirect reads the original address from Linux netfilter or the macOS pf.
+func redirectAvailable() bool {
+	return (C.IsLinux || C.IsDarwin) && !C.IsAndroid && !C.IsIos
+}
diff --git a/v2/config/inbound_ports_test.go b/v2/config/inbound_ports_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..393db9dab2c1a8eed219a39864542314784cfd68
--- /dev/null
+++ b/v2/config/inbound_ports_test.go
@@ -0,0 +1,139 @@
+package config
+
+import (
+	"fmt"
+	"net/netip"
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/experimental/libbox"
+	"github.com/sagernet/sing-box/option"
+)
+
+// mixedInbounds builds the config of settings and returns its mixed inbounds by "address port", and
+// each transparent port that opened by its type.
+func mixedInbounds(t *testing.T, settings string) map[string]*option.HTTPMixedInboundOptions {
+	t.Helper()
+	options, err := BuildConfig(libbox.BaseContext(nil), chainTestOptions(t, settings), &ReadOptions{Content: chainTestProfile})
+	if err != nil {
+		t.Fatalf("BuildConfig: %v", err)
+	}
+	mixed := map[string]*option.HTTPMixedInboundOptions{}
+	for _, inbound := range options.Inbounds {
+		switch inbound.Type {
+		case C.TypeMixed:
+			opts := inbound.Options.(*option.HTTPMixedInboundOptions)
+			mixed[fmt.Sprint(netip.Addr(*opts.Listen), " ", opts.ListenPort)] = opts
+		case C.TypeRedirect, C.TypeTProxy, C.TypeDirect:
+			mixed[inbound.Type] = nil
+		}
+	}
+	return mixed
+}
+
+
+func TestLANSharingPasswordJSONDoesNotShadowConfiguredSecret(t *testing.T) {
+	opts := chainTestOptions(t, `{"lan-sharing-password":"s3cret","local-proxy-auth":true}`)
+	if opts.LanSharingPassword != "s3cret" {
+		t.Fatalf("LAN sharing password not decoded: %q", opts.LanSharingPassword)
+	}
+	users := localUsers(opts)
+	if len(users) != 1 || users[0].Password != "s3cret" {
+		t.Fatalf("local proxy authentication lost: %v", users)
+	}
+}
+
+const ports = `"mixed-port":12334,"lan-sharing-port":12338,"redirect-port":12336,"direct-port":12337,"lan-sharing-password":"s3cret"`
+
+func asksTheSecret(opts *option.HTTPMixedInboundOptions) bool {
+	return len(opts.Users) == 1 && opts.Users[0].Username == ProxyUser && opts.Users[0].Password == "s3cret"
+}
+
+func TestVPNModeOpensNoPort(t *testing.T) {
+	if got := mixedInbounds(t, `{"enable-tun":true,`+ports+`}`); len(got) != 0 {
+		t.Fatalf("VPN mode opened %v", got)
+	}
+}
+
+func TestVPNModeOpensTheLocalPortWhenAsked(t *testing.T) {
+	got := mixedInbounds(t, `{"enable-tun":true,"local-proxy-in-vpn":true,`+ports+`}`)
+	opts := got["127.0.0.1 12334"]
+	if opts == nil || len(opts.Users) != 0 || len(got) != 2 {
+		t.Fatalf("VPN mode, local port asked for: %v", got)
+	}
+}
+
+func TestSharingOpensItsOwnPortWithTheSecret(t *testing.T) {
+	got := mixedInbounds(t, `{"enable-tun":true,"allow-connection-from-lan":true,`+ports+`}`)
+	opts := got[":: 12338"]
+	if opts == nil || !asksTheSecret(opts) || opts.SetSystemProxy {
+		t.Fatalf("shared VPN: %v", got)
+	}
+	if got["127.0.0.1 12334"] != nil {
+		t.Fatal("a shared VPN opened the local port too")
+	}
+}
+
+func TestProxyModeLocalPortHasNoPasswordByDefault(t *testing.T) {
+	got := mixedInbounds(t, `{`+ports+`}`)
+	opts := got["127.0.0.1 12334"]
+	if opts == nil || len(opts.Users) != 0 || opts.SetSystemProxy {
+		t.Fatalf("proxy mode local port = %+v", got)
+	}
+}
+
+func TestProxyModeLocalPortAsksTheSecretWhenAsked(t *testing.T) {
+	got := mixedInbounds(t, `{"local-proxy-auth":true,`+ports+`}`)
+	if opts := got["127.0.0.1 12334"]; opts == nil || !asksTheSecret(opts) {
+		t.Fatalf("proxy mode local port with a password = %+v", got)
+	}
+}
+
+func TestSystemProxyNeverAsksThisDevice(t *testing.T) {
+	got := mixedInbounds(t, `{"set-system-proxy":true,"local-proxy-auth":true,"allow-connection-from-lan":true,`+ports+`}`)
+	if opts := got["127.0.0.1 12334"]; opts == nil || len(opts.Users) != 0 || !opts.SetSystemProxy {
+		t.Fatalf("the system proxy's own listener = %+v", opts)
+	}
+	if opts := got[":: 12338"]; opts == nil || !asksTheSecret(opts) || opts.SetSystemProxy {
+		t.Fatalf("the network's listener = %+v", opts)
+	}
+}
+
+// The ::1 listener starts after the 127.0.0.1 one; were it the system proxy too, Windows would be
+// left pointed at http://[::1]:port, which Telegram can not use.
+func TestSystemProxyIsTheIPv4LoopbackOnly(t *testing.T) {
+	got := mixedInbounds(t, `{"set-system-proxy":true,`+ports+`}`)
+	if opts := got["127.0.0.1 12334"]; opts == nil || !opts.SetSystemProxy {
+		t.Fatalf("the IPv4 loopback listener = %+v", opts)
+	}
+	if opts := got["::1 12334"]; opts == nil || opts.SetSystemProxy {
+		t.Fatalf("the IPv6 loopback listener = %+v", opts)
+	}
+}
+
+func TestSharingOnTheLocalPortTakesItOver(t *testing.T) {
+	got := mixedInbounds(t, `{"allow-connection-from-lan":true,`+ports+`,"lan-sharing-port":12334}`)
+	opts := got[":: 12334"]
+	if opts == nil || !asksTheSecret(opts) || len(got) != 1 {
+		t.Fatalf("sharing on the local port: %v", got)
+	}
+}
+
+func TestPortSwitchesTurnPortsOff(t *testing.T) {
+	got := mixedInbounds(t, `{"enable-mixed-port":false,"enable-redirect-port":false,"enable-direct-port":false,`+ports+`}`)
+	if len(got) != 0 {
+		t.Fatalf("switched off ports opened %v", got)
+	}
+}
+
+func TestTransparentPortsAreOffUntilAskedFor(t *testing.T) {
+	got := mixedInbounds(t, `{"set-system-proxy":true,`+ports+`}`)
+	for addr, opts := range got {
+		if opts == nil {
+			t.Fatalf("an unset transparent port opened: %s", addr)
+		}
+	}
+	if got["127.0.0.1 12334"] == nil {
+		t.Fatal("the proxy port, on by default, did not open")
+	}
+}
diff --git a/v2/config/keep_top.go b/v2/config/keep_top.go
new file mode 100644
index 0000000000000000000000000000000000000000..72d0c4e09234dc02c5d9fe560be2914f66da4bbf
--- /dev/null
+++ b/v2/config/keep_top.go
@@ -0,0 +1,136 @@
+package config
+
+import (
+	"context"
+	"encoding/json"
+	"slices"
+	"strings"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+)
+
+// With keep-top, a profile with many proxies runs only its fastest few once their first
+// pings are in (hcore picks them). These helpers find a profile's proxies and drop the others from
+// its options before the config is built; the extra security and unblocker hops are not the
+// profile's, so they always stay.
+
+// UserProxyTags are the proxies of the profile that end up in the select group: what setOutbounds
+// lists, before the chain hop is added.
+func UserProxyTags(input *option.Options) []string {
+	var tags []string
+	for _, out := range input.Outbounds {
+		if isUserProxy(out.Tag, out.Type) && !isDNSOutbound(out) {
+			tags = append(tags, out.Tag)
+		}
+	}
+	for _, end := range input.Endpoints {
+		if isUserProxy(end.Tag, end.Type) {
+			tags = append(tags, end.Tag)
+		}
+	}
+	return tags
+}
+
+// ChosenProxies are the tags of chosen that are the profile's proxies (UserProxyTags), to keep.
+func ChosenProxies(input *option.Options, chosen []string) map[string]bool {
+	keep := make(map[string]bool)
+	for _, tag := range UserProxyTags(input) {
+		if slices.Contains(chosen, tag) {
+			keep[tag] = true
+		}
+	}
+	return keep
+}
+
+func isUserProxy(tag, typ string) bool {
+	if contains(PredefinedOutboundTags, tag) || contains([]string{"direct", "bypass", "block"}, tag) {
+		return false
+	}
+	if strings.Contains(tag, "§hide§") {
+		return false
+	}
+	switch typ {
+	case C.TypeBlock, C.TypeSelector, C.TypeURLTest, C.TypeCustom, C.TypeDNS:
+		return false
+	}
+	return true
+}
+
+// KeepOnlyProxies drops the profile's proxies that are not in keep, except those a kept one goes
+// through (its detour, and theirs), and returns how many were dropped.
+func KeepOnlyProxies(ctx context.Context, input *option.Options, keep map[string]bool) int {
+	needed := make(map[string]bool, len(keep))
+	for tag := range keep {
+		needed[tag] = true
+	}
+	looked := make(map[string]bool)
+	for grew := true; grew; {
+		grew = false
+		for i := range input.Outbounds {
+			if tag := input.Outbounds[i].Tag; needed[tag] && !looked[tag] {
+				looked[tag], grew = true, true
+				content, _ := input.Outbounds[i].MarshalJSONContext(ctx)
+				addDetours(content, needed)
+			}
+		}
+		for i := range input.Endpoints {
+			if tag := input.Endpoints[i].Tag; needed[tag] && !looked[tag] {
+				looked[tag], grew = true, true
+				content, _ := input.Endpoints[i].MarshalJSONContext(ctx)
+				addDetours(content, needed)
+			}
+		}
+	}
+	dropped := 0
+	outbounds := input.Outbounds[:0]
+	for _, out := range input.Outbounds {
+		if isUserProxy(out.Tag, out.Type) && !isDNSOutbound(out) && !needed[out.Tag] {
+			dropped++
+			continue
+		}
+		outbounds = append(outbounds, out)
+	}
+	input.Outbounds = outbounds
+	endpoints := input.Endpoints[:0]
+	for _, end := range input.Endpoints {
+		if isUserProxy(end.Tag, end.Type) && !needed[end.Tag] {
+			dropped++
+			continue
+		}
+		endpoints = append(endpoints, end)
+	}
+	input.Endpoints = endpoints
+	return dropped
+}
+
+// addDetours adds every "detour" an outbound's options name, at any depth, to needed.
+func addDetours(content []byte, needed map[string]bool) {
+	var value any
+	if json.Unmarshal(content, &value) != nil {
+		return
+	}
+	walkJSON(value, func(object map[string]any, key string, field any) bool {
+		if tag, ok := field.(string); ok && key == "detour" && tag != "" {
+			needed[tag] = true
+		}
+		return true
+	})
+}
+
+// walkJSON visits every field of every object in a JSON tree, depth first: visit gets the object,
+// the key and the field, and says whether to go on into the field.
+func walkJSON(value any, visit func(object map[string]any, key string, field any) bool) {
+	switch v := value.(type) {
+	case map[string]any:
+		for key, field := range v {
+			if visit(v, key, field) {
+				walkJSON(field, visit)
+			}
+		}
+	case []any:
+		for _, field := range v {
+			walkJSON(field, visit)
+		}
+	}
+}
