+package config
+
+import (
+	"reflect"
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/experimental/libbox"
+	"github.com/sagernet/sing-box/option"
+)
+
+func TestRussianNetworkPriorityAcrossRoutingModes(t *testing.T) {
+	for _, mode := range []string{"off", "ru-bypass", "proxy-selected"} {
+		for _, full := range []bool{false, true} {
+			for _, community := range []bool{false, true} {
+				h := DefaultHiddifyOptions()
+				h.Region, h.PrivacyRoutingMode, h.FullTunnel, h.HandbookRouting = "ru", mode, full, community
+				h.PrivacyRussianNetworkBypass = true
+				h.PrivacyProxyPackages = []string{"com.example.app"}
+				h.PrivacyProxyDomains = []string{"example.ru"}
+				// Simulate existing community/profile/full-tunnel rules: they must stay behind the exception.
+				existing := option.Rule{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultRule{
+					RuleAction: option.RuleAction{Action: C.RuleActionTypeRoute, RouteOptions: option.RouteActionOptions{Outbound: OutboundMainDetour}},
+				}}
+				opts := &option.Options{Route: &option.RouteOptions{Rules: []option.Rule{existing}}, DNS: &option.DNSOptions{}}
+				applyRegionalPrivacy(opts, h)
+				if opts.Route.Rules[0].DefaultOptions.Action != C.RuleActionTypeSniff ||
+					opts.Route.Rules[1].DefaultOptions.Action != C.RuleActionTypeHijackDNS {
+					t.Fatal("sniffing and DNS interception must precede routing")
+				}
+				domains, geo := opts.Route.Rules[3].DefaultOptions, opts.Route.Rules[4].DefaultOptions
+				if domains.RouteOptions.Outbound != OutboundDirectTag ||
+					!reflect.DeepEqual([]string(domains.DomainSuffix), []string{"ru", "su", "xn--p1ai"}) {
+					t.Fatalf("Russian domains must route first: mode=%s full=%v community=%v", mode, full, community)
+				}
+				if geo.RouteOptions.Outbound != OutboundDirectTag ||
+					!reflect.DeepEqual([]string(geo.RuleSet), []string{"geosite-ru", "geoip-ru"}) {
+					t.Fatal("Russian geosite and IP rules must precede VPN application rules")
+				}
+				if opts.Route.Rules[len(opts.Route.Rules)-1].DefaultOptions.RouteOptions.Outbound != OutboundMainDetour {
+					t.Fatal("existing VPN fallback must be preserved")
+				}
+				if !reflect.DeepEqual([]string(opts.DNS.Rules[1].DefaultOptions.RuleSet), []string{"geosite-ru"}) ||
+					opts.DNS.Rules[1].DefaultOptions.RouteOptions.Server != DNSMultiDirectTag {
+					t.Fatal("Russian names must resolve directly without a GeoIP DNS matcher")
+				}
+				if len(opts.Route.RuleSet) != 2 {
+					t.Fatal("both geographic datasets are required")
+				}
+				applyRussianNetworkPriority(opts, h)
+				if len(opts.Route.RuleSet) != 2 {
+					t.Fatal("existing geographic datasets must not be duplicated")
+				}
+			}
+		}
+	}
+}
+
+func TestDisabledRussianNetworkAddsNoPriorityRules(t *testing.T) {
+	h := DefaultHiddifyOptions()
+	h.Region = "other"
+	opts := &option.Options{Route: &option.RouteOptions{}, DNS: &option.DNSOptions{}}
+	applyRussianNetworkPriority(opts, h)
+	if len(opts.Route.Rules) != 0 || len(opts.Route.RuleSet) != 0 || len(opts.DNS.Rules) != 0 {
+		t.Fatal("disabled network exception must not add rules or download datasets")
+	}
+}
+
+func TestRussianNetworkPriorityInGeneratedFullTunnelConfig(t *testing.T) {
+	h := DefaultHiddifyOptions()
+	h.Region = "ru"
+	h.PrivacyRussianNetworkBypass = true
+	h.FullTunnel = true
+	h.EnableTun = true
+	built, err := BuildConfig(libbox.BaseContext(nil), h, &ReadOptions{Content: legacyDNSOutboundProfile})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if built.Route.Rules[4].DefaultOptions.RouteOptions.Outbound != OutboundDirectTag {
+		t.Fatal("Russian geographic exception must precede full tunnel")
+	}
+	if built.DNS.Rules[1].DefaultOptions.RouteOptions.Server != DNSMultiDirectTag {
+		t.Fatal("Russian DNS exception must precede full tunnel DNS")
+	}
+	foundTunnel := false
+	for _, r := range built.Route.Rules {
+		if r.DefaultOptions.RouteOptions.Outbound == OutboundMainDetour {
+			foundTunnel = true
+		}
+	}
+	if !foundTunnel {
+		t.Fatal("other traffic must retain the VPN fallback")
+	}
+}
diff --git a/v2/config/stable_tags.go b/v2/config/stable_tags.go
new file mode 100644
index 0000000000000000000000000000000000000000..d9fbadf68d1e6a040bab0427cb171f1f01ff4c3d
--- /dev/null
+++ b/v2/config/stable_tags.go
@@ -0,0 +1,227 @@
+package config
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"strconv"
+	"strings"
+
+	"github.com/sagernet/sing-box/option"
+)
+
+// Stable tags across profile updates.
+//
+// The share links of a profile are numbered by their position ("name § 59"). A subscription
+// update that adds, removes or reorders a link renumbers every link after it, so every proxy
+// looked changed: the hot reload replaced them all, their pings went back to cached, and the
+// whole list was tested again, which also made keep top pick anew. StableProxyTags gives a proxy
+// of the new profile the tag it had in the previous one when its options are the same (the tag
+// and the detour aside, the detour being the previous link of a chain, renamed with it), so the
+// hot reload keeps its instance and its ping. A new proxy whose tag an old one took gets a free
+// number. References follow the renaming: detours, group members, route and selector targets.
+
+// StableProxyTags renames the profile's proxies in input to the tags they had in previous (the
+// ProxyItems of the profile as last built, nil the first time), when their options are the same.
+// It returns input's proxies with their tags as they are now, for the next time, and how many
+// were renamed.
+func StableProxyTags(ctx context.Context, input *option.Options, previous []ProxyItem) ([]ProxyItem, int, error) {
+	if input == nil {
+		return nil, 0, nil
+	}
+	raw, err := input.MarshalJSONContext(ctx)
+	if err != nil {
+		return nil, 0, err
+	}
+	var tree map[string]any
+	if err := json.Unmarshal(raw, &tree); err != nil {
+		return nil, 0, err
+	}
+	items := ProxyItems(tree)
+	rename := stableRenaming(previous, items)
+	if len(rename) == 0 {
+		return items, 0, nil
+	}
+	renameReferences(tree, rename)
+	renamed, err := json.Marshal(tree)
+	if err != nil {
+		return nil, 0, err
+	}
+	var options option.Options
+	if err := options.UnmarshalJSONContext(ctx, renamed); err != nil {
+		return nil, 0, err
+	}
+	*input = options
+	for i := range items {
+		if to, ok := rename[items[i].Tag]; ok {
+			items[i].Tag = to
+		}
+	}
+	return items, len(rename), nil
+}
+
+// ProxyItem is a proxy of a profile: its tag and its fingerprint, a hash of its options but the
+// tag and the detour. Keep top keeps its pick by the same fingerprint.
+type ProxyItem struct {
+	Tag         string
+	Fingerprint string
+}
+
+// Fingerprints are the items by tag, as keep top keeps them.
+func Fingerprints(items []ProxyItem) map[string]string {
+	fingerprints := make(map[string]string, len(items))
+	for _, item := range items {
+		fingerprints[item.Tag] = item.Fingerprint
+	}
+	return fingerprints
+}
+
+// ProxyItems are the profile's proxies in tree, the profile's options as a JSON tree.
+func ProxyItems(tree map[string]any) []ProxyItem {
+	var items []ProxyItem
+	for _, key := range []string{"outbounds", "endpoints"} {
+		list, _ := tree[key].([]any)
+		for _, entry := range list {
+			object, ok := entry.(map[string]any)
+			if !ok {
+				continue
+			}
+			tag, _ := object["tag"].(string)
+			typ, _ := object["type"].(string)
+			if tag == "" || !isUserProxy(tag, typ) {
+				continue
+			}
+			copied := make(map[string]any, len(object))
+			for k, v := range object {
+				if k != "tag" && k != "detour" {
+					copied[k] = v
+				}
+			}
+			content, err := json.Marshal(copied) // encoding/json sorts the keys
+			if err != nil {
+				continue
+			}
+			sum := sha256.Sum256(content)
+			items = append(items, ProxyItem{Tag: tag, Fingerprint: hex.EncodeToString(sum[:])})
+		}
+	}
+	return items
+}
+
+// stableRenaming maps the new tags to the old ones of the same proxies, in order of appearance
+// for repeated ones, and a new proxy whose tag an old one takes to a free one.
+func stableRenaming(oldItems, newItems []ProxyItem) map[string]string {
+	oldByFingerprint := make(map[string][]string)
+	for _, item := range oldItems {
+		oldByFingerprint[item.Fingerprint] = append(oldByFingerprint[item.Fingerprint], item.Tag)
+	}
+	rename := make(map[string]string)
+	taken := make(map[string]bool)
+	var unmatched []string
+	for _, item := range newItems {
+		if tags := oldByFingerprint[item.Fingerprint]; len(tags) > 0 {
+			oldTag := tags[0]
+			oldByFingerprint[item.Fingerprint] = tags[1:]
+			taken[oldTag] = true
+			if oldTag != item.Tag {
+				rename[item.Tag] = oldTag
+			}
+			continue
+		}
+		unmatched = append(unmatched, item.Tag)
+	}
+	if len(rename) == 0 {
+		return rename
+	}
+	// a new proxy keeps its tag unless a matched one took it
+	highest := highestTagNumber(oldItems, newItems)
+	for _, tag := range unmatched {
+		if !taken[tag] {
+			taken[tag] = true
+			continue
+		}
+		base, _, _ := splitNumberedTag(tag)
+		candidate := freeName(base, highest+1, func(name string) bool { return taken[name] })
+		taken[candidate] = true
+		rename[tag] = candidate
+		_, highest, _ = splitNumberedTag(candidate)
+	}
+	return rename
+}
+
+// splitNumberedTag splits a numbered tag ("x § 12") into its name and number; numbered is false
+// for a plain tag, whose name is the tag.
+func splitNumberedTag(tag string) (name string, n int, numbered bool) {
+	parts := strings.SplitN(tag, " § ", 2)
+	if len(parts) < 2 {
+		return tag, 0, false
+	}
+	n, err := strconv.Atoi(strings.TrimSpace(parts[1]))
+	return parts[0], n, err == nil
+}
+
+// highestTagNumber is the highest number of the numbered tags in lists.
+func highestTagNumber(lists ...[]ProxyItem) int {
+	highest := 0
+	for _, items := range lists {
+		for _, item := range items {
+			if _, n, numbered := splitNumberedTag(item.Tag); numbered && n > highest {
+				highest = n
+			}
+		}
+	}
+	return highest
+}
+
+// referenceKeys hold a tag: an outbound's detour, a group's members and default, a route
+// rule's or the DNS's outbound, the route's final.
+var referenceKeys = map[string]bool{"detour": true, "outbounds": true, "default": true, "outbound": true, "final": true}
+
+// renameReferences renames the tags of the outbounds and endpoints, and every reference to them,
+// in the whole tree. A renaming is applied at once, so a swap of two tags is right.
+func renameReferences(tree map[string]any, rename map[string]string) {
+	for _, key := range []string{"outbounds", "endpoints"} {
+		list, _ := tree[key].([]any)
+		for _, entry := range list {
+			if object, ok := entry.(map[string]any); ok {
+				if tag, ok := object["tag"].(string); ok {
+					if to, renamed := rename[tag]; renamed {
+						object["tag"] = to
+					}
+				}
+			}
+		}
+	}
+	walkJSON(tree, func(object map[string]any, key string, field any) bool {
+		if !referenceKeys[key] {
+			return true
+		}
+		if tag, ok := field.(string); ok {
+			if to, renamed := rename[tag]; renamed {
+				object[key] = to
+			}
+			return false
+		}
+		return !renameMembers(field, rename) // the top-level outbounds list, of objects, is walked
+	})
+}
+
+// renameMembers renames the tags of a list of them in place (a group's members) and reports
+// whether field was one; the top-level outbounds list, of objects, is not.
+func renameMembers(field any, rename map[string]string) bool {
+	list, ok := field.([]any)
+	if !ok {
+		return false
+	}
+	tags := false
+	for i, item := range list {
+		if tag, ok := item.(string); ok {
+			tags = true
+			if to, renamed := rename[tag]; renamed {
+				list[i] = to
+			}
+		}
+	}
+	return tags
+}
diff --git a/v2/config/stable_tags_test.go b/v2/config/stable_tags_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..7e8f37eefe227ba462b87b7a824daeea02162f98
--- /dev/null
+++ b/v2/config/stable_tags_test.go
@@ -0,0 +1,101 @@
+package config
+
+import (
+	"context"
+	"fmt"
+	"testing"
+
+	"github.com/sagernet/sing-box/experimental/libbox"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json"
+	"github.com/stretchr/testify/require"
+)
+
+func parseOptions(t *testing.T, ctx context.Context, content string) *option.Options {
+	t.Helper()
+	options, err := json.UnmarshalExtendedContext[option.Options](ctx, []byte(content))
+	require.NoError(t, err)
+	return &options
+}
+
+// previousItems are the proxy items of a profile as last built, what StableProxyTags is given.
+func previousItems(t *testing.T, ctx context.Context, options *option.Options) []ProxyItem {
+	t.Helper()
+	items, _, err := StableProxyTags(ctx, options, nil)
+	require.NoError(t, err)
+	return items
+}
+
+func itemTags(items []ProxyItem) []string {
+	tags := make([]string, 0, len(items))
+	for _, item := range items {
+		tags = append(tags, item.Tag)
+	}
+	return tags
+}
+
+// ss is a shadowsocks outbound of a profile, as JSON; ssVia dials through detour.
+func ss(tag, server string, port int) string {
+	return fmt.Sprintf(`{"type": "shadowsocks", "tag": %q, "server": %q, "server_port": %d, "method": "aes-128-gcm", "password": "p"}`, tag, server, port)
+}
+
+func ssVia(tag, server string, port int, detour string) string {
+	return ss(tag, server, port)[:len(ss(tag, server, port))-1] + fmt.Sprintf(`, "detour": %q}`, detour)
+}
+
+func tagsOf(options *option.Options) []string {
+	var tags []string
+	for _, out := range options.Outbounds {
+		tags = append(tags, out.Tag)
+	}
+	return tags
+}
+
+// A subscription update that adds a link renumbers the links after it. The proxies that did not
+// change keep the tags they had, so the hot reload keeps them and their pings, and the references
+// to them follow.
+func TestStableProxyTagsKeepTheOldTagsOfUnchangedProxies(t *testing.T) {
+	ctx := libbox.BaseContext(nil)
+	previous := parseOptions(t, ctx, `{"outbounds": [`+ss("a § 0", "a.example.com", 443)+", "+ss("b § 1", "b.example.com", 443)+", "+ss("c § 2", "c.example.com", 443)+`, {"type": "selector", "tag": "g", "outbounds": ["a § 0", "b § 1", "c § 2"], "default": "b § 1"}]}`)
+	// n is new and first, so every old link moved one up; c changed its port
+	input := parseOptions(t, ctx, `{"outbounds": [`+ss("n § 0", "n.example.com", 443)+", "+ss("a § 1", "a.example.com", 443)+", "+ss("b § 2", "b.example.com", 443)+", "+ss("c § 3", "c.example.com", 8443)+`, {"type": "selector", "tag": "g", "outbounds": ["n § 0", "a § 1", "b § 2", "c § 3"], "default": "b § 2"}], "route": {"rules": [{"domain": ["x.example.com"], "outbound": "a § 1"}], "final": "b § 2"}}`)
+	items, renamed, err := StableProxyTags(ctx, input, previousItems(t, ctx, previous))
+	require.NoError(t, err)
+	require.Equal(t, 2, renamed, "a and b take their old tags; n and the changed c keep theirs")
+	require.Equal(t, []string{"n § 0", "a § 0", "b § 1", "c § 3"}, itemTags(items), "the items for the next time carry the tags as they are now")
+	require.Equal(t, []string{"n § 0", "a § 0", "b § 1", "c § 3", "g"}, tagsOf(input))
+	selector := input.Outbounds[4].Options.(*option.SelectorOutboundOptions)
+	require.Equal(t, []string{"n § 0", "a § 0", "b § 1", "c § 3"}, selector.Outbounds)
+	require.Equal(t, "b § 1", selector.Default)
+	require.Equal(t, "a § 0", input.Route.Rules[0].DefaultOptions.RouteOptions.Outbound)
+	require.Equal(t, "b § 1", input.Route.Final)
+
+	// nothing changed: nothing renamed
+	again := parseOptions(t, ctx, `{"outbounds": [`+ss("a § 0", "a.example.com", 443)+`]}`)
+	_, renamed, err = StableProxyTags(ctx, again, previousItems(t, ctx, parseOptions(t, ctx, `{"outbounds": [`+ss("a § 0", "a.example.com", 443)+`]}`)))
+	require.NoError(t, err)
+	require.Equal(t, 0, renamed)
+}
+
+// A chain's links dial through the previous link: the detour is not part of the fingerprint, and
+// it is renamed with the link it names.
+func TestStableProxyTagsFollowTheDetourOfAChain(t *testing.T) {
+	ctx := libbox.BaseContext(nil)
+	previous := parseOptions(t, ctx, `{"outbounds": [`+ss("first § 0", "1.example.com", 443)+", "+ssVia("second § 0", "2.example.com", 443, "first § 0")+`]}`)
+	input := parseOptions(t, ctx, `{"outbounds": [`+ss("new § 0", "0.example.com", 443)+", "+ss("first § 1", "1.example.com", 443)+", "+ssVia("second § 1", "2.example.com", 443, "first § 1")+`]}`)
+	_, _, err := StableProxyTags(ctx, input, previousItems(t, ctx, previous))
+	require.NoError(t, err)
+	require.Equal(t, []string{"new § 0", "first § 0", "second § 0"}, tagsOf(input))
+	require.Equal(t, "first § 0", input.Outbounds[2].Options.(*option.ShadowsocksOutboundOptions).DialerOptions.Detour)
+}
+
+// A new proxy that got the tag an unchanged one had takes a free number instead.
+func TestStableProxyTagsGiveANewProxyAFreeNumber(t *testing.T) {
+	ctx := libbox.BaseContext(nil)
+	previous := parseOptions(t, ctx, `{"outbounds": [`+ss("x § 0", "a.example.com", 443)+`]}`)
+	input := parseOptions(t, ctx, `{"outbounds": [`+ss("x § 0", "new.example.com", 443)+", "+ss("x § 1", "a.example.com", 443)+`]}`)
+	_, renamed, err := StableProxyTags(ctx, input, previousItems(t, ctx, previous))
+	require.NoError(t, err)
+	require.Equal(t, 2, renamed)
+	require.Equal(t, []string{"x § 2", "x § 0"}, tagsOf(input))
+}
