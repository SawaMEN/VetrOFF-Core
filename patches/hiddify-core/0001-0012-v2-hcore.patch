@@ -0,0 +1,53 @@
+package hcore
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestSendLogsFlushesBurstAndPreservesOrder(t *testing.T) {
+	logs := make(chan *LogMessage, 8)
+	debug := &LogMessage{Level: LogLevel_DEBUG}
+	first := &LogMessage{Level: LogLevel_INFO, Message: "first"}
+	second := &LogMessage{Level: LogLevel_INFO, Message: "second"}
+	warning := &LogMessage{Level: LogLevel_WARNING}
+	logs <- debug
+	logs <- nil
+	logs <- first
+	logs <- second
+	logs <- warning
+
+	done := errors.New("stream closed")
+	var sent []*LogMessage
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	err := sendLogs(ctx, logs, LogLevel_INFO, func(message *LogMessage) error {
+		sent = append(sent, message)
+		if message == warning {
+			return done
+		}
+		return nil
+	})
+	require.ErrorIs(t, err, done)
+	require.Equal(t, []*LogMessage{first, second, warning}, sent)
+}
+
+func TestSendLogsFlushesOnInputClose(t *testing.T) {
+	logs := make(chan *LogMessage, 1)
+	want := &LogMessage{Level: LogLevel_INFO}
+	logs <- want
+	close(logs)
+	var sent []*LogMessage
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	err := sendLogs(ctx, logs, LogLevel_INFO, func(message *LogMessage) error {
+		sent = append(sent, message)
+		return nil
+	})
+	require.NoError(t, err)
+	require.Equal(t, []*LogMessage{want}, sent)
+}
