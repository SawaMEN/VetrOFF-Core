+)
+
+func TestLastStartRequestFollowsMovedWorkingDirectory(t *testing.T) {
+	root := t.TempDir()
+	work := filepath.Join(root, "Support", "Working")
+	relative := filepath.Join("configs", "a.json")
+	config := filepath.Join(work, relative)
+	require.NoError(t, os.MkdirAll(filepath.Dir(config), 0o700))
+	require.NoError(t, os.WriteFile(config, []byte("{}"), 0o600))
+	require.NoError(t, Setup(&SetupRequest{
+		BasePath: work, WorkingDir: work, TempDir: work, Mode: SetupMode_OLD,
+	}, nil))
+
+	require.NoError(t, saveLastStartRequest(&StartRequest{ConfigPath: config, ConfigName: "a"}))
+	request, err := loadLastStartRequestIfNeeded(&StartRequest{})
+	require.NoError(t, err)
+	require.Equal(t, config, request.ConfigPath)
+	require.Equal(t, relative, workingRelative(config))
+	legacy := filepath.Join(root, "Caches", "Working", relative)
+	require.Equal(t, config, inWorkingDir(legacy))
+
+	// An existing absolute path outside the working directory remains valid.
+	external := filepath.Join(root, "external.json")
+	require.NoError(t, os.WriteFile(external, []byte("{}"), 0o600))
+	require.Equal(t, external, workingRelative(external))
+	require.Equal(t, external, inWorkingDir(external))
+}
